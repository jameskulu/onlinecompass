---
import Layout from '../../layouts/Layout.astro';
import BubbleLevel from '../../components/BubbleLevel.astro';
import PageHero from '../../components/PageHero.astro';
import RelatedTools from '../../components/RelatedTools.astro';
---

<Layout
	title="آن لائن ڈیجیٹل ببل لیول — مفت اسپرٹ لیول اور انکلینومیٹر"
	description="فون کے جائروسکوپ سے کام کرنے والا مفت آن لائن ڈیجیٹل ببل لیول اور انکلینومیٹر۔ سطح کی ہمواری، پچ اور رول کا زاویہ معلوم کریں۔ زیرو کیلیبریشن کے ساتھ۔"
	path="/ur/level/"
	keywords="ڈیجیٹل ببل لیول, آن لائن اسپرٹ لیول, زاویہ پیمائش, سطح ہموار کرنا"
>
	<PageHero
		eyebrow="ببل لیول · انکلینومیٹر"
		title="اپنے براؤزر میں درست سطح کی پیمائش۔"
		description="اپنے اسمارٹ فون کو ایک درست ڈیجیٹل اسپرٹ لیول میں تبدیل کریں۔ ہیمپٹک وائبریشن اور زیرو کیلیبریشن کے ساتھ کسی بھی سطح کی ہمواری چیک کریں۔"
	>
		<BubbleLevel />
	</PageHero>

	<section class="border-t border-hairline bg-canvas">
		<div class="mx-auto max-w-3xl px-4 py-20 sm:px-6 md:py-24">
			<p class="eyebrow">ببل لیول · انکلینومیٹر</p>
			<h2 class="mt-3 text-display-lg text-ink">ڈیجیٹل ببل لیول اور انکلینومیٹر کیسے کام کرتے ہیں</h2>

			<p class="mt-6 text-body-lg text-body">
				ڈیجیٹل اسپرٹ لیول اسمارٹ فون کے اندرونی سینسرز کو استعمال کر کے زمین کی کشش ثقل کے زاویے سے ہمواری کی پیمائش کرتا ہے۔
			</p>

			<h3 class="mt-14 text-display-sm text-ink">FAQ</h3>
			<div class="mt-6 space-y-6 text-sm divide-y divide-hairline">
				<div class="pt-6 first:pt-0">
					<h4 class="font-semibold text-ink text-base">فون کا ببل لیول کتنا درست ہے؟</h4>
					<p class="mt-2 text-body leading-6">جدید اسمارٹ فونز 0.1 ڈگری تک کا باریک زاویہ ناپ سکتے ہیں، جو گھر کی مرمت اور فرنیچر کی تنصیب کے لیے بہترین ہے۔</p>
				</div>
				<div class="pt-6">
					<h4 class="font-semibold text-ink text-base">آئی او ایس سینسر کی اجازت کیوں مانگتا ہے؟</h4>
					<p class="mt-2 text-body leading-6">پرائیویسی تحفظ کی خاطر ایپل سفاری موشن سینسر تک رسائی کے لیے صارف کی اجازت ضروری قرار دیتا ہے۔</p>
				</div>
				<div class="pt-6">
					<h4 class="font-semibold text-ink text-base">کیا یہ انٹرنیٹ کے بغیر چلتا ہے؟</h4>
					<p class="mt-2 text-body leading-6">جی ہاں! یہ ویب سائٹ PWA پر بنی ہے اور انٹرنیٹ کے بغیر بھی آسانی سے کام کرتی ہے۔</p>
				</div>
			</div>
		</div>
	</section>

	<RelatedTools current="/level/" />
</Layout>
