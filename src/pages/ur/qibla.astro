---
import Layout from '../../layouts/Layout.astro';
import QiblaFinder from '../../components/QiblaFinder.astro';
import PageHero from '../../components/PageHero.astro';
import RelatedTools from '../../components/RelatedTools.astro';
---

<Layout
	title="قبلہ فائنڈر آنلائن — میرے مقام سے کعبہ کی سمت"
	description="قبلہ کے لیے آنلائن کمپاس — میرے مقام سے کعبہ کی سمت تلاش کریں۔ مکہ تک گریٹ سرکل بیرنگ اور فاصلہ، آپ کے براؤزر میں نجومی طور پر حساب۔"
	path="/ur/qibla/"
	keywords="قبلہ کے لیے آنلائن کمپاس, قبلہ فائنڈر آنلائن کمپاس, آنلائن کمپاس کعبہ میرے مقام سے شمال تلاش کرنا, قبلہ کی سمت, کعبہ کی سمت, میرے مقام سے قبلہ تلاش کرنا"
>
	<PageHero
		eyebrow="قبلہ فائنڈر"
		title="زمین پر کہیں بھی کعبہ کی طرف رخ کریں۔"
		description="آپ کے کو辕ینیٹس سے مکہ تک گریٹ سرکل بیرنگ آپ کے ڈیوائس پر حساب کیا جاتا ہے — ڈگری تک درست، ڈیزائن میں نجومی۔"
	>
		<QiblaFinder />
	</PageHero>

	<section class="border-y border-hairline bg-canvas">
		<div class="mx-auto max-w-[1200px] grid gap-6 px-4 py-16 sm:px-6 md:grid-cols-2">
			<div>
				<p class="eyebrow mb-2">یہ کیسے حساب ہوتا ہے</p>
				<p class="text-sm text-body leading-6">
					بیرنگ آپ کے مقام اور کعبہ (21.4225° N, 39.8262° E) کے درمیان سب سے مختصر گریٹ سرکل راستہ استعمال کرتا ہے۔ یہ زمین کی گولائی کا خیال رکھتا ہے، اس لیے یہ سپاٹ کمپاس روز ریڈنگ سے مختلف ہے۔
				</p>
			</div>
			<div>
				<p class="eyebrow mb-2">عمل میں لائیں</p>
				<p class="text-sm text-body leading-6">
					بیرنگ نوٹ کریں، پھر کمپاس ٹول کھولیں اور گھمیں جب تک آپ کی ہیڈنگ اس سے مل نہ جائے۔ یا بہترین درستگی کے لیے باہر دھات سے دور کیلیبریشن کریں۔
				</p>
			</div>
		</div>
	</section>

	<section class="border-t border-hairline bg-canvas">
		<div class="mx-auto max-w-3xl px-4 py-20 sm:px-6 md:py-24">
			<p class="eyebrow">قبلہ فائنڈر</p>
			<h2 class="mt-3 text-display-lg text-ink">میرے مقام سے قبلہ کی سمت تلاش کریں</h2>

			<p class="mt-6 text-body-lg text-body">
				<strong class="text-ink font-medium">قبلہ فائنڈر آنلائن</strong> آپ کو نماز کے لیے بالکل سمت بتاتا ہے — آپ کہیں بھی ہوں سے مکہ مکرمہ میں کعبہ تک بیرنگ (21.4225° N, 39.8262° E)۔ یہ صفحہ وہ سمت آپ کے لائیو مقام یا کسی بھی درج کردہ کو辕ینیٹس سے حساب کرتا ہے، ڈگریوں میں بیرنگ اور کمپاس سمت دونوں دکھاتا ہے، ساتھ میں مکہ تک گریٹ سرکل فاصلہ۔ کوئی ایپ نہیں، کوئی انسٹال نہیں، کوئی اکاؤنٹ نہیں — صفحہ کھولیں اور جانیں کہ نماز کس طرف پڑھنی ہے۔
			</p>
			<p class="mt-4 leading-7">
				دنیا بھر کے مسلمان پانچ وقت نماز کعبہ کی طرف پڑھتے ہیں، اور سمت درست ہونا اہم ہے۔ چاہے آپ سفر پر ہوں، کسی علاقے میں نئے ہوں، یا صرف اپنے گھر میں سمت کی تصدیق کرنا چاہتے ہوں، یہ مفت <strong class="text-ink font-medium">قبلہ فائنڈر آنلائن کمپاس</strong> چند سیکنڈوں میں درست جواب دیتا ہے۔
			</p>

			<h3 class="mt-10 text-display-sm text-ink">کعبہ کی سمت کیسے حساب ہوتی ہے</h3>
			<p class="mt-3 leading-7">
				<strong class="text-ink font-medium">میرے مقام سے کعبہ کی سمت</strong> سپاٹ میپ شارٹ کٹ نہیں ہے۔ کیونکہ زمین گول ہے، درست بیرنگ دو پوائنٹس کے درمیان سب سے مختصر گریٹ سرکل راستہ پر چلتا ہے۔ لندن سے مکہ کا بیرنگ تقریباً 118° ہے، نیویارک سے تقریباً 58°، جاکارتا سے تقریباً 295°، اور سڈنی سے تقریباً 295° شمال سے مغرب — یہ نمبر بہت سے لوگوں کو حیران کرتے ہیں کیونکہ یہ گریٹ سرکل بیرنگز ہیں، سپاٹ لائن میپ سمتیں نہیں۔ یہ ٹول ہوائی جہاز نیویگیشن میں استعمال ہونے والی جیسی کھلی trigonometry کرتا ہے، تو نتیجہ زمین پر کہیں بھی ہوں ڈگری تک درست ہوتا ہے۔
			</p>
			<p class="mt-4 leading-7">
				کیونکہ حساب بالکل آپ کے براؤزر میں چلتا ہے، آپ کے کو辕ینیٹس کبھی سرور کو نہیں بھیئے جاتے۔ بہت سے آنلائن قبلہ ٹولز آپ کے مقام کی خفیہ لاگ رکھتے ہیں؛ یہ نہیں رکھتا۔ یہ ایک آنلائن کمپاس ہے جتنا نجومی ہے اتنا ہی درست۔
			</p>

			<h3 class="mt-10 text-display-sm text-ink">قبلہ بیرنگ کو عمل میں لانا</h3>
			<p class="mt-3 leading-7">
				جب آپ کے پاس بیرنگ ہو، اگلا قدم اسے ایک ایسی سمت میں بدلنا ہے جس کی طرف آپ جسمانی طور پر رخ کر سکیں۔ سب سے آسان طریقہ: بیرنگ ڈگریوں میں نوٹ کریں،
				<a href="/" class="text-link underline decoration-link/30 hover:decoration-link">لائیو آنلائن کمپاس</a>
				کھولیں، اور گھمیں جب تک آپ کی ہیڈنگ قبلہ بیرنگ سے مل نہ جائے۔ کمپاس ڈائل آپ کی ہیڈنگ ریئل ٹائم میں دکھاتا ہے، تو ملانا چند سیکنڈوں کا کام ہے۔
			</p>
			<p class="mt-4 leading-7">
				بہترین نتیجے کے لیے، دونوں ٹولز میں "مقام استعمال کریں" پر ٹیپ کریں تاکہ مائلت درست ہو اور ریڈنگز اصل شمال پر مبنی ہوں۔ اگر آپ کے پاس کمپاس دستیاب نہیں، تو آپ سورج سے بھی خود کو سمت کر سکتے ہیں: شمالی نصف کرہ میں مقامی دوپہر کو سورج بالکل جنوب میں ہوتا ہے، جنوبی نصف کرہ میں بالکل شمال میں — بیرنگ کے ساتھ باریک سی باریکی کرنے سے پہلے عمومی orientation کے لیے ایک قابل اعتماد دن کا حوالہ۔
			</p>

			<div class="mt-10 grid gap-4 sm:grid-cols-2">
				<div class="card-soft p-5">
					<h4 class="text-sm font-medium text-ink mb-1">عام تلاش: "آنلائن کمپاس کعبہ میرے مقام سے شمال تلاش کرنا"</h4>
					<p class="text-sm leading-6">
						یہ جملہ بالکل وہ ہے جس کا یہ ٹول جواب دیتا ہے۔ اپنی پوزیشن معلوم کریں، قبلہ بیرنگ پڑھیں، پھر کمپاس پر اس کی پیروی کریں — زمین پر کسی بھی مقام سے مفت آنلائن کمپاس۔
					</p>
				</div>
				<div class="card-soft p-5">
					<h4 class="text-sm font-medium text-ink mb-1">مکہ تک فاصلہ</h4>
					<p class="text-sm leading-6">
						بیرنگ کے ساتھ آپ کو کعبہ تک گریٹ سرکل فاصلہ ملتا ہے — سفر کی منصوبہ بندی اور اس بات کو سمجھنے میں مفید کہ فاصلہ بدلنے کے ساتھ بیرنگ کیسے بدلتا ہے۔
					</p>
				</div>
			</div>

			<h3 class="mt-10 text-display-sm text-ink">آپ کے مقام کے ساتھ بدلنے والی قبلہ کی سمت</h3>
			<p class="mt-3 leading-7">
				آپ کی <strong class="text-ink font-medium">قبلہ کی سمت</strong> مکمل طور پر اس پر منحصر ہے کہ آپ کہاں ہیں۔ یہ شہر سے شہر اور ایک گلی سے دوسری گلی بدل جاتی ہے، تو برسوں پہلے کسی ایک ملک میں تلاش کی گئی قیمت دوسرے ملک میں شاذیدہ نہیں ہوتی۔ اسی لیے لائیو کیلکیولیٹر قابل اعتماد انتخاب ہے: یہ ہر بار آپ کے موجودہ کو辕ینیٹس کے لیے تازہ بیرنگ حساب کرتا ہے۔ چند سو کلومیٹر سفر کریں اور بیرنگ چند ڈگریوں تک بدل سکتا ہے — اور یہ صفحہ خودکار طور پر اسے دیکھتا ہے۔
			</p>
			<p class="mt-4 leading-7">
				یہ ٹول دستی کو辕ینیٹس کے ساتھ بھی کام کرتا ہے، جو کار آمد ہے جب آپ کسی ایسی جگہ کے لیے سمت چیک کرنا چاہتے ہیں جس پر جانے والے ہیں، یا جب آپ کے براؤزر کی اجازت بند ہو۔ شہر یا کو辕ینیٹس درج کریں اور قبلہ فائنڈر وہی درست بیرنگ اور فاصلہ دیتا ہے۔ جہاں بھی سوال "میرے مقام سے قبلہ تلاش کرنا" ہو، یہ صفحہ جواب دیتا ہے — نجومی طور پر، درستی سے، اور مفت۔
			</p>
		</div>
	</section>

	<RelatedTools current="/qibla/" />
</Layout>
