---
import Layout from '../../layouts/Layout.astro';
import BearingCalculator from '../../components/BearingCalculator.astro';
import PageHero from '../../components/PageHero.astro';
import RelatedTools from '../../components/RelatedTools.astro';
---

<Layout
	title="بیرنگ کیلکیولیٹر آنلائن — دو پوائنٹس کے درمیان سمت اور فاصلہ"
	description="دو کو辕ینیٹس کے درمیان بیرنگ اور گریٹ سرکل فاصلہ حساب کرنے کے لیے مفت آنلائن کمپاس ٹول۔ آپ کے مقام سے قبلہ کی سمت، معدنی مائلت، اور سورج کی پوزیشن بھی دکھاتا ہے۔"
	path="/ur/bearing/"
	keywords="آنلائن کمپاس ریاضی, آنلائن کمپاس جیومیٹری, بیرنگ کیلکیولیٹر, دو پوائنٹس کے درمیان سمت, گریٹ سرکل فاصلہ, بیرنگ کیلکیولیٹر آنلائن"
>
	<PageHero
		eyebrow="بیرنگ کیلکیولیٹر"
		title="روت بنائیں، ڈگری بہ ڈگری۔"
		description="زمین پر کسی بھی دو پوائنٹس کے درمیان ابتدائی بیرنگ اور گریٹ سرکل فاصلہ حساب کریں — آپ کے لائیو مقام، دستی کو辕ینیٹس، یا پری سیٹ روت سے۔"
	>
		<BearingCalculator />
	</PageHero>

	<section class="border-y border-hairline bg-canvas">
		<div class="mx-auto max-w-[1200px] grid gap-6 px-4 py-16 sm:px-6 md:grid-cols-2">
			<div>
				<p class="eyebrow mb-2">ابتدائی بنام اختتامی بیرنگ</p>
				<p class="text-sm text-body leading-6">
					یہ ابتدائی بیرنگ دیتا ہے — وہ سمت جس میں آپ روانہ ہوتے ہیں۔ طویل راستوں پر بیرنگ گریٹ سرکل کے ساتھ بدلتا ہے، تو درمیانی راستے کی اصلاحیں عام ہیں۔
				</p>
			</div>
			<div>
				<p class="eyebrow mb-2">کمپاس کے ساتھ استعمال کریں</p>
				<p class="text-sm text-body leading-6">
					اپنے حساب کردہ بیرنگ کو کمپاس ٹول میں لیں اور اس وقت تک گھمیں جب تک ہیڈنگ مل نہ جائے۔ نقشے کی درست رہنمائی کے لیے اصل شمال پر سوئچ کریں۔
				</p>
			</div>
		</div>
	</section>

	<section class="border-t border-hairline bg-canvas">
		<div class="mx-auto max-w-3xl px-4 py-20 sm:px-6 md:py-24">
			<p class="eyebrow">بیرنگ کیلکیولیٹر</p>
			<h2 class="mt-3 text-display-lg text-ink">دو پوائنٹس کے درمیان بیرنگ اور فاصلہ حساب کریں</h2>

			<p class="mt-6 text-body-lg text-body">
				<strong class="text-ink font-medium">بیرنگ کیلکیولیٹر آنلائن</strong> زمین پر کسی بھی دو پوائنٹس کے درمیان سمت اور فاصلہ تلاش کرتا ہے۔ دو کو辕ینیٹس درج کریں — یا ایک سرانے کے لیے اپنا لائیو مقام استعمال کریں — اور یہ ٹول ابتدائی بیرنگ ڈگریوں میں، کمپاس سمت، اور کلومیٹر میں گریٹ سرکل فاصلہ دیتا ہے۔ یہ نیویگیشن، روت منصوبہ بندی، سروے، اور مطالعے کے لیے ضروری <strong class="text-ink font-medium">آنلائن کمپاس ریاضی</strong> ٹول ہے۔
			</p>
			<p class="mt-4 leading-7">
				بیرنگ وہ زاویہ ہے جو شمال سے آپ کی مطلوبہ سمت تک گھڑی کے ساتھ میں ناپا جاتا ہے: 0° شمال ہے، 90° مشرق، 180° جنوب، 270° مغرب۔ لندن سے نیویارک کا راستہ مثال کے طور پر تقریباً 288° ابتدائی بیرنگ سے شروع ہوتا ہے — وہ کمپاس سمت ہے جو آپ جہاز کی ناک یا کشتی کے تیرے کو اس لمحے میرا بھیجتے ہیں جب روانہ ہوتے ہیں۔
			</p>

			<h3 class="mt-10 text-display-sm text-ink">ابتدائی بیرنگ بنام اختتامی بیرنگ</h3>
			<p class="mt-3 leading-7">
				کیونکہ زمین گول ہے، <strong class="text-ink font-medium">دو پوائنٹس کے درمیان سمت</strong> نقشے پر سیدھی لکیر نہیں ہے۔ سب سے مختصر راستہ گریٹ سرکل کا پیروی کرتا ہے، اور اس راستے پر بیرنگ مسلسل بدلتا ہے۔ "ابتدائی بیرنگ" آپ کے شروعاتی پوائنٹ پر سمت ہے — وہی جو آپ پہلے steering میں استعمال کرتے ہیں۔ طویل راستوں پر بیرنگ سفر کے ساتھ بدلتا رہتا ہے، اس لیے پائٹ اور نیویگیٹرز واپوائنٹس اور درمیانی اصلاحات استعمال کرتے ہیں۔ یہ کیلکیولیٹر ابتدائی بیرنگ کے ساتھ گریٹ سرکل راستے کے اختتامی بیرنگ بھی نکالتا ہے۔
			</p>
			<p class="mt-4 leading-7">
				مسافرتوں کے لیے — ایک ہائیک، شہر میں گاڑی کا سفر، دو نقشے پوائنٹس کے درمیان پیدل چلنا — ابتدائی بیرنگ نظری طور پر پورا راستہ ہے۔ اس لیے یہ بیرنگ کیلکیولیٹر روزمرہ منصوبہ بندی کے لیے بھی بالکل مناسب ہے اور کلاس روم کی جیومیٹری کے لیے بھی۔
			</p>

			<h3 class="mt-10 text-display-sm text-ink">فاصلہ جس طرح نیویگیٹر ناپتا ہے</h3>
			<p class="mt-3 leading-7">
				بیرنگ کے ساتھ آپ کو گریٹ سرکل فاصلہ ملتا ہے — دو پوائنٹس کے درمیان زمین کی سطح پر سب سے مختصر فاصلہ، ہیورسین فارمولا سے حساب کیا گیا۔ سپاٹ میپ پر پٹری کے برعکس، یہ سیارے کی گولائی کا خیال رکھتا ہے، تو نتیجہ حقیقی سفر کے فاصلوں سے ملتا ہے۔ یہ وہی حساب ہے جو فلائٹ منصوبہ بندی اور بحری نیویگیشن میں استعمال ہوتا ہے۔
			</p>
			<p class="mt-4 leading-7">
				یہ ٹول سادہ کیلکیولیٹر سے آگے جاتا ہے۔ پری سیٹ فہرست سے منزل منتخب کریں — عالمی شہروں اور مکہ مکرمہ میں کعبہ سمیت — اور یہ خلاصہ حساب کرتا ہے ("نیویارک لندن سے 245° مغربی جنوب مغرب ہے، 5,570 کلومیٹر دور") ساتھ میں پوائنٹ A سے چار اضافی ریڈنگز: ابتدا سے <a href="/ur/qibla/" class="text-link underline decoration-link/30 hover:decoration-link">قبلہ کی سمت</a>، معدنی مائلت، اور
				<a href="/ur/sun/" class="text-link underline decoration-link/30 hover:decoration-link">سورج کی پوزیشن</a>۔ ایک اندراج، اور آپ دیکھتے ہیں کہ آپ کے کمپاس، قبلہ، اور شمسی ڈیٹا آپ کے راستے کے ساتھ کیسے ملتے ہیں۔
			</p>

			<h3 class="mt-10 text-display-sm text-ink">بیرنگ کو کمپاس کے ساتھ استعمال کریں</h3>
			<p class="mt-3 leading-7">
				اس ٹول کا قدری ساتھی ہے
				<a href="/" class="text-link underline decoration-link/30 hover:decoration-link">آنلائن کمپاس</a>۔
				اپنا بیرنگ حساب کریں، کمپاس کھولیں، اور گھمیں جب تک ہیڈنگ مل نہ جائے۔ کمپاس کو اصل شمال پر سوئچ کریں تاکہ آپ کی steering نقشے کے شمال کے ساتھ مل جائے — اور کمپاس خودکار طور پر آپ کے مقام کی مائلت لاگو کر دے۔ یہ مل جانے سے صفحے پر ایک نمبر کورس میں بدل جاتا ہے جو آپ حقیقی طور پر پیدل چل سکتے ہیں، تیر سکتے ہیں، یا گاڑی چلا سکتے ہیں۔
			</p>
			<p class="mt-4 leading-7">
				یہ بیرنگ کیلکیولیٹر ہائیک سے پہلے روت منصوبہ بندی، اینٹینز اور سولر پینلز alignment، دو پتے کے درمیان سفر کا اندازہ، کمپاس کورس کی تصدیق، یا ہوم ورک کی تصدیق کے لیے مفید ہے۔ کیونکہ سب کچھ آپ کے براؤزر میں مقامی طور پر چلتا ہے، یہ ایک نجومی، مفت آنلائن کمپاس جیومیٹری ٹول ہے جس پر آپ کہیں بھی بھروسہ کر سکتے ہیں — کوئی انسٹال نہیں، کوئی اکاؤنٹ نہیں، کوئی ڈیٹا جمع نہیں۔
			</p>

			<h3 class="mt-10 text-display-sm text-ink">ڈگریز، سمتیں، اور منصوبہ بندی</h3>
			<p class="mt-3 leading-7">
				بیرنگ ڈگریز میں درست ہوتے ہیں لیکن تجریدی؛ اس لیے یہ ٹول انہیں سادہ کمپاس سمتیں میں بھی بدل دیتا ہے۔ 45° NE بن جاتا ہے، 200° SSW بن جاتا ہے، اور اسی طرح — تو آپ کمپاس یا نقشے کی زبان میں سوالات کا جواب دے سکتے ہیں کہ "مجھے کس طرف جانا چاہیے؟" اپنی لائیو پوزیشن کو پوائنٹ A اور منزل کو پوائنٹ B درج کریں، اور پوری تصویر — بیرنگ، سمت، فاصلہ، قبلہ، مائلت، اور سورج — فوری اپ ڈیٹ ہو جاتی ہے۔ یہ آپ کے حقیقی کو辕ینیٹس پر مبنی آنلائن کمپاس ریاضی ٹول کی طاقت ہے۔
			</p>
		</div>
	</section>

	<RelatedTools current="/bearing/" />
</Layout>
