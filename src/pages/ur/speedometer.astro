---
import Layout from '../../layouts/Layout.astro';
import Speedometer from '../../components/Speedometer.astro';
import PageHero from '../../components/PageHero.astro';
import RelatedTools from '../../components/RelatedTools.astro';
---

<Layout
	title="آن لائن جی پی ایس اسپیڈومیٹر — مفت رفتار اور الٹی میٹر"
	description="مفت آن لائن جی پی ایس اسپیڈومیٹر اور درست الٹی میٹر۔ کلومیٹر فی گھنٹہ، میل فی گھنٹہ، ناٹس میں لائیو رفتار، سطح سمندر سے بلندی اور فاصلہ چیک کریں۔"
	path="/ur/speedometer/"
	keywords="جی پی ایس اسپیڈومیٹر آن لائن, رفتار ناپنے کا آلہ, الٹی میٹر آن لائن, لائیو اسپیڈ"
>
	<PageHero
		eyebrow="جی پی ایس اسپیڈومیٹر · الٹی میٹر"
		title="ہر ڈیوائس پر حقیقی رفتار اور بلندی کا حساب۔"
		description="سیٹلائٹ پوزیشننگ کے ذریعے زمین پر اپنی اصل رفتار اور سطح سمندر سے بلندی کو براہ راست ناپیں۔"
	>
		<Speedometer />
	</PageHero>

	<section class="border-t border-hairline bg-canvas">
		<div class="mx-auto max-w-3xl px-4 py-20 sm:px-6 md:py-24">
			<p class="eyebrow">جی پی ایس اسپیڈومیٹر · الٹی میٹر</p>
			<h2 class="mt-3 text-display-lg text-ink">آن لائن جی پی ایس اسپیڈومیٹر کیسے کام کرتا ہے</h2>

			<p class="mt-6 text-body-lg text-body">
				جی پی ایس اسپیڈومیٹر سیٹلائٹ سگنلز کے ڈوپلر شفٹ سے اصل رفتار نکالتا ہے، جس میں گاڑی کے ٹائروں کے گھسنے کی وجہ سے کوئی فرق نہیں آتا۔
			</p>

			<h3 class="mt-14 text-display-sm text-ink">FAQ</h3>
			<div class="mt-6 space-y-6 text-sm divide-y divide-hairline">
				<div class="pt-6 first:pt-0">
					<h4 class="font-semibold text-ink text-base">کار کے میٹر اور جی پی ایس کی رفتار میں فرق کیوں ہوتا ہے؟</h4>
					<p class="mt-2 text-body leading-6">بین الاقوامی قوانین کے مطابق کار ساز کمپنیاں اسپیڈومیٹر کو جان بوجھ کر 2 سے 5 فیصد زیادہ دکھانے کے لیے سیٹ کرتی ہیں تاکہ اوور اسپیڈنگ نہ ہو۔</p>
				</div>
				<div class="pt-6">
					<h4 class="font-semibold text-ink text-base">کیا یہ سرنگ میں کام کرتا ہے؟</h4>
					<p class="mt-2 text-body leading-6">نہیں، سیٹلائٹ سگنل کے لیے کھلے آسمان کی ضرورت ہوتی ہے اور یہ سرنگوں سے نہیں گزر سکتا۔</p>
				</div>
				<div class="pt-6">
					<h4 class="font-semibold text-ink text-base">کیا میرا لوکیشن ڈیٹا محفوظ ہے؟</h4>
					<p class="mt-2 text-body leading-6">جی ہاں، تمام حسابی کام براؤزر کے اندر ہی ہوتا ہے اور کوئی بھی ڈیٹا سرور کو نہیں بھیجا جاتا۔</p>
				</div>
			</div>
		</div>
	</section>

	<RelatedTools current="/speedometer/" />
</Layout>
