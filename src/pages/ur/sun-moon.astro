---
import Layout from '../../layouts/Layout.astro';
import SunMoonCompass from '../../components/SunMoonCompass.astro';
import PageHero from '../../components/PageHero.astro';
import RelatedTools from '../../components/RelatedTools.astro';
---

<Layout
	title="کمپاس پر سورج اور چاند کی سمت — لائیو سمت (ایزیمتھ)"
	description="کمپاس ڈایاگرام سے سورج اور چاند کی سمت تلاش کریں۔ کسی بھی مقام کے لیے ڈائل پر بنائے گئے سورج کے ایزیمتھ اور چاند کے ایزیمتھ کے ساتھ سینسر کی لائیو سمت۔"
	path="/ur/sun-moon/"
	keywords="سورج کی سمت, چاند کی سمت, سورج کا ایزیمتھ, چاند کا ایزیمتھ, کمپاس پر سورج تلاش کرنا, سورج کی پوزیشن, چاند کی پوزیشن"
>
	<section class="relative overflow-hidden">
		<div class="mesh-gradient" aria-hidden="true"></div>
		<div class="relative">
			<PageHero
				eyebrow="سورج اور چاند کی سمت"
				title="کمپاس پر سورج اور چاند کو دیکھیں۔"
				description="ایک لائیو فون کمپاس جس میں سورج کا ایزیمتھ اور چاند کا ایزیمتھ براہِ راست ڈائل پر بنے ہوتے ہیں۔ نشان کی طرف منہ کریں، اور آپ سورج یا چاند کی طرف دیکھ رہے ہیں — بغیر اندازے کے۔"
			>
				<SunMoonCompass />
			</PageHero>
		</div>
	</section>

	<section class="border-y border-hairline bg-canvas">
		<div class="mx-auto max-w-[1200px] grid gap-6 px-4 py-16 sm:px-6 md:grid-cols-3">
			<div>
				<p class="eyebrow mb-2">اسے کیسے پڑھیں</p>
				<p class="text-sm text-body leading-6">
					سرخ سوئی شمال کی طرف اشارہ کرتی ہے۔ ڈائل پر دو رنگین نقطے سورج (عنبری) اور چاند (نیلا) کی
					کمپاس سمت دکھاتے ہیں۔ کسی نقطے کے سامنے آنے تک گھومیں تاکہ براہِ راست اس کی طرف دیکھ سکیں۔
				</p>
			</div>
			<div>
				<p class="eyebrow mb-2">لائیو اپڈیٹس</p>
				<p class="text-sm text-body leading-6">
					دن اور رات کے گزرنے کے ساتھ ساتھ سورج اور چاند کے نشان خود بخود نئی پوزیشن پر چلے جاتے ہیں۔
					اپنا مقام استعمال کریں تاکہ ایزیمتھ آپ کے اوپر کے آسمان کے مطابق ہوں۔
				</p>
			</div>
			<div>
				<p class="eyebrow mb-2">صرف اعداد نہیں، سمت</p>
				<p class="text-sm text-body leading-6">
					ایزیمتھ مطلق سمتیں ہیں۔ ڈائل انہیں آپ کی حقیقی سمت کے اوپر دکھاتا ہے، اس لیے آپ سورج یا چاند
					کو فوری تلاش کر سکتے ہیں، چاہے وہ بادلوں کے پیچھے ہی کیوں نہ ہوں۔
				</p>
			</div>
		</div>
	</section>

	<section class="border-t border-hairline bg-canvas">
		<div class="mx-auto max-w-3xl px-4 py-20 sm:px-6 md:py-24">
			<p class="eyebrow">سورج اور چاند کی سمت کا آلہ</p>
			<h2 class="mt-3 text-display-lg text-ink">کمپاس ڈایاگرام سے سورج اور چاند کی سمت تلاش کریں</h2>

			<p class="mt-6 text-body-lg text-body">
				یہ صفحہ <strong class="text-ink font-medium">سورج کی سمت</strong> اور
				<strong class="text-ink font-medium">چاند کی سمت</strong> کو براہِ راست لائیو کمپاس ڈایاگرام پر
				رکھتا ہے۔ عنبری یا نیلا نشان ڈائل پر جہاں بھی ہو، وہی وہ کمپاس سمت ہے جس کی طرف سورج یا چاند
				دیکھنے کے لیے مڑنا ہوگا۔ بغیر فلکیات کے علم کے یہ
				<strong class="text-ink font-medium">کمپاس پر سورج تلاش کرنے</strong> کا تیز ترین طریقہ ہے — یا
				دن کی روشنی میں چاند کا مقام جاننے کا۔
			</p>
			<p class="mt-4 leading-7">
				ایزیمتھ حقیقی شمال سے گھڑی کی سمت میں ناپا جاتا ہے: 0° شمال، 90° مشرق، 180° جنوب اور 270° مغرب۔
				یہ آلہ دونوں اجسام کے لائیو ایزیمتھ آپ کے نقاط کے لیے شمار کرتا ہے اور انہیں آپ کی حقیقی سمت کے
				پاس ڈائل پر کھینچتا ہے، تاکہ ڈایاگرام ہمیشہ صحیح سمت دکھائے۔
			</p>

			<h3 class="mt-10 text-display-sm text-ink">ڈائل پر سورج اور چاند کو پڑھنا</h3>
			<p class="mt-3 leading-7">
				<strong class="text-ink font-medium">عنبری نشان</strong> سورج ہے اور
				<strong class="text-ink font-medium">نیلا نشان</strong> چاند ہے۔ ہر ایک جسم کی سمت ڈگری اور
				بنیادی سمت میں دکھاتا ہے، ساتھ ہی افق سے اس کی بلندی بھی۔ جب کوئی نشان ڈائل سے باہر دیکھے یا کم
				بلندی ظاہر کرے، تو وہ جسم افق کے نیچے ہے — یعنی آپ کے پیروں کے نیچے، نظر نہیں آتا۔
			</p>
			<p class="mt-4 leading-7">
				سورج مشرق سے نکلتا ہے اور مغرب میں غروب ہوتا ہے، اس لیے (شمالی نصف کرہ میں) صبح سے شام تک اس کا
				نشان ڈائل کے شمالی نصف حصے کو عبور کرتا ہے۔ چاند اسی طرح کا راستہ طے کرتا ہے لیکن ہر دن تقریباً 12
				ڈگری پیچھے ہو جاتا ہے، اسی لیے کمپاس پر اس کی پوزیشن دن بہ دن بدلتی رہتی ہے۔
			</p>

			<h3 class="mt-10 text-display-sm text-ink">سورج اور چاند تلاش کرنے کے لیے کمپاس کیوں استعمال کریں</h3>
			<p class="mt-3 leading-7">
				کمپاس کی سمت آسمانی نقاط کے مقابلے میں کہیں زیادہ عملی ہے۔ چاہے آپ تصویر کھینچ رہے ہوں، سایے کی
				منصوبہ بندی کر رہے ہوں، سیٹلائٹ ڈش سیدھ میں لگا رہے ہوں، یہ دیکھ رہے ہوں کہ روشنی کہاں پڑے گی، یا
				بس یہ جاننا چاہ رہے ہوں کہ آج رات چاند کہاں ہے — سمت کو کمپاس پر ایک نقطے کے طور پر دیکھنا اسے
				فوراً کارآمد بناتا ہے: مڑیں، اور وہ حاضر ہے۔
			</p>
			<p class="mt-4 leading-7">
				سب کچھ آپ کے براؤزر میں مقامی طور پر چلتا ہے اور کوئی ڈیٹا اپ لوڈ نہیں ہوتا۔
				<a href="/ur/sun/" class="text-link underline decoration-link/30 hover:decoration-link">سورج کی پوزیشن کیلکیولیٹر</a>
				اور
				<a href="/ur/compass/" class="text-link underline decoration-link/30 hover:decoration-link">آنلائن کمپاس</a>
				کے ساتھ مل کر، آپ کو آپ کے اوپر جو کچھ ہے اس کی مکمل تصویر مل جاتی ہے، چاہے آپ کہیں بھی ہوں۔
			</p>
		</div>
	</section>

	<RelatedTools current="/sun-moon/" />
</Layout>