---
import Layout from '../../layouts/Layout.astro';
import SunPanel from '../../components/SunPanel.astro';
import PageHero from '../../components/PageHero.astro';
import RelatedTools from '../../components/RelatedTools.astro';
---

<Layout
	title="سورج کی پوزیشن کیلکیولیٹر آنلائن — ازموت، طلوع اور غروب"
	description="آنلائن سورج کی پوزیشن حساب کریں: ازموت، بلندی، طلوع، شمس نماز، اور غروب کسی بھی مقام کے لیے۔ مفت اور فوری — بالکل آپ کے براؤزر میں چلتا ہے۔"
	path="/ur/sun/"
	keywords="سورج کی پوزیشن کیلکیولیٹر, شمسی ازموت, طلوع غروب کے اوقات, سورج کی سمت, شمسی پوزیشن آنلائن"
>
	<PageHero
		eyebrow="سورج کی پوزیشن"
		title="سورج کو درستگی سے ٹریک کریں۔"
		description="لائیو شمسی ازموت اور بلندی، ساتھ میں طلوع، شمس نماز، اور غروب — آپ کے مقام یا کسی بھی درج کردہ کو辕ینیٹس کے لیے حساب۔"
	>
		<SunPanel />
	</PageHero>

	<section class="border-y border-hairline bg-canvas">
		<div class="mx-auto max-w-[1200px] grid gap-6 px-4 py-16 sm:px-6 md:grid-cols-2">
			<div>
				<p class="eyebrow mb-2">نمبروں کا مطلب</p>
				<p class="text-sm text-body leading-6">
					ازموت سورج کی کمپاس سمت ہے (0° = شمال، 90° = مشرق)۔ بلندی یہ ہے کہ یہ افق سے کتنا اوپر ہے — سایہ، سولر پینلز، اور فوٹوگرافی کے لیے مفید۔
				</p>
			</div>
			<div>
				<p class="eyebrow mb-2">اپنے کمپاس کی تصدیق کریں</p>
				<p class="text-sm text-body leading-6">
					دوپہر کے وقت سورج شمالی نصف کرہ میں بالکل جنوب اور جنوبی نصف کرہ میں بالکل شمال کے قریب ہوتا ہے — دن کی روشنی میں اپنی ہیڈنگ کی تصدیق کا ایک قابل اعتماد طریقہ۔
				</p>
			</div>
		</div>
	</section>

	<section class="border-t border-hairline bg-canvas">
		<div class="mx-auto max-w-3xl px-4 py-20 sm:px-6 md:py-24">
			<p class="eyebrow">سورج کی پوزیشن ٹول</p>
			<h2 class="mt-3 text-display-lg text-ink">آنلائن سورج کی پوزیشن حساب کریں — کسی بھی مقام کے لیے</h2>

			<p class="mt-6 text-body-lg text-body">
				<strong class="text-ink font-medium">سورج کی پوزیشن کیلکیولیٹر آنلائن</strong> دکھاتا ہے کہ سورج کسی مخصوص وقت پر کسی مخصوص جگہ آسمان میں کہاں ہے۔ یہ صفحہ سورج کا موجودہ <strong class="text-ink font-medium">ازموت</strong> (اس کی کمپاس سمت ڈگریوں میں) اور <strong class="text-ink font-medium">بلندی</strong> (افق سے اس کی اونچائی) حساب کرتا ہے، ساتھ میں طلوع، شمس نماز، اور غروب کے اوقات — آپ کے لائیو مقام یا کسی بھی درج کردہ کو辕ینیٹس کے لیے۔ سب کچھ آپ کے براؤزر میں چلتا ہے، تو یہ فوری، مفت، اور نجومی ہے۔
			</p>
			<p class="mt-4 leading-7">
				دن گزرنے کے ساتھ نمبر ریئل ٹائم میں اپ ڈیٹ ہوتے ہیں، جو اس ٹول کو حیرت انگیز طور پر کئی کاموں کے لیے مفید بناتا ہے: سولر پینلز رکھنا، فوٹوگرافی کی روشنی منصوبہ بندی، باغ بیڈز کا انتظام، پیٹھیوں کے لیے سایہ کی پوزیشن، یا صرف یہ جاننا کہ سورج سڑک کے پار کی عمارت کب نکلے گا۔
			</p>

			<h3 class="mt-10 text-display-sm text-ink">ازموت اور بلندی — آسمان کو پڑھنا</h3>
			<p class="mt-3 leading-7">
				<strong class="text-ink font-medium">ازموت</strong> سورج کی سمت ہے جو شمال سے گھڑی کے ساتھ میں ناپی جاتی ہے: 0° بالکل شمال ہے، 90° بالکل مشرق، 180° بالکل جنوب، اور 270° بالکل مغرب۔ دوپہر کے وقت سورج شمالی نصف کرہ میں تقریباً 180° (بالکل جنوب) اور جنوبی نصف کرہ میں تقریباً 0° (بالکل شمال) پر ہوتا ہے۔ <strong class="text-ink font-medium">بلندی</strong> افق سے سورج کا زاویہ ہے، طلوع اور غروب پر 0° سے شمس نماز پر اس کی سب سے بلند پوزیشن تک۔ مل کر یہ بالکل بتاتے ہیں کہ سورج آسمان میں کہاں ہے — وہی کو辕ینیٹس جو ماہرین شمسیات اور سولر انجینئرز استعمال کرتے ہیں۔
			</p>
			<p class="mt-4 leading-7">
				سورج کا راستہ آپ کی عرض اور موسم کے ساتھ بدلتا ہے: گرمیوں میں زیادہ اوپر، سردیوں میں نیچے، مشرق سے طلوع اور مغرب میں غروب زمین پر ہر جگہ۔ کیلکیولیٹر معیاری شمسی پوزیشن الگورتھم سے یہ سب سنبھالتا ہے، تو آپ کی تاریخ، وقت، اور کو辕ینیٹس کے لیے ازموت اور بلندی درست ہوتی ہیں۔
			</p>

			<h3 class="mt-10 text-display-sm text-ink">سمت تلاش کرنے کے لیے سورج کیوں مفید ہے</h3>
			<p class="mt-3 leading-7">
				کمپاس اور GPS سے پہلے، لوگ سورج کا استعمال orientation کے لیے کرتے تھے — اور آج بھی یہ کام کرتا ہے۔ مقامی دوپہر کے آس پاس سورج شمالی نصف کرہ میں بالکل جنوب اور جنوبی نصف کرہ میں بالکل شمال میں ہوتا ہے۔ طلوع کے وقت تقریباً مشرق میں ہوتا ہے؛ غروب کے وقت تقریباً مغرب میں۔ یہ قابل اعتماد قاعدے ہیں، اور یہ صفحہ انہیں درست نمبروں میں بدل دیتا ہے۔ اگر آپ دن کی روشنی میں بغیر کمپاس کے باہر ہیں، تو یہاں ازموت چیک کریں اور اس کے مطابق خود کو سمت کریں — پھر
				<a href="/" class="text-link underline decoration-link/30 hover:decoration-link">آنلائن کمپاس</a>
				کے ساتھ تصدیق کریں جب آپ واپس فون پر ہوں۔
			</p>

			<div class="mt-10 grid gap-4 sm:grid-cols-2">
				<div class="card-soft p-5">
					<h4 class="text-sm font-medium text-ink mb-1">شمسی توانائی</h4>
					<p class="text-sm leading-6">
						پینلز alignment یا انسٹالیشن منصوبہ بندی کریں: دوپہر کی بلندی بہترین ریچھ دکھاتی ہے، اور ازموت رینج بتاتی ہے کہ سطح کو دن میں کتنا سورج ملتا ہے۔
					</p>
				</div>
				<div class="card-soft p-5">
					<h4 class="text-sm font-medium text-ink mb-1">فوٹوگرافی اور باغبانی</h4>
					<p class="text-sm leading-6">
						گولڈن ہاور شوٹس منصوبہ بندی کریں، جانیں کہ باغ بیڈ کو کب روشنی ملتی ہے، یا پیٹھیوں یا شیڈ سیل کو دوپہر کی دھوپ کے لیے پوزیشن کریں — سب آپ کی بالکل مقام سے۔
					</p>
				</div>
			</div>

			<h3 class="mt-10 text-display-sm text-ink">طلوع، شمس نماز، اور غروب</h3>
			<p class="mt-3 leading-7">
				یہ ٹول دن کے اہم لمحات بھی بتاتا ہے: <strong class="text-ink font-medium">طلوع</strong>، جب سورج پہلی بار افق سے اوپر آتا ہے؛ <strong class="text-ink font-medium">شمس نماز</strong>، جب یہ اپنی سب سے بلند پوزیشن پر پہنچتا ہے؛ اور <strong class="text-ink font-medium">غروب</strong>، جب یہ غائب ہو جاتا ہے۔ شمس نماز وہ لمحہ ہے جب سورج مریڈین کو عبور کرتا ہے اور سب سے مختصر سایہ ڈالتا ہے — اوپر بتائے گئے سورج-کمپاس ٹرک کا حوالہ پوائنٹ۔
			</p>
			<p class="mt-4 leading-7">
				کیونکہ حسابات مقامی ہیں، نتائج آپ کے کو辕ینیٹس اور تاریخ کے ساتھ فطری طور پر بدلتے ہیں: شمالی سردیاں مختصر دن اور کم دوپہر کی بلندی لاتی ہیں، جبکہ حاری مقامات سورج کو سال بھر اوپر چڑھتے دیکھتے ہیں۔ آپ کہیں بھی ہوں، یہ مفت سورج کی پوزیشن کیلکیولیٹر آپ کو شمسی راستہ ایک نظر دکھاتا ہے — اور
				<a href="/ur/bearing/" class="text-link underline decoration-link/30 hover:decoration-link">بیرنگ کیلکیولیٹر</a>
				اور
				<a href="/ur/qibla/" class="text-link underline decoration-link/30 hover:decoration-link">قبلہ فائنڈر</a>
				کے ساتھ آپ کے اوپر کے آسمان کی پوری تصویر بناتا ہے۔
			</p>
		</div>
	</section>

	<RelatedTools current="/sun/" />
</Layout>
