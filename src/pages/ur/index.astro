---
import Layout from '../../layouts/Layout.astro';
import Compass from '../../components/Compass.astro';

const faq = [
	{
		q: 'میں کس سمت میں کھڑا ہوں — آنلائن کمپاس؟',
		a: 'اپنے فون پر یہ صفحہ کھولیں اور ڈائل کے نیچے لائیو ہیڈنگ ریڈاؤٹ آپ کی بالکل ڈگری اور کمپاس سمت (شمال، شمال مشرق، مشرق، جنوب مشرق، جنوب، جنوب مغرب، مغرب، شمال مغرب) دکھاتا ہے جو آپ کے گھومنے کے ساتھ ریئل ٹائم میں اپ ڈیٹ ہوتا ہے۔',
	},
	{
		q: 'آنلائن کمپاس — شمال کہاں ہے؟',
		a: 'سوزن کا سرخ حصہ ہمیشہ شمال کی طرف اشارہ کرتا ہے، جو ڈائل کی چوٹی پر 0°/360° پڑھتا ہے۔ "اصل شمال" پر ٹوگل کریں اور سائٹ آپ کے مقام پر معدنی مائلت کی اصلاح کرتی ہے تاکہ شمال نقشے سے مل جائے۔',
	},
	{
		q: 'میں کس سمت میں کھڑا ہوں — آنلائن کمپاس؟',
		a: 'اپنا فون سپاٹ پکڑیں، سینسر رسائی دیں، اور ڈائل کے نیچے ہیڈنگ آپ کو سمت بتاتی ہے ڈگریوں میں اور کمپاس پوائنٹ کے طور پر — مثال کے طور پر 274° یا مغرب۔',
	},
	{
		q: 'بغیر کمپاس آنلائن سمت کیسے پتا لگائیں؟',
		a: 'سورج کا استعمال کریں: مقامی دوپہر کے آس پاس یہ شمالی نصف کرہ میں بالکل جنوب اور جنوبی نصف کرہ میں بالکل شمال میں ہوتا ہے۔ اس سائٹ کا سورج ٹول کسی بھی مقام کا درست شمسی ازموت دکھاتا ہے، اور قبلہ فائنڈر بطور مستقل حوالہ سمت بھی کام کرتا ہے۔',
	},
	{
		q: 'میں کس طرف کھڑا ہوں — آنلائن کمپاس؟',
		a: 'سینسر رسائی دیں، فون کو سپاٹ اور دھات سے دور پکڑیں، اور ہیڈنگ ریڈاؤٹ پڑھیں۔ یہ آپ کے گھومنے پر مسلسل اپ ڈیٹ ہوتا ہے، تو آپ ہمیشہ جانتے ہیں کہ آپ کس طرف کھڑے ہیں۔',
	},
	{
		q: 'آنلائن کمپاس کیسے استعمال کریں؟',
		a: 'فون پر یہ صفحہ کھولیں، "لائیو کمپاس فعال کریں" پر ٹیپ کریں، ڈیوائس کو سپاٹ پکڑیں، اور ہیڈنگ پڑھیں۔ اگر سوزن بہتے تو چند بار آٹھ کی شکل میں ہلائیں تاکہ میگنیٹومیٹر کی کیلیبریشن ہو جائے۔',
	},
	{
		q: 'کیا میں اپنے فون کو کمپاس کی طرح استعمال کر سکتا ہوں؟',
		a: 'جی ہاں۔ جدید فونوں میں میگنیٹومیٹر ہوتا ہے، اور یہ ویب سائٹ اس سینسر کو آپ کے براؤزر میں کمپاس میں بدل دیتی ہے — کوئی ایپ ڈاؤن لوڈ کرنے کی ضرورت نہیں اور کچھ بھی انسٹال کرنے کی ضرورت نہیں۔',
	},
	{
		q: 'گوگل میں میرا کمپاس کہاں ہے؟',
		a: 'گوگل میپس نقشے کے اوپری دائیں کونے پر ایک چھوٹا کمپاس دکھاتا ہے۔ ڈگریوں میں لائیو ہیڈنگ کے لیے، بس گوگل پر "آنلائن کمپاس" تلاش کریں اور یہ صفحہ کھولیں — جیسے ہی آپ سینسر رسائی دیتے ہیں یہ کمپاس بن جاتا ہے۔',
	},
	{
		q: 'کیا میرا فون مجھے بتا سکتا ہے کہ میں کس سمت میں ہوں؟',
		a: 'جی ہاں۔ آپ کے فون کا میگنیٹومیٹر اس صفحے کے ساتھ لائیو ہیڈنگ دیتا ہے، اور سائٹ خودکار طور پر معدنی مائلت کی اصلاح کرتی ہے تاکہ شمال آپ کے نقشے سے مل جائے۔',
	},
	{
		q: 'موبائل پر کمپاس کیسے دیکھیں؟',
		a: 'اپنے فون پر یہ صفحہ کھولیں اور کمپاس فوری نظر آ جاتا ہے — کوئی ایپ کی ضرورت نہیں۔ اینڈروئڈ پر، گوگل میپس میں بھی کمپاس ہوتا ہے، اور کچھ فونوں میں بلٹ ان کمپاس ایپ آتی ہے۔',
	},
	{
		q: 'میرا شمال کی سمت کون سی ہے؟',
		a: 'اصل شمال جغرافیائی شمالی قطب ہے؛ معدنی شمال وہ ہے جہاں کمپاس کا سوزن اشارہ کرتا ہے۔ دونوں کے درمیان زاویہ (مائلت) مقام کے مطابق مختلف ہوتا ہے، اور یہ سائٹ خودکار طور پر اس کی اصلاح کرتی ہے۔',
	},
	{
		q: 'میرے فون پر کمپاس کہاں ہے؟',
		a: 'بہت سے فونوں میں الگ کمپاس ایپ نہیں آتی — لیکن سینسر بلٹ ان ہوتا ہے۔ اپنے فون پر یہ ویب سائٹ کھولیں اور یہ بغیر انسٹال کے کمپاس بن جاتا ہے۔',
	},
	{
		q: 'کون سے موبائل فونوں میں کمپاس سینسر ہوتا ہے؟',
		a: 'تقریباً ہر جدید اسمارٹ فون — iPhone 3GS کے بعد سے ہر iPhone اور تقریباً ہر اینڈروئڈ فون — میں میگنیٹومیٹر ہوتا ہے، تو یہ آنلائن کمپاس تقریباً ہر ڈیوائس پر کام کرتا ہے۔',
	},
	{
		q: 'میری ہیڈنگ کیوں ہلتی ہے؟',
		a: 'قریبی دھات اور الیکٹرانکس آلات میگنیٹومیٹر کو متاثر کرتے ہیں۔ اوپر دی گئی کیلیبریشن کے اقدامات پر عمل کریں، اور یقینی بنائیں کہ فون سپاٹ ہے۔ اندرونی علاقوں میں چند ڈگریوں کا ہلنا عام ہے۔',
	},
	{
		q: 'معدنی اور اصل شمال میں کیا فرق ہے؟',
		a: 'معدنی شمال وہ ہے جہاں آپ کے کمپاس کا سوزن اشارہ کرتا ہے۔ اصل شمال جغرافیائی شمالی قطب ہے، جو نقشے اور نیویگیشن استعمال کرتے ہیں۔ ان دونوں کے درمیان زاویہ — مائلت — مقام کے مطابق مختلف ہوتا ہے، اور یہ ٹول خودکار طور پر اس کی اصلاح کرتا ہے۔',
	},
	{
		q: 'یہ میرے مقام کیوں مانگتا ہے؟',
		a: 'مقام ہمیں معدنی مائلت، قبلہ بیرنگ، اور سورج کی پوزیشن درستگی سے محساب کرنے دیتا ہے۔ یہ اختیاری ہے — ہر ٹول دستی کو辕ینیٹس کے ساتھ بھی کام کرتا ہے — اور یہ آپ کے ڈیوائس سے کبھی نہیں جاتا۔',
	},
	{
		q: 'کیا آپ میرا مقام جمع یا فروخت کرتے ہیں؟',
		a: 'نہیں۔ کوئی ٹریکرز نہیں، کوئی تجزیات نہیں، اور کوئی باک اینڈ نہیں۔ تمام سینسر اور مقام کا ڈیٹا آپ کے براؤزر میں مقامی طور پر پروسیس ہوتا ہے اور آپ کے جانے پر ڈسکارڈ ہو جاتا ہے۔',
	},
];
---

<Layout
	path="/ur/"
	title="آنلائن کمپاس — شمال تلاش کرنے کے لیے مفت لائیو ٹول"
	description="اپنے مقام سے شمال تلاش کرنے کے لیے مفت آنلائن کمپاس۔ اصل اور معدنی شمال کے ساتھ لائیو ہیڈنگ، مائلت، قبلہ فائنڈر، بیرنگ کیلکیولیٹر، اور سورج کی پوزیشن — کوئی انسٹال نہیں، ہر فون پر کام کرتا ہے۔"
	keywords="آنلائن کمپاس, آنلائن کمپاس ٹول, مفت آنلائن کمپاس, آنلائن کمپاس گوگل, آنلائن کمپاس مفت, آنلائن کمپاس شمال تلاش کرنا, آنلائن کمپاس سمت, آنلائن کمپاس جیومیٹری, آنلائن کمپاس ٹول جیومیٹری, آنلائن کمپاس جیومیٹری کے لیے, آنلائن کمپاس ریاضی, مفت آنلائن کمپاس ٹول, آنلائن کمپاس قبلہ کے لیے, آنلائن کمپاس لائیو, آنلائن کمپاس کعبہ میرے مقام سے شمال تلاش کرنا, قبلہ فائنڈر آنلائن کمپاس"
>
	<!-- ہیرو -->
	<section id="compass" class="relative overflow-hidden">
		<div class="mesh-gradient" aria-hidden="true"></div>
		<div
			class="relative mx-auto max-w-[1200px] px-4 pb-20 pt-16 text-center sm:px-6 md:pb-28 md:pt-24"
		>
			<div class="badge mx-auto">مفت · نجومی · کوئی انسٹال نہیں</div>

			<h1
				class="mx-auto mt-6 max-w-3xl text-[36px] leading-[40px] text-ink sm:text-display-xl md:text-[56px] md:leading-[56px]"
			>
				ایک کمپاس جو اصل شمال کی طرف اشارہ کرتا ہے، صرف معدنی نہیں۔
			</h1>

			<p class="mx-auto mt-4 max-w-xl text-body-lg text-body">
				خودکار مائلت، GPS کو辕ینیٹس، قبلہ کی سمت، اور سورج کی پوزیشن کے ساتھ ریئل ٹائم ڈیوائس ہیڈنگ — سب آپ کے براؤزر میں۔ کوئی چیز انسٹال نہیں کرنی، کوئی چیز اپلوڈ نہیں ہوتی۔
			</p>

			<div class="mt-8 flex flex-wrap items-center justify-center gap-3">
				<a href="/ur/location/" class="btn-primary">میری پوزیشن</a>
				<a href="/ur/compass/" class="btn-secondary">کمپاس کھولیں</a>
			</div>

			<div class="mx-auto mt-12 max-w-xl md:mt-16">
				<Compass />
			</div>
		</div>
	</section>

	<!-- فیچر سٹرپ -->
	<section class="border-y border-hairline bg-canvas">
		<div
			class="mx-auto grid max-w-[1200px] grid-cols-1 gap-px overflow-hidden px-4 py-12 sm:grid-cols-3 sm:px-6"
		>
			<div class="p-4">
				<p class="eyebrow mb-2">اصل بنام معدنی</p>
				<p class="text-sm text-body leading-6">
					دنیا کے معدنی ماڈل سے مائلت خودکار طور پر حساب کی جاتی ہے — دونوں ہیڈنگز ایک نظر میں دیکھیں۔
				</p>
			</div>
			<div class="p-4">
				<p class="eyebrow mb-2">رجوعیت پہلے</p>
				<p class="text-sm text-body leading-6">
					تمام سینسر کی پروسیسنگ ڈیوائس پر ہوتی ہے۔ کوئی اکاؤنٹس نہیں، کوئی ٹریکنگ نہیں، اور کچھ بھی آپ کے براؤزر سے باہر نہیں جاتا۔
				</p>
			</div>
			<div class="p-4">
				<p class="eyebrow mb-2">ہر جگہ کام کرتا ہے</p>
				<p class="text-sm text-body leading-6">
					آئیفون اور اینڈروئڈ پر کروم، سفیری اور فائر فاکس، چلتے وقت GPS ہیڈنگ فال بیک کے ساتھ۔
				</p>
			</div>
		</div>
	</section>

	<!-- ٹولز گرڈ -->
	<section id="tools" class="scroll-mt-16">
		<div class="mx-auto max-w-[1200px] px-4 py-20 sm:px-6 md:py-28">
			<p class="eyebrow">ٹول کٹ</p>
			<h2 class="mt-3 max-w-2xl text-display-lg text-ink">
				ایک کمپاس، آپ کو ضرورت ہر بیرنگ۔
			</h2>
			<p class="mt-3 max-w-xl text-body-lg text-body">
				پانچ مرکوز ٹولز، ہر ایک اپنے صفحے پر، سب آپ کے ڈیوائس پر مقامی طور پر چلتے ہیں۔
			</p>

			<div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
				<a href="/ur/compass/" class="card-lg group p-6 transition-shadow hover:shadow-modal">
					<p class="eyebrow mb-2">کمپاس</p>
					<h3 class="text-display-sm text-ink group-hover:text-link transition-colors">لائیو ہیڈنگ</h3>
					<p class="mt-2 text-sm text-body leading-6">
						ہموار سوزن، معدنی اور اصل شمال، اور لائیو درستگی ریڈیک کے ساتھ ریئل ٹائم 360° ڈائل۔
					</p>
				</a>
				<a href="/ur/location/" class="card-lg group p-6 transition-shadow hover:shadow-modal">
					<p class="eyebrow mb-2">مقام</p>
					<h3 class="text-display-sm text-ink group-hover:text-link transition-colors">GPS کو辕ینیٹس</h3>
					<p class="mt-2 text-sm text-body leading-6">
						عرض، طول، بلندی، اور درستگی ڈیسمل اور DMS میں — کاپی، شیئر، اور میپس میں کھولیں۔
					</p>
				</a>
				<a href="/ur/qibla/" class="card-lg group p-6 transition-shadow hover:shadow-modal">
					<p class="eyebrow mb-2">قبلہ</p>
					<h3 class="text-display-sm text-ink group-hover:text-link transition-colors">مکہ کی طرف سمت</h3>
					<p class="mt-2 text-sm text-body leading-6">
						آپ کے کو辕ینیٹس سے کعبہ تک گریٹ سرکل بیرنگ اور فاصلہ، ڈگری تک درست۔
					</p>
				</a>
				<a href="/ur/bearing/" class="card-lg group p-6 transition-shadow hover:shadow-modal">
					<p class="eyebrow mb-2">بیرنگ</p>
					<h3 class="text-display-sm text-ink group-hover:text-link transition-colors">کورس کیلکیولیٹر</h3>
					<p class="mt-2 text-sm text-body leading-6">
						کسی بھی دو پوائنٹس کے درمیان بیرنگ اور گریٹ سرکل فاصلہ — نیویگیشن اور روت پلاننگ کے لیے بالکل مناسب۔
					</p>
				</a>
				<a href="/ur/sun/" class="card-lg group p-6 transition-shadow hover:shadow-modal">
					<p class="eyebrow mb-2">سورج</p>
					<h3 class="text-display-sm text-ink group-hover:text-link transition-colors">سورج کی پوزیشن</h3>
					<p class="mt-2 text-sm text-body leading-6">
						شمسی ازموت اور بلندی فوری، ساتھ میں طلوع، شمس نماز، اور غروب — کسی بھی مقام کے لیے۔
					</p>
				</a>
				<div class="card-soft flex flex-col justify-center p-6">
					<p class="text-sm text-body leading-6">
						کوئی اکاؤنٹس نہیں۔ کوئی ٹریکرز نہیں۔ ہر حساب آپ کے براؤزر میں چلتا ہے اور آپ کے جانے کی لمحے ڈسکارڈ ہو جاتا ہے۔
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- یہ کیسے کام کرتا ہے -->
	<section id="how-it-works" class="border-y border-hairline bg-canvas scroll-mt-16">
		<div class="mx-auto max-w-[1200px] px-4 py-20 sm:px-6 md:py-28">
			<p class="eyebrow">یہ کیسے کام کرتا ہے</p>
			<h2 class="mt-3 max-w-2xl text-display-lg text-ink">درستگی کے لیے ڈیزائن کیا گیا۔</h2>
			<p class="mt-3 max-w-xl text-body-lg text-body">
				آپ کے فون کا میگنیٹومیٹر، جائیروسکوپ، اور ایکسلیرومیٹر ٹلٹ کے مطابق ہیڈنگ انجین کو فیڈ کرتے ہیں، دنیا کے معدنی ماڈل کے خلاف درست کیا جاتا ہے۔
			</p>

			<div class="mt-12 grid gap-6 md:grid-cols-3">
				<div class="card p-6">
					<div class="mb-4 flex h-10 w-10 items-center justify-center rounded-md border border-hairline text-ink">
						<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" aria-hidden="true">
							<circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5" />
							<path d="M15.5 8.5 13 13l-4.5 2.5L11 11z" fill="var(--color-error)" />
						</svg>
					</div>
					<h3 class="text-display-sm text-ink">سینسر فیوژن</h3>
					<p class="mt-2 text-sm text-body leading-6">
						ہیڈنگ سائیشن اور میگنیٹومیٹر ڈیٹا سے حاصل کی جاتی ہے، ریئل ٹائم میں ہموار کی جاتی ہے تاکہ سوزن آپ کے ہاتھ میں مستحکم رہے۔
					</p>
				</div>
				<div class="card p-6">
