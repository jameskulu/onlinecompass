---
import Layout from '../../layouts/Layout.astro';
import Compass from '../../components/Compass.astro';

const faq = [
	{
		q: 'آن لائن کمپاس کیا ہے؟',
		a: 'آن لائن کمپاس ایک ڈیجیٹل کمپاس ہے جو الگ ایپ کے بجائے آپ کے ویب براؤزر کے اندر چلتا ہے۔ یہ آپ کے فون کے میگنیٹومیٹر، ایکسلیرومیٹر، اور جائیروسکوپ کو پڑھتا ہے اور انہیں ڈگریوں میں ایک لائیو ہیڈنگ میں بدل دیتا ہے — کوئی ڈاؤن لوڈ درکار نہیں۔ آپ اس جیسا صفحہ کھولتے ہیں، سینسر تک رسائی دیتے ہیں، اور جیسے جیسے آپ مڑتے ہیں ڈائل ریئل ٹائم میں اپ ڈیٹ ہوتا رہتا ہے۔',
	},
	{
		q: 'آن لائن کمپاس موبائل پر کیسے استعمال کریں؟',
		a: 'اپنے فون پر یہ صفحہ کھولیں، "لائیو کمپاس فعال کریں" پر ٹیپ کریں، اور ڈیوائس کو اپنی ہتھیلی میں ہموار پکڑیں۔ ہیڈنگ ڈائل کے نیچے ڈگریوں میں اور کمپاس پوائنٹ کے طور پر ظاہر ہوتی ہے۔ سب سے درست نتائج کے لیے میگنیٹومیٹر کیلیبریٹ کرنے کے لیے آٹھ کی شکل بنائیں اور فون کو دھات اور مقناطیس سے دور رکھیں۔',
	},
	{
		q: 'کیا آن لائن کمپاس درست ہے؟',
		a: 'کیلیبریٹ شدہ فون کمپاس عام طور پر باہر تقریباً 1–5 ڈگری کے اندر درست ہوتا ہے۔ میگنیٹومیٹر خود حساس ہوتا ہے، اور قریبی دھات، الیکٹرانکس، یا مقناطیسی فون کیس اسے بگاڑ سکتے ہیں۔ ایک بار کیلیبریٹ کر کے مداخلت سے دور ہٹ جائیں تو ریڈنگز عام طور پر جسمانی کمپاس سے چند ڈگری کے اندر میل کھاتی ہیں۔',
	},
	{
		q: 'اصل شمال اور معدنی شمال میں کیا فرق ہے؟',
		a: 'معدنی شمال وہ سمت ہے جس کی طرف آپ کے فون کا میگنیٹومیٹر اشارہ کرتا ہے — یہ زمین کے مقناطیسی میدان کی پیروی کرتا ہے، جو ہر سال بدلتا ہے۔ اصل شمال وہ جغرافیائی قطب شمالی ہے جو نقشے استعمال کرتے ہیں۔ دونوں کے درمیان زاویے کو معدنی مائلت کہتے ہیں، اور یہ ٹول خودکار طور پر اس کی اصلاح کرتا ہے تاکہ آپ کی ہیڈنگ نقشے سے میل کھائے۔',
	},
	{
		q: 'معدنی مائلت کیا ہے؟',
		a: 'معدنی مائلت کسی مقام پر معدنی شمال اور اصل شمال کے درمیان زاویہ ہے۔ یہ دنیا بھر میں تقریباً −30° سے +30° تک ہوتی ہے اور وقت کے ساتھ آہستہ بدلتی ہے۔ لندن میں یہ تقریباً صفر ہے، جبکہ کینیڈا کے کچھ حصوں میں یہ 15° سے بھی زیادہ ہو سکتی ہے۔ چونکہ یہ مقام کے مطابق بدلتی ہے، اس لیے جب بھی آپ کسی بیرنگ کی پیروی کریں تو GPS کے مطابق درست مائلت کی اصلاح اہم ہوتی ہے۔',
	},
	{
		q: 'میری کمپاس کی سوئی کیوں اچھلتی یا گھومتی ہے؟',
		a: 'میگنیٹومیٹر ایک حساس آلہ ہے۔ مقناطیس والے فون کیس، اسپیکر، لیپ ٹاپ، دھات کی میزیں، گاڑی کے ڈیش بورڈ، اور اسٹیل کے ڈھانچے والی عمارتیں سب آپ کے گرد مقناطیسی میدان کو مروڑ دیتے ہیں۔ ان سے دور ہٹیں، فون کو ہموار پکڑیں، اور دوبارہ کیلیبریٹ کرنے کے لیے آٹھ کی شکل بنائیں۔ اندر چند ڈگری کی حرکت معمول ہے۔',
	},
	{
		q: 'اپنے فون کے کمپاس کی کیلیبریشن کیسے کریں؟',
		a: 'فون کو ہموار پکڑیں، پھر اسکرین اوپر رکھتے ہوئے اسے آہستہ آہستہ کئی بار آٹھ کی شکل میں گھمائیں۔ اس سے میگنیٹومیٹر کو کیلیبریٹ کرنے کے لیے پوری رینج مل جاتی ہے۔ آخر میں ایک سیکنڈ ساکن رہیں۔ جب بھی ہیڈنگ غیر مستحکم لگے، دوبارہ کریں۔',
	},
	{
		q: 'کیا آن لائن کمپاس آف لائن اور لیپ ٹاپ پر کام کرتا ہے؟',
		a: 'صفحہ لوڈ ہونے کے بعد ڈائل آف لائن بھی کام کرتا رہتا ہے، کیونکہ ہیڈنگ آپ کے ڈیوائس پر بنتی ہے۔ البتہ لیپ ٹاپ یا ڈیسک ٹاپ لائیو ہیڈنگ کے لیے کام نہیں کرے گا — زیادہ تر میں میگنیٹومیٹر نہیں ہوتا، تو پڑھنے کو کچھ نہیں۔ فون یا ٹیبلٹ استعمال کریں؛ کمپیوٹر پھر بھی ڈیمو ڈائل اور سورج و چاند کا ڈیٹا دکھاتا ہے۔',
	},
	{
		q: 'کیا آن لائن کمپاس میرا مقام مانگتا ہے، اور کیا یہ نجی ہے؟',
		a: 'مقام اختیاری ہے اور صرف معدنی مائلت، قبلہ بیرنگ، اور سورج کی پوزیشن حساب کرنے کے لیے استعمال ہوتا ہے۔ تمام حساب آپ کے براؤزر میں مقامی طور پر چلتا ہے — کوئی اکاؤنٹ نہیں، کوئی بیک اینڈ نہیں، اور کوئی تجزیات نہیں۔ آپ کے کوآرڈینیٹس کبھی آپ کے ڈیوائس سے باہر نہیں جاتے، اور آپ ہمیشہ دستی طور پر کوآرڈینیٹس درج کر سکتے ہیں۔',
	},
	{
		q: 'کیا میں قبلہ تلاش کرنے کے لیے آن لائن کمپاس استعمال کر سکتا ہوں؟',
		a: 'جی ہاں۔ قبلہ فائنڈر آپ کے کوآرڈینیٹس سے مکہ میں کعبہ تک عظیم دائرے کا بیرنگ، ڈگری تک درست، اور ساتھ فاصلہ حساب کرتا ہے۔ پھر آپ لائیو کمپاس ڈائل پر اس بیرنگ کی پیروی کر کے اس کی طرف رخ کر سکتے ہیں۔',
	},
	{
		q: 'بغیر کمپاس شمال کیسے تلاش کریں؟',
		a: 'شمالی نصف کرہ میں مقامی دوپہر کے وقت سورج بالکل جنوب میں ہوتا ہے، اس لیے یہ شمال کی طرف اشارہ کرتی چھایا بناتا ہے۔ رات کو قطب نما ستارہ (پولارس) تقریباً بالکل اصل شمال کے اوپر ہوتا ہے۔ اس سائٹ کا سورج کی پوزیشن ٹول آپ کے مقام اور وقت کے لیے عین شمسی ازموت دیتا ہے، جو کسی بھی کمپاس کے لیے ایک قابلِ بھروسہ کراس چیک ہے۔',
	},
	{
		q: 'کیا اس کمپاس کے لیے کوئی ایپ انسٹال کرنی پڑتی ہے؟',
		a: 'نہیں۔ سب کچھ براؤزر میں چلتا ہے، تو ڈاؤن لوڈ کرنے کو کچھ نہیں، نہ کوئی ایپ اسٹور، نہ سائن اپ، اور نہ اپ ڈیٹ سنبھالنے کی ضرورت۔ یہ آئی فون، اینڈرائڈ، اور زیادہ تر ٹیبلٹس پر یکساں کام کرتا ہے۔',
	},
	{
		q: 'کیا یہ آن لائن کمپاس مفت ہے؟',
		a: 'جی ہاں، یہ مکمل طور پر مفت ہے اور کوئی پریمیم درجے یا پے وال نہیں۔ سائٹ کا ہر ٹول — کمپاس، GPS کوآرڈینیٹس، قبلہ فائنڈر، بیرنگ کیلکیولیٹر، سورج کی پوزیشن، اور سورج و چاند کی سمت — استعمال کے لیے مفت ہے۔',
	},
	{
		q: 'میرا گھر یا کھڑکی کس سمت میں ہے؟',
		a: 'کھڑکی پر باہر کی طرف رخ کر کے کھڑے ہوں، فون ہموار پکڑیں، اور ہیڈنگ پڑھیں۔ شمال 0°، مشرق 90°، جنوب 180°، اور مغرب 270° ہے۔ باغبان اسے دھوپ کی منصوبہ بندی کے لیے استعمال کرتے ہیں، اور فوٹوگرافر اس سے اندازہ لگاتے ہیں کہ سورج کہاں طلوع اور غروب ہوگا۔',
	},
	{
		q: 'گوگل میں میرا کمپاس کہاں ہے؟',
		a: 'گوگل میپس نقشے کے اوپری دائیں کونے میں ایک چھوٹا کمپاس دکھاتا ہے۔ ڈگریوں میں لائیو ہیڈنگ کے لیے، بس گوگل پر "آن لائن کمپاس" تلاش کریں اور یہ صفحہ کھولیں — جیسے ہی آپ سینسر تک رسائی دیتے ہیں یہ کمپاس بن جاتا ہے۔',
	},
	{
		q: 'کون سے موبائل فونوں میں کمپاس سینسر ہوتا ہے؟',
		a: 'تقریباً ہر جدید اسمارٹ فون — iPhone 3GS کے بعد سے ہر آئی فون اور تقریباً ہر اینڈرائڈ فون — میں میگنیٹومیٹر ہوتا ہے، تو یہ آن لائن کمپاس تقریباً ہر ڈیوائس پر کام کرتا ہے۔',
	},
];

const declinationExamples = [
	{ place: 'لندن، مملکت متحدہ', value: '≈ 0°' },
	{ place: 'پیرس، فرانس', value: '≈ +1° مشرق' },
	{ place: 'نیویارک، ریاستہائے متحدہ', value: '≈ −13° مغرب' },
	{ place: 'ٹورنٹو، کینیڈا', value: '≈ −11° مغرب' },
	{ place: 'لاس اینجلس، ریاستہائے متحدہ', value: '≈ +12° مشرق' },
	{ place: 'اینکریج، ریاستہائے متحدہ', value: '≈ +15° مشرق' },
	{ place: 'سڈنی، آسٹریلیا', value: '≈ +12° مشرق' },
	{ place: 'ساؤ پاؤلو، برازیل', value: '≈ −23° مغرب' },
	{ place: 'کیپ ٹاؤن، جنوبی افریقہ', value: '≈ −25° مغرب' },
	{ place: 'ٹوکیو، جاپان', value: '≈ −8° مغرب' },
];

const compassRose = [
	{ point: 'N', deg: '0°' },
	{ point: 'NNE', deg: '22.5°' },
	{ point: 'NE', deg: '45°' },
	{ point: 'ENE', deg: '67.5°' },
	{ point: 'E', deg: '90°' },
	{ point: 'ESE', deg: '112.5°' },
	{ point: 'SE', deg: '135°' },
	{ point: 'SSE', deg: '157.5°' },
	{ point: 'S', deg: '180°' },
	{ point: 'SSW', deg: '202.5°' },
	{ point: 'SW', deg: '225°' },
	{ point: 'WSW', deg: '247.5°' },
	{ point: 'W', deg: '270°' },
	{ point: 'WNW', deg: '292.5°' },
	{ point: 'NW', deg: '315°' },
	{ point: 'NNW', deg: '337.5°' },
];

const compassTypes = [
	{
		type: 'روایتی مقناطیسی کمپاس',
		measures: 'تیرتی سوئی سے زمین کا مقناطیسی میدان ناپتا ہے',
		best: 'آف لائن بھروسہ، بغیر بیٹری، تعلیم',
		limitation: 'ہموار سطح درکار، مائلت کی اصلاح نہیں، ایک ہی سینسر',
	},
	{
		type: 'فون سینسر کمپاس (یہ سائٹ)',
		measures: 'میگنیٹومیٹر کے ساتھ ایکسلیرومیٹر اور جائیروسکوپ، یکجا',
		best: 'ڈگریوں میں لائیو ہیڈنگ، جھکاؤ کی تلافی، نقشے کی سیدھ',
		limitation: 'قریبی دھات اور مقناطیس سے حساس',
	},
	{
		type: 'GPS کورس کمپاس',
		measures: 'GPS پوزیشن کی تبدیلیوں سے سفر کی سمت',
		best: 'چلتے وقت نیویگیشن، بغیر میگنیٹومیٹر کام کرتا ہے',
		limitation: 'صرف حرکت میں کام کرتا ہے؛ ساکن کھڑے ہونے پر بیکار',
	},
	{
		type: 'جائرو کمپاس',
		measures: 'تیزی سے گھومنے والے جائروسکوپس سے زمین کی گردش',
		best: 'جہاز اور ہوائی جہاز، مقناطیسی میدانوں سے غیر متاثر',
		limitation: 'بڑا، مہنگا، بسنے میں سست',
	},
