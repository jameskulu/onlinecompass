	<!-- ─── Online Compass Geometry & Math Section ──────────── -->
	<section id="geometry-math" class="border-t border-hairline bg-canvas scroll-mt-16">
		<div class="mx-auto max-w-[1200px] px-4 py-20 sm:px-6 md:py-28">
			<div class="mx-auto max-w-3xl">
				<p class="eyebrow">ریاضی اور ہندسہ</p>
				<h2 class="mt-3 text-display-lg text-ink">
					قطب نما کی ہندسہ اور ریاضی: 360 ڈگری کا دائرہ
				</h2>
				<p class="mt-6 text-body-lg text-body leading-relaxed">
					قطب نما میں 360 ڈگری کیوں ہوتی ہیں اور دائرے کی ہندسہ نیویگیشن سے کیسے جڑی ہے؟ ایزیمتھ، بیک بیئرنگ اور تکونیات کی بنیادی ریاضی جانیے۔
				</p>

				<div class="mt-8 space-y-6">
					<div class="card p-6">
						<h3 class="text-display-sm text-ink">1. 360 ڈگری دائرے کی جیومیٹری</h3>
						<p class="mt-2 text-sm text-body leading-6">
							ایک مکمل چکر 360 ڈگری کا ہوتا ہے۔ بابلی تہذیب نے 360 کا انتخاب اس لیے کیا کیونکہ اس کے 24 مکمل تقسیمی عدد ہیں، جس سے دائرے کو بغیر کسر کے 4 چوتھائیوں اور 8 سمتوں میں تقسیم کرنا آسان ہو جاتا ہے۔
						</p>
					</div>

					<div class="card p-6">
						<h3 class="text-display-sm text-ink">2. کمپاس کی ڈگریاں بمقابلہ ریڈین</h3>
						<p class="mt-2 text-sm text-body leading-6">
							ملاح ڈگری (0° سے 360°) پڑھتے ہیں جبکہ فزکس اور ریاضیاتی کمپیوٹر انجن ریڈین میں کام کرتے ہیں۔ تبدیلی کا فارمولا: ریڈین = ڈگری × (π / 180°)۔
						</p>
						<div class="my-4 rounded-xl border border-hairline bg-canvas-soft p-4 font-mono text-xs sm:text-sm text-ink">
							<p>θ_radians = θ_degrees × (π / 180°)</p>
							<p class="mt-1">θ_degrees = θ_radians × (180° / π)</p>
							<p class="mt-2 text-mute text-xs">// 0° (N) = 0 rad | 90° (E) = π/2 rad ≈ 1.5708 rad | 180° (S) = π rad ≈ 3.1416 rad | 270° (W) = 3π/2 rad ≈ 4.7124 rad</p>
						</div>
					</div>

					<div class="card p-6">
						<h3 class="text-display-sm text-ink">3. ہندسی پرکار بمقابلہ سمتی قطب نما</h3>
						<p class="mt-2 text-sm text-body leading-6">
							اردو میں دائرہ بنانے والے آلے کو پرکار اور سمت بتانے والے آلے کو قطب نما کہتے ہیں۔ تاہم دونوں دائرے کے یکساں ہندسی اصولوں پر قائم ہیں۔ اگر آپ کو ہندسی اشکال بنانے، زاویوں کے خاکے تیار کرنے یا ڈرائنگ کے لیے ڈیجیٹل کینوس درکار ہو تو آپ بغیر کسی ایپ انسٹالیشن کے براہِ راست اپنے براؤزر میں <a href="https://simplesketchpad.com/" target="_blank" rel="noopener" class="text-link underline hover:text-ink">Simple Sketchpad</a> استعمال کر سکتے ہیں:
						</p>
					</div>
				</div>

				<!-- Comparison Table: Geometry Compass vs Navigational Online Compass -->
				<div class="mt-10 overflow-x-auto">
					<table class="w-full border-collapse text-sm">
						<caption class="sr-only">ہندسی پرکار اور ڈیجیٹل قطب نما کا تقابل</caption>
						<thead>
							<tr class="border-b border-hairline-strong text-left">
								<th scope="col" class="py-3.5 pr-4 font-semibold text-ink">خصوصیت</th>
								<th scope="col" class="py-3.5 pr-4 font-semibold text-ink">ہندسی پرکار (ڈرائنگ)</th>
								<th scope="col" class="py-3.5 font-semibold text-ink">ڈیجیٹل آن لائن قطب نما</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-hairline">
							{geometryCompassComparison.map((row) => (
								<tr class="hover:bg-canvas-soft/40 transition-colors align-top">
									<td class="py-4 pr-4 font-medium text-ink">{row.feature}</td>
									<td class="py-4 pr-4 text-xs text-body leading-5">{row.geometryCompass}</td>
									<td class="py-4 text-xs text-body leading-5 font-medium text-ink">{row.digitalCompass}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>

				<div class="mt-8 rounded-xl border border-hairline bg-canvas-soft p-6">
					<h3 class="text-base font-semibold text-ink">واپسی کے راستے (Back-Bearing) کا ریاضیاتی فارمولا</h3>
					<p class="mt-2 text-sm text-body leading-6">
						اسی راستے پر عین درستگی سے واپس آنے کے لیے:
					</p>
					<div class="my-3 font-mono text-xs text-ink bg-canvas p-3 rounded border border-hairline">
						<p>If Forward_Bearing &lt; 180°: Back_Bearing = Forward_Bearing + 180°</p>
						<p class="mt-1">If Forward_Bearing ≥ 180°: Back_Bearing = Forward_Bearing - 180°</p>
					</div>
					<p class="text-xs text-mute">
						مثال: اگر آپ 045° (شمال مشرق) پر گئے ہیں تو واپسی کا اصل زاویہ 045° + 180° = 225° (جنوب مغرب) ہوگا۔
					</p>
				</div>
			</div>
		</div>
