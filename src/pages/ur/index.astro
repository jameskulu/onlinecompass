---
import Layout from '../../layouts/Layout.astro';
import Compass from '../../components/Compass.astro';

const faq = [
	{
		"q": "آن لائن ڈیجیٹل کمپاس کیا ہے اور یہ ویب براؤزر میں کیسے کام کرتا ہے؟",
		"a": "آن لائن ڈیجیٹل کمپاس ایک ویب ایپلی کیشن ہے جو W3C DeviceOrientation API کے ذریعے آپ کے اسمارٹ فون کے اندرونی فزیکل سینسرز (میگنیٹومیٹر، ایکسلرومیٹر اور جائروسکوپ) کو براہ راست پڑھتی ہے۔ کسی ایپ کو انسٹال کیے بغیر جاوا اسکرپٹ پر فوری سہ جہتی ٹلٹ کمپنسیشن کر کے یہ 0° سے 360° تک بالکل درست زاویہ فراہم کرتا ہے۔"
	},
	{
		"q": "حقیقی شمال (True North) اور مقناطیسی شمال (Magnetic North) میں کیا فرق ہے؟",
		"a": "حقیقی شمال زمین کے گھومنے والے جغرافیائی قطب شمالی کی طرف اشارہ کرتا ہے جہاں تمام طول بلد لکیریں ملتی ہیں۔ مقناطیسی شمال بحر منجمد شمالی کا وہ مقام ہے جہاں زمین کی مقناطیسی لہریں عمودی طور پر کور میں داخل ہوتی ہیں۔ ان دونوں کے درمیان کے زاویاتی فرق کو مقناطیسی انحراف (Magnetic Declination) کہا جاتا ہے۔"
	},
	{
		"q": "مقناطیسی انحراف کیا ہے اور درست نیویگیشن کے لیے یہ کیوں ضروری ہے؟",
		"a": "مقناطیسی انحراف آپ کے مقام پر مقناطیسی شمال اور حقیقی شمال کے درمیان کا افقی زاویہ ہے۔ نیویارک میں یہ تقریباً −13° مغرب اور لاس اینجلس میں +12° مشرق ہے۔ ہمارا قطب نما امریکی ادارے NOAA کے ورلڈ میگنیٹک ماڈل (WMM) کو خودکار طور پر لاگو کرتا ہے تاکہ کمپاس کی سوئی ٹوپوگرافک نقشے سے بالکل مطابقت رکھے۔"
	},
	{
		"q": "بہترین درستگی کے لیے میں اپنے فون کے کمپاس کو کیسے کیلیبریٹ کروں؟",
		"a": "فون کو اپنی ہتھیلی پر افقی سیدھا رکھیں، اسکرین آسمان کی طرف ہو، اور ہوا میں 5 سے 10 سیکنڈ تک انگریزی کے 8 یا لامتناہی (∞) کے ہندسے کی شکل میں گھمائیں۔ اس سے فون کا تھری ایکسیئل میگنیٹومیٹر زمین کے فیلڈ کو ہر رخ سے پڑھ کر فون کے اندرونی برقی پرزوں کے مقناطیسی بگاڑ کو خودکار طور پر منہا کر دیتا ہے۔"
	},
	{
		"q": "میرے کمپاس کی سوئی غیر مستحکم ہو کر کانپتی یا گھومتی کیوں ہے؟",
		"a": "سوئی کا غیر مستحکم ہونا قریبی الیکٹرو میگنیٹک رکاوٹوں کی وجہ سے ہوتا ہے۔ مقناطیسی فون کور، میگ سیف اسیسریز، لیپ ٹاپ، کنکریٹ کے سریا اور گاڑی کے ڈیش بورڈ سے کم از کم 2 میٹر دور ہٹ جائیں اور دوبارہ 8 کے ہندسے والی کیلیبریشن دہرائیں۔"
	},
	{
		"q": "اسمارٹ فون کا کمپاس دستی بیس پلیٹ کمپاس کے مقابلے میں کتنا درست ہے؟",
		"a": "دھاتی اشیاء سے دور کیلیبریٹ ہونے کے بعد اسمارٹ فون کا MEMS سینسر کھلے میدان میں ±1° سے ±3° تک درستگی دیتا ہے جو عام مائع کمپاس کے برابر ہے۔ مزید برآں اس میں ٹلٹ درستگی اور حقیقی شمال کی خودکار ایڈجسٹمنٹ شامل ہے۔ تاہم دشوار گزار پہاڑی مہمات میں عام مقناطیسی کمپاس بطور ایمرجنسی بیک اپ ساتھ رکھنا مفید ہے۔"
	},
	{
		"q": "کیا یہ آن لائن کمپاس انٹرنیٹ کے بغیر (آف لائن) اور ہوائی جہاز موڈ میں کام کرتا ہے؟",
		"a": "جی ہاں! یہ ویب سائٹ مکمل طور پر آف لائن چلنے والی پروگریسو ویب ایپ (PWA) کے طور پر بنائی گئی ہے۔ تمام کوڈ اور جیو میگنیٹک ماڈل براؤزر کی میموری میں محفوظ ہو جاتے ہیں۔ ایک بار کھلنے کے بعد یہ کسی بھی انٹرنیٹ سگنل کے بغیر دور دراز وادیوں میں بھی بالکل ٹھیک کام کرتا ہے۔"
	},
	{
		"q": "کمپیوٹر یا لیپ ٹاپ پر یہ کمپاس ڈیمو ڈائل کیوں دکھاتا ہے؟",
		"a": "براہ راست سمت جاننے کے لیے ہارڈویئر میگنیٹومیٹر چِپ کی ضرورت ہوتی ہے۔ اسمارٹ فونز اور ٹیبلٹس میں یہ سینسر موجود ہوتا ہے مگر عام لیپ ٹاپس اور ڈیسک ٹاپ کمپیوٹرز میں یہ چِپ نہیں ہوتی۔ کمپیوٹر پر یہ ٹول انٹرایکٹو سیمولیشن اور سورج کے حساب کتاب کی سہولت پیش کرتا ہے۔"
	},
	{
		"q": "قبلہ فائنڈر مکہ مکرمہ کی درست سمت کا تعین کیسے کرتا ہے؟",
		"a": "یہ ٹول آپ کے جی پی ایس کوآرڈینیٹس سے مکہ مکرمہ میں خانہ کعبہ (21° 25' 21\" شمال، 39° 49' 34\" مشرق) کے درمیان کا عظیم دائرہ راستہ (Great-Circle Azimuth) کروی مثلثیات کے اصولوں سے نکالتا ہے۔ ڈائل پر سبز رنگ کا کعبہ مارکر آپ کو درست قبلہ رخ ہونے میں رہنمائی دیتا ہے۔"
	},
	{
		"q": "میرا گھر، بالکونی یا کمرہ کس سمت میں واقع ہے؟",
		"a": "اپنی کھڑکی یا بیرونی دروازے پر فون کو بالکل سیدھا ہاتھ میں پکڑ کر کھڑے ہوں۔ اگر ریڈنگ 315° سے 45° کے درمیان ہے تو یہ شمال رخ ہے۔ جنوب رخ (135°–225°) سال بھر سب سے زیادہ دھوپ حاصل کرتا ہے، مشرق سے صبح کی روشنی اور مغرب سے شام کی تپش ملتی ہے۔"
	}
];

