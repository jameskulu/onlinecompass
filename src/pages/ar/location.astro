---
import Layout from '../../layouts/Layout.astro';
import LocationPanel from '../../components/LocationPanel.astro';
import PageHero from '../../components/PageHero.astro';
import RelatedTools from '../../components/RelatedTools.astro';
---

<Layout
	title="إحداثيات GPS أون لاين — خط العرض وخط الطول وDMS"
	description="ابحث عن إحداثيات GPS الخاصة بي أون لاين: خط العرض وخط الطول والارتفاع والدقة بتنسيق الدرجات العشرية وDMS. انسخ أو شارك أو افتح في خرائط جوجل. بدون تثبيت، بدون تتبع."
	path="/ar/location/"
	keywords="إحداثيات GPS أون لاين, إيجاد موقعي, خط العرض خط الطول, إحداثيات DMS, موقعي GPS"
>
	<PageHero
		eyebrow="GPS · الموقع"
		title="اعرف بالضبط أين أنت."
		description="إحداثيات GPS حية والارتفاع والدقة مباشرة من جهازك. كل شيء يُحسب محلياً — موقعك لا يغادر متصفحك أبداً."
	>
		<LocationPanel />
	</PageHero>

	<section class="border-t border-hairline bg-canvas">
		<div class="mx-auto max-w-3xl px-4 py-20 sm:px-6 md:py-24">
			<p class="eyebrow">أداة الموقع GPS</p>
			<h2 class="mt-3 text-display-lg text-ink">احصل على إحداثيات GPS أون لاين — فوراً</h2>

			<p class="mt-6 text-body-lg text-body">
				تحتاج إلى <strong class="text-ink font-medium">إيجاد إحداثيات GPS الخاصة بي أون لاين</strong>؟
				تقرأ هذه الأداة موقع جهازك في الوقت realtime وتُظهر خط العرض وخط الطول الحاليين
				بتنسيق الدرجات العشرية وتنسيق الدقائق والثوانٍ (DMS)، بالإضافة إلى
				ارتفاعك والدقة المقدرة. امنح الإذن مرة واحدة، وتتتبع الصفحة موقعك باستمرار
				أثناء تحركك — مفيد للمشي لمسافات طويلة، والعمل الميداني، والبحث عن الكنوز، أو ببساطة
				مشاركة مكانك بالضبط مع شخص ما.
			</p>
			<p class="mt-4 leading-7">
				كل شيء يُعالج محلياً في متصفحك. موقعك لا يُرسل إلى خادم أو يُخزّن أو يُشارك —
				هذه أداة إحداثيات GPS أون لاين خاصة بالتصميم، والقراءة تختفي في اللحظة التي
				تُغلق فيها الصفحة.
			</p>

			<h3 class="mt-10 text-display-sm text-ink">شرح خط العرض وخط الطول وDMS</h3>
			<p class="mt-3 leading-7">
				<strong class="text-ink font-medium">خط العرض</strong> يقيس مدى بعدك شمالاً أو جنوباً عن
				خط الاستواء (0° عند خط الاستواء، 90° عند القطبين)، بينما
				<strong class="text-ink font-medium">خط الطول</strong> يقيس مدى بعدك شرقاً أو غرباً عن
				خط الزوال الرئيسي. معاً يُشكّلان شبكة تحدد أي مكان على الأرض
				بإطار أمتار. تستخدم معظم تطبيقات الخرائط الدرجات العشرية (على سبيل المثال 48.8584، 2.2945 لـ
				باريس)، لكن كثيراً من النماذج وأدلة الملاحة تتوقع DMS (48° 51' 29.6" شمالاً، 2° 17' 40.2" شرقاً).
				تُظهر هذه الأداة <strong class="text-ink font-medium">موقعي</strong> بالتنسيقين
				لنسخ أيهما تحتاج — بدون تحويل يدوي.
			</p>
			<p class="mt-4 leading-7">
				الدرجات العشرية وDMS هما نفس الموقع، فقط بأسلوب كتابة مختلف. درجة واحدة من
				خط العرض حوالي 111 كيلومتراً؛ دقيقة واحدة حوالي 1.85 كيلومتر؛ ثانية واحدة
				حوالي 30 متراً. فهم الوحدات يساعدك على تحديد مدى دقة الإحداثيات
				ولماذا تهم الدقة عندما تكون في الميدان.
			</p>

			<h3 class="mt-10 text-display-sm text-ink">أين يمكنك استخدام إحداثيات GPS الحية؟</h3>
			<div class="mt-4 space-y-3">
				<p class="leading-7">
					<strong class="text-ink font-medium">الملاحة الخارجية.</strong> عندما تكون على
					مسار أو في مخيم أو تستكشف مدينة جديدة، سجّل إحداثياتك لتشاركها أو تعود بها.
					إنها أسرع طريقة للإجابة على "أين أنا الآن؟"
				</p>
				<p class="leading-7">
					<strong class="text-ink font-medium">التصوير والتخطيط.</strong> حدد موقع جغرافي
					للتصوير، سجّل مكان وقوفك للصورة، أو تحقق من ارتفاع نقطة مشاهدة
					قبل تخطيط مسار.
				</p>
				<p class="leading-7">
					<strong class="text-ink font-medium">العمل والدراسة.</strong> يستخدم المسّاحون والمزارعون
					وباحثو الميدان إحداثيات دقيقة لتحديد القطع والنقاط. يستخدمها الطلاب
					لمشاريع الجغرافيا وللتحقق من عمل الخرائط.
				</p>
				<p class="leading-7">
					<strong class="text-ink font-medium">الأدوات الأخرى في هذا الموقع.</strong> إحداثياتك
					تُغذّي مباشرة محدد القبلة وحاسبة الاتجاه وأداة
					موضع الشمس، لتتمكن من العمل بدقة في كل مكان.
				</p>
			</div>

			<h3 class="mt-10 text-display-sm text-ink">ما مدى دقة موقع GPS؟</h3>
			<p class="mt-3 leading-7">
				تجمع الهواتف الحديثة بين GPS الأقمار الصناعية وWiFi وبيانات أجهزة الاتصال. في الخارج
				مع سماء صافية عادةً ما تحصل على دقة ضمن 3-10 أمتار؛ في الداخل يضعف الإشارة وت下降
				الدقة. تُظهر الأداة دقتك المقدرة بالأمتار لتعرف مدى الثقة في
				القراءة. للحصول على أفضل تثبيت، وقف لبضع ثوانٍ في الخارج، بعيداً عن المباني
				العالية والأغطية الشجرية الكثيفة.
			</p>
			<p class="mt-4 leading-7">
				بما أن هذه أداة إحداثيات GPS أون لاين لا ترفع شيئاً أبداً، يمكنك استخدامها
				بثقة في أي مكان — طريقة خاصة لإيجاد موقعي تُعطيك أيضاً
				الدقة التي تحتاجها.
			</p>
		<h3 class="mt-10 text-display-sm text-ink">شارك وانسخ وافتح إحداثياتك</h3>
			<p class="mt-3 leading-7">
				الأداة مصممة للاستخدام الحقيقي، وليس العرض فقط. انسخ إحداثياتك بالتنسيق
				الذي تحتاجه، شاركها مع صديق، أو افتح موقعك مباشرة في خرائط جوجل لعرض أوسع
				للمنطقة. مع قراءة الدقة الحية، يمكنك تسجيل مكان بثقة الآن والعودة إليه
				لاحقاً — نقطة مرجعية مفيدة للمشي والاجتماعات والتوصيلات.
			</p>
			<p class="mt-4 leading-7">
				تعمل أداة إحداثيات GPS أون لاين هذه مع باقي الموقع: موقعك الحالي
				يصبح نقطة البداية لـ
				<a href="/ar/bearing/" class="text-link underline decoration-link/30 hover:decoration-link">حاسبة الاتجاه</a>،
				والمرجع لـ
				<a href="/ar/qibla/" class="text-link underline decoration-link/30 hover:decoration-link">محدد القبلة</a>،
				والموقع لـ
				<a href="/ar/sun/" class="text-link underline decoration-link/30 hover:decoration-link">موضع الشمس</a>
				و
				<a href="/" class="text-link underline decoration-link/30 hover:decoration-link">البوصلة الحية</a>.
				تثبيت واحد دقيق، وكل أداة اتجاه في هذا الموقع تستخدمه.
			</p>

			<h3 class="mt-10 text-display-sm text-ink">لماذا تحسب الإحداثيات محلياً؟</h3>
			<p class="mt-3 leading-7">
				كثير من مواقع "إيجاد موقعي" تُرسل إحداثياتك إلى خادم في اللحظة التي تُحمّلها.
				هذه الصفحة تفعل العكس: يأتي تثبيت GPS مباشرة من API الموقع في متصفحك
				ولا يُنقل أبداً إلى أي مكان. هذا يعني لا تتبع، لا سجلات، ولا خطر من
				تخزين موقعك ضد رغباتك — طريقة حقيقية خاصة لإيجاد إحداثيات GPS
				لل بي أون لاين. إنها سريعة ومجانية وتعمل على أي هاتف أو حاسوب حديث بمتصفح.
			</p>
		</div>
	</section>

	<RelatedTools current="/location/" />
</Layout>
