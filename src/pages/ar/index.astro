	<!-- ─── True vs magnetic north ─────────────────────────── -->
	<section id="true-north" class="scroll-mt-16">
		<div class="mx-auto max-w-[1200px] px-4 py-20 sm:px-6 md:py-24">
			<div class="mx-auto max-w-3xl">
				<p class="eyebrow">الشمال الحقيقي مقابل المغناطيسي</p>
				<h2 class="mt-3 text-display-lg text-ink">لماذا يحدد الانحراف مدى صحة اتجاهك.</h2>
				<p class="mt-3 text-body-lg text-body">
					إبرة البوصلة لا تشير إلى أعلى الخريطة، بل تشير إلى الشمال المغناطيسي، وهي
					نقطة متحركة في القطب الشمالي. والفرق بينها وبين الشمال الحقيقي هو الانحراف
					المغناطيسي — وهو السبب الأكثر شيوعاً لظهور قراءة البوصلة كأنها «خاطئة».
				</p>
				<p class="mt-4 text-body leading-7">
					الانحراف ليس رقماً ثابتاً يمكنك حفظه. فهو يعتمد على مكانك على الكوكب، وينزاح
					بجزء من الدرجة كل عام مع حركة لبّ الأرض المنصهر. في لندن بقي الشمالان
					متقاربين تقريباً سنوات طويلة، ولهذا تتجاهل الخرائط البريطانية الفرق غالباً؛
					أما في أجزاء من كندا وجنوب أفريقيا فقد يبلغ الفرق 20° أو أكثر — وهو فرق بين
					أن تصل إلى سيارتك وأن تسلك الشارع الخطأ.
				</p>
				<p class="mt-4 text-body leading-7">
					وهذا تحديداً ما تخطئ فيه البوصلة غير المصحّحة. تطبّق بوصلة أون لاين النموذج
					المغناطيسي العالمي وفق إحداثياتك، لذا فإن التبديل إلى
					<strong class="text-ink font-medium">الشمال الحقيقي</strong> يجعل الاتجاه
					متوافقاً مع شبكة الخريطة. يوضّح الجدول أدناه الحجم التقريبي للتصحيح في أماكن
					معروفة؛ اضغط <em>«استخدم الموقع لحساب الانحراف»</em> على المقياس للحصول على
					القيمة الدقيقة في مكانك.
				</p>
			</div>

			<div class="mx-auto mt-10 max-w-3xl overflow-x-auto">
				<table class="w-full border-collapse text-sm">
					<caption class="sr-only">الانحراف المغناطيسي التقريبي حسب المدينة</caption>
					<thead>
						<tr class="border-b border-hairline-strong text-left">
							<th scope="col" class="py-3 pr-4 font-medium text-ink">المكان</th>
							<th scope="col" class="py-3 font-medium text-ink">الانحراف التقريبي</th>
						</tr>
					</thead>
					<tbody>
						{declinationExamples.map((d) => (
							<tr class="border-b border-hairline">
								<td class="py-3 pr-4 text-body">{d.place}</td>
								<td class="py-3 text-body">{d.value}</td>
							</tr>
						))}
					</tbody>
				</table>
				<p class="mt-3 text-xs text-mute">
					قيم تقريبية لمنتصف عشرينيات القرن الحادي والعشرين للتوضيح فقط. يتغيّر الانحراف
					كل عام ويتفاوت حسب الموقع الدقيق — استخدم دائماً التصحيح الحي في الأداة.
				</p>
			</div>
		</div>
	</section>

	<!-- ─── How to read a compass ──────────────────────────── -->
	<section id="reading" class="border-y border-hairline bg-canvas scroll-mt-16">
		<div class="mx-auto max-w-[1200px] px-4 py-20 sm:px-6 md:py-24">
			<div class="mx-auto max-w-3xl">
				<p class="eyebrow">قراءة المقياس</p>
				<h2 class="mt-3 text-display-lg text-ink">الاتجاهات والزوايا ووردة البوصلة.</h2>
				<p class="mt-3 text-body-lg text-body">
					بمجرد أن يصبح المقياس حياً، تبقى مهارة واحدة: قراءته.
				</p>
				<div class="mt-8 grid gap-4 sm:grid-cols-2">
					<div class="card-soft p-5">
						<h3 class="text-sm font-medium text-ink mb-1">الاتجاه (Heading)</h3>
						<p class="text-sm leading-6">الجهة التي تواجهها حالياً، بالدرجات في اتجاه عقارب الساعة من الشمال. مواجهة الشرق 90°، والجنوب 180°، والغرب 270°.</p>
					</div>
					<div class="card-soft p-5">
						<h3 class="text-sm font-medium text-ink mb-1">الزاوية (Bearing)</h3>
						<p class="text-sm leading-6">الاتجاه من نقطة إلى أخرى. استخدم <a href="/ar/bearing/" class="text-link underline decoration-link/30 hover:decoration-link">حاسبة الاتجاه</a> للحصول عليه بين أي إحداثيتين.</p>
					</div>
					<div class="card-soft p-5">
						<h3 class="text-sm font-medium text-ink mb-1">السمت (Azimuth)</h3>
						<p class="text-sm leading-6">زاوية تُعبَّر عنها بدرجة من 0° إلى 360°. تعطيك <a href="/ar/sun/" class="text-link underline decoration-link/30 hover:decoration-link">أداة الشمس</a> سمت الشمس لموقعك.</p>
					</div>
					<div class="card-soft p-5">
						<h3 class="text-sm font-medium text-ink mb-1">الزاوية المعاكسة (Back bearing)</h3>
						<p class="text-sm leading-6">الاتجاه العكسي — الزاوية من النقطة «ب» رجوعاً إلى النقطة «أ». أضف 180° إذا كانت الزاوية الأمامية أقل من 180°، وإلا اطرح 180°.</p>
					</div>
				</div>
			</div>

			<div class="mx-auto mt-12 max-w-3xl">
				<h3 class="text-display-sm text-ink">وردة البوصلة ذات 16 نقطة</h3>
				<p class="mt-2 text-sm text-body leading-6">
					بين النقاط الأساسية الأربع تقع نقاط وسيطة. تقسم وردة الـ16 نقطة الدائرة إلى
					قطاعات بزاوية 22.5° — وهي الدقة التي تستخدمها معظم تقارير الملاحة والطقس.
				</p>
				<div class="mt-5 grid grid-cols-2 gap-x-6 sm:grid-cols-4">
					{compassRose.map((c) => (
						<div class="flex items-baseline justify-between border-b border-hairline py-2">
							<span class="font-mono text-sm text-ink">{c.point}</span>
							<span class="font-mono text-xs text-mute">{c.deg}</span>
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<!-- ─── Accuracy ───────────────────────────────────────── -->
	<section id="accuracy" class="scroll-mt-16">
		<div class="mx-auto max-w-[1200px] px-4 py-20 sm:px-6 md:py-24">
			<div class="mx-auto max-w-3xl">
				<p class="eyebrow">الدقة</p>
				<h2 class="mt-3 text-display-lg text-ink">ما مدى دقة بوصلة الهاتف؟</h2>
				<p class="mt-3 text-body-lg text-body">
					عند استخدامها بإتقان، تكون بوصلة الهاتف دقيقة في حدود درجة أو درجتين. وعند
					استخدامها بإهمال، قد تنحرف عشرين درجة. والفرق بيئي بالكامل تقريباً.
				</p>
				<p class="mt-4 text-body leading-7">
					يقيس المقياس المغناطيسي شدة المجال بالميكروتسلا، وهو مصمّم للملاحة لا
					للمساحة: مناسب لاتباع مسار جبلي أو محاذاة لوح شمسي، لكنه لا يضاهي جهازاً
					احترافياً. المهم هو مؤشر الدقة على المقياس — ثق بقراءة ثابتة، وتحرّك عندما
					تقفز بعشرات الدرجات، لأن المجال حولك مشوّه. في الداخل، توقّع انحرافاً بضع
					درجات بسبب الأسلاك والأثاث؛ وفي الخارج، بعيداً عن سيارة أو درابزين، تكون
					القراءات موثوقة. وإذا كانت الدقة مهمة، خذ متوسط عدة قراءات وقارنها
					بـ<a href="/ar/sun/" class="text-link underline decoration-link/30 hover:decoration-link">موضع الشمس</a>.
				</p>
			</div>
		</div>
	</section>

	<!-- ─── Calibration ────────────────────────────────────── -->
	<section id="calibration" class="border-y border-hairline bg-canvas scroll-mt-16">
		<div class="mx-auto max-w-[1200px] px-4 py-20 sm:px-6 md:py-24">
			<div class="grid gap-10 lg:grid-cols-2 lg:items-start">
				<div>
					<p class="eyebrow">الضبط</p>
					<h2 class="mt-3 text-display-lg text-ink">احصل على أدق قراءة.</h2>
					<p class="mt-3 text-body-lg text-body">
						مقياس المغناطيسية في الهاتف حساس للمعادن والحقول المغناطيسية القريبة. بضع
						ثوانٍ من الضبط تحوّل إبرة منحرفة إلى اتجاه موثوق.
					</p>
				</div>
				<ol class="card-soft divide-y divide-hairline">
					<li class="flex gap-4 p-5">
						<span class="font-mono text-sm text-mute">01</span>
						<div>
							<p class="text-sm font-medium text-ink">أمسك الهاتف مستوياً</p>
							<p class="mt-1 text-sm text-body">أبقِ الشاشة متوازية مع الأرض، في راحة يدك أو على سطح مستقر.</p>
						</div>
					</li>
					<li class="flex gap-4 p-5">
						<span class="font-mono text-sm text-mute">02</span>
						<div>
							<p class="text-sm font-medium text-ink">حرّك الهاتف على شكل ثمانية</p>
							<p class="mt-1 text-sm text-body">حرّك الهاتف بلطف في حركة ثمانية بضع مرات، ثم ثبّته.</p>
						</div>
					</li>
					<li class="flex gap-4 p-5">
						<span class="font-mono text-sm text-mute">03</span>
						<div>
							<p class="text-sm font-medium text-ink">ابتعد عن التداخل</p>
							<p class="mt-1 text-sm text-body">ابتعد عن الحواسيب والهواتف والمغناطيسات والطاولات المعدنية قبل أخذ القراءة.</p>
						</div>
					</li>
					<li class="flex gap-4 p-5">
						<span class="font-mono text-sm text-mute">04</span>
						<div>
							<p class="text-sm font-medium text-ink">تحقق بالشمس</p>
							<p class="mt-1 text-sm text-body">استخدم علامة موضع الشمس على المقياس كتحقق مستقل في ضوء النهار.</p>
						</div>
					</li>
				</ol>
			</div>
		</div>
	</section>

	<!-- ─── Compare compass types ──────────────────────────── -->
	<section id="compare" class="scroll-mt-16">
		<div class="mx-auto max-w-[1200px] px-4 py-20 sm:px-6 md:py-24">
			<div class="mx-auto max-w-3xl">
				<p class="eyebrow">أنواع البوصلات</p>
				<h2 class="mt-3 text-display-lg text-ink">ليست كل البوصلات تعمل بالطريقة نفسها.</h2>
				<p class="mt-3 text-body-lg text-body">
					معرفة التقنية التي تحملها تفسّر نقاط قوتها وحدودها، وسبب اختلاف سلوك بوصلة
					الهاتف عن البوصلة النحاسية في الدرج.
				</p>
			</div>
			<div class="mt-10 overflow-x-auto">
				<table class="w-full border-collapse text-sm">
					<caption class="sr-only">مقارنة بين أنواع البوصلات</caption>
					<thead>
						<tr class="border-b border-hairline-strong text-left">
							<th scope="col" class="py-3 pr-4 font-medium text-ink">النوع</th>
							<th scope="col" class="py-3 pr-4 font-medium text-ink">ما الذي تقيسه</th>
							<th scope="col" class="py-3 pr-4 font-medium text-ink">الأفضل لـ</th>
							<th scope="col" class="py-3 font-medium text-ink">القيود</th>
						</tr>
					</thead>
					<tbody>
						{compassTypes.map((c) => (
							<tr class="border-b border-hairline align-top">
								<td class="py-3 pr-4 font-medium text-ink">{c.type}</td>
								<td class="py-3 pr-4 text-body">{c.measures}</td>
								<td class="py-3 pr-4 text-body">{c.best}</td>
								<td class="py-3 text-body">{c.limitation}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>
	</section>

	<!-- ─── Uses ───────────────────────────────────────────── -->
	<section id="uses" class="border-y border-hairline bg-canvas scroll-mt-16">
		<div class="mx-auto max-w-[1200px] px-4 py-20 sm:px-6 md:py-24">
			<p class="eyebrow">استخدامات يومية</p>
			<h2 class="mt-3 max-w-2xl text-display-lg text-ink">من يستخدم بوصلة أون لاين فعلاً.</h2>
			<p class="mt-3 max-w-2xl text-body-lg text-body">
				بعيداً عن حالة التنزه الواضحة، يحل الاتجاه السريع عدداً مفاجئاً من المشكلات
				الصغيرة الواقعية.
			</p>
			<div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
				<div class="card p-6">
					<h3 class="text-display-sm text-ink">التنزه والملاحة على المسارات</h3>
					<p class="mt-2 text-sm text-body leading-6">
						وجّه خريطة ورقية قبل الانطلاق، وخذ زاوية معاكسة لتتبع مسارك، وأكّد الاتجاه
						تحت ظلال الأشجار حيث يتأخر استقرار GPS.
					</p>
				</div>
				<div class="card p-6">
					<h3 class="text-display-sm text-ink">التصوير الفوتوغرافي والفيديو</h3>
					<p class="mt-2 text-sm text-body leading-6">
						خطّط لجلسة تصوير في الساعة الذهبية بالتحقق من الجهة التي يواجهها الموقع،
						وتوقّع أين تشرق الشمس وتغرب باستخدام <a href="/ar/sun/" class="text-link underline decoration-link/30 hover:decoration-link">أداة الشمس</a>.
					</p>
				</div>
				<div class="card p-6">
					<h3 class="text-display-sm text-ink">البستنة والطاقة الشمسية</h3>
					<p class="mt-2 text-sm text-body leading-6">
						اكتشف الجهة التي تواجهها الحديقة أو الشرفة لزرع النباتات المحبّة للشمس،
						ووجّه الألواح الشمسية نحو الجنوب أو الشمال الحقيقي للحصول على أقصى إنتاج.
					</p>
				</div>
				<div class="card p-6">
					<h3 class="text-display-sm text-ink">المنزل والعقارات</h3>
					<p class="mt-2 text-sm text-body leading-6">
						تحقق من توجّه الغرفة من حيث الإضاءة والتدفئة، وصِف واجهة العقار بدقة،
						واحسم سؤال «إلى أي جهة تواجه غرفة المعيشة؟» في ثوانٍ.
					</p>
				</div>
				<div class="card p-6">
					<h3 class="text-display-sm text-ink">السفر والقبلة</h3>
					<p class="mt-2 text-sm text-body leading-6">
						اعرف اتجاه الصلاة في أي مكان عبر
						<a href="/ar/qibla/" class="text-link underline decoration-link/30 hover:decoration-link">محدد القبلة</a>،
						وحدّد اتجاهك في مدينة غريبة قبل أن يلحق بك تطبيق الخرائط.
					</p>
				</div>
				<div class="card p-6">
					<h3 class="text-display-sm text-ink">التعليم ومواد STEM</h3>
					<p class="mt-2 text-sm text-body leading-6">
						يمكن للمعلمين والطلاب مشاهدة الزوايا والاتجاهات والفرق بين الشمال الحقيقي
						والمغناطيسي تنبض بالحياة على مقياس يستجيب لأداة حقيقية.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- ─── Troubleshooting ────────────────────────────────── -->
	<section id="troubleshooting" class="scroll-mt-16">
		<div class="mx-auto max-w-[1200px] px-4 py-20 sm:px-6 md:py-24">
			<div class="mx-auto max-w-3xl">
				<p class="eyebrow">حل المشكلات</p>
				<h2 class="mt-3 text-display-lg text-ink">عندما تشير بوصلتك إلى الاتجاه الخطأ.</h2>
				<p class="mt-3 text-body-lg text-body">
					البوصلة التي تسيء التصرف تكون دائماً تقريباً مشكلة تداخل، لا مستشعراً معطوباً.
					راجع هذه الفحوص بالترتيب.
				</p>
				<div class="mt-8 space-y-4">
					<div class="card-soft p-5">
						<h3 class="text-sm font-medium text-ink mb-1">يدور المقياس أو يتصاعد الرقم بلا توقف</h3>
						<p class="text-sm leading-6">أنت قريب من مصدر مغناطيسي قوي. أزل أغلفة MagSafe والحوامل المغناطيسية، وابتعد عن مكبرات الصوت والمحركات والمعادن، ثم أعد الضبط.</p>
					</div>
					<div class="card-soft p-5">
						<h3 class="text-sm font-medium text-ink mb-1">القراءة ثابتة لكنها تبدو منحرفة بضع درجات</h3>
						<p class="text-sm leading-6">هذا هو الانحراف المغناطيسي عادةً. فعّل الشمال الحقيقي واسمح بالوصول إلى الموقع كي يُطبَّق التصحيح على إحداثياتك الدقيقة.</p>
					</div>
					<div class="card-soft p-5">
						<h3 class="text-sm font-medium text-ink mb-1">لا يحدث شيء عند الضغط على الزر</h3>
						<p class="text-sm leading-6">يتطلب الوصول إلى المستشعرات صفحة HTTPS آمنة وجهازاً مزوّداً بمقياس مغناطيسي. تأكد من منح إذن الحركة والتوجيه لهذا الموقع.</p>
					</div>
					<div class="card-soft p-5">
						<h3 class="text-sm font-medium text-ink mb-1">يعمل على هاتفي لا على حاسوبي المحمول</h3>
						<p class="text-sm leading-6">لا تحتوي معظم الحواسيب المحمولة على مقياس مغناطيسي، فلا يوجد ما يُقرأ. استخدم هاتفك للاتجاه الحي؛ وما زال الحاسوب يعرض المقياس التجريبي وبيانات الشمس والقمر.</p>
					</div>
					<div class="card-soft p-5">
						<h3 class="text-sm font-medium text-ink mb-1">تتأخر الإبرة عند الدوران السريع</h3>
						<p class="text-sm leading-6">يُبقي التسطيح القراءة مستقرة، لذا تتأخر قليلاً خلف الدورانات السريعة. أبطئ لحظة وسيستقر الرقم.</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ─── FAQ ────────────────────────────────────────────── -->
	<section id="faq" class="border-t border-hairline bg-canvas scroll-mt-16">
		<div class="mx-auto max-w-3xl px-4 py-20 sm:px-6 md:py-24">
			<p class="eyebrow text-center">الأسئلة الشائعة</p>
			<h2 class="mt-3 text-center text-display-lg text-ink">أسئلة، وإجابات.</h2>

			<div class="mt-10 space-y-3">
				{faq.map((f) => (
					<details class="card overflow-hidden">
						<summary class="flex cursor-pointer items-center justify-between gap-4 px-6 py-4 text-sm font-medium text-ink">
							{f.q}
							<svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0 text-mute" fill="none" aria-hidden="true">
								<path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</summary>
						<p class="px-6 pb-5 text-sm text-body leading-6">{f.a}</p>
					</details>
				))}
			</div>
		</div>
	</section>

	<!-- ─── CTA band ───────────────────────────────────────── -->
	<section class="bg-ink text-on-primary">
		<div class="mx-auto max-w-[1200px] px-4 py-20 text-center sm:px-6 md:py-24">
			<p class="font-mono text-xs uppercase tracking-[0.08em] text-on-primary/60">جاهز متى كنت جاهزاً</p>
			<h2 class="mt-4 text-display-lg text-on-primary">حدد اتجاهك.</h2>
			<p class="mx-auto mt-3 max-w-lg text-body-lg text-on-primary/70">
				وجّه هاتفك نحو الشمال، أو تحقق من قبلتك، أو ارسم مساراً — كل ذلك في أداة مجانية واحدة.
			</p>
			<div class="mt-8 flex flex-wrap items-center justify-center gap-3">
				<a href="/ar/compass/" class="btn-primary bg-on-primary text-primary hover:opacity-85">افتح البوصلة</a>
				<a href="/blog/how-to-use-online-compass/" class="btn-secondary">اقرأ الدليل الكامل</a>
			</div>
		</div>
	</section>

	<script type="application/ld+json" set:html={JSON.stringify({
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: faq.map((f) => ({
			'@type': 'Question',
			name: f.q,
			acceptedAnswer: {
				'@type': 'Answer',
				text: f.a,
			},
		})),
	})} />
</Layout>

<style>
	details summary::-webkit-details-marker {
		display: none;
	}
