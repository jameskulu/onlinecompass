	<section id="applications" class="border-t border-hairline bg-canvas scroll-mt-16">
		<div class="mx-auto max-w-[1200px] px-4 py-20 sm:px-6 md:py-28">
			<div class="mx-auto max-w-3xl text-center">
				<p class="eyebrow">دليل التطبيقات العملية</p>
				<h2 class="mt-3 text-display-lg text-ink">التطبيقات الاحترافية في مختلف المهن والأنشطة</h2>
				<p class="mt-4 text-body-lg text-body">
					من الهندسة المدنية والطاقة الشمسية إلى الرحلات الاستكشافية وعمليات الإنقاذ:
				</p>
			</div>

			<div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				
				<div class="card p-6">
					<div class="flex items-center gap-2 mb-3">
						<span class="text-xs font-mono font-bold text-link">01</span>
						<h3 class="text-display-sm text-ink">المشي الجبلي وقراءة الخرائط</h3>
					</div>
					<p class="text-sm text-body leading-6">
						طابق الخرائط الطبوغرافية الورقية مع التضاريس المحيطة في ثوانٍ. استخدم <a href="/ar/bearing/" class="text-link underline hover:text-ink">حاسبة السمت</a> لتصويب قمتين جبليتين وتحديد موقعك بدقة دون الحاجة لشبكة خلوية.
					</p>
				</div>

				<div class="card p-6">
					<div class="flex items-center gap-2 mb-3">
						<span class="text-xs font-mono font-bold text-link">02</span>
						<h3 class="text-display-sm text-ink">الإنشاءات المدنية وأعمال السباكة</h3>
					</div>
					<p class="text-sm text-body leading-6">
						استخدم <a href="/ar/level/" class="text-link underline hover:text-ink">ميزان الماء الرقمي</a> للتحقق من انحدار مواسير الصرف (2%)، ومطابقة مسارات الكراسي المتحركة، وقياس زوايا أسقف المباني.
					</p>
				</div>

				<div class="card p-6">
					<div class="flex items-center gap-2 mb-3">
						<span class="text-xs font-mono font-bold text-link">03</span>
						<h3 class="text-display-sm text-ink">تحسين كفاءة الألواح الشمسية</h3>
					</div>
					<p class="text-sm text-body leading-6">
						حقق أعلى توليد للطاقة بتوجيه الألواح نحو الجنوب الحقيقي تماماً (في النصف الشمالي) عبر بوصلتنا المصححة، وضبط زاوية الميل المثالية بمقياس الميل.
					</p>
				</div>

				<div class="card p-6">
					<div class="flex items-center gap-2 mb-3">
						<span class="text-xs font-mono font-bold text-link">04</span>
						<h3 class="text-display-sm text-ink">تسوية الكرفانات وسيارات التخييم</h3>
					</div>
					<p class="text-sm text-body leading-6">
						تجنب احتراق ثلاجات الأمونيا بالسيارات (التي تتعطل بشكل دائم إذا مالت أكثر من 3 درجات). ضع هاتفك على طاولة الكرفان واجعل ميزان الماء دائرياً باللون الأخضر.
					</p>
				</div>

				<div class="card p-6">
					<div class="flex items-center gap-2 mb-3">
						<span class="text-xs font-mono font-bold text-link">05</span>
						<h3 class="text-display-sm text-ink">التقييم العقاري ومسار الشمس</h3>
					</div>
					<p class="text-sm text-body leading-6">
						تحقق من وفرة الضوء الطبيعي، والعزل الحراري الشتوي، واتجاه الرياح. قارن بين شمس الصباح والشرفة الغربية عبر <a href="/ar/sun/" class="text-link underline hover:text-ink">أداة مسار الشمس</a>.
					</p>
				</div>

				<div class="card p-6">
					<div class="flex items-center gap-2 mb-3">
						<span class="text-xs font-mono font-bold text-link">06</span>
						<h3 class="text-display-sm text-ink">التصوير الفوتوغرافي ومواقع السينما</h3>
					</div>
					<p class="text-sm text-body leading-6">
						توقع سمت الساعة الذهبية والزرقاء بدقة قبل أيام. وجّه الكاميرا نحو مؤشر الشمس بالبوصلة لمعرفة الموقع الدقيق الذي ستشرق منه خيوط الصباح الأولى.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- ─── Calibration & Interference Guide ───────────────── -->
	<section id="calibration" class="border-t border-hairline bg-canvas scroll-mt-16">
		<div class="mx-auto max-w-[1200px] px-4 py-20 sm:px-6 md:py-28">
			<div class="grid gap-12 lg:grid-cols-2 lg:items-center">
				<div>
					<p class="eyebrow">حل مشكلات الدقة والتشويش</p>
					<h2 class="mt-3 text-display-lg text-ink">إتقان معايرة مقياس المغناطيسية والتحكم بالتداخلات</h2>
					<p class="mt-4 text-body-lg text-body leading-relaxed">
						على عكس الكاميرا أو مستقبل أقمار GPS، لا يقيس مقياس المغناطيسية إشارة مفردة، بل يقيس المجموع الاتجاهي لـ <em>كل خط مغناطيسي موجود في محيطه</em>.
					</p>
					<p class="mt-4 text-sm text-body leading-6">
						يُصنف مهندسو الإلكترونيات التشوهات المغناطيسية إلى فئتين رئيسيتين:
					</p>

					<div class="mt-6 space-y-4">
						<div class="rounded-xl border border-hairline bg-canvas-soft/50 p-4">
							<h3 class="text-sm font-semibold text-ink">تشوه الحديد الصلب (Hard Iron)</h3>
							<p class="mt-1 text-xs text-body leading-5">
								ينتج عن أجزاء ممغنطة دائمة داخل الهاتف نفسه (السماعات، ومثبتات الكاميرا البصرية، ومغناطيس MagSafe). يُحدث هذا إزاحة ثابتة تُخرج مركز الدائرة المقاسة عن مكانها.
							</p>
						</div>
						<div class="rounded-xl border border-hairline bg-canvas-soft/50 p-4">
							<h3 class="text-sm font-semibold text-ink">تشوه الحديد المرن (Soft Iron)</h3>
							<p class="mt-1 text-xs text-body leading-5">
								ينتج عن مواد حديدية محيطة بالهاتف (حديد التسليح في الأرضيات، وأبواب السيارات، والمدافئ المعدنية) تعمل على تشويه المجال الكروي المتناظر ليصبح شكلاً بيضاوياً.
							</p>
						</div>
					</div>

					<p class="mt-6 text-sm text-body leading-6">
						حركة <strong>"الرقم 8"</strong> الشهيرة هي خوارزمية هندسية: تدوير الهاتف في الفضاء ثلاثي الأبعاد يُجبر الحساس على أخذ عينات من كل جانب، مما يتيح لمرشح كالمان حساب المصفوفة العكسية وإعادة المجال لشكله الكروي المتناسق.
					</p>
				</div>

				<div class="card-soft p-6 sm:p-8">
					<h3 class="text-display-sm text-ink mb-6">دليل المعايرة الدقيقة في 4 خطوات</h3>
					<ol class="space-y-6">
						
						<li class="flex gap-4">
							<span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-ink text-xs font-mono font-bold text-on-primary">1</span>
							<div>
								<h4 class="text-sm font-semibold text-ink">إبعاد الملحقات المعدنية</h4>
								<p class="mt-1 text-xs text-body leading-5">انزع الأغطية ذات المساند المعدنية أو المغناطيسية، وابتعد مسافة متر ونصف عن الحواسيب المحمولة ومحركات السيارات والسماعات.</p>
							</div>
						</li>

						<li class="flex gap-4">
							<span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-ink text-xs font-mono font-bold text-on-primary">2</span>
							<div>
								<h4 class="text-sm font-semibold text-ink">وضع الهاتف مستوياً باليد</h4>
								<p class="mt-1 text-xs text-body leading-5">احمل الهاتف بشكل أفقي مستوٍ في راحة يدك والشاشة للأعلى وموازية للأرض لالتقاط أقصى شدة للمجال الأفقي.</p>
							</div>
						</li>

						<li class="flex gap-4">
							<span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-ink text-xs font-mono font-bold text-on-primary">3</span>
							<div>
								<h4 class="text-sm font-semibold text-ink">رسم شكل 8 ثلاثي الأبعاد</h4>
								<p class="mt-1 text-xs text-body leading-5">حرّك معصمك ليرسم الهاتف علامة اللانهاية (∞) لمدة 8 إلى 10 ثوانٍ مع إمالته للأمام والخلف حتى يضيء المؤشر بالأخضر.</p>
							</div>
						</li>

						<li class="flex gap-4">
							<span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-ink text-xs font-mono font-bold text-on-primary">4</span>
							<div>
								<h4 class="text-sm font-semibold text-ink">المطابقة مع موقع الشمس</h4>
								<p class="mt-1 text-xs text-body leading-5">في الأيام المشمسة، راجع مؤشر الشمس الأصفر على إطار البوصلة: إذا تطابق مع موقع الشمس بالسماء، فبوصلتك معايرة بنسبة 100%.</p>
							</div>
						</li>
					</ol>
				</div>
			</div>
		</div>
	</section>

	<!-- ─── Comparative Sensor Technology Matrix ───────────── -->
	<section id="compare" class="border-t border-hairline bg-canvas scroll-mt-16">
		<div class="mx-auto max-w-[1200px] px-4 py-20 sm:px-6 md:py-28">
			<div class="mx-auto max-w-3xl text-center">
				<p class="eyebrow">مقارنة الأجهزة الملاحية</p>
				<h2 class="mt-3 text-display-lg text-ink">مقارنة بين تقنيات البوصلات الحديثة</h2>
				<p class="mt-4 text-body-lg text-body">
					تعرف على الخصائص الفيزيائية ومحددات كل فئة لاختيار الأداة المناسبة لظروف رحلتك:
				</p>
			</div>

			<div class="mt-12 overflow-x-auto">
				<table class="w-full border-collapse text-sm">
					<caption class="sr-only">مصفوفة مقارنة حساسات وتقنيات التوجيه الملاحي</caption>
					<thead>
						<tr class="border-b border-hairline-strong text-left">
							<th scope="col" class="py-3.5 pr-4 font-semibold text-ink">التقنية</th>
							<th scope="col" class="py-3.5 pr-4 font-semibold text-ink">المبدأ الفيزيائي</th>
							<th scope="col" class="py-3.5 pr-4 font-semibold text-ink">الدقة المعتادة</th>
							<th scope="col" class="py-3.5 pr-4 font-semibold text-ink">أبرز المزايا</th>
							<th scope="col" class="py-3.5 font-semibold text-ink">المحددات البيئية</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-hairline">
						{compassTechComparison.map((c) => (
							<tr class="hover:bg-canvas-soft/40 transition-colors align-top">
								<td class="py-4 pr-4 font-medium text-ink">{c.tech}</td>
								<td class="py-4 pr-4 text-xs text-body leading-5">{c.operatingPrinciple}</td>
								<td class="py-4 pr-4 font-mono text-xs font-semibold text-link">{c.accuracy}</td>
								<td class="py-4 pr-4 text-xs text-body leading-5">{c.advantages}</td>
								<td class="py-4 text-xs text-mute leading-5">{c.limitations}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>
	</section>

	<!-- ─── The 16-Point Compass Rose Reference ─────────────── -->
	<section id="rose" class="border-t border-hairline bg-canvas scroll-mt-16">
		<div class="mx-auto max-w-[1200px] px-4 py-20 sm:px-6 md:py-28">
			<div class="mx-auto max-w-3xl text-center">
				<p class="eyebrow">مرجع خرائطي</p>
				<h2 class="mt-3 text-display-lg text-ink">وردة البوصلة البحرية ذات الـ 16 اتجاهاً</h2>
				<p class="mt-4 text-body-lg text-body">
					الدرجات والتقسيمات الزاوية والقطاعات البحرية والأرصادية الدولية القياسية من 0.0° إلى 360.0°.
				</p>
			</div>

			<div class="mx-auto mt-12 max-w-4xl grid grid-cols-2 sm:grid-cols-4 gap-4">
				{compassRose.map((c) => (
					<div class="card p-4 flex flex-col justify-between">
						<div class="flex items-center justify-between">
							<span class="font-mono text-base font-bold text-ink">{c.point}</span>
							<span class="font-mono text-xs font-semibold text-link">{c.deg}</span>
						</div>
						<div class="mt-3">
							<p class="text-xs font-medium text-ink">{c.name}</p>
							<p class="text-[11px] text-mute">{c.quadrant}</p>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- ─── Comprehensive FAQ Section (10 In-Depth Items) ──── -->
	<section id="faq" class="border-t border-hairline bg-canvas scroll-mt-16">
		<div class="mx-auto max-w-3xl px-4 py-20 sm:px-6 md:py-28">
			<p class="eyebrow text-center">الأسئلة الأكثر شيوعاً</p>
			<h2 class="mt-3 text-center text-display-lg text-ink">كل ما تحتاج معرفته عن الملاحة بالبوصلة</h2>
			<p class="mt-4 text-center text-body leading-relaxed">
				إجابات تقنية وافية حول حساسات المغناطيسية، والجيوديسيا، واستخدام البوصلة عبر المتصفح.
			</p>

			<div class="mt-12 space-y-4">
				{faq.map((f) => (
					<details class="card overflow-hidden group">
						<summary class="flex cursor-pointer items-center justify-between gap-4 px-6 py-4.5 text-sm font-semibold text-ink group-open:border-b group-open:border-hairline transition-colors">
							<span>{f.q}</span>
							<svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0 text-mute group-hover:text-ink transition-transform duration-200" fill="none" aria-hidden="true">
								<path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</summary>
						<p class="px-6 py-5 text-sm text-body leading-7 bg-canvas-soft/20">{f.a}</p>
					</details>
				))}
			</div>
		</div>
	</section>

	<!-- ─── Call to Action Banner ──────────────────────────── -->
	<section class="border-t border-hairline bg-ink text-on-primary">
		<div class="mx-auto max-w-[1200px] px-4 py-20 text-center sm:px-6 md:py-24">
			<p class="font-mono text-xs uppercase tracking-[0.08em] text-on-primary/60">ملاحة عبر المتصفح</p>
			<h2 class="mt-4 text-display-lg text-on-primary">هل أنت مستعد لتحديد وجهتك؟</h2>
			<p class="mx-auto mt-3 max-w-xl text-body-lg text-on-primary/75">
				شغّل بوصلة المتصفح الآن لتوجيه مباشر وفائق الدقة — مجاناً، بخصوصية كاملة، ومن جهازك مباشرة.
			</p>
			<div class="mt-8 flex flex-wrap items-center justify-center gap-3">
				<a href="/ar/compass/" class="btn-primary bg-on-primary text-primary hover:opacity-90">بدء البوصلة المباشرة</a>
				<a href="/ar/level/" class="btn-secondary text-on-primary border-on-primary/30 hover:bg-on-primary/10">تجربة ميزان الماء</a>
			</div>
		</div>
	</section>

	<!-- Structured Data for FAQ Schema -->
	<script type="application/ld+json" set:html={JSON.stringify({
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: faq.map((f) => ({
			'@type': 'Question',
			name: f.q,
			acceptedAnswer: {
				'@type': 'Answer',
				text: f.a,
			},
		})),
	})} />
</Layout>

