---
import Layout from '../../layouts/Layout.astro';
import Compass from '../../components/Compass.astro';

const faq = [
	{
		q: 'ما هي بوصلة أون لاين؟',
		a: 'بوصلة أون لاين هي بوصلة رقمية تعمل داخل متصفح الويب بدلاً من تطبيق منفصل. تقرأ المقياس المغناطيسي ومقياس التسارع والجيروسكوب في هاتفك وتحوّلها إلى اتجاه حي بالدرجات — دون أي تحميل. افتح صفحة كهذه، وامنح إذن الوصول إلى المستشعرات، وسيتحدّث المقياس في الوقت الحقيقي أثناء دورانك.',
	},
	{
		q: 'كيف أستخدم بوصلة أون لاين على هاتفي؟',
		a: 'افتح هذه الصفحة على هاتفك، واضغط «تفعيل البوصلة الحية»، وأمسك الجهاز مستوياً في راحة يدك. يظهر الاتجاه أسفل المقياس بالدرجات وكنقطة بوصلة. لأدق النتائج، حرّك الهاتف على شكل ثمانية لضبط المقياس المغناطيسي، وأبعده عن المعادن والمغناطيسات.',
	},
	{
		q: 'هل بوصلة أون لاين دقيقة؟',
		a: 'بوصلة الهاتف المضبوطة دقيقة عادةً في حدود درجة إلى 5 درجات في الخارج. المقياس المغناطيسي نفسه حساس، وقد تؤثر المعادن القريبة أو الأجهزة الإلكترونية أو غلاف الهاتف المغناطيسي في دقته. بمجرد الضبط والابتعاد عن مصادر التداخل، تتطابق القراءات عادةً مع بوصلة فيزيائية في حدود درجتين.',
	},
	{
		q: 'ما الفرق بين الشمال الحقيقي والشمال المغناطيسي؟',
		a: 'الشمال المغناطيسي هو الاتجاه الذي يشير إليه مقياس هاتفك — فهو يتبع مجال الأرض المغناطيسي الذي يتغيّر كل عام. والشمال الحقيقي هو القطب الشمالي الجغرافي الذي تستخدمه الخرائط. والزاوية بينهما تُسمى الانحراف المغناطيسي، وتصحّح هذه الأداة له تلقائياً بحيث يتوافق اتجاهك مع الخريطة.',
	},
	{
		q: 'ما هو الانحراف المغناطيسي؟',
		a: 'الانحراف المغناطيسي هو الزاوية بين الشمال المغناطيسي والشمال الحقيقي في موقع معيّن. يتراوح عالمياً بين نحو −30° و+30° ويتغيّر ببطء مع الوقت. في لندن يقارب الصفر، بينما قد يتجاوز 15° في أجزاء من كندا. ولأنه يتفاوت حسب المكان، فإن تصحيح الانحراف الدقيق عبر GPS مهم كلما اتبعت مساراً.',
	},
	{
		q: 'لماذا تقفز إبرة البوصلة أو تدور؟',
		a: 'المقياس المغناطيسي أداة حساسة. أغلفة الهاتف المغناطيسية والمكبرات والحواسيب والطاولات المعدنية ولوحات القيادة والمباني ذات الهياكل الفولاذية كلها تلوّي المجال المغناطيسي حولك. ابتعد عنها، وأمسك الهاتف مستوياً، وحرّكه على شكل ثمانية لإعادة الضبط. وحركة بضع درجات في الأماكن المغلقة أمر طبيعي.',
	},
	{
		q: 'كيف أضبط بوصلة هاتفي؟',
		a: 'أمسك الهاتف مستوياً، ثم دوّره ببطء على شكل ثمانية عدة مرات مع إبقاء الشاشة للأعلى. يمنح ذلك المقياس المغناطيسي قراءات كاملة ليضبط نفسه عليها. ثم اثبت للحظة. أعد العملية متى بدا الاتجاه غير مستقر.',
	},
	{
		q: 'هل تعمل بوصلة أون لاين دون اتصال، وعلى الحاسوب المحمول؟',
		a: 'يستمر المقياس في العمل دون اتصال بمجرد تحميل الصفحة، لأن الاتجاه يُولَّد على جهازك. أما الحاسوب المحمول أو المكتبي فلن يعمل على الاتجاهات الحية، إذ لا تحتوي معظم هذه الأجهزة على مقياس مغناطيسي. استخدم هاتفاً أو جهازاً لوحياً؛ وما زال الحاسوب يعرض المقياس التجريبي وبيانات الشمس والقمر.',
	},
	{
		q: 'هل تطلب بوصلة أون لاين موقعي، وهل هي خاصة؟',
		a: 'الموقع اختياري، ويُستخدم فقط لحساب الانحراف المغناطيسي واتجاه القبلة وموضع الشمس. تجري كل الحسابات محلياً في متصفحك — فلا حساب ولا خادم خلفي ولا تحليلات. لا تغادر إحداثياتك جهازك أبداً، ويمكنك دائماً إدخالها يدوياً بدلاً من ذلك.',
	},
	{
		q: 'هل يمكنني استخدام بوصلة أون لاين لتحديد القبلة؟',
		a: 'نعم. يستخدم محدد القبلة إحداثياتك لحساب اتجاه الدائرة الكبرى إلى الكعبة في مكة بدقة تصل إلى الدرجة، بالإضافة إلى المسافة. ويمكنك بعد ذلك اتباع هذا الاتجاه على مقياس البوصلة الحي للالتفات نحوه.',
	},
	{
		q: 'كيف أجد الشمال بدون بوصلة؟',
		a: 'في نصف الكرة الشمالي تكون الشمس جنوباً تماماً عند الظهيرة المحلية، لذا تُلقي ظلالاً تتجه نحو الشمال. وفي الليل يقع النجم القطبي (نجم الشمال) فوق الشمال الحقيقي تقريباً. تعطيك أداة موضع الشمس في هذا الموقع سمت الشمس الدقيق لموقعك ووقتك، وهو تحقق موثوق لأي بوصلة.',
	},
	{
		q: 'هل أحتاج إلى تثبيت تطبيق لاستخدام هذه البوصلة؟',
		a: 'لا. كل شيء يعمل في المتصفح، فلا شيء لتحميله، ولا متجر تطبيقات، ولا تسجيل، ولا تحديثات لإدارتها. وتعمل بالطريقة نفسها على آيفون وأندرويد ومعظم الأجهزة اللوحية.',
	},
	{
		q: 'هل بوصلة أون لاين مجانية؟',
		a: 'نعم، إنها مجانية تماماً دون مستويات مدفوعة أو جدران دفع. كل أداة في الموقع — البوصلة وإحداثيات GPS ومحدد القبلة وحاسبة الاتجاه وموضع الشمس واتجاه الشمس والقمر — مجانية للاستخدام.',
	},
	{
		q: 'إلى أي جهة يتّجه منزلي أو نافذتي؟',
		a: 'قف عند النافذة متجهاً إلى الخارج، وأمسك هاتفك مستوياً، واقرأ الاتجاه. الشمال 0°، والشرق 90°، والجنوب 180°، والغرب 270°. يستخدم البستانيون هذا لتخطيط أشعة الشمس، ويستخدمه المصورون لتوقّع مكان شروق الشمس وغروبها.',
	},
	{
		q: 'هل يمكنني استخدام هاتفي كبوصلة؟',
		a: 'نعم. تحتوي الهواتف الحديثة على مقياس مغناطيسي، ويحوّل هذا الموقع ذلك المستشعر إلى بوصلة مباشرة في متصفحك — بدون تحميل تطبيق أو تثبيت أي شيء. وحتى لو لم يكن في هاتفك تطبيق بوصلة مخصص، فالمستشعر مدمج بداخله.',
	},
	{
		q: 'أين البوصلة في هاتفي، وأي الهواتف تحتوي على حسّاس بوصلة؟',
		a: 'كثير من الهواتف لا تحتوي على تطبيق بوصلة مخصص، لكن الحسّاس مدمج. تحتوي كل هواتف آيفون تقريباً منذ طراز 3GS ومعظم هواتف أندرويد على مقياس مغناطيسي، لذا تعمل بوصلة أون لاين على أي جهاز حديث تقريباً. ويمكنك أيضاً رؤية بوصلة صغيرة في أعلى يمين خريطة جوجل.',
	},
];

const declinationExamples = [
	{ place: 'لندن، المملكة المتحدة', value: '≈ 0°' },
	{ place: 'باريس، فرنسا', value: '≈ +1° شرقاً' },
	{ place: 'نيويورك، الولايات المتحدة', value: '≈ −13° غرباً' },
	{ place: 'تورونتو، كندا', value: '≈ −11° غرباً' },
	{ place: 'لوس أنجلوس، الولايات المتحدة', value: '≈ +12° شرقاً' },
	{ place: 'أنكوريج، الولايات المتحدة', value: '≈ +15° شرقاً' },
	{ place: 'سيدني، أستراليا', value: '≈ +12° شرقاً' },
	{ place: 'ساو باولو، البرازيل', value: '≈ −23° غرباً' },
	{ place: 'كيب تاون، جنوب أفريقيا', value: '≈ −25° غرباً' },
	{ place: 'طوكيو، اليابان', value: '≈ −8° غرباً' },
];

const compassRose = [
	{ point: 'N', deg: '0°' },
	{ point: 'NNE', deg: '22.5°' },
	{ point: 'NE', deg: '45°' },
	{ point: 'ENE', deg: '67.5°' },
	{ point: 'E', deg: '90°' },
	{ point: 'ESE', deg: '112.5°' },
	{ point: 'SE', deg: '135°' },
	{ point: 'SSE', deg: '157.5°' },
	{ point: 'S', deg: '180°' },
	{ point: 'SSW', deg: '202.5°' },
	{ point: 'SW', deg: '225°' },
	{ point: 'WSW', deg: '247.5°' },
	{ point: 'W', deg: '270°' },
	{ point: 'WNW', deg: '292.5°' },
	{ point: 'NW', deg: '315°' },
	{ point: 'NNW', deg: '337.5°' },
];

const compassTypes = [
	{
		type: 'بوصلة مغناطيسية تقليدية',
		measures: 'تقيس مجال الأرض المغناطيسي بإبرة عائمة',
		best: 'موثوقية دون اتصال، وبدون بطاريات، وللتعليم',
		limitation: 'تحتاج سطحاً مستوياً، ولا تصحّح الانحراف، ومستشعر واحد فقط',
	},
	{
		type: 'بوصلة مستشعرات الهاتف (هذا الموقع)',
		measures: 'مقياس مغناطيسي مع مقياس تسارع وجيروسكوب، مدموجة معاً',
		best: 'اتجاه حي بالدرجات، وتعويض الميل، ومحاذاة مع الخرائط',
		limitation: 'حساسة للمعادن والمغناطيسات القريبة',
	},
	{
		type: 'بوصلة مسار GPS',
		measures: 'اتجاه الحركة المستنتج من تغيّر موضع GPS',
		best: 'الملاحة أثناء الحركة، وتعمل بدون مقياس مغناطيسي',
		limitation: 'تعمل فقط أثناء الحركة؛ وعديمة الفائدة عند الوقوف',
	},
	{
		type: 'البوصلة الجيروسكوبية',
		measures: 'دوران الأرض بجيروسكوبات سريعة الدوران',
		best: 'السفن والطائرات، ولا تتأثر بالحقول المغناطيسية',
		limitation: 'كبيرة ومكلفة وبطيئة الاستقرار',
	},
];
---

<Layout
	path="/ar/"
	title="بوصلة أون لاين — أداة مجانية حية للعثور على الشمال"
	description="بوصلة أون لاين مجانية للعثور على الشمال من موقعك. اتجاه حي مع الشمال الحقيقي والمغناطيسي، والانحراف، ومحدد القبلة، وحاسبة الاتجاه، وموضع الشمس — بدون تثبيت، تعمل على أي هاتف."
	keywords="بوصلة أون لاين, أداة بوصلة أون لاين, بوصلة أون لاين مجانية, بوصلة أون لاين جوجل, بوصلة أون لاين مجاناً, بوصلة أون لاين للعثور على الشمال, اتجاه بوصلة أون لاين, بوصلة أون لاين هندسية, أداة بوصلة أون لاين هندسية, بوصلة أون لاين للهندسة, بوصلة أون لاين رياضيات, أداة بوصلة أون لاين مجانية, بوصلة أون لاين للقبلة, بوصلة أون لاين حية, بوصلة كعبة أون لاين للعثور على الشمال من موقعي, محدد قبلة بوصلة أون لاين"
>
	<!-- ─── Hero ───────────────────────────────────────────── -->
	<section id="compass" class="relative overflow-hidden">
		<div class="mesh-gradient" aria-hidden="true"></div>
		<div class="relative mx-auto max-w-[1200px] px-4 pt-12 pb-20 text-center sm:px-6 md:pt-20 md:pb-28">
			<Compass />
			<div class="mx-auto mt-10 max-w-3xl md:mt-14">
				<div class="badge mx-auto">مجاني · خاص · بدون تثبيت</div>

				<h1 class="mx-auto mt-6 max-w-3xl text-[36px] leading-[40px] text-ink sm:text-display-xl md:text-[56px] md:leading-[56px]">بوصلة تشير إلى الشمال الحقيقي، لا إلى المغناطيسي فقط.</h1>

				<p class="mx-auto mt-4 max-w-xl text-body-lg text-body">اتجاه فوري للجهاز مع تصحيح تلقائي للانحراف المغناطيسي، وإحداثيات GPS، واتجاه القبلة،
				وموضع الشمس — كل ذلك في متصفحك. لا شيء لتثبيته، ولا شيء يُرفع إلى أي خادم.</p>

				<div class="mt-8 flex flex-wrap items-center justify-center gap-3">
					<a href="/ar/location/" class="btn-primary">حدد موقعي</a>
					<a href="/ar/compass/" class="btn-secondary">افتح البوصلة</a>
				</div>
			</div>
		</div>
	</section>

	<!-- ─── Feature strip ──────────────────────────────────── -->
	<section class="border-y border-hairline bg-canvas">
		<div
			class="mx-auto grid max-w-[1200px] grid-cols-1 gap-px overflow-hidden px-4 py-12 sm:grid-cols-3 sm:px-6"
		>
			<div class="p-4">
				<p class="eyebrow mb-2">الشمال الحقيقي مقابل المغناطيسي</p>
				<p class="text-sm text-body leading-6">
					يُحسب الانحراف المغناطيسي تلقائياً من النموذج المغناطيسي العالمي — شاهد
					الاتجاهين بنظرة واحدة.
				</p>
			</div>
			<div class="p-4">
				<p class="eyebrow mb-2">الخصوصية أولاً</p>
				<p class="text-sm text-body leading-6">
					كل معالجة المستشعرات تحدث على الجهاز. لا حسابات، ولا تتبع، ولا شيء يغادر
					متصفحك أبداً.
				</p>
			</div>
			<div class="p-4">
				<p class="eyebrow mb-2">تعمل في كل مكان</p>
				<p class="text-sm text-body leading-6">
					كروم وسفاري وفايرفوكس على iOS وأندرويد، مع بديل اتجاه GPS عند
					التحرك.
				</p>
			</div>
		</div>
	</section>

	<!-- ─── Tools grid ─────────────────────────────────────── -->
	<section id="tools" class="scroll-mt-16">
		<div class="mx-auto max-w-[1200px] px-4 py-20 sm:px-6 md:py-28">
			<p class="eyebrow">الأدوات</p>
			<h2 class="mt-3 max-w-2xl text-display-lg text-ink">
				بوصلة واحدة، وكل اتجاه تحتاجه.
			</h2>
			<p class="mt-3 max-w-xl text-body-lg text-body">
				ست أدوات متخصصة، كل منها في صفحة خاصة به، وكلها تعمل محلياً على جهازك.
			</p>

			<div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
				<a href="/ar/compass/" class="card-lg group p-6 transition-shadow hover:shadow-modal">
					<p class="eyebrow mb-2">بوصلة</p>
					<h3 class="text-display-sm text-ink group-hover:text-link transition-colors">اتجاه حي</h3>
					<p class="mt-2 text-sm text-body leading-6">
						مقياس 360° في الوقت الحقيقي مع إبرة سلسة، والشمال المغناطيسي والحقيقي،
						وملاحظات دقة حية.
					</p>
				</a>
				<a href="/ar/location/" class="card-lg group p-6 transition-shadow hover:shadow-modal">
					<p class="eyebrow mb-2">الموقع</p>
					<h3 class="text-display-sm text-ink group-hover:text-link transition-colors">إحداثيات GPS</h3>
					<p class="mt-2 text-sm text-body leading-6">
						خط العرض وخط الطول والارتفاع والدقة بالدرجات العشرية وDMS — مع النسخ
						والمشاركة والفتح في الخرائط.
					</p>
				</a>
				<a href="/ar/qibla/" class="card-lg group p-6 transition-shadow hover:shadow-modal">
					<p class="eyebrow mb-2">القبلة</p>
					<h3 class="text-display-sm text-ink group-hover:text-link transition-colors">اتجاه مكة</h3>
					<p class="mt-2 text-sm text-body leading-6">
						اتجاه ومسافة الدائرة الكبرى إلى الكعبة من إحداثياتك، بدقة
						درجة واحدة.
					</p>
				</a>
				<a href="/ar/bearing/" class="card-lg group p-6 transition-shadow hover:shadow-modal">
					<p class="eyebrow mb-2">الاتجاه</p>
					<h3 class="text-display-sm text-ink group-hover:text-link transition-colors">حاسبة المسار</h3>
					<p class="mt-2 text-sm text-body leading-6">
						الاتجاه والمسافة على الدائرة الكبرى بين أي نقطتين — مثالية للملاحة
						والتخطيط للمسار.
					</p>
				</a>
				<a href="/ar/sun/" class="card-lg group p-6 transition-shadow hover:shadow-modal">
					<p class="eyebrow mb-2">الشمس</p>
					<h3 class="text-display-sm text-ink group-hover:text-link transition-colors">موضع الشمس</h3>
					<p class="mt-2 text-sm text-body leading-6">
						السمت الشمسي والارتفاع الآن، بالإضافة إلى شروق الشمس والظهيرة الشمسية وغروبها
						لأي موقع.
					</p>
				</a>
				<a href="/ar/sun-moon/" class="card-lg group p-6 transition-shadow hover:shadow-modal">
					<p class="eyebrow mb-2">الشمس والقمر</p>
					<h3 class="text-display-sm text-ink group-hover:text-link transition-colors">اتجاه الشمس والقمر</h3>
					<p class="mt-2 text-sm text-body leading-6">
						يُرسم سمت الشمس والقمر مباشرةً على مقياس البوصلة الحي، فيمكنك العثور على
						أيّ منهما في السماء بالالتفات نحو العلامة.
					</p>
				</a>
				<div class="card-soft flex flex-col justify-center p-6">
					<p class="text-sm text-body leading-6">
						لا حسابات. لا متتبّعات. كل عملية حسابية تعمل في متصفحك وتُحذف
						في اللحظة التي تغادر فيها.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- ─── How it works ───────────────────────────────────── -->
	<section id="how-it-works" class="border-y border-hairline bg-canvas scroll-mt-16">
		<div class="mx-auto max-w-[1200px] px-4 py-20 sm:px-6 md:py-28">
			<p class="eyebrow">كيف يعمل</p>
