import Layout from '../../layouts/Layout.astro';
import Compass from '../../components/Compass.astro';

const faq = [
	{
		"q": "ما هو الاتجاه الذي أواجهه باستخدام البوصلة الإلكترونية عبر الإنترنت؟",
		"a": "لمعرفة اتجاهك الحالي، أمسك هاتفك بشكل أفقي مستوٍ في راحة يدك وانظر إلى أعلى قرص البوصلة. يُظهر الرقم الكبير سمتك بالدرجات (0° إلى 360°) والحرف يوضح الاتجاه: 0° شمال (N)، 90° شرق (E)، 180° جنوب (S)، 270° غرب (W). إذا أشارت البوصلة إلى 45° فأنت تواجه الشمال الشرقي (NE)؛ وإذا أشارت إلى 225° فأنت تواجه الجنوب الغربي (SW)."
	},
	{
		"q": "البوصلة الإلكترونية: أين اتجاه الشمال وأين يقع شمالي؟",
		"a": "في هذه البوصلة الرقمية، يشير رأس السهم الأحمر دائماً نحو الشمال الحقيقي (0°/360°). أمسك الهاتف مسطحاً؛ الاتجاه الذي يشير إليه الرأس الأحمر هو اتجاه الشمال بالنسبة لموقعك. إذا كان السهم للأمام مباشرة فأنت تواجه الشمال؛ وإذا كان لليسار فالشمال على يسارك."
	},
	{
		"q": "إلى أي جهة أتجه وما هو زاويتي على البوصلة؟",
		"a": "يتحدد اتجاهك من خلال الحافة العلوية لهاتفك. أثناء دوران جسمك، تدور حلقة البوصلة بسلاسة تحت علامة القياس العلوية لتظهر الاتجاهات الأصلية (شمال، جنوب، شرق، غرب) والدرجات بدقة متناهية."
	},
	{
		"q": "كيف أستخدم البوصلة عبر الإنترنت؟",
		"a": "الاستخدام سهل جداً: (1) افتح trueonlinecompass.com في متصفحك (سفاري أو كروم). (2) اضغط \"تفعيل البوصلة المباشرة\" وامنح إذن الحساسات والموقع. (3) احمل الهاتف أفقياً بعيداً عن المعادن. (4) استدر حول نفسك وسيدور القرص بزاوية 360 درجة بسرعة 60 إطاراً في الثانية."
	},
	{
		"q": "هل يمكنني استخدام هاتفي كبوصلة؟",
		"a": "نعم. تحتوي جميع الهواتف الذكية الحديثة على مقياس مغناطيسي ثلاثي المحاور MEMS (حساس مغناطيسي إلكتروني) مدمج مع مقياس تسارع وجيروسكوب. بوصلتنا تقرأ هذه الحساسات مباشرة عبر المتصفح دون الحاجة لتثبيت أي تطبيق."
	},
	{
		"q": "هل يستطيع هاتفي تحديد وجهتي والجهة التي أنظر إليها؟",
		"a": "نعم. تعمل خوارزميات دمج الحساسات على دمج بيانات المجال المغناطيسي والجاذبية الأرضية لتحديد وجهتك بدقة تصل إلى 0.1 درجة بالنسبة لأقطاب الأرض."
	},
	{
		"q": "أين أجد البوصلة في جوجل (خرائط جوجل وجوجل كروم)؟",
		"a": "في تطبيق خرائط جوجل على الهاتف، تظهر إبرة بوصلة حمراء وبيضاء صغيرة في الزاوية العلوية عند تدوير الخريطة، وبالنقر عليها تتجه الخريطة للشمال. وفي جوجل كروم لا توجد بوصلة ملء الشاشة مدمجة؛ لذلك يمكنك فتح trueonlinecompass.com في كروم للوصول لبوصلة كاملة مع ميزان الماء."
	},
	{
		"q": "أين توجد البوصلة في هاتفي وكيف أراها على الجوال؟",
		"a": "في هواتف آيفون، توفر أبل تطبيق \"البوصلة\" مسبق التثبيت في مجلد الأدوات، أو افتح هذا الموقع في سفاري. وفي أندرويد افتح الموقع في جوجل كروم. الحساس الفعلي عبارة عن شريحة ميكروية مدمجة داخل اللوحة الأم للهاتف."
	},
	{
		"q": "ما هي الهواتف المحمولة التي تحتوي على حساس البوصلة؟",
		"a": "تقريباً جميع هواتف آيفون (من آيفون 3GS حتى آيفون 16 / برو) ومعظم هواتف أندرويد المتوسطة والرائدة (سلسلة سامسونج جالاكسي S و A، جوجل بكسل، شاومي، موتورولا) تحتوي على حساس مغناطيسي."
	},
	{
		"q": "كيف أعرف الاتجاهات بدون بوصلة عبر الإنترنت؟",
		"a": "يمكنك الاستدلال بالطبيعة: (1) الشمس والظلال: تشرق الشمس شرقاً وتكون في اتجاه الجنوب وقت الظهيرة (في النصف الشمالي) وتغرب غرباً. يتحرك رأس ظل العصا من الغرب إلى الشرق. (2) طريقة الساعة ذات العقارب: وجه عقرب الساعات للشمس؛ منتصف الزاوية بين العقرب والرقم 12 يشير للجنوب. (3) النجوم ليلاً: حدد النجم القطبي من بنات نعش الكبرى لمعرفة الشمال الحقيقي. (4) حاسبة الشمس الرقمية: استخدم أداة مسار الشمس المتوفرة في موقعنا."
	}
];

