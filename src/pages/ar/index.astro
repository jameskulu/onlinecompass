---
import Layout from '../../layouts/Layout.astro';
import Compass from '../../components/Compass.astro';

const faq = [
	{
		"q": "ما هي البوصلة الرقمية عبر الإنترنت وكيف تعمل داخل المتصفح؟",
		"a": "البوصلة الرقمية عبر الإنترنت هي تطبيق ويب يقرأ الحساسات الفيزيائية MEMS (المغناطيسية والتسارع والجيروسكوب) المدمجة بهاتفك عبر واجهة W3C DeviceOrientation API. وبدون تحميل أي تطبيق، ينفذ المتصفح معادلات رياضية لحظية لتعويض ميلان الهاتف بالاعتماد على الجافاسكريبت ليمنحك اتجاهاً مستقراً من 0° إلى 360°."
	},
	{
		"q": "ما الفرق بين الشمال الحقيقي (True North) والشمال المغناطيسي (Magnetic North)؟",
		"a": "الشمال الحقيقي يشير نحو القطب الشمالي الجغرافي الواقع على محور دوران الأرض حيث تلتقي كافة خطوط الطول، وهو المعتمد في الخرائط وأقمار GPS. بينما الشمال المغناطيسي هو الموقع في المحيط المتجمد الشمالي الذي تدخل عنده خطوط المجال الجيومغناطيسي عمودياً نحو باطن الأرض. ويُسمى الفارق الزاوي بينهما بالانحراف المغناطيسي."
	},
	{
		"q": "ما هو الانحراف المغناطيسي ولماذا يُعد ضرورياً للملاحة الدقيقة؟",
		"a": "الانحراف المغناطيسي هو الزاوية الأفقية بين الشمال المغناطيسي والشمال الحقيقي عند إحداثياتك. فمثلاً في نيويورك يبلغ حوالي −13° غرباً وفي لوس أنجلوس +12° شرقاً. تدمج بوصلتنا النموذج المغناطيسي العالمي (WMM) الصادر عن وكالة NOAA لتعديل هذا الفارق تلقائياً ومطابقة قراءتك مع الخرائط الطبوغرافية."
	},
	{
		"q": "كيف أقوم بمعايرة بوصلة هاتفي للحصول على أعلى دقة ممكنة؟",
		"a": "امسك هاتفك أفقياً في راحة يدك واجعله موازياً للأرض والشاشة متجهة للأعلى، ثم حركه بسلاسة في الهواء راسمًا شكل رقم ثمانية بالإنجليزية أو علامة اللانهاية (∞) لمدة 5 إلى 10 ثوانٍ. تتيح هذه الحركة لمستشعر المغناطيسية ثلاثي المحاور قراءة المجال الأرضي من كل الزوايا وتصفية التشويش المعدني الداخلي للهاتف."
	},
	{
		"q": "لماذا تهتز إبرة البوصلة أو تدور دون توقف؟",
		"a": "القراءات المضطربة ناتجة عن وجود تداخل كهرومغناطيسي قوي بالقرب منك. ابتعد مسافة مترين على الأقل عن الأجسام المعدنية، وأغطية الهواتف التي تحتوي على مغناطيس أو حلقة MagSafe، والحواسيب المحمولة، وحديد تسليح الخرسانة، ولوحات عدادات السيارات، ثم كرر حركة المعايرة على شكل الرقم 8."
	},
	{
		"q": "ما مدى دقة بوصلة الهاتف الذكي مقارنة ببوصلة الرحلات اليدوية؟",
		"a": "عند معايرتها والابتعاد عن المعادن، يحقق حساس المغناطيسية MEMS في الهاتف دقة تتراوح بين ±1° إلى ±3° في الأماكن المفتوحة، وهي دقة تماثل بوصلات الرحلات السائلة. وتتفوق بوصلة الهاتف بوجود تعويض الميلان الرقمي والتصحيح التلقائي للشمال الحقيقي، مع بقاء البوصلة اليدوية خياراً احتياطياً ممتازاً في الجبال."
	},
	{
		"q": "هل تعمل هذه البوصلة دون اتصال بالإنترنت وفي وضع الطيران؟",
		"a": "نعم. تم تصميم المنصة كـ Progressive Web App (PWA) تعمل دون إنترنت. يتم حفظ الشفرات البرمجية ونماذج WMM المغناطيسية في ذاكرة الـ Service Worker لمتصفحك. بمجرد فتح الصفحة لمرة واحدة، تستمر البوصلة والحاسبات في العمل بكفاءة تامة وسط البراري وفي وضع الطيران."
	},
	{
		"q": "لماذا تعرض البوصلة قرصاً تجريبياً عند فتحها من جهاز كمبيوتر مكتبي أو لابتوب؟",
		"a": "تحديد الاتجاه المباشر يتطلب شريحة استشعار فيزيائية للمجال المغناطيسي (Magnetometer). وفي حين تحتوي الهواتف والأجهزة اللوحية على هذه الشريحة، تخلو منها معظم الحواسيب المحمولة والمكتبية. على الكمبيوتر، توفر الأداة واجهة محاكاة تفاعلية وأدوات لحساب حركة الشمس والإحداثيات."
	},
	{
		"q": "كيف تحدد أداة القبلة الاتجاه الدقيق نحو الكعبة المشرفة في مكة؟",
		"a": "تحسب الأداة قوس الدائرة العظمى (المسار الجيوديسي) من إحداثيات موقعك الحالي مباشرة إلى الكعبة المشرفة بمكة المكرمة (21° 25' 21\" شمالاً، 39° 49' 34\" شرقاً) بواسطة حساب المثلثات الكروية. يظهر مؤشر بلون أخضر زمردي على إطار البوصلة ليرشدك بصرياً للتواجه بدقة تامة."
	},
	{
		"q": "كيف أعرف الاتجاه الذي تواجهه شقتي أو شرفتي أو حديقتي؟",
		"a": "قف أمام النافذة أو الشرفة وأنت تحمل هاتفك بشكل أفقي مستوٍ متجهاً للخارج. القراءة بين 315° و45° تعني واجهة شمالية. الواجهة الجنوبية (135°–225°) تضمن أطول فترة سطوع شمسي على مدار العام، بينما الواجهة الشرقية تستقبل شمس الصباح الباكر والغربية تستقبل شمس الظهيرة الدافئة."
	}
];

const declinationExamples = [
	{
