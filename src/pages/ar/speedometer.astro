---
import Layout from '../../layouts/Layout.astro';
import Speedometer from '../../components/Speedometer.astro';
import PageHero from '../../components/PageHero.astro';
import RelatedTools from '../../components/RelatedTools.astro';
---

<Layout
	title="عداد سرعة GPS أونلاين — قياس السرعة والارتفاع مجاناً"
	description="عداد سرعة GPS رقمي ومقياس ارتفاع فائق الدقة أونلاين. تابع سرعتك الحقيقية بوحدات كم/س، ميل/س، عقدة أو م/ث، والارتفاع عن سطح البحر مع عداد المسافات."
	path="/ar/speedometer/"
	keywords="عداد سرعة gps أونلاين, قياس السرعة مجانا, مقياس الارتفاع عن البحر, عداد كم/س مباشر"
>
	<PageHero
		eyebrow="عداد سرعة gps · مقياس ارتفاع"
		title="سرعة وارتفاع دقيقان على أي جهاز."
		description="قس سرعتك الفعلية فوق الأرض والارتفاع عن مستوى سطح البحر بدقة الأقمار الصناعية مع عداد المسافات المدمج."
	>
		<Speedometer />
	</PageHero>

	<section class="border-t border-hairline bg-canvas">
		<div class="mx-auto max-w-3xl px-4 py-20 sm:px-6 md:py-24">
			<p class="eyebrow">عداد سرعة gps · مقياس ارتفاع</p>
			<h2 class="mt-3 text-display-lg text-ink">كيف يعمل عداد السرعة ومقياس الارتفاع عبر GPS</h2>

			<p class="mt-6 text-body-lg text-body">
				يحسب عداد السرعة GPS السرعة الحركية الحقيقية عبر انزياح دوبلر لإشارات الأقمار الصناعية دون التأثر بحجم إطارات السيارة أو تآكلها.
			</p>

			<h3 class="mt-14 text-display-sm text-ink">FAQ</h3>
			<div class="mt-6 space-y-6 text-sm divide-y divide-hairline">
				<div class="pt-6 first:pt-0">
					<h4 class="font-semibold text-ink text-base">لماذا تختلف سرعة السيارة في العداد عن الـ GPS؟</h4>
					<p class="mt-2 text-body leading-6">المعايير الدولية لصناعة السيارات تلزم المصانع بمعايرة عداد السيارة ليعطي قراءة أعلى بـ 2 إلى 5% لتجنب تجاوز السرعات القانونية.</p>
				</div>
				<div class="pt-6">
					<h4 class="font-semibold text-ink text-base">هل يعمل داخل الأنفاق؟</h4>
					<p class="mt-2 text-body leading-6">لا، تتطلب إشارات GPS اتصالاً مباشراً بالسماء المفتوحة ولا تخترق الخرسانة السميكة أو الأنفاق.</p>
				</div>
				<div class="pt-6">
					<h4 class="font-semibold text-ink text-base">هل بيانات موقعي آمنة وخاصة؟</h4>
					<p class="mt-2 text-body leading-6">نعم 100%. جميع العمليات الحسابية تتم محلياً داخل متصفحك ولا تُرسل أي بيانات إلى خوادم خارجية.</p>
				</div>
			</div>
		</div>
	</section>

	<RelatedTools current="/speedometer/" />
</Layout>
