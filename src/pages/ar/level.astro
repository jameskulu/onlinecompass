---
import Layout from '../../layouts/Layout.astro';
import BubbleLevel from '../../components/BubbleLevel.astro';
import PageHero from '../../components/PageHero.astro';
import RelatedTools from '../../components/RelatedTools.astro';
---

<Layout
	title="ميزان ماء رقمي أونلاين — ميزان تسوية وميل مجاني"
	description="ميزان ماء رقمي ومقياس ميل مجاني عبر الإنترنت. قس زوايا الميل والانحدار وسطح الاستواء في الوقت الفعلي باستخدام جيروسكوب هاتفك مع خاصية المعايرة الصفرية."
	path="/ar/level/"
	keywords="ميزان ماء رقمي, مقياس ميل أونلاين, ميزان تسوية مجاني, قياس الزوايا بالهاتف"
>
	<PageHero
		eyebrow="ميزان ماء · مقياس ميل"
		title="ضبط استواء الأسطح بدقة داخل متصفحك."
		description="حول هاتفك الذكي إلى ميزان ماء رقمي فائق الدقة. قس استواء الأسطح الأفقية ورأسية الجدران مع اهتزاز لمسي ومعايرة نقطة الصفر."
	>
		<BubbleLevel />
	</PageHero>

	<section class="border-t border-hairline bg-canvas">
		<div class="mx-auto max-w-3xl px-4 py-20 sm:px-6 md:py-24">
			<p class="eyebrow">ميزان ماء · مقياس ميل</p>
			<h2 class="mt-3 text-display-lg text-ink">كيف تعمل موازين الماء الرقمية ومقاييس الميل</h2>

			<p class="mt-6 text-body-lg text-body">
				يعتمد ميزان الماء الرقمي على مستشعرات التسارع الميكانيكية الدقيقة (MEMS) داخل الهاتف لحساب متجهات الجاذبية الأرضية والانحراف الزاوي بدقة تصل إلى أعشار الدرجة.
			</p>

			<h3 class="mt-14 text-display-sm text-ink">FAQ</h3>
			<div class="mt-6 space-y-6 text-sm divide-y divide-hairline">
				<div class="pt-6 first:pt-0">
					<h4 class="font-semibold text-ink text-base">ما مدى دقة ميزان الماء على الهاتف؟</h4>
					<p class="mt-2 text-body leading-6">مستشعرات الهواتف الحديثة ترصد التغيرات حتى 0.1 درجة، وهي دقة ممتازة للأعمال المنزلية والتركيبات والتخييم.</p>
				</div>
				<div class="pt-6">
					<h4 class="font-semibold text-ink text-base">لماذا يطلب نظام iOS الإذن لاستخدام المستشعرات؟</h4>
					<p class="mt-2 text-body leading-6">يفرض متصفح Safari ذلك لحماية الخصوصية قبل تفعيل بيانات الحركة والاتجاه. لا يتم حفظ أو مشاركة أي بيانات.</p>
				</div>
				<div class="pt-6">
					<h4 class="font-semibold text-ink text-base">هل يعمل بدون اتصال بالإنترنت؟</h4>
					<p class="mt-2 text-body leading-6">نعم! بفضل دعم تطبيقات الويب التقدمية (PWA)، يتم تخزين الأداة محلياً لتعمل في أي مكان بدون شبكة.</p>
				</div>
			</div>
		</div>
	</section>

	<RelatedTools current="/level/" />
</Layout>
