---
import Layout from '../../layouts/Layout.astro';
import SunMoonCompass from '../../components/SunMoonCompass.astro';
import PageHero from '../../components/PageHero.astro';
import RelatedTools from '../../components/RelatedTools.astro';
---

<Layout
	title="اتجاه الشمس والقمر على البوصلة — زاوية سمتية مباشرة"
	description="اعثر على اتجاه الشمس والقمر من مخطط البوصلة. اتجاه مباشر من المستشعرات مع زاوية الشمس السمتية وزاوية القمر السمتية مرسومتين على القرص لأي موقع."
	path="/ar/sun-moon/"
	keywords="اتجاه الشمس, اتجاه القمر, زاوية الشمس السمتية, زاوية القمر السمتية, إيجاد الشمس على البوصلة, موقع الشمس, موقع القمر"
>
	<section class="relative overflow-hidden">
		<div class="mesh-gradient" aria-hidden="true"></div>
		<div class="relative">
			<PageHero
				eyebrow="اتجاه الشمس والقمر"
				title="شاهد الشمس والقمر على البوصلة."
				description="بوصلة هاتف مباشرة مع زاوية الشمس والقمر السمتية مرسومتين مباشرة على القرص. استدر نحو العلامة وستكون تنظر إلى الشمس أو القمر — دون تخمين."
			>
				<SunMoonCompass />
			</PageHero>
		</div>
	</section>

	<section class="border-y border-hairline bg-canvas">
		<div class="mx-auto max-w-[1200px] grid gap-6 px-4 py-16 sm:px-6 md:grid-cols-3">
			<div>
				<p class="eyebrow mb-2">كيف تقرأه</p>
				<p class="text-sm text-body leading-6">
					الإبرة الحمراء تشير إلى الشمال. نقطتان ملونتان على القرص تظهران اتجاه البوصلة للشمس (الكهرماني)
					وللقمر (الأزرق). استدر حتى تواجه نقطة لتنظر إليها مباشرة.
				</p>
			</div>
			<div>
				<p class="eyebrow mb-2">تحديثات مباشرة</p>
				<p class="text-sm text-body leading-6">
					تتغير مواضع علامتي الشمس والقمر تلقائيًا مع تقدم النهار والليل. استخدم موقعك لتطابق الزوايا
					السمتية مع السماء فوقك.
				</p>
			</div>
			<div>
				<p class="eyebrow mb-2">اتجاه، لا مجرد أرقام</p>
				<p class="text-sm text-body leading-6">
					الزوايا السمتية اتجاهات مطلقة. يعرضها القرص فوق اتجاهك الحقيقي، فتبحث عن الشمس أو القمر فورًا،
					حتى خلف الغيوم.
				</p>
			</div>
		</div>
	</section>

	<section class="border-t border-hairline bg-canvas">
		<div class="mx-auto max-w-3xl px-4 py-20 sm:px-6 md:py-24">
			<p class="eyebrow">أداة اتجاه الشمس والقمر</p>
			<h2 class="mt-3 text-display-lg text-ink">اعثر على اتجاه الشمس والقمر من مخطط البوصلة</h2>

			<p class="mt-6 text-body-lg text-body">
				تضع هذه الصفحة <strong class="text-ink font-medium">اتجاه الشمس</strong> و
				<strong class="text-ink font-medium">اتجاه القمر</strong> مباشرة على مخطط بوصلة حي. أينما كانت
				العلامة الكهرمانية أو الزرقاء على القرص فهو اتجاه البوصلة الذي يجب أن تستدير نحوه لترى الشمس أو
				القمر. إنها أسرع طريقة <strong class="text-ink font-medium">لإيجاد الشمس على البوصلة</strong> أو
				تحديد موقع القمر في وضح النهار — دون أي معرفة فلكية.
			</p>
			<p class="mt-4 leading-7">
				تُقاس الزاوية السمتية في اتجاه عقارب الساعة من الشمال الحقيقي: 0° شمال، 90° شرق، 180° جنوب و270°
				غرب. تحسب الأداة الزاوية السمتية الحية لكلا الجسمين لإحداثياتك وترسمها على القرص بجانب اتجاهك
				الحقيقي، فنرى دائمًا الاتجاه الصحيح.
			</p>

			<h3 class="mt-10 text-display-sm text-ink">قراءة الشمس والقمر على القرص</h3>
			<p class="mt-3 leading-7">
				<strong class="text-ink font-medium">العلامة الكهرمانية</strong> هي الشمس و
				<strong class="text-ink font-medium">العلامة الزرقاء</strong> هي القمر. كل منهما يعرض اتجاه الجسم
				بالدرجات وكجهة أساسية، بالإضافة إلى ارتفاعه فوق الأفق. عندما تشير علامة خارج القرص أو تُظهر
				ارتفاعًا منخفضًا، يكون هذا الجسم تحت الأفق — تحت قدميك، غير مرئي.
			</p>
			<p class="mt-4 leading-7">
				تشرق الشمس من الشرق وتغرب من الغرب، لذلك تجتاز علامتها النصف الشمالي من القرص (في نصف الكرة الشمالي)
				من الصباح إلى المساء. يسلك القمر مسارًا مشابهًا لكنه يتأخر نحو 12 درجة كل يوم، ولهذا يتغير موقعه على
				البوصلة من يوم إلى آخر.
			</p>

			<h3 class="mt-10 text-display-sm text-ink">لماذا تستخدم البوصلة لإيجاد الشمس والقمر</h3>
			<p class="mt-3 leading-7">
				اتجاه البوصلة عملي أكثر بكثير من مجموعة من الإحداثيات السماوية. سواء كنت تصور، أو تخطط للظل، أو
				تضبط طبق قمر صناعي، أو تتحقق من أين سيسقط الضوء، أو ببساطة تريد أن تعرف أين القمر هذه الليلة —
				رؤية الاتجاه كنقطة على البوصلة يجعلها مفيدة فورًا: استدر، فها هو.
			</p>
			<p class="mt-4 leading-7">
				يعمل كل شيء محليًا على متصفحك ولا يتم رفع أي بيانات. مع
				<a href="/ar/sun/" class="text-link underline decoration-link/30 hover:decoration-link">حاسبة موضع شمس</a>
				و
				<a href="/ar/compass/" class="text-link underline decoration-link/30 hover:decoration-link">بوصلة أون لاين</a>,
				تحصل على الصورة الكاملة لما فوقك أينما كنت.
			</p>
		</div>
	</section>

	<RelatedTools current="/sun-moon/" />
</Layout>