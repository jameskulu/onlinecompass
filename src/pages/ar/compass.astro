---
import Layout from '../../layouts/Layout.astro';
import Compass from '../../components/Compass.astro';
import PageHero from '../../components/PageHero.astro';
import RelatedTools from '../../components/RelatedTools.astro';
---

<Layout
	title="أداة بوصلة أون لاين — اتجاه حي للشمال الحقيقي والمغناطيسي"
	description="استخدم أداة بوصلة أون لاين مجانية này للحصول على اتجاه 360° حي على هاتفك. اتجاه بوصلة أون لاين مع الشمال المغناطيسي وال אמיתי، وانحراف مغناطيسي تلقائي، وملاحظات دقة، ودليل ضبط."
	path="/ar/compass/"
	keywords="بوصلة أون لاين, أداة بوصلة أون لاين, أداة بوصلة أون لاين مجانية, بوصلة أون لاين حية, اتجاه بوصلة أون لاين, بوصلة أون لاين للعثور على الشمال, بوصلة أون لاين مجانية"
>
	<section class="relative overflow-hidden">
		<div class="mesh-gradient" aria-hidden="true"></div>
		<div class="relative">
			<PageHero
				eyebrow="بوصلة حية"
				title="هاتفك هو البوصلة."
				description="امنح إذن الوصول للحسّاس وتصبح هذه الصفحة هاتفك بوصلة رقمية دقيقة — مقياس 360°، إبرة سلسة، وقراءات الشمال المغناطيسي والحقيقي."
			>
				<Compass />
			</PageHero>
		</div>
	</section>

	<section class="border-y border-hairline bg-canvas">
		<div class="mx-auto max-w-[1200px] grid gap-6 px-4 py-16 sm:px-6 md:grid-cols-3">
			<div>
				<p class="eyebrow mb-2">كيف تقرأها</p>
				<p class="text-sm text-body leading-6">
					الطرف الأحمر من الإبرة يشير دائماً إلى الشمال. دور بدنك حتى يلتقي العلامة الثابتة
					في الأعلى بالاتجاه الذي تريده — يُقرأ الاتجاه في الأعلى.
				</p>
			</div>
			<div>
				<p class="eyebrow mb-2">الشمال الحقيقي مقابل المغناطيسي</p>
				<p class="text-sm text-body leading-6">
					قم بالتبديل بين الاتجاهات. يُطبّق الشمال الحقيقي الانحراف المغناطيسي لموقعك
					لتطابق الخرائط والملاحة والاتجاهات.
				</p>
			</div>
			<div>
				<p class="eyebrow mb-2">الدقة</p>
				<p class="text-sm text-body leading-6">
					تُظهر حبة الحالة مصدر المستشعر الحي والانحراف المقدر. إذا تذبذبت القراءات،
					اتبع خطوات الضبط أسفل المقياس.
				</p>
			</div>
		</div>
	</section>

	<section class="border-t border-hairline bg-canvas">
		<div class="mx-auto max-w-3xl px-4 py-20 sm:px-6 md:py-24">
			<p class="eyebrow">أداة البوصلة الأون لاين</p>
			<h2 class="mt-3 text-display-lg text-ink">العثور على الشمال أون لاين — فوراً، من متصفحك</h2>

			<p class="mt-6 text-body-lg text-body">
				<strong class="text-ink font-medium">البوصلة الأون لاين</strong> هي بوصلة رقمية
				تعمل مباشرة في متصفح الويب. لا متجر تطبيقات، لا تحميل، لا حساب — تفتح هذه
				الصفحة، تمنح إذن الوصول للحسّاس، ويصبح هاتفك بوصلة أون لاين مجانية مع قراءة
				اتجاه 360° حية. إنها أسرع طريقة لـ <strong class="text-ink font-medium">العثور
				على الشمال أون لاين</strong> سواء كنت في المنزل أو في نزهة أو في مخيم أو فقط
				تحاول معرفة اتجاه شقتك.
			</p>
			<p class="mt-4 leading-7">
				تقرأ البوصلة مستشعرات جهازك في الوقت الحقيقي. الطرف الأحمر من الإبرة يشير دائماً
				إلى الشمال — 0° أو 360° في أعلى المقياس — ويظهر الاتجاه أسفله بالدرجات إلى جانب
				نقطة البوصلة (شمال، شمال شرق، شرق، جنوب شرق، جنوب، جنوب غرب، غرب، شمال غرب). أثناء
				دورانك، يدور المقياس معك، لذا <strong class="text-ink font-medium">اتجاه البوصلة
				الأون لاين</strong> الذي تواجهه يظهر دائماً بنظرة واحدة.
			</p>

			<h3 class="mt-10 text-display-sm text-ink">الشمال الحقيقي مقابل الشمال المغناطيسي على البوصلة الأون لاين</h3>
			<p class="mt-3 leading-7">
				معظم بوصلات الهواتف تُظهر <strong class="text-ink font-medium">الشمال المغناطيسي</strong> —
				حيث تنجذب الإبرة بحقل الأرض المغناطيسي. لكن الخرائط وGPS والملاحة جميعها تستخدم
				<strong class="text-ink font-medium">الشمال الحقيقي</strong>، القطب الجغرافي الشمالي.
				الزاوية بينهما، تُسمى <strong class="text-ink font-medium">الانحراف
				المغناطيسي</strong>، تتراوح من حوالي -30° إلى +30° حسب موقعك على الكوكب. في بعض
				المدن الفرق بضع درجات؛ وفي أخرى أكثر من خمس عشرة. تجاهل الانحراف وقد تنحرف
				اتجاهاتك بمقدار كبير.
			</p>
			<p class="mt-4 leading-7">
				تتولى أداة البوصلة الأون لاين هذه المهمة لك. تُطبّق النموذج المغناطيسي العالمي
				باستخدام موقعك، لذا التبديل بين الشمال المغناطيسي والحقيقي بنقرة واحدة. عند التبديل
				إلى الشمال الحقيقي، يتطابق الاتجاه مع الشبكة على الخريطة — أساسي للملاحة
				والبحث عن الكنوز ومحاذاة الأقمار الصناعية أو اتباع اتجاه حسبنته في مكان آخر.
				للحصول على أكثر نتيجة دقة، اضغط "استخدم الموقع للانحراف" ليتم حساب التصحيح
				لإحداثياتك الدقيقة بدلاً من تقدير تقريبي.
			</p>

			<h3 class="mt-10 text-display-sm text-ink">ما مدى دقة بوصلة المتصفح؟</h3>
			<p class="mt-3 leading-7">
				تحتوي الهواتف على مقياس مغناطيسي ومسرّع ومقياس جyroscopy. تدمج البوصلة الأون لاين
				الجيدة هذه المستشعرات لإنتاج اتجاه معوّض للميل — مما يعني أنه يبقى ثابتاً نسبياً
				حتى عندما لا تمسك الهاتف بشكل مسطح تماماً. تُظهر هذه الصفحة مؤشر دقة ومصدر
				المستشعر الحي، لترى مدى ثقة القراءة.
			</p>
			<p class="mt-4 leading-7">
				للحصول على أفضل النتائج: أمسك الهاتف بشكل مبعد عن جسمك، وأبقِه بعيداً عن
				المعادن والمكبرات والأجهزة الإلكترونية، وحرّكه في شكل ثمانية بضع مرات إذا
				انحرفت الإبرة. يستغرق الضبط ثوانٍ ويعمل فرقاً حقيقياً. في الداخل، توقع تذبذب
				بضع درجات؛ في الخارج، بعيداً عن المعادن، بوصلة أون لاين مجانية كهذه
				توافق عادةً بوصلة فيزيائية بدرجة أو درجتين.
			</p>

			<div class="mt-10 grid gap-4 sm:grid-cols-2">
				<div class="card-soft p-5">
					<h4 class="text-sm font-medium text-ink mb-1">عندما تحتاج أداة بوصلة أون لاين مجانية</h4>
					<p class="text-sm leading-6">
						توجيه خريطة، محاذاة الألواح الشمسية، التحقق من اتجاه النافذة للنباتات،
						التحقق من اتجاه الصورة، تعليم الهندسة، أو تدريب الملاحة —
						كل ذلك بدون حمل بوصلة فيزيائية.
					</p>
				</div>
				<div class="card-soft p-5">
					<h4 class="text-sm font-medium text-ink mb-1">ما الذي يجعل هذه البوصلة مختلفة</h4>
					<p class="text-sm leading-6">
						بدون تثبيت، بلا إعلانات، بلا تتبع، ولا شيء يتم رفعه. كل شيء يعمل محلياً
						على جهازك، والقراءات مصحّحة للشمال الحقيقي تلقائياً.
					</p>
				</div>
			</div>

			<h3 class="mt-10 text-display-sm text-ink">كل طريقة لاستخدام بوصلة أون لاين</h3>
			<p class="mt-3 leading-7">
				تتجاوز الاستخدامات بكثير معرفة أي اتجاه الشمال. يستخدم المتسلقون و runners المسار
				بوصلة أون لاين لتوجيه خريطة قبل انطلاقهم. يستخدمها المصورون لتخطيط أماكن شروق
				وغروب الشمس. يستخدمها المتواجدون في المخيم لتوجيه خيمتهم نحو شمس الصباح. يتحقق
				الموظفون العقاريون من اتجاه الغرفة، ويرتب الحدائقون الأسرّة المرتفعة للحصول على
				أقصى ضوء. يستخدم الطلاب هذه البوصلة الأون لاين للهندسة لرؤية الزوايا تعيش على المقياس.
				ومع زر ملء الشاشة، يمكنك حمل المقياس على طول الذراع ومواءمته مع
				معلم بعيد — تماماً مثل بوصلة يدوية.
			</p>
			<p class="mt-4 leading-7">
				بما أن كل شيء يُحسب في متصفحك، يمكنك استخدام هذه البوصلة الأون لاين الحية من
				أي مكان في العالم — وتُصحح للانحراف المغناطيسي أينما كنت، لذا
				الشمال الحقيقي دقيق دائماً. تلك المجموعة من بوصلة أون لاين مجانية للعثور على الشمال،
				واتجاه حي، وتصحيح الانحراف، والخصوصية يصعب العثور عليها في مكان آخر.
			</p>

			<h3 class="mt-10 text-display-sm text-ink">ادمج البوصلة مع باقي الأدوات</h3>
			<p class="mt-3 leading-7">
				هذه البوصلة جزء من حزمة ملاحة كاملة. استخدم
				<a href="/ar/location/" class="text-link underline decoration-link/30 hover:decoration-link">أداة إحداثيات GPS</a>
				لاستلام موقعك الدقيق، و
				<a href="/ar/bearing/" class="text-link underline decoration-link/30 hover:decoration-link">حاسبة الاتجاه</a>
				لتخطيط مسار بين نقطتين، و
				<a href="/ar/qibla/" class="text-link underline decoration-link/30 hover:decoration-link">محدد القبلة</a>
				للتوجه نحو الكعبة، و
				<a href="/ar/sun/" class="text-link underline decoration-link/30 hover:decoration-link">حاسبة موضع الشمس</a>
				لتتبع المسار الشمسي. كل الأدوات تعمل معاً، وكل أداة خاصة ومجانية
				وتعمل على أي هاتف بمتصفح.
			</p>
			<p class="mt-4 leading-7">
				جاهز للعثور على الشمال؟ امنح إذن الوصول للحسّاس أعلاه، واتبع خطوات الضبط إذا
				انحرفت الإبرة، واستمتع بأحد أكثر أدوات البوصلة الأون لاين دقة المتاحة —
				بدون تثبيت أي شيء.
			</p>
		</div>
	</section>

	<RelatedTools current="/" />
</Layout>
