---
import Layout from '../../layouts/Layout.astro';
import BearingCalculator from '../../components/BearingCalculator.astro';
import PageHero from '../../components/PageHero.astro';
import RelatedTools from '../../components/RelatedTools.astro';
---

<Layout
	title="حاسبة الاتجاه أون لاين — الاتجاه والمسافة بين نقطتين"
	description="أداة بوصلة أون لاين مجانية لحساب الاتجاه والمسافة على الدائرة الكبرى بين إحداثيتين. تُظهر أيضاً اتجاه القبلة والانحراف المغناطيسي وموضع الشمس من موقعك."
	path="/ar/bearing/"
	keywords="رياضيات بوصلة أون لاين, بوصلة أون لاين هندسية, حاسبة الاتجاه, اتجاه بين نقطتين, مسافة الدائرة الكبرى, حاسبة الاتجاه أون لاين"
>
	<PageHero
		eyebrow="حاسبة الاتجاه"
		title="حدد مساراً، درجة بدرجة."
		description="احسب الاتجاه الأولي والمسافة على الدائرة الكبرى بين أي نقطتين على الأرض — من موقعك الحي أو إحداثيات يدوية أو مسار مُعرّف مسبقاً."
	>
		<BearingCalculator />
	</PageHero>

	<section class="border-y border-hairline bg-canvas">
		<div class="mx-auto max-w-[1200px] grid gap-6 px-4 py-16 sm:px-6 md:grid-cols-2">
			<div>
				<p class="eyebrow mb-2">الاتجاه الأولي مقابل النهائي</p>
				<p class="text-sm text-body leading-6">
					يعيد هذا الاتجاه الأولي — الاتجاه الذي تنطلق فيه. على المسارات الطويلة يتغير
					الاتجاه على طول الدائرة الكبرى، لذا التصحيحات في منتصف المسار طبيعية.
				</p>
			</div>
			<div>
				<p class="eyebrow mb-2">استخدمه مع البوصلة</p>
				<p class="text-sm text-body leading-6">
					خذ الاتجاه المحسوب إلى أداة البوصلة واتجه حتى يتطابق الاتجاه. انتقل
					إلى الشمال الحقيقي للملاحة الدقيقة حسب الخريطة.
				</p>
			</div>
		</div>
	</section>

	<section class="border-t border-hairline bg-canvas">
		<div class="mx-auto max-w-3xl px-4 py-20 sm:px-6 md:py-24">
			<p class="eyebrow">حاسبة الاتجاه</p>
			<h2 class="mt-3 text-display-lg text-ink">احسب الاتجاه والمسافة بين نقطتين</h2>

			<p class="mt-6 text-body-lg text-body">
				<strong class="text-ink font-medium">حاسبة الاتجاه الأون لاين</strong> تجد
				الاتجاه والمسافة بين أي نقطتين على الأرض. أدخل مجموعتي إحداثيات —
				أو استخدم موقعك الحي لنهاية واحدة — وتعيد هذه الأداة الاتجاه الأولي
				بالدرجات واتجاه البوصلة والمسافة على الدائرة الكبرى بالكيلومترات. إنها
				أداة <strong class="text-ink font-medium">رياضيات بوصلة أون لاين</strong> الأساسية
				للملاحة وتخطيط المسارات والمسح والدراسة.
			</p>
			<p class="mt-4 leading-7">
				الاتجاه هو الزاوية المقاسة من الشمال clockwise إلى الاتجاه الذي تحتاج
				السفر إليه: 0° شمالاً، 90° شرقاً، 180° جنوباً، 270° غرباً. مسار من لندن إلى نيويورك،
				على سبيل المثال، يبدأ باتجاه أولي حوالي 288° — هذا اتجاه البوصلة الذي
				توجّه به مقدمة طائرة أو مقدمة سفينة في لحظة الانطلاق.
			</p>

			<h3 class="mt-10 text-display-sm text-ink">الاتجاه الأولي مقابل النهائي</h3>
			<p class="mt-3 leading-7">
				بما أن الأرض كرة، <strong class="text-ink font-medium">الاتجاه بين نقطتين</strong>
				ليس خطاً مستقيماً على الخريطة. يتبع أقصر مسار دائرة كبرى، وعلى ذلك المسار يتغير
				الاتجاه باستمرار. "الاتجاه الأولي" هو الاتجاه عند نقطة البداية —
				الذي تبدأ بالmith在他之后。 على المسارات الطويلة يتحرك الاتجاه
				أثناء السير، ولهذا يستخدم الطيارون والملاحون نقاط التキング والتصحيحات
				في منتصف المسار. تُبلغ هذه الحاسبة عن الاتجاه الأولي وتحسب أيضاً
				الاتجاه النهائي للوصول إلى نهاية مسار الدائرة الكبرى.
			</p>
			<p class="mt-4 leading-7">
				للرحلات القصيرة — نزهة أو قيادة عبر مدينة أو مشي بين نقطتين على خريطة —
				الاتجاه الأولي هو المسار الكامل فعلياً. يجعل هذا حاسب الاتجاه الأون لاين
				مثالياً للتخطيط اليومي وكذلك للهندسة في الفصل.
			</p>

			<h3 class="mt-10 text-display-sm text-ink">المسافة كما يقيسها الملاّح</h3>
			<p class="mt-3 leading-7">
				إلى جانب الاتجاه تحصل على المسافة على الدائرة الكبرى — أقصر مسافة على
				سطح الأرض بين النقطتين، محسوبة بمعادلة Haversine. على عックス
				المسطرة على خريطة مسطحة، هذا يأخذ في الاعتبار تقوس الكوكب، لتطابق
				النتيجة مع مسافات السفر الحقيقية. إنه نفس الحساب المستخدم لتخطيط
				الرحلات الجوية والملاحة البحرية.
			</p>
			<p class="mt-4 leading-7">
				تذهب الأداة أبعد من حاسبة بسيطة. اختر وجهة من القائمة المُعرّفة
				— بما في ذلك المدن العالمية الكبرى والكعبة في مكة — ويحسب الملخص
				("نيويورك في اتجاه 245° غرب جنوب غرب من لندن، على بعد 5,570 كم") بالإضافة إلى أربع
				قراءات إضافية من النقطة A:
				<a href="/ar/qibla/" class="text-link underline decoration-link/30 hover:decoration-link">اتجاه القبلة</a>،
				والانحراف المغناطيسي، و
				<a href="/ar/sun/" class="text-link underline decoration-link/30 hover:decoration-link">موضع الشمس</a>.
				إدخال واحد، وتشوف كيف تتواصل البوصلة والقبلة والبيانات الشمسية مع مسارك.
			</p>

			<h3 class="mt-10 text-display-sm text-ink">استخدم الاتجاه مع بوصلة</h3>
			<p class="mt-3 leading-7">
				الرفيق الطبيعي لهذه الأداة هو
				<a href="/" class="text-link underline decoration-link/30 hover:decoration-link">البوصلة الأون لاين</a>.
				احسب اتجاهك، وافتح البوصلة، ودور حتى يتطابق اتجاهك. انتقل البوصلة
				إلى الشمال الحقيقي حتى تتطابق ملاحتك مع شمال الخريطة — ودع البوصلة
				تطبق انحراف موقعك تلقائياً. تحول ذلك رقم على صفحة
				إلى مسار يمكنك المشي أو الإبحار أو القيادة فعلياً.
			</p>
			<p class="mt-4 leading-7">
				هذه حاسب الاتجاه الأون لاين مفيدة لتخطيط المسارات قبل نزهة، ومحاذاة
				الهوائيات والألواح الشمسية، وتقدير السفر بين عنوانيْن، والتحقق من مسار
				بوصلة، أو التحقق من الواجب. بما أن كل شيء يعمل محلياً في متصفحك،
				إنها أداة هندسة بوصلة أون لاين خاصة ومجانية يمكنك الوثوق بها في أي مكان —
				بدون تثبيت، بلا حسابات، بلا جمع بيانات.
			</p>

			<h3 class="mt-10 text-display-sm text-ink">الدرجات والاتجاهات والتخطيط</h3>
			<p class="mt-3 leading-7">
				الاتجاهات بالدرجات دقيقة لكن مجردة؛ ولهذا تحوّل الأداة أيضاً
				إلى اتجاهات بوصلة واضحة. 45° يصبح شمال شرق، و200° يصبح جنوب جنوب غرب، وما إلى ذلك
				— لتتمكن من الإجابة على أسئلة مثل "أي اتجاه أحتاج للذهاب؟" بنفس لغة البوصلة أو
				الخريطة. أدخل موقعك الحالي كنقطة A وجهة كنقطة B، والصورة الكاملة —
				الاتجاه والاتجاه والمسافة والقبلة والانحراف والشمس — تتحدث
				فوراً. هذه قوة أداة رياضيات بوصلة أون لاين مبنية حول إحداثياتك
				الحقيقية.
			</p>
		</div>
	</section>

	<RelatedTools current="/bearing/" />
</Layout>
