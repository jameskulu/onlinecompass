---
import Layout from '../../layouts/Layout.astro';
import QiblaFinder from '../../components/QiblaFinder.astro';
import PageHero from '../../components/PageHero.astro';
import RelatedTools from '../../components/RelatedTools.astro';
---

<Layout
	title="محدد القبلة أون لاين — اتجاه الكعبة من موقعي"
	description="بوصلة أون لاين للقبلة — اتجاه الكعبة من موقعي. محدد قبلة مع اتجاه ومسافة الدائرة الكبرى إلى مكة، محسوب بشكل خاص في متصفحك."
	path="/ar/qibla/"
	keywords="بوصلة أون لاين للقبلة, محدد قبلة بوصلة أون لاين, بوصلة كعبة أون لاين للعثور على الشمال من موقعي, اتجاه القبلة, اتجاه الكعبة, إيجاد القبلة من موقعي"
>
	<PageHero
		eyebrow="محدد القبلة"
		title="اتجه نحو الكعبة، في أي مكان على الأرض."
		description="يُحسب اتجاه الدائرة الكبرى إلى مكة على جهازك من إحداثياتك — بدقة درجة واحدة، خاص بالتصميم."
	>
		<QiblaFinder />
	</PageHero>

	<section class="border-y border-hairline bg-canvas">
		<div class="mx-auto max-w-[1200px] grid gap-6 px-4 py-16 sm:px-6 md:grid-cols-2">
			<div>
				<p class="eyebrow mb-2">كيف يُحسب</p>
				<p class="text-sm text-body leading-6">
					يستخدم الاتجاه أقصر مسار دائرة الكبرى بين موقعك والكعبة
					(21.4225° شمالاً، 39.8262° شرقاً). يأخذ في الاعتبار تقوس الأرض، لذا يختلف عن قراءة
					بوصلة مسطحة.
				</p>
			</div>
			<div>
				<p class="eyebrow mb-2">طبّقه عملياً</p>
				<p class="text-sm text-body leading-6">
					سجّل الاتجاه، ثم افتح أداة البوصلة ودور حتى يتطابق اتجاهك معه.
					أو اضبط في الخارج بعيداً عن المعادن لأفضل دقة.
				</p>
			</div>
		</div>
	</section>

	<section class="border-t border-hairline bg-canvas">
		<div class="mx-auto max-w-3xl px-4 py-20 sm:px-6 md:py-24">
			<p class="eyebrow">محدد القبلة</p>
			<h2 class="mt-3 text-display-lg text-ink">ابحث عن اتجاه القبلة من موقعي</h2>

			<p class="mt-6 text-body-lg text-body">
				<strong class="text-ink font-medium">محدد القبلة الأون لاين</strong> يخبرك بالاتجاه
				الدقيق للتوجه للصلاة — الاتجاه من أي مكان أنت فيه إلى الكعبة في مكة
				المكرمة، المملكة العربية السعودية (21.4225° شمالاً، 39.8262° شرقاً). تحسب هذه الصفحة
				ذلك الاتجاه من موقعك الحي أو من أي إحداثيات تدخلها، وتُظهر الاتجاه بالدرجات
				واتجاه البوصلة، بالإضافة إلى المسافة على الدائرة الكبرى إلى مكة. بدون تطبيق،
				بدون تثبيت، بدون حساب — افتح الصفحة واعرف أي اتجاه للصلاة.
			</p>
			<p class="mt-4 leading-7">
				يصلي المسلمون حول العالم نحو الكعبة خمس مرات يومياً، واحترام الاتجاه
				يهم. سواء كنت مسافراً أو جديداً في منطقة أو تريد ببساطة
				التحقق من الاتجاه في منزلك، يُعطيك هذا <strong class="text-ink font-medium">محدد قبلة بوصلة أون لاين</strong>
				مجاني إجابة دقيقة في ثوانٍ.
			</p>

			<h3 class="mt-10 text-display-sm text-ink">كيف يُحسب اتجاه الكعبة</h3>
			<p class="mt-3 leading-7">
				<strong class="text-ink font-medium">اتجاه الكعبة من موقعي</strong> ليس
				اختصاراً على خريطة مسطحة. بما أن الأرض مقوسة، يتبع الاتجاه الصحيح أقصر
				مسار دائرة الكبرى بين نقطتين. الاتجاه من لندن إلى مكة حوالي 118°،
				من نيويورك حوالي 58°، من جاكرتا حوالي 295°، ومن سيدني حوالي 295° غرب
				الشمال — أرقام تُفاجئ كثير من الناس لأنها اتجاهات دوائر كبرى،
				وليست اتجاهات خط مستقيم على الخريطة. تُجري هذه الأداة نفس حسابات المثلثات
				الكرية المستخدمة في ملاحة الطائرات، لذا النتيجة دقيقة لدرجة واحدة أينما
				كنت على الكوكب.
			</p>
			<p class="mt-4 leading-7">
				بما أن الحساب يعمل بالكامل في متصفحك، إحداثياتك لا تُرسل أبداً إلى
				خادم. كثير من أدوات القبلة الأون لاين تسجل موقعك بهدوء؛ هذه لا تستطيع. إنها
				بوصلة أون لاين للقبلة خاسمةἅ كما هي دقيقة.
			</p>

			<h3 class="mt-10 text-display-sm text-ink">تطبيق اتجاه القبلة عملياً</h3>
			<p class="mt-3 leading-7">
				بمجرد حصولك على الاتجاه، الخطوة التالية هي تحويله إلى اتجاه يمكنك
				التوجه إليه فعلياً. أبسط طريقة: سجّل الاتجاه بالدرجات، وافتح
				<a href="/" class="text-link underline decoration-link/30 hover:decoration-link">البوصلة الأون لاين الحية</a>,
				ودور حتى يتطابق اتجاهك مع اتجاه القبلة. يُظهر مقياس البوصلة
				اتجاهك في الوقت الحقيقي، لذا يأخذ المطابقة ثوانٍ.
			</p>
			<p class="mt-4 leading-7">
				للحصول على أفضل نتيجة، اضغط "استخدم الموقع" في الأداةتين ليتم تصحيح الانحراف
				وتكون القراءات مبنية على الشمال الحقيقي. إذا لم يكن لديك بوصلة
				بجوارك، يمكنك أيضاً تحديد اتجاهك بالشمس: في نصف الكرة الشمالي الشمس
				تقع جنوباً في الظهيرة المحلية، وفي نصف الكرة الجنوبي شمالاً — مرجع موثوق
				في النهار لتحديد اتجاهك العام قبل الضبط الدقيق بالاتجاه.
			</p>

			<div class="mt-10 grid gap-4 sm:grid-cols-2">
				<div class="card-soft p-5">
					<h4 class="text-sm font-medium text-ink mb-1">بحث شائع: "بوصلة كعبة أون لاين للعثور على الشمال من موقعي"</h4>
					<p class="text-sm leading-6">
						هذه العبارة بالضبط ما تجيب عليه هذه الأداة. حدد موقعك، واقرأ اتجاه
						القبلة، ثم اتبعه على البوصلة — بوصلة أون لاين مجانية للقبلة من أي
						موقع على الأرض.
					</p>
				</div>
				<div class="card-soft p-5">
					<h4 class="text-sm font-medium text-ink mb-1">المسافة إلى مكة</h4>
					<p class="text-sm leading-6">
						إلى جانب الاتجاه تحصل على المسافة على الدائرة الكبرى إلى الكعبة — مفيدة
						لخطط السفر وفهم كيف يتغير الاتجاه مع المسافة.
					</p>
				</div>
			</div>

			<h3 class="mt-10 text-display-sm text-ink">اتجاه القبلة يتغير مع موقعك</h3>
			<p class="mt-3 leading-7">
				<strong class="text-ink font-medium">اتجاه القبلة</strong> يعتمد بالكامل على
				مكانك. يتغير من مدينة لأخرى وحتى من شارع لشارع، لذا قيمة بحثت عنها
				منذ سنوات في بلد واحد نادراً ما تكون صحيحة في آخر. لهذا كان حاسب حي
				الخيار الموثوق: يحسب الاتجاه طازجاً لإحداثياتك الحالية
				في كل مرة. اسافر بضع مئات الكيلومترات ويمكن أن يتحرك الاتجاه بعدة
				درجات — وهذه الصفحة تتحرك تلقائياً.
			</p>
			<p class="mt-4 leading-7">
				تعمل الأداة بإحداثيات يدوية أيضاً، وهو مفيد عندما تريد التحقق
				من اتجاه مكان ستزوره، أو عندما يكون إذن متصفحك معطلاً.
				أدخل مدينة أو إحداثيات ويُعيد محدد القبلة نفس الاتجاه الدقيق والمسافة.
				أينما كان السؤال "ابحث عن القبلة من موقعي"، هذه الصفحة تجيب عليه —
				بشكل خاص ودقيق ومجاني.
			</p>
		</div>
	</section>

	<RelatedTools current="/qibla/" />
</Layout>
