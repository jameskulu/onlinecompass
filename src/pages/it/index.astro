import Layout from '../../layouts/Layout.astro';
import Compass from '../../components/Compass.astro';

const faq = [
	{
		"q": "Che cos'è una bussola digitale online e come funziona nel browser?",
		"a": "Una bussola digitale online è un'applicazione web che accede direttamente ai sensori fisici MEMS (magnetometro, accelerometro e giroscopio) del tuo dispositivo tramite l'API DeviceOrientation del W3C. Esegue una compensazione trigonometrica dell'inclinazione in tempo reale in JavaScript per fornire una direzione stabile da 0° a 360° senza scaricare alcuna app."
	},
	{
		"q": "Qual è la differenza tra nord vero e nord magnetico?",
		"a": "Il nord vero punta lungo l'asse di rotazione terrestre verso il Polo Nord geografico, dove convergono tutti i meridiani. Il nord magnetico è il punto nell'Artico in cui le linee del campo geomagnetico entrano verticalmente nella Terra. La differenza angolare tra i due valori si chiama declinazione magnetica."
	},
	{
		"q": "Che cos'è la declinazione magnetica e perché è fondamentale per la navigazione?",
		"a": "La declinazione magnetica è l'angolo orizzontale tra nord magnetico e nord vero alle tue coordinate. A New York è di circa −13° Ovest, a Los Angeles +12° Est. La nostra bussola integra il modello WMM della NOAA per correggere automaticamente questo scostamento e allineare la rotta con le carte topografiche."
	},
	{
		"q": "Come posso calibrare la bussola del mio smartphone per la massima precisione?",
		"a": "Tieni il telefono piatto nel palmo della mano e muovilo disegnando una figura a otto (∞) fluida nell'aria per 5-10 secondi. Questo movimento espone il magnetometro triassiale al campo terrestre da ogni angolazione, permettendo all'algoritmo di filtrare e annullare le interferenze da ferro duro e ferro dolce dell'apparecchio."
	},
	{
		"q": "Perché l'ago della bussola vibra o ruota in modo incontrollato?",
		"a": "Le letture instabili sono dovute a interferenze elettromagnetiche ambientali. Allontanati di almeno due metri da oggetti metallici, cover con magneti o MagSafe, computer portatili, cemento armato e cruscotti d'auto, quindi ripeti la calibrazione con il movimento a otto."
	},
	{
		"q": "Quanto è precisa la bussola di uno smartphone rispetto a una bussola da trekking?",
		"a": "Una volta calibrato e distante da masse metalliche, il magnetometro MEMS di uno smartphone raggiunge una precisione di ±1° a ±3° all'aperto, equiparabile a una bussola tradizionale a liquido. Gli smartphone offrono inoltre compensazione automatica dell'inclinazione e declinazione automatica, pur rimanendo la bussola fisica il backup d'emergenza ideale in montagna."
	},
	{
		"q": "Questa bussola online funziona anche offline e in modalità aereo?",
		"a": "Sì. L'applicazione è strutturata come una Progressive Web App (PWA) offline-first. L'intero codice sorgente e le tabelle geomagnetiche WMM vengono salvati nella cache del Service Worker del browser. Una volta aperta, continua a funzionare perfettamente anche in aperta natura senza segnale cellulare né Wi-Fi."
	},
	{
		"q": "Perché la bussola mostra un quadrante dimostrativo su computer e notebook?",
		"a": "Il rilevamento dal vivo richiede un chip hardware magnetometro (sensore di campo magnetico). Mentre smartphone e tablet ne sono provvisti, i PC desktop e i portatili ne sono quasi sempre privi. Sui computer, l'applicazione offre una simulazione interattiva e calcolatori di azimut solare e coordinate."
	},
	{
		"q": "Come calcola il cercatore Qibla la direzione esatta per La Mecca?",
		"a": "Lo strumento calcola l'azimut ortodromico (rotta di cerchio massimo) dalle tue coordinate alla Kaaba alla Mecca (21° 25' 21\" N, 39° 49' 34\" E) applicando la formula della trigonometria sferica. Un indicatore verde smeraldo sul quadrante ti guida visivamente per allinearti alla perfezione."
	},
	{
		"q": "Verso quale direzione è orientata la mia casa, il mio balcone o il giardino?",
		"a": "Mettiti davanti alla finestra o alla porta tenendo il telefono orizzontale. Un valore tra 315° e 45° indica esposizione a Nord. L'esposizione a Sud (135°–225°) garantisce il massimo irraggiamento solare nell'arco dell'anno, l'Est riceve la luce del mattino e l'Ovest il tepore pomeridiano."
	}
];

