const compassTechComparison = [
	{
		"tech": "ブラウザMEMSセンサーフュージョン",
		"operatingPrinciple": "3軸ホール磁気センサー＋静電容量加速度計＋角速度ジャイロの統合処理",
		"accuracy": "±1.0°〜±2.5°（オイラー角傾斜補正・WMM自動偏角適用時）",
		"advantages": "アプリ不要、地図座標への自動アライメント、夜間暗所HUD、キブラ・座標連動",
		"limitations": "磁気センサー内蔵端末が必要。周辺金属や磁石付きスマホカバーに感応"
	},
	{
		"tech": "伝統的オイル式磁気コンパス",
		"operatingPrinciple": "流体封入カプセル内の磁化鋼針が地球の水平磁力線に沿って整向",
		"accuracy": "±2.0°〜±5.0°（流体の減衰性能および水平保持状態に依存）",
		"advantages": "電池消費ゼロ、ソフトウェア不具合や電子干渉から完全独立",
		"limitations": "磁北のみを指示、手動偏角計算が必要、高所気圧でカプセル内に気泡発生の恐れ"
	},
	{
