---
import Layout from '../../layouts/Layout.astro';
import Compass from '../../components/Compass.astro';

const faq = [
	{
		"q": "オンラインデジタルコンパスとは何ですか？ブラウザでどのように機能しますか？",
		"a": "オンラインデジタルコンパスは、アプリをダウンロードすることなく、W3C DeviceOrientation APIを介してスマートフォンに内蔵された物理MEMSセンサー（磁力計・加速度計・ジャイロ）を直接読み取るウェブアプリケーションです。JavaScriptによるリアルタイムの三角関数傾斜補正により、端末が傾いていても0°〜360°の正確な方位を瞬時に算出します。"
	},
	{
		"q": "「真北（しんぽく）」と「磁北（じほく）」の違いは何ですか？",
		"a": "真北は地球の自転軸に沿った地理的な北極点（すべての経線が収束する地点）を指し、地図やGPSが基準とします。磁北は地球の地磁気ラインが鉛直に地核へ入る北極海の地点であり、地球内部のコア活動によって毎年数十キロ移動します。この両者の角度のズレを「磁気偏角」と呼びます。"
	},
	{
		"q": "磁気偏角とは何ですか？正確なナビゲーションになぜ必須なのですか？",
		"a": "磁気偏角とは、観測地点における磁北と真北の間の水平角度です。例えばニューヨークでは約−13°西偏、東京では約−8°西偏しています。偏角を補正しないと、地図上の目的地から距離1kmあたり数十〜数百メートル以上ずれてしまいます。当サイトは米国NOAAの最新世界磁気モデル（WMM）を統合し、偏角を自動加減算して地図と完全一致させます。"
	},
	{
		"q": "スマートフォンのコンパスを最高精度に校正（キャリブレーション）する方法は？",
		"a": "端末を手のひらに平らに乗せ、画面を上に向けた状態で、空間にゆっくりと大きな「8の字（∞）」を描くように5〜10秒間動かしてください。これにより3軸磁力計が地球磁場を全方位から受光し、スマホ内部のスピーカーやカメラ部品による固定磁気ノイズを自動的に相殺補正します。"
	},
	{
		"q": "コンパスの針が震えたり、激しく回転して定まらない原因は何ですか？",
		"a": "局所的な電磁気干渉が主な原因です。金属製の手帳型ケース、MagSafeリング、ノートPC、鉄筋コンクリートの梁、車のダッシュボードなどの金属や磁石から2メートル以上離れ、平らな場所で8の字校正を行ってください。"
	},
	{
		"q": "スマホのコンパスは市販のアナログコンパス（シルバコンパス等）と比べて正確ですか？",
		"a": "金属干渉のない屋外で適切に校正されたスマホのMEMS磁力計は、±1°〜±3°の測定精度を持ち、一般的なオイル封入式コンパスと同等以上の精度を発揮します。さらに傾斜補正や真北自動計算が作動する利点があります。ただし過酷な雪山登山では電池切れのないアナログコンパスの携行が推奨されます。"
	},
	{
		"q": "このオンラインコンパスはオフラインや機内モードでも動作しますか？",
		"a": "はい。当サイトはオフラインファーストのProgressive Web App（PWA）として設計されています。主要なコードやWMM地磁気計算データはブラウザのService Workerにキャッシュされるため、一度読み込めば携帯の電波が圏外の山奥でも問題なく動作します。"
	},
	{
		"q": "PCやノートパソコンで開いた際にデモ画面が表示されるのはなぜですか？",
		"a": "リアルタイムの方位計測には磁界を検出するハードウェア（磁気センサー）が必要です。スマートフォンやタブレットには搭載されていますが、一般的なノートPCやデスクトップPCには搭載されていません。PC環境では各種計算ツールとシミュレーション機能が起動します。"
	},
	{
		"q": "キブラ（Qibla）ファインダーはどのようにメッカの方角を算出しますか？",
		"a": "現在地の緯度経度からサウジアラビア・メッカのカアバ神殿（北緯21°25'21\"、東経39°49'34\"）への大圏航路（大円方位角）を球面三角法により正確に計算します。コンパス外周のエメラルドグリーンのマーカーに体の向きを合わせるだけで、正確にメッカへ正対できます。"
	},
	{
		"q": "自宅やバルコニー、庭が向いている方角を調べるには？",
		"a": "窓際やベランダに立ち、スマートフォンを水平にして外に向けてください。方位角が315°〜45°なら北向き、135°〜225°なら日当たりが最も良い南向きです。東向きは朝日が入り、西向きは午後の強い西日を受けます。"
	}
];

