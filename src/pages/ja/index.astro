---
import Layout from '../../layouts/Layout.astro';
import Compass from '../../components/Compass.astro';

const faq = [
	{
		q: 'オンラインコンパスとは何ですか？',
		a: 'オンラインコンパスとは、別のアプリとしてではなく、ウェブブラウザの中で動くデジタルコンパスです。スマートフォンの磁力計、加速度計、ジャイロスコープを読み取り、現在の方位を度数でリアルタイムに表示します。ダウンロードは不要です。このページのようなサイトを開いてセンサーの利用を許可すれば、端末を回すたびにダイヤルがその場で更新されます。',
	},
	{
		q: 'スマートフォンでオンラインコンパスを使うには？',
		a: 'スマートフォンでこのページを開き、「リアルタイムコンパスを有効にする」をタップして、端末を手のひらで水平に保ちます。方位はダイヤルの下に度数と方位点で表示されます。最も正確な結果を得るには、8の字を描くように動かして磁力計をキャリブレーションし、スマートフォンを金属や磁石から離しておきましょう。',
	},
	{
		q: 'オンラインコンパスは正確ですか？',
		a: 'キャリブレーション済みのスマートフォンコンパスは、屋外では通常1〜5度程度の精度です。磁力計自体が繊細で、近くの金属や電子機器、磁気を帯びたスマートフォンケースなどで乱れることがあります。キャリブレーションを行い、干渉源から離れれば、多くの場合、物理的なコンパスと数度以内で一致します。',
	},
	{
		q: '真北と磁北の違いは何ですか？',
		a: '磁北はスマートフォンの磁力計が指す方向で、毎年変動する地球の磁場に従います。真北は地図が使う地理上の北極点です。この2つのなす角を磁気偏角と呼び、このツールでは地図と方位が一致するよう自動的に補正します。',
	},
	{
		q: '磁気偏角とは何ですか？',
		a: '磁気偏角とは、ある地点における磁北と真北のなす角です。世界でおおよそ−30°から+30°の範囲にあり、時間とともにゆっくり変化します。ロンドンではほぼ0°ですが、カナダの一部では15°を超えることもあります。場所によって異なるため、方位に従うときはGPSに基づく正確な偏角補正が重要になります。',
	},
	{
		q: 'コンパスの針が飛び回ったり回転したりするのはなぜ？',
		a: '磁力計は繊細な計器です。磁石付きのスマートフォンケース、スピーカー、ノートパソコン、金属のテーブル、車のダッシュボード、鉄骨の建物などは、周囲の磁場を歪めます。これらから離れ、スマートフォンを水平に持ち、8の字を描いて再キャリブレーションしてください。屋内で数度揺れるのは正常です。',
	},
	{
		q: 'スマートフォンのコンパスをキャリブレーションするには？',
		a: 'スマートフォンを水平に持ち、画面を上に向けたまま、ゆっくりと8の字を何回か描くように回します。これにより磁力計が広い範囲の測定値を得られ、キャリブレーションできます。最後に1秒ほど静止してください。方位が不安定に見えるたびに繰り返しましょう。',
	},
	{
		q: 'オンラインコンパスはオフラインやパソコンでも使えますか？',
		a: 'ページを一度読み込めば、方位は端末上で生成されるため、オフラインでもダイヤルは動作し続けます。ただしノートパソコンやデスクトップではリアルタイムの方位は得られません。ほとんどの機種に磁力計がないためです。スマートフォンやタブレットをお使いください。パソコンでもデモ用のダイヤルや太陽・月のデータは表示されます。',
	},
	{
		q: 'オンラインコンパスは位置情報を要求しますか？プライバシーは守られますか？',
		a: '位置情報は任意で、磁気偏角、キブラ方位、太陽位置の計算にのみ使われます。計算はすべてブラウザ内でローカルに実行され、アカウントもバックエンドも解析ツールもありません。座標がデバイスの外に出ることはなく、いつでも手動で座標を入力することもできます。',
	},
	{
		q: 'オンラインコンパスでキブラを見つけられますか？',
		a: 'はい。キブラファインダーは現在地の座標からメッカのカアバへの大圏方位を度数単位で計算し、距離も表示します。その方位をリアルタイムコンパスのダイヤル上でたどれば、その方向を向くことができます。',
	},
	{
		q: 'コンパスなしで北を見つけるには？',
		a: '北半球では、地方時の正午に太陽は真南にあり、影は北を指します。夜は北極星（ポラリス）がほぼ真北の真上にあります。このサイトの太陽位置ツールは、現在地と時刻における正確な太陽方位角を示すので、コンパスの信頼できる照合手段になります。',
	},
	{
		q: 'このコンパスを使うのにアプリのインストールは必要ですか？',
		a: 'いいえ。すべてブラウザ内で動作するため、ダウンロードもアプリストアも登録も更新も不要です。iPhone、Android、ほとんどのタブレットで同じように使えます。',
	},
	{
		q: 'このオンラインコンパスは無料ですか？',
		a: 'はい、完全に無料で、有料プランや課金の壁はありません。このサイトのすべてのツール — コンパス、GPS座標、キブラファインダー、方位計算機、太陽位置、太陽と月の方向 — を無料で利用できます。',
	},
	{
		q: '自宅や窓がどちらを向いているか知るには？',
		a: '窓の前に立ち、外に向かってスマートフォンを水平に持ち、方位を読み取ります。北が0°、東が90°、南が180°、西が270°です。園芸では日当たりの計画に、写真撮影では日の出や日の入りの位置の予測に活用されています。',
	},
	{
		q: 'オンラインコンパスはどうやって真北を計算していますか？',
		a: '現在地の座標をもとに世界磁気モデル（World Magnetic Model）を適用し、その地点の磁気偏角を求めます。磁力計が示す磁北にこの偏角を加減することで、真北を基準とした方位を算出します。',
	},
];

const declinationExamples = [
	{ place: 'ロンドン、イギリス', value: '≈ 0°' },
	{ place: 'パリ、フランス', value: '≈ +1° east' },
	{ place: 'ニューヨーク、アメリカ合衆国', value: '≈ −13° west' },
	{ place: 'トロント、カナダ', value: '≈ −11° west' },
	{ place: 'ロサンゼルス、アメリカ合衆国', value: '≈ +12° east' },
	{ place: 'アンカレッジ、アメリカ合衆国', value: '≈ +15° east' },
	{ place: 'シドニー、オーストラリア', value: '≈ +12° east' },
	{ place: 'サンパウロ、ブラジル', value: '≈ −23° west' },
	{ place: 'ケープタウン、南アフリカ', value: '≈ −25° west' },
	{ place: '東京、日本', value: '≈ −8° west' },
];

const compassRose = [
	{ point: 'N', deg: '0°' },
	{ point: 'NNE', deg: '22.5°' },
	{ point: 'NE', deg: '45°' },
	{ point: 'ENE', deg: '67.5°' },
	{ point: 'E', deg: '90°' },
	{ point: 'ESE', deg: '112.5°' },
	{ point: 'SE', deg: '135°' },
	{ point: 'SSE', deg: '157.5°' },
	{ point: 'S', deg: '180°' },
	{ point: 'SSW', deg: '202.5°' },
	{ point: 'SW', deg: '225°' },
	{ point: 'WSW', deg: '247.5°' },
	{ point: 'W', deg: '270°' },
	{ point: 'WNW', deg: '292.5°' },
	{ point: 'NW', deg: '315°' },
	{ point: 'NNW', deg: '337.5°' },
];

const compassTypes = [
	{
		type: '従来の磁気コンパス',
		measures: '浮遊する針で地球の磁場を測定',
		best: 'オフラインでの信頼性、電池不要、教育用途',
		limitation: '水平な面が必要、偏角補正なし、センサーは1つ',
	},
	{
		type: 'スマートフォンのセンサーコンパス（このサイト）',
		measures: '磁力計・加速度計・ジャイロスコープを融合',
		best: '度数でのリアルタイム方位、傾斜補正、地図との整合',
		limitation: '近くの金属や磁石に敏感',
	},
	{
		type: 'GPSコースコンパス',
		measures: 'GPS位置の変化から進行方向を算出',
		best: '移動中のナビゲーション、磁力計なしでも動作',
		limitation: '移動中のみ有効、静止時は使えない',
	},
	{
		type: 'ジャイロコンパス',
		measures: '高速回転するジャイロで地球の自転を測定',
		best: '船舶や航空機、磁場の影響を受けない',
		limitation: '大型・高価・安定するまで時間がかかる',
	},
];
---

<Layout
	path="/ja/"
	title="オンラインコンパス — 北を見つけるための無料リアルタイムツール"
	description="現在地から北を見つけるための無料オンラインコンパス。真北と磁北によるリアルタイム方位、磁気偏角、キブラファインダー、方位計算機、太陽位置 — インストール不要、すべてのスマートフォンで動作。"
	keywords="オンラインコンパス, オンラインコンパスツール, 無料オンラインコンパス, オンラインコンパス Google, オンラインコンパス 無料, オンラインコンパス 北を見つける, オンラインコンパス 方角, オンラインコンパス 幾何学, オンラインコンパスツール 幾何学, オンラインコンパス 幾何学用, オンラインコンパス 数学, 無料オンラインコンパスツール, オンラインコンパス キブラ, オンラインコンパス リアルタイム, オンラインコンパス カッバ 現在地から北を見つける, キブラファインダー オンラインコンパス"
>
	<!-- ─── Hero ───────────────────────────────────────────── -->
	<section id="compass" class="relative overflow-hidden">
		<div class="mesh-gradient" aria-hidden="true"></div>
		<div class="relative mx-auto max-w-[1200px] px-4 pt-12 pb-20 text-center sm:px-6 md:pt-20 md:pb-28">
			<Compass />
			<div class="mx-auto mt-10 max-w-3xl md:mt-14">
				<div class="badge mx-auto">無料・プライバシー重視・インストール不要</div>

				<h1 class="mx-auto mt-6 max-w-3xl text-[36px] leading-[40px] text-ink sm:text-display-xl md:text-[56px] md:leading-[56px]">真北を指すコンパス。磁気だけではありません。</h1>

				<p class="mx-auto mt-4 max-w-xl text-body-lg text-body">自動偏角補正、GPS座標、キブラ方向、太陽位置をリアルタイムで表示 — すべてブラウザ内で完結。インストール不要、データ送信なし。</p>

				<div class="mt-8 flex flex-wrap items-center justify-center gap-3">
					<a href="/ja/location/" class="btn-primary">位置情報を取得</a>
					<a href="/ja/compass/" class="btn-secondary">コンパスを開く</a>
				</div>
			</div>
		</div>
	</section>

	<!-- ─── Feature strip ──────────────────────────────────── -->
	<section class="border-y border-hairline bg-canvas">
		<div
			class="mx-auto grid max-w-[1200px] grid-cols-1 gap-px overflow-hidden px-4 py-12 sm:grid-cols-3 sm:px-6"
		>
			<div class="p-4">
				<p class="eyebrow mb-2">真北 vs 磁北</p>
				<p class="text-sm text-body leading-6">
					偏角は世界磁気モデルから自動的に計算され、両方の方位を一目で確認できます。
				</p>
			</div>
			<div class="p-4">
				<p class="eyebrow mb-2">プライバシー重視</p>
				<p class="text-sm text-body leading-6">
					すべてのセンサー処理はデバイス上で実行されます。アカウント不要、トラッキングなし、ブラウザの外にデータが送出されることはありません。
				</p>
			</div>
			<div class="p-4">
				<p class="eyebrow mb-2">どこでも動作</p>
				<p class="text-sm text-body leading-6">
					iOSとAndroidのChrome、Safari、Firefoxに対応。移動中はGPS方位フォールバックも利用可能です。
				</p>
			</div>
		</div>
	</section>

	<!-- ─── Tools grid ─────────────────────────────────────── -->
	<section id="tools" class="scroll-mt-16">
		<div class="mx-auto max-w-[1200px] px-4 py-20 sm:px-6 md:py-28">
			<p class="eyebrow">ツールキット</p>
			<h2 class="mt-3 max-w-2xl text-display-lg text-ink">
				1つのコンパスで、必要なすべての方位をカバー。
			</h2>
			<p class="mt-3 max-w-xl text-body-lg text-body">
				6つの専門ツール。それぞれ専用ページで、すべてお使いの端末上でローカルに動作します。
			</p>

			<div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
				<a href="/ja/compass/" class="card-lg group p-6 transition-shadow hover:shadow-modal">
					<p class="eyebrow mb-2">コンパス</p>
					<h3 class="text-display-sm text-ink group-hover:text-link transition-colors">リアルタイム方位</h3>
					<p class="mt-2 text-sm text-body leading-6">
						滑らかな針付き360°リアルタイムダイヤル、磁北と真北、リアルタイム精度フィードバック。
					</p>
				</a>
				<a href="/ja/location/" class="card-lg group p-6 transition-shadow hover:shadow-modal">
					<p class="eyebrow mb-2">位置情報</p>
					<h3 class="text-display-sm text-ink group-hover:text-link transition-colors">GPS座標</h3>
					<p class="mt-2 text-sm text-body leading-6">
						緯度、経度、標高、精度を10進数とDMSで表示 — コピー、共有、マップで開く機能付き。
					</p>
				</a>
				<a href="/ja/qibla/" class="card-lg group p-6 transition-shadow hover:shadow-modal">
					<p class="eyebrow mb-2">キブラ</p>
					<h3 class="text-display-sm text-ink group-hover:text-link transition-colors">メッカへの方向</h3>
					<p class="mt-2 text-sm text-body leading-6">
						現在の座標からカアバへの大圏方位と距離を度数単位で高精度に計算。
					</p>
				</a>
				<a href="/ja/bearing/" class="card-lg group p-6 transition-shadow hover:shadow-modal">
					<p class="eyebrow mb-2">方位計算機</p>
					<h3 class="text-display-sm text-ink group-hover:text-link transition-colors">コース計算機</h3>
					<p class="mt-2 text-sm text-body leading-6">
						任意の2点間の大圏方位と距離を計算 — ナビゲーションや経路計画に最適。
					</p>
				</a>
				<a href="/ja/sun/" class="card-lg group p-6 transition-shadow hover:shadow-modal">
					<p class="eyebrow mb-2">太陽</p>
					<h3 class="text-display-sm text-ink group-hover:text-link transition-colors">太陽位置</h3>
					<p class="mt-2 text-sm text-body leading-6">
						リアルタイムの太陽方位角と高度、さらに任意の場所の日の出、南中、日の入りを表示。
					</p>
				</a>
				<a href="/ja/sun-moon/" class="card-lg group p-6 transition-shadow hover:shadow-modal">
					<p class="eyebrow mb-2">太陽と月</p>
					<h3 class="text-display-sm text-ink group-hover:text-link transition-colors">太陽と月の方向</h3>
					<p class="mt-2 text-sm text-body leading-6">
						太陽と月の方位角をリアルタイムコンパスのダイヤル上に直接表示。マーカーの方向を向けば、空の太陽や月を見つけられます。
					</p>
				</a>
				<div class="card-soft flex flex-col justify-center p-6">
					<p class="text-sm text-body leading-6">
						アカウント不要、トラッキングなし。すべての計算はブラウザ内で実行され、ページを離れると削除されます。
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- ─── How it works ───────────────────────────────────── -->
	<section id="how-it-works" class="border-y border-hairline bg-canvas scroll-mt-16">
		<div class="mx-auto max-w-[1200px] px-4 py-20 sm:px-6 md:py-28">
			<p class="eyebrow">仕組み</p>
			<h2 class="mt-3 max-w-2xl text-display-lg text-ink">精度のために設計された。</h2>
			<p class="mt-3 max-w-xl text-body-lg text-body">
				スマートフォンの磁力計、ジャイロスコープ、加速度計が傾斜補正方位エンジンを駆動し、世界磁気モデルで補正されます。
			</p>

			<div class="mt-12 grid gap-6 md:grid-cols-3">
				<div class="card p-6">
					<div class="mb-4 flex h-10 w-10 items-center justify-center rounded-md border border-hairline text-ink">
						<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" aria-hidden="true">
							<circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5" />
							<path d="M15.5 8.5 13 13l-4.5 2.5L11 11z" fill="var(--color-error)" />
						</svg>
					</div>
					<h3 class="text-display-sm text-ink">センサーフュージョン</h3>
					<p class="mt-2 text-sm text-body leading-6">
						方位は姿勢と磁力計のデータから導き出され、リアルタイムに平滑化されるため、針は手の中でも安定します。
					</p>
				</div>
				<div class="card p-6">
					<div class="mb-4 flex h-10 w-10 items-center justify-center rounded-md border border-hairline text-ink">
						<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" aria-hidden="true">
							<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5" />
							<path
								d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4"
								stroke="currentColor"
								stroke-width="1.5"
							/>
							<circle cx="12" cy="12" r="3" fill="currentColor" />
						</svg>
					</div>
					<h3 class="text-display-sm text-ink">真北補正</h3>
					<p class="mt-2 text-sm text-body leading-6">
						偏角は地球上で−30°から+30°まで変化します。当サイトは世界磁気モデルを適用するので、どこにいても真北が正確になります。
					</p>
				</div>
				<div class="card p-6">
					<div class="mb-4 flex h-10 w-10 items-center justify-center rounded-md border border-hairline text-ink">
						<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" aria-hidden="true">
							<path
								d="M12 21s7-5.1 7-11a7 7 0 1 0-14 0c0 5.9 7 11 7 11Z"
								stroke="currentColor"
								stroke-width="1.5"
							/>
							<circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="1.5" />
						</svg>
					</div>
					<h3 class="text-display-sm text-ink">ローカル設計</h3>
					<p class="mt-2 text-sm text-body leading-6">
						座標、キブラ方位、太陽位置の計算はすべて端末上で完結します。位置情報がサーバーに触れることはありません。
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- ─── What is an online compass (SEO / value) ───────── -->
	<section id="about" class="scroll-mt-16">
		<div class="mx-auto max-w-[1200px] px-4 py-20 sm:px-6 md:py-24">
			<div class="mx-auto max-w-3xl">
				<p class="eyebrow text-center">無料オンラインコンパス</p>
				<h2 class="mt-3 text-center text-display-lg text-ink">オンラインコンパスとは？</h2>
				<p class="mt-6 text-body-lg text-body">
					<strong class="text-ink font-medium">オンラインコンパス</strong>とは、ウェブブラウザ上で直接動作するデジタルコンパスです。アプリのダウンロードもインストールも不要で、費用もかかりません。スマートフォンでこのページを開けば、数秒で無料のオンラインコンパスが使え、現在の方位を度数でリアルタイムに表示し、どこにいても北を指し示し、磁北と真北の差を自動的に補正します。
				</p>
				<p class="mt-4 text-body leading-7">
					ブラウザの中で動くため、自宅でも野外でも教室でも同じように使えます。Googleで「オンラインコンパス」を検索してこのサイトを開けば、あとはデバイスのセンサーが引き継ぎます。重力やドリフトと戦う針を持つ従来のコンパスとは異なり、オンラインコンパスはスマートフォンの磁力計、ジャイロスコープ、加速度計を組み合わせて、より安定した信頼性の高い
					<strong class="text-ink font-medium">オンラインコンパスの方向</strong>を算出します。
				</p>
				<p class="mt-4 text-body leading-7">
					ここにあるすべてのツールは、向きを定めて
					<strong class="text-ink font-medium">オンラインで北を見つける</strong>という1つの目的を中心に作られています。その周りには、度数によるリアルタイムの方位表示、基本方位と中間方位、ワンタップのフルスクリーンモード、そして読み取りをどこまで信頼すべきかがわかる精度インジケーターといった、ナビゲーションのためのツール一式がそろっています。すべてがローカルで処理されるため、位置情報がデバイスの外部に出ることはありません。
				</p>
			</div>

			<div class="mx-auto mt-12 grid max-w-5xl gap-6 md:grid-cols-3">
				<div class="card p-6">
					<h3 class="text-display-sm text-ink">オンラインコンパスの仕組み</h3>
					<p class="mt-2 text-sm text-body leading-6">
						<strong class="text-ink font-medium">3つのセンサー</strong>が働きます。磁力計は地球の磁場を測定し、加速度計はどちらが下かを検知し、ジャイロスコープは回転を追跡します。ブラウザがこれらを1つの方位に統合し、傾斜補正によってスマートフォンが水平でなくても正確さを保ちます。
					</p>
				</div>
				<div class="card p-6">
					<h3 class="text-display-sm text-ink">オンラインコンパスと従来のコンパスの比較</h3>
					<p class="mt-2 text-sm text-body leading-6">
						針のコンパスはシンプルですが、水平に置かなければならず、常に磁北を指します — 地図上の北ではありません。オンラインコンパスは、方位の正確な度数、自動的な偏角補正、そして暗い場所でも読める表示を追加します。
					</p>
				</div>
				<div class="card p-6">
					<h3 class="text-display-sm text-ink">あえてブラウザコンパスを使う理由</h3>
					<p class="mt-2 text-sm text-body leading-6">
