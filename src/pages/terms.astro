---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Terms & Conditions"
	description="Terms & conditions for Accurate Online Compass — a free, browser-based tool. Use at your own discretion; not for safety-critical navigation."
	path="/terms/"
>
	<div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 md:py-24">
		<p class="eyebrow">legal</p>
		<h1 class="mt-4 text-display-lg text-ink">Terms &amp; Conditions</h1>
		<p class="mt-3 text-sm text-mute">Last updated: {new Date().toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}</p>

		<div class="mt-10 space-y-8 text-body">
			<section>
				<h2 class="text-display-sm text-ink mb-3">Acceptance</h2>
				<p class="leading-7">
					By using accurateonlinecompass.com ("the Service") you agree to these terms. If you do
					not agree, please do not use the Service.
				</p>
			</section>

			<section>
				<h2 class="text-display-sm text-ink mb-3">The Service</h2>
				<p class="leading-7">
					The Service provides browser-based tools including a compass, location readout, Qibla
					finder, bearing calculator, and sun position calculator. Tools are provided free of
					charge and without warranty.
				</p>
			</section>

			<section>
				<h2 class="text-display-sm text-ink mb-3">Not for safety-critical use</h2>
				<p class="leading-7 mb-3">
					The Service is a consumer tool, not an instrument-grade navigation device. Sensor
					accuracy varies by device and environment. Do not rely on it for:
				</p>
				<ul class="list-disc space-y-2 pl-5 leading-7">
					<li>Aviation, maritime, or off-road navigation.</li>
					<li>Emergency or life-safety situations.</li>
					<li>Surveys, legal boundaries, or construction requiring certified accuracy.</li>
				</ul>
			</section>

			<section>
				<h2 class="text-display-sm text-ink mb-3">No warranty</h2>
				<p class="leading-7">
					The Service is provided "as is" and "as available." To the maximum extent permitted by
					law, we make no warranties, express or implied, regarding its availability, accuracy,
					or fitness for any purpose.
				</p>
			</section>

			<section>
				<h2 class="text-display-sm text-ink mb-3">Limitation of liability</h2>
				<p class="leading-7">
					To the maximum extent permitted by law, we shall not be liable for any indirect,
					incidental, special, or consequential damages arising from your use of the Service,
					including any loss arising from reliance on its output.
				</p>
			</section>

			<section>
				<h2 class="text-display-sm text-ink mb-3">Changes</h2>
				<p class="leading-7">
					We may update these terms from time to time. Continued use of the Service after changes
					constitutes acceptance of the updated terms.
				</p>
			</section>

			<section>
				<h2 class="text-display-sm text-ink mb-3">Contact</h2>
				<p class="leading-7">
					Questions about these terms? Reach us via the <a href="/contact/" class="text-link underline decoration-link/30 hover:decoration-link">contact page</a>.
				</p>
			</section>

			<section class="border-t border-hairline pt-8">
				<h2 class="text-display-sm text-ink mb-3">About this online compass</h2>
				<p class="leading-7">
					Accurate Online Compass is a free, browser-based toolkit: a live
					<a href="/" class="text-link underline decoration-link/30 hover:decoration-link">online compass</a>
					for true and magnetic north, a
					<a href="/location/" class="text-link underline decoration-link/30 hover:decoration-link">GPS coordinates</a>
					reader, a
					<a href="/qibla/" class="text-link underline decoration-link/30 hover:decoration-link">Qibla finder</a>
					to face the Kaaba, a
					<a href="/bearing/" class="text-link underline decoration-link/30 hover:decoration-link">bearing calculator</a>
					for direction and distance, and a
					<a href="/sun/" class="text-link underline decoration-link/30 hover:decoration-link">sun position calculator</a>.
					All tools run entirely in your browser — free, private, and available on any phone
					without an install. Find out more on the
					<a href="/about/" class="text-link underline decoration-link/30 hover:decoration-link">about page</a>.
				</p>
			</section>
		</div>
	</div>
</Layout>