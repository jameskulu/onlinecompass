				<a href="/blog/how-to-use-online-compass/" class="btn-secondary">전체 가이드 읽기</a>
			</div>
		</div>
	</section>

	<script type="application/ld+json" set:html={JSON.stringify({
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: faq.map((f) => ({
			'@type': 'Question',
