---
import Layout from '../../layouts/Layout.astro';
import Compass from '../../components/Compass.astro';

const faq = [
	{
		q: '어느 방향을 보고 있나요 — 온라인 나침반?',
		a: '이 페이지를 휴대폰에서 열면 다이얼 아래의 실시간 향読み取り에서 현재 보고 있는 정확한 도수와 나침반 방향(N, NE, E, SE, S, SW, W, NW)을 실시간으로 확인할 수 있습니다.',
	},
	{
		q: '온라인 나침반 — 북쪽은 어디인가요?',
		a: '바늘의 빨간 끝은 항상 북쪽을 가리키며, 다이얼 상단에서 0°/360°로 표시됩니다. "진북"으로 전환하면 현재 위치의 자극편위를 자동 보정하여 지도와 일치하도록 북쪽을 맞춰줍니다.',
	},
	{
		q: '어느 방향을 보고 있나요 — 온라인 나침반?',
		a: '휴대폰을 평평하게 들고 센서 접근을 허용하면, 다이얼 아래에 도수와 나침반 방향(예: 274° 또는 W)으로 현재 보고 있는 방향을 알려줍니다.',
	},
	{
		q: '나침반 없이 온라인으로 방향을 어떻게 알 수 있나요?',
		a: '태양을 이용하세요: 현지 정오 무렵에 북반구에서는 정확히 남쪽, 남반구에서는 정확히 북쪽에 위치합니다. 이 사이트의 태양 도구는 모든 위치에서 정확한 태양 방위각을 보여주며, 키블라 finder도 고정된 기준 방향으로 사용할 수 있습니다.',
	},
	{
		q: '어느 방향을 보고 있나요 — 온라인 나침반?',
	a: '센서 접근을 허용하고, 휴대폰을 금속에서 떨어뜨려 평평하게 들면, 향 읽기에서 회전할 때마다 지속적으로 업데이트되는 방향을 확인할 수 있습니다.',
	},
	{
		q: '온라인 나침반을 어떻게 사용하나요?',
		a: '휴대폰에서 이 페이지를 열고 "실시간 나침반 활성화"를 탭한 후 기기를 평평하게 들고 향을 읽으세요. 바늘이 흔들리면 8자 모양을 몇 번 그리며 자력계를 재보정하세요.',
	},
	{
		q: '내 휴대폰을 나침반으로 사용할 수 있나요?',
		a: '네. 최신 휴대폰에는 자력계가 내장되어 있으며, 이 웹사이트는 해당 센서를 브라우저 바로크기나 나침반으로 변환합니다 — 앱 다운로드나 설치가 필요 없습니다.',
	},
	{
		q: '구글에서 내 나침반은 어디에 있나요?',
		a: '구글 지도는 지도 보기 우측 상단에 작은 나침반을 표시합니다. 도수로 된 실시간 향을 보려면 구글에서 "온라인 나침반"을 검색하고 이 페이지를 열면 됩니다 — 센서 접근을 허용하는 순간 나침반으로 작동합니다.',
	},
	{
		q: '내 휴대폰이 어떤 방향을 보고 있는지 알려줄 수 있나요?',
		a: '네. 휴대폰의 자력계와 이 페이지가 결합되어 실시간 향을 제공하며, 자극편위를 자동으로 보정하여 북쪽이 지도와 일치하도록 합니다.',
	},
	{
		q: '모바일에서 나침반을 어떻게 볼 수 있나요?',
		a: '이 페이지를 휴대폰에서 열면 앱 설치 없이 바로 나침반이 표시됩니다. 안드로이드에서는 구글 지도에도 나침반이 포함되어 있으며, 일부 휴대폰에는 내장 나침반 앱이 제공됩니다.',
	},
	{
		q: '나의 북쪽 방향은 어디인가요?',
		a: '진북은 지리학적 북극점이고, 자북은 나침반 바늘이 가리키는 방향입니다. 두 방향 사이의 각도(편위각)는 위치에 따라 다르며, 이 사이트가 자동으로 보정합니다.',
	},
	{
		q: '내 휴대폰에서 나침반은 어디에 있나요?',
		a: '많은 휴대폰에는 전용 나침반 앱이 없지만 센서는 내장되어 있습니다. 이 웹사이트를 휴대폰에서 열면 설치 없이 나침반으로 작동합니다.',
	},
	{
		q: '어떤 휴대폰에 자력계 센서가 있나요?',
		a: '거의 모든 최신 스마트폰 — iPhone 3GS 이후의 모든 아이폰과 거의 모든 안드로이드 휴대폰 — 에 자력계가 포함되어 있어, 이 온라인 나침반은 거의 모든 기기에서 작동합니다.',
	},
	{
		q: '왜 향이 불안정하게 움직이나요?',
		a: '주변의 금속과 전자기기가 자력계를 왜곡합니다. 위의 보정 단계를 따르고, 휴대폰을 평평하게 유지하세요. 실내에서 몇 도 정도의 흔들림은 정상입니다.',
	},
	{
		q: '자기 북쪽과 진북의 차이점은 무엇인가요?',
		a: '자기 북쪽은 나침반 바늘이 가리키는 방향이고, 진북은 지리학적 북극점으로 지도와 내비게이션에서 사용됩니다. 두 방향 사이의 각도(편위각)는 위치에 따라 다르며, 이 도구가 자동으로 보정합니다.',
	},
	{
		q: '왜 위치를 요청하나요?',
		a: '위치를 통해 자극편위, 키블라 방향, 태양 위치를 정밀하게 계산할 수 있습니다. 위치 정보는 선택 사항이며 — 모든 도구는 수동 좌표로도 작동합니다 — 기기 밖으로 전송되지 않습니다.',
	},
	{
		q: '위치 정보를 저장하거나 판매하나요?',
		a: '아니요. 추적기, 분석 도구, 백엔드가 없습니다. 모든 센서 및 위치 데이터는 브라우저에서 로컬로 처리되며 떠날 때 삭제됩니다.',
	},
];
---

<Layout
	path="/ko/"
	title="온라인 나침반 — 북쪽을 찾는 무료 실시간 도구"
	description="현재 위치에서 북쪽을 찾는 무료 온라인 나침반. 진북 및 자북 실시간 향, 자극편위, 키블라 finder, 방위각 계산기, 태양 위치 — 설치 없이 모든 휴대폰에서 작동."
	keywords="온라인 나침반, 온라인 나침반 도구, 무료 온라인 나침반, 온라인 나침반 구글, 온라인 나침반 무료, 온라인 나침반 북쪽 찾기, 온라인 나침반 방향, 온라인 나침반 기하학, 온라인 나침반 기하학 도구, 온라인 나침반 기하학용, 온라인 나침반 수학, 무료 온라인 나침반 도구, 온라인 나침반 키블라용, 온라인 나침반 실시간, 온라인 나침반 카바 북쪽 찾기, 키블라 파인더 온라인 나침반"
>
	<!-- ─── 히어로 ──────────────────────── -->
	<section id="compass" class="relative overflow-hidden">
		<div class="mesh-gradient" aria-hidden="true"></div>
		<div
			class="relative mx-auto max-w-[1200px] px-4 pb-20 pt-16 text-center sm:px-6 md:pb-28 md:pt-24"
		>
			<div class="badge mx-auto">무료 · 개인정보 보호 · 설치 불필요</div>

			<h1
				class="mx-auto mt-6 max-w-3xl text-[36px] leading-[40px] text-ink sm:text-display-xl md:text-[56px] md:leading-[56px]"
			>
				진북을 가리키는 나침반, 자기 북쪽만이 아닌.
			</h1>

			<p class="mx-auto mt-4 max-w-xl text-body-lg text-body">
				자동 자극편위 보정이 적용된 실시간 기기 향, GPS 좌표, 키블라 방향,
				태양 위치 — 모두 브라우저에서 제공됩니다. 설치할 것도, 업로드할 것도 없습니다.
			</p>

			<div class="mt-8 flex flex-wrap items-center justify-center gap-3">
				<a href="/ko/location/" class="btn-primary">내 위치 찾기</a>
				<a href="/ko/compass/" class="btn-secondary">나침반 열기</a>
			</div>

			<div class="mx-auto mt-12 max-w-xl md:mt-16">
				<Compass />
			</div>
		</div>
	</section>

	<!-- ─── 기능 소개 스트립 ──────────────── -->
	<section class="border-y border-hairline bg-canvas">
		<div
			class="mx-auto grid max-w-[1200px] grid-cols-1 gap-px overflow-hidden px-4 py-12 sm:grid-cols-3 sm:px-6"
		>
			<div class="p-4">
				<p class="eyebrow mb-2">진북 vs 자북</p>
				<p class="text-sm text-body leading-6">
					편위각은 세계자기모형에 의해 자동으로 계산됩니다 — 두 향을
					한눈에 확인할 수 있습니다.
				</p>
			</div>
			<div class="p-4">
				<p class="eyebrow mb-2">개인정보 보호 우선</p>
				<p class="text-sm text-body leading-6">
					모든 센서 처리는 기기 내에서 이루어집니다. 계정도, 추적도,
					브라우저 밖으로 나가는 데이터도 없습니다.
				</p>
			</div>
			<div class="p-4">
				<p class="eyebrow mb-2">모든 곳에서 작동</p>
				<p class="text-sm text-body leading-6">
					iOS 및 Android의 Chrome, Safari, Firefox에서 작동하며,
					이동 중에는 GPS 향 대체 기능을 제공합니다.
				</p>
			</div>
		</div>
	</section>

	<!-- ─── 도구 그리드 ────────────────── -->
	<section id="tools" class="scroll-mt-16">
		<div class="mx-auto max-w-[1200px] px-4 py-20 sm:px-6 md:py-28">
			<p class="eyebrow">도구 모음</p>
			<h2 class="mt-3 max-w-2xl text-display-lg text-ink">
				하나의 나침반, 필요한 모든 방위각.
			</h2>
			<p class="mt-3 max-w-xl text-body-lg text-body">
				각각 별도 페이지의 5가지 전문 도구, 모두 기기 내에서 로컬로 작동합니다.
			</p>

			<div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
				<a href="/ko/compass/" class="card-lg group p-6 transition-shadow hover:shadow-modal">
					<p class="eyebrow mb-2">나침반</p>
					<h3 class="text-display-sm text-ink group-hover:text-link transition-colors">실시간 향</h3>
					<p class="mt-2 text-sm text-body leading-6">
						매끄러운 바늘의 실시간 360° 다이얼, 자북 및 진북,
						그리고 실시간 정확도 피드백.
					</p>
				</a>
				<a href="/ko/location/" class="card-lg group p-6 transition-shadow hover:shadow-modal">
					<p class="eyebrow mb-2">위치</p>
					<h3 class="text-display-sm text-ink group-hover:text-link transition-colors">GPS 좌표</h3>
					<p class="mt-2 text-sm text-body leading-6">
						위도, 경도, 고도, 그리고 소수점 및 DMS 형식의 정확도 —
						복사, 공유, 지도에서 열기 기능 포함.
					</p>
				</a>
				<a href="/ko/qibla/" class="card-lg group p-6 transition-shadow hover:shadow-modal">
					<p class="eyebrow mb-2">키블라</p>
					<h3 class="text-display-sm text-ink group-hover:text-link transition-colors">메카 방향</h3>
					<p class="mt-2 text-sm text-body leading-6">
						현재 좌표에서 카바까지의 대원 방위각과 거리,
						도 단위로 정확하게 계산됩니다.
					</p>
				</a>
				<a href="/ko/bearing/" class="card-lg group p-6 transition-shadow hover:shadow-modal">
					<p class="eyebrow mb-2">방위각</p>
					<h3 class="text-display-sm text-ink group-hover:text-link transition-colors">경로 계산기</h3>
					<p class="mt-2 text-sm text-body leading-6">
						두 지점 간의 방위각과 대원 거리 — 내비게이션과
						경로 계획에 이상적입니다.
					</p>
				</a>
				<a href="/ko/sun/" class="card-lg group p-6 transition-shadow hover:shadow-modal">
					<p class="eyebrow mb-2">태양</p>
					<h3 class="text-display-sm text-ink group-hover:text-link transition-colors">태양 위치</h3>
					<p class="mt-2 text-sm text-body leading-6">
						현재 태양의 방위각과 고도, 그리고 어떤 위치에서든
						일출, 태양 남중, 일몰 시간.
					</p>
				</a>
				<div class="card-soft flex flex-col justify-center p-6">
					<p class="text-sm text-body leading-6">
						계정 없음. 추적 없음. 모든 계산은 브라우저에서 실행되며
						페이지를 떠나는 순간 삭제됩니다.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- ─── 작동 방식 ──────────────────── -->
	<section id="how-it-works" class="border-y border-hairline bg-canvas scroll-mt-16">
		<div class="mx-auto max-w-[1200px] px-4 py-20 sm:px-6 md:py-28">
			<p class="eyebrow">작동 방식</p>
			<h2 class="mt-3 max-w-2xl text-display-lg text-ink">정확성을 위해 설계되었습니다.</h2>
			<p class="mt-3 max-w-xl text-body-lg text-body">
				휴대폰의 자력계, 자이로스코프, 가속도계가 기울기 보상 향 엔진에 데이터를 공급하며,
				세계자기모형으로 보정됩니다.
			</p>

			<div class="mt-12 grid gap-6 md:grid-cols-3">
				<div class="card p-6">
					<div class="mb-4 flex h-10 w-10 items-center justify-center rounded-md border border-hairline text-ink">
						<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" aria-hidden="true">
							<circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5" />
							<path d="M15.5 8.5 13 13l-4.5 2.5L11 11z" fill="var(--color-error)" />
						</svg>
					</div>
					<h3 class="text-display-sm text-ink">센서 융합</h3>
					<p class="mt-2 text-sm text-body leading-6">
						향은 방향 및 자력계 데이터에서 도출되며, 실시간으로 매끄럽게 처리되어
						바늘이 손 안에서 안정적으로 유지됩니다.
					</p>
				</div>
				<div class="card p-6">
					<div class="mb-4 flex h-10 w-10 items-center justify-center rounded-md border border-hairline text-ink">
						<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" aria-hidden="true">
							<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5" />
							<path
								d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4"
								stroke="currentColor"
								stroke-width="1.5"
							/>
							<circle cx="12" cy="12" r="3" fill="currentColor" />
						</svg>
					</div>
					<h3 class="text-display-sm text-ink">진북 보정</h3>
					<p class="mt-2 text-sm text-body leading-6">
						편위각은 지구 전역에서 -30°에서 +30°까지 다양합니다.
						세계자기모형을 적용하여 어떤 위치에서든 진북이 정확합니다.
					</p>
				</div>
				<div class="card p-6">
					<div class="mb-4 flex h-10 w-10 items-center justify-center rounded-md border border-hairline text-ink">
						<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" aria-hidden="true">
							<path
								d="M12 21s7-5.1 7-11a7 7 0 1 0-14 0c0 5.9 7 11 7 11Z"
								stroke="currentColor"
								stroke-width="1.5"
							/>
							<circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="1.5" />
						</svg>
					</div>
					<h3 class="text-display-sm text-ink">로컬 설계</h3>
					<p class="mt-2 text-sm text-body leading-6">
						좌표, 키블라 방위각, 태양 위치 계산은 모두 기기 내에서 이루어집니다.
