---
import Layout from '../../layouts/Layout.astro';
import Compass from '../../components/Compass.astro';

const faq = [
	{
		q: '온라인 나침반이란 무엇인가요?',
		a: '온라인 나침반은 별도 앱이 아니라 웹 브라우저 안에서 실행되는 디지털 나침반입니다. 휴대폰의 자력계, 가속도계, 자이로스코프를 읽어 실시간 방향을 도수로 바꿔 줍니다 — 다운로드가 필요 없습니다. 이 페이지처럼 나침반 페이지를 열고 센서 접근을 허용하면, 기기를 돌릴 때마다 다이얼이 실시간으로 갱신됩니다.',
	},
	{
		q: '휴대폰에서 온라인 나침반을 어떻게 사용하나요?',
		a: '휴대폰에서 이 페이지를 열고 "실시간 나침반 활성화"를 누른 뒤 기기를 손바닥에 평평하게 들고 있으세요. 방향이 다이얼 아래에 도수와 나침반 방위로 나타납니다. 가장 정확한 결과를 얻으려면 8자 모양으로 기기를 움직여 자력계를 보정하고, 금속과 자석에서 떨어뜨려 두세요.',
	},
	{
		q: '온라인 나침반은 정확한가요?',
		a: '보정된 휴대폰 나침반은 실외에서 보통 약 1~5도 이내의 정확도를 보입니다. 자력계 자체가 민감해서 주변 금속이나 전자기기, 자석이 들어간 휴대폰 케이스가 오차를 키울 수 있습니다. 보정을 마치고 간섭 요인에서 벗어나면, 대개 실제 나침반과 몇 도 이내로 일치합니다.',
	},
	{
		q: '진북과 자북의 차이는 무엇인가요?',
		a: '자북은 휴대폰 자력계가 가리키는 방향으로, 해마다 조금씩 움직이는 지구 자기장을 따릅니다. 진북은 지도에서 사용하는 지리적 북극점입니다. 두 방향 사이의 각도를 자극편위(편각)라고 하며, 이 도구는 이를 자동으로 보정하여 방향이 지도와 일치하도록 맞춰 줍니다.',
	},
	{
		q: '자극편위(편각)란 무엇인가요?',
		a: '자극편위는 특정 위치에서 자북과 진북 사이의 각도입니다. 전 세계에서 대략 −30°에서 +30° 사이이며 시간이 지나면서 천천히 변합니다. 런던에서는 거의 0°에 가깝지만, 캐나다 일부 지역에서는 15°를 넘기도 합니다. 위치마다 다르기 때문에, 방위를 따라 이동할 때는 GPS로 정확히 계산한 편각 보정이 중요합니다.',
	},
	{
		q: '나침반 바늘이 갑자기 흔들리거나 계속 돌아가는 이유는 무엇인가요?',
		a: '자력계는 민감한 계측기입니다. 자석이 들어간 휴대폰 케이스, 스피커, 노트북, 금속 테이블, 자동차 대시보드, 철골 건물 등이 주변 자기장을 왜곡합니다. 이런 것들에서 멀어져 기기를 평평하게 들고 8자를 그리며 다시 보정하세요. 실내에서 몇 도 정도 흔들리는 것은 정상입니다.',
	},
	{
		q: '휴대폰 나침반은 어떻게 보정하나요?',
		a: '기기를 평평하게 들고 화면이 위를 향하도록 한 상태에서 천천히 여러 번 8자 모양으로 회전시키세요. 그러면 자력계가 다양한 범위의 값을 읽어 보정할 수 있습니다. 마지막에 잠시 가만히 두세요. 방향이 불안정해 보일 때마다 반복하면 됩니다.',
	},
	{
		q: '온라인 나침반이 오프라인에서도 작동하나요? 노트북에서도 되나요?',
		a: '페이지가 한 번 로드되면 방향이 기기에서 생성되므로 오프라인에서도 다이얼은 계속 작동합니다. 다만 대부분의 노트북과 데스크톱에는 자력계가 없어 실시간 방향은 읽을 수 없습니다. 휴대폰이나 태블릿을 사용하세요. 컴퓨터에서도 데모 다이얼과 태양·달 정보는 볼 수 있습니다.',
	},
	{
		q: '온라인 나침반이 내 위치를 요청하나요? 개인정보는 안전한가요?',
		a: '위치는 선택 사항이며 자극편위, 키블라 방위, 태양 위치를 계산할 때만 사용됩니다. 모든 계산은 브라우저에서 로컬로 실행되며 계정도, 백엔드도, 분석 도구도 없습니다. 좌표는 기기 밖으로 나가지 않으며, 언제든 좌표를 직접 입력할 수도 있습니다.',
	},
	{
		q: '온라인 나침반으로 키블라를 찾을 수 있나요?',
		a: '네. 키블라 파인더는 현재 좌표를 이용해 메카의 카바를 향하는 대원 방위와 거리를 도 단위로 정확하게 계산합니다. 그 방위를 실시간 나침반 다이얼에서 따라가면 그 방향을 향할 수 있습니다.',
	},
	{
		q: '나침반 없이 북쪽을 찾는 방법은 무엇인가요?',
		a: '북반구에서는 현지 정오에 태양이 정남쪽에 있어 그림자가 북쪽을 가리킵니다. 밤에는 북극성(폴라리스)이 진북 거의 바로 위에 있습니다. 이 사이트의 태양 위치 도구는 현재 위치와 시각에 따른 정확한 태양 방위각을 알려주므로 어떤 나침반이든 교차 검증하는 데 유용합니다.',
	},
	{
		q: '이 나침반을 쓰려면 앱을 설치해야 하나요?',
		a: '아니요. 모든 것이 브라우저에서 실행되므로 다운로드도, 앱스토어도, 가입도, 업데이트 관리도 필요하지 않습니다. iPhone, Android, 대부분의 태블릿에서 동일하게 작동합니다.',
	},
	{
		q: '이 온라인 나침반은 무료인가요?',
		a: '네, 완전히 무료이며 유료 등급이나 결제 장벽이 없습니다. 나침반, GPS 좌표, 키블라 파인더, 방위각 계산기, 태양 위치, 태양·달 방향 등 사이트의 모든 도구를 무료로 사용할 수 있습니다.',
	},
	{
		q: '우리 집이나 창문은 어느 방향을 향하고 있나요?',
		a: '창문 앞에 서서 바깥을 향해 기기를 평평하게 들고 방향을 읽으세요. 북쪽은 0°, 동쪽은 90°, 남쪽은 180°, 서쪽은 270°입니다. 정원사는 이 정보로 일조량을 계획하고, 사진가들은 해가 뜨고 지는 위치를 예측합니다.',
	},
	{
		q: '어떤 휴대폰에 자력계 센서가 있나요?',
		a: '거의 모든 최신 스마트폰 — 모든 아이폰과 대부분의 안드로이드 휴대폰 — 에 자력계가 내장되어 있어, 이 온라인 나침반은 거의 모든 기기에서 작동합니다.',
	},
	{
		q: '구글 지도의 나침반과는 어떻게 다른가요?',
		a: '구글 지도는 지도 보기 우측 상단에 작은 나침반을 표시하는 정도지만, 이 온라인 나침반은 도수로 된 실시간 방향과 자극편위 보정, 나침반 방위, GPS 좌표, 키블라, 태양 위치까지 한곳에서 제공합니다.',
	},
];

const declinationExamples = [
	{ place: '런던, 영국', value: '≈ 0°' },
	{ place: '파리, 프랑스', value: '≈ +1° 동쪽' },
	{ place: '뉴욕, 미국', value: '≈ −13° 서쪽' },
	{ place: '토론토, 캐나다', value: '≈ −11° 서쪽' },
	{ place: '로스앤젤레스, 미국', value: '≈ +12° 동쪽' },
	{ place: '앵커리지, 미국', value: '≈ +15° 동쪽' },
	{ place: '시드니, 호주', value: '≈ +12° 동쪽' },
	{ place: '상파울루, 브라질', value: '≈ −23° 서쪽' },
	{ place: '케이프타운, 남아프리카 공화국', value: '≈ −25° 서쪽' },
	{ place: '도쿄, 일본', value: '≈ −8° 서쪽' },
];

const compassRose = [
	{ point: 'N', deg: '0°' },
	{ point: 'NNE', deg: '22.5°' },
	{ point: 'NE', deg: '45°' },
	{ point: 'ENE', deg: '67.5°' },
	{ point: 'E', deg: '90°' },
	{ point: 'ESE', deg: '112.5°' },
	{ point: 'SE', deg: '135°' },
	{ point: 'SSE', deg: '157.5°' },
	{ point: 'S', deg: '180°' },
	{ point: 'SSW', deg: '202.5°' },
	{ point: 'SW', deg: '225°' },
	{ point: 'WSW', deg: '247.5°' },
	{ point: 'W', deg: '270°' },
	{ point: 'WNW', deg: '292.5°' },
	{ point: 'NW', deg: '315°' },
	{ point: 'NNW', deg: '337.5°' },
];

const compassTypes = [
	{
		type: '전통 자침 나침반',
		measures: '부침 바늘로 지구 자기장을 측정',
		best: '오프라인 신뢰성, 배터리 불필요, 교육용',
		limitation: '수평한 표면 필요, 자극편위 보정 불가, 단일 센서',
	},
	{
		type: '휴대폰 센서 나침반(이 사이트)',
		measures: '자력계와 가속도계·자이로스코프를 융합',
		best: '도수 단위의 실시간 방향, 기울기 보상, 지도 정렬',
		limitation: '주변 금속과 자석에 민감',
	},
	{
		type: 'GPS 진행 방향 나침반',
		measures: 'GPS 위치 변화로부터의 이동 방향',
		best: '이동 중 내비게이션, 자력계 없이도 작동',
		limitation: '이동할 때만 작동, 정지 상태에서는 무용',
	},
	{
		type: '자이로 컴퍼스',
		measures: '고속 회전 자이로스코프로 지구 자전을 측정',
		best: '선박과 항공기, 자기장의 영향 없음',
		limitation: '크고 비싸며, 안정화가 느림',
	},
];
---

<Layout
	path="/ko/"
	title="온라인 나침반 — 북쪽을 찾는 무료 실시간 도구"
	description="현재 위치에서 북쪽을 찾는 무료 온라인 나침반. 진북 및 자북 실시간 향, 자극편위, 키블라 finder, 방위각 계산기, 태양 위치 — 설치 없이 모든 휴대폰에서 작동."
	keywords="온라인 나침반, 온라인 나침반 도구, 무료 온라인 나침반, 온라인 나침반 구글, 온라인 나침반 무료, 온라인 나침반 북쪽 찾기, 온라인 나침반 방향, 온라인 나침반 기하학, 온라인 나침반 기하학 도구, 온라인 나침반 기하학용, 온라인 나침반 수학, 무료 온라인 나침반 도구, 온라인 나침반 키블라용, 온라인 나침반 실시간, 온라인 나침반 카바 북쪽 찾기, 키블라 파인더 온라인 나침반"
>
	<!-- ─── 히어로 ─────────────────────────────────────────── -->
	<section id="compass" class="relative overflow-hidden">
		<div class="mesh-gradient" aria-hidden="true"></div>
		<div class="relative mx-auto max-w-[1200px] px-4 pt-12 pb-20 text-center sm:px-6 md:pt-20 md:pb-28">
			<Compass />
			<div class="mx-auto mt-10 max-w-3xl md:mt-14">
				<div class="badge mx-auto">무료 · 개인정보 보호 · 설치 불필요</div>

				<h1 class="mx-auto mt-6 max-w-3xl text-[36px] leading-[40px] text-ink sm:text-display-xl md:text-[56px] md:leading-[56px]">자북만이 아니라 진북을 가리키는 나침반.</h1>

				<p class="mx-auto mt-4 max-w-xl text-body-lg text-body">자동 자극편위 보정이 적용된 실시간 기기 방향, GPS 좌표, 키블라 방향,
				태양 위치 — 모두 브라우저 안에서. 설치할 것도, 업로드할 것도 없습니다.</p>

				<div class="mt-8 flex flex-wrap items-center justify-center gap-3">
					<a href="/ko/location/" class="btn-primary">내 위치 찾기</a>
					<a href="/ko/compass/" class="btn-secondary">나침반 열기</a>
				</div>
			</div>
		</div>
	</section>

	<!-- ─── 기능 소개 스트립 ────────────────────────────────── -->
	<section class="border-y border-hairline bg-canvas">
		<div
			class="mx-auto grid max-w-[1200px] grid-cols-1 gap-px overflow-hidden px-4 py-12 sm:grid-cols-3 sm:px-6"
		>
			<div class="p-4">
				<p class="eyebrow mb-2">진북 vs 자북</p>
				<p class="text-sm text-body leading-6">
					자극편위는 세계자기모형(World Magnetic Model)으로 자동 계산됩니다 — 두
					방향을 한눈에 확인하세요.
				</p>
			</div>
			<div class="p-4">
				<p class="eyebrow mb-2">개인정보 보호 우선</p>
				<p class="text-sm text-body leading-6">
					모든 센서 처리는 기기 안에서 이루어집니다. 계정도, 추적도 없으며, 어떤
					데이터도 브라우저를 벗어나지 않습니다.
				</p>
			</div>
			<div class="p-4">
				<p class="eyebrow mb-2">어디서나 작동</p>
				<p class="text-sm text-body leading-6">
					iOS와 Android의 Chrome, Safari, Firefox에서 작동하며, 이동 중에는
					GPS 방향 대체 기능을 제공합니다.
				</p>
			</div>
		</div>
	</section>

	<!-- ─── 도구 그리드 ─────────────────────────────────────── -->
	<section id="tools" class="scroll-mt-16">
		<div class="mx-auto max-w-[1200px] px-4 py-20 sm:px-6 md:py-28">
			<p class="eyebrow">도구 모음</p>
			<h2 class="mt-3 max-w-2xl text-display-lg text-ink">
				하나의 나침반, 필요한 모든 방위.
			</h2>
			<p class="mt-3 max-w-xl text-body-lg text-body">
				각각 별도 페이지에 있는 여섯 가지 도구, 모두 기기에서 로컬로 실행됩니다.
			</p>

			<div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
				<a href="/ko/compass/" class="card-lg group p-6 transition-shadow hover:shadow-modal">
					<p class="eyebrow mb-2">나침반</p>
					<h3 class="text-display-sm text-ink group-hover:text-link transition-colors">실시간 방향</h3>
					<p class="mt-2 text-sm text-body leading-6">
						매끄러운 바늘이 있는 실시간 360° 다이얼, 자북과 진북, 그리고 실시간
						정확도 피드백.
					</p>
				</a>
				<a href="/ko/location/" class="card-lg group p-6 transition-shadow hover:shadow-modal">
					<p class="eyebrow mb-2">위치</p>
					<h3 class="text-display-sm text-ink group-hover:text-link transition-colors">GPS 좌표</h3>
					<p class="mt-2 text-sm text-body leading-6">
						위도, 경도, 고도, 정확도를 소수점과 DMS 형식으로 — 복사, 공유,
						지도에서 열기 기능 포함.
					</p>
				</a>
				<a href="/ko/qibla/" class="card-lg group p-6 transition-shadow hover:shadow-modal">
