---
import Layout from '../../layouts/Layout.astro';
import Compass from '../../components/Compass.astro';

const faq = [
	{
		"q": "온라인 디지털 나침반이란 무엇이며 웹 브라우저에서 어떻게 작동합니까?",
		"a": "온라인 디지털 나침반은 별도의 앱 설치 없이 W3C DeviceOrientation API를 통해 스마트폰에 내장된 물리적 MEMS 센서(자력계, 가속도계, 자이로스코프)를 브라우저에서 직접 읽어내는 웹 애플리케이션입니다. 자바스크립트로 구동되는 실시간 삼각함수 기울기 보정 알고리즘을 통해 휴대폰을 기울여도 0°~360°의 정확한 방위각을 즉각 계산합니다."
	},
	{
		"q": "진북(True North)과 자북(Magnetic North)의 차이점은 무엇입니까?",
		"a": "진북은 지구의 자전축에 위치한 지리적 북극점(모든 경선이 모이는 지점)을 가리키며 지도와 GPS의 기준입니다. 자북은 지구 내부 외핵의 대류로 형성된 지구 자기장 선이 수직으로 들어가는 북극해 지점으로 매년 수십 킬로미터씩 이동합니다. 이 둘 사이의 각도 차이를 자기 편각이라고 부릅니다."
	},
	{
		"q": "자기 편각이란 무엇이며 왜 정확한 내비게이션에 필수적입니까?",
		"a": "자기 편각은 현재 위치에서 자북과 진북 사이의 수평 각도 차이입니다. 서울은 약 −8°~−9° 서편각, 뉴욕은 약 −13° 서편각을 가집니다. 편각을 보정하지 않으면 이동 거리가 길어질수록 실제 목표 지점에서 수백 미터 이상 벗어납니다. 본 나침반은 미국 NOAA의 세계 자기 모델(WMM)을 탑재하여 지도 좌표와 일치하도록 편각을 자동 계산합니다."
	},
	{
		"q": "스마트폰 나침반을 최고 정밀도로 보정(캘리브레이션)하는 방법은 무엇입니까?",
		"a": "휴대폰을 손바닥 위에 평평하게 올려놓고 화면이 하늘을 향한 상태에서 공중에 큰 8자(∞) 모양을 그리며 5~10초간 부드럽게 회전시키십시오. 이를 통해 3축 자력계가 지구 자기장을 전 방위에서 감지하여 내부 스피커나 금속 부품으로 인한 고유 자기장 왜곡을 상쇄합니다."
	},
	{
		"q": "나침반 바늘이 심하게 떨리거나 제자리에서 헛도는 이유는 무엇입니까?",
		"a": "주변의 강한 전자기 간섭이 원인입니다. 자석이 포함된 휴대폰 케이스, 맥세이프 액세서리, 노트북, 철근 콘크리트 기둥, 자동차 대시보드 등 금속 물체로부터 최소 2미터 이상 떨어진 후 8자 회전 캘리브레이션을 진행하십시오."
	},
	{
		"q": "스마트폰 나침반은 전통적인 아날로그 나침반에 비해 얼마나 정확합니까?",
		"a": "금속 간섭이 없는 야외에서 캘리브레이션을 마친 스마트폰 MEMS 자력계는 ±1°~±3° 수준의 정확도를 보여주며, 일반 액체 제동식 실바 나침반과 대등합니다. 또한 경사 보정과 진북 자동 변환 기능을 갖추고 있습니다. 다만 극한의 설산 등반 시에는 배터리가 필요 없는 실물 나침반을 비상용으로 함께 소지하는 것이 좋습니다."
	},
	{
		"q": "이 온라인 나침반은 오프라인 및 비행기 탑승 모드에서도 작동합니까?",
		"a": "네, 작동합니다. 본 사이트는 오프라인 우선 Progressive Web App(PWA) 기술로 구축되었습니다. 모든 실행 코드와 WMM 자기장 계산 데이터는 브라우저의 서비스 워커에 캐시되므로 인터넷 연결이나 통신망이 없는 깊은 산속에서도 완벽하게 작동합니다."
	},
	{
		"q": "데스크톱 PC나 노트북에서 나침반이 데모 모드로 표시되는 이유는 무엇입니까?",
		"a": "실시간 나침반 기능은 자기장을 감지하는 물리적 센서(자력계) 하드웨어가 필요합니다. 스마트폰과 태블릿에는 기본 탑재되어 있으나, 일반 노트북과 데스크톱 PC에는 센서가 없습니다. PC 환경에서는 시뮬레이션 다이얼과 태양/좌표 계산기가 제공됩니다."
	},
	{
		"q": "키블라(Qibla) 나침반은 메카 방향을 어떻게 정밀하게 찾아냅니까?",
		"a": "본 도구는 사용자의 현재 GPS 좌표에서 사우디아라비아 메카의 카바 신전(북위 21° 25' 21\", 동경 39° 49' 34\")까지의 대권 항로(대원 방위각)를 구면삼각법으로 계산합니다. 나침반 외곽의 에메랄드색 카바 마커에 몸의 방향을 맞추면 정확하게 메카를 향할 수 있습니다."
	},
	{
		"q": "내 집, 발코니 또는 정원이 향하고 있는 방위를 확인하려면 어떻게 합니까?",
		"a": "창문이나 문 앞마당에 서서 스마트폰을 수평으로 쥐고 정면을 바라보십시오. 나침반 각도가 315°~45° 사이라면 북향이며, 135°~225° 사이라면 사계절 일조량이 가장 풍부한 남향입니다. 동향은 아침 햇살을, 서향은 따뜻한 오후 햇살을 받습니다."
	}
];

