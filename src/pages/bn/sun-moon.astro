---
import Layout from '../../layouts/Layout.astro';
import SunMoonCompass from '../../components/SunMoonCompass.astro';

import RelatedTools from '../../components/RelatedTools.astro';
---

<Layout
	title="কম্পাসে সূর্য ও চাঁদের দিক — লাইভ অজিমুথ"
	description="কম্পাস ডায়াগ্রাম থেকে সূর্য ও চাঁদের দিক খুঁজে বের করুন। যেকোনো অবস্থানের জন্য ডায়ালে আঁকা সূর্যের অজিমুথ এবং চাঁদের অজিমুথসহ সেন্সরের লাইভ হেডিং।"
	path="/bn/sun-moon/"
	keywords="সূর্যের দিক, চাঁদের দিক, সূর্যের অজিমুথ, চাঁদের অজিমুথ, কম্পাসে সূর্য খুঁজে বের করা, সূর্যের অবস্থান, চাঁদের অবস্থান"
>
	<section class="relative overflow-hidden">
		<div class="mesh-gradient" aria-hidden="true"></div>
		<div class="relative flex flex-col items-center justify-center px-4 pt-12 pb-8 sm:pt-16 sm:pb-10 md:pt-20 md:pb-12">
			<SunMoonCompass />
			<div class="mt-10 max-w-2xl text-center md:mt-14">
				<p class="eyebrow">সূর্য ও চাঁদের দিক</p>
				<h1 class="mt-4 text-display-lg text-ink md:text-[40px] md:leading-[48px]">কম্পাসে সূর্য ও চাঁদ দেখুন।</h1>
				<p class="mt-4 text-body-lg text-body">সূর্যের অজিমুথ এবং চাঁদের অজিমুথ সরাসরি ডায়ালে আঁকা একটি লাইভ ফোন কম্পাস। মার্কারের দিকে মুখ করুন এবং আপনি সূর্য বা চাঁদের দিকেই তাকিয়ে আছেন — আন্দাজ করার দরকার নেই।</p>
			</div>
		</div>
	</section>

	<section class="border-y border-hairline bg-canvas">
		<div class="mx-auto max-w-[1200px] grid gap-6 px-4 py-16 sm:px-6 md:grid-cols-3">
			<div>
				<p class="eyebrow mb-2">যেভাবে পড়বেন</p>
				<p class="text-sm text-body leading-6">
					লাল কাঁটা উত্তর দিকে নির্দেশ করে। ডায়ালের দুইটি রঙিন বিন্দু সূর্য (অ্যাম্বার) ও চাঁদের (নীল)
					কম্পাসের দিক দেখায়। একটি বিন্দুর দিকে মুখ না করা পর্যন্ত ঘুরুন যাতে সরাসরি সেটির দিকে তাকাতে
					পারেন।
				</p>
			</div>
			<div>
				<p class="eyebrow mb-2">লাইভ আপডেট</p>
				<p class="text-sm text-body leading-6">
					দিন ও রাত এগোনোর সঙ্গে সঙ্গে সূর্য ও চাঁদের মার্কার স্বয়ংক্রিয়ভাবে নতুন অবস্থানে সরে যায়।
					অজিমুথগুলো আপনার মাথার উপরের আকাশের সঙ্গে মিলিয়ে নিতে নিজের অবস্থান ব্যবহার করুন।
				</p>
			</div>
			<div>
				<p class="eyebrow mb-2">শুধু সংখ্যা নয়, দিক</p>
				<p class="text-sm text-body leading-6">
					অজিমুথ হলো পরম দিক। ডায়াল সেগুলো আপনার প্রকৃত হেডিংয়ের উপর বসায়, তাই মেঘের আড়ালেও আপনি
					সূর্য বা চাঁদ তাৎক্ষণিকভাবে খুঁজে পেতে পারেন।
				</p>
			</div>
		</div>
	</section>

	<section class="border-t border-hairline bg-canvas">
		<div class="mx-auto max-w-3xl px-4 py-20 sm:px-6 md:py-24">
			<p class="eyebrow">সূর্য ও চাঁদের দিক নির্ণয় টুল</p>
			<h2 class="mt-3 text-display-lg text-ink">কম্পাস ডায়াগ্রাম থেকে সূর্য ও চাঁদের দিক খুঁজে বের করুন</h2>

			<p class="mt-6 text-body-lg text-body">
				এই পৃষ্ঠাটি <strong class="text-ink font-medium">সূর্যের দিক</strong> এবং
				<strong class="text-ink font-medium">চাঁদের দিক</strong> সরাসরি একটি লাইভ কম্পাস ডায়াগ্রামের
				উপরে স্থাপন করে। অ্যাম্বার বা নীল মার্কার যেখানেই থাকে সেটিই সূর্য বা চাঁদ দেখতে যে দিকে ঘুরতে
				হবে সেই কম্পাসের দিক। জ্যোতির্বিজ্ঞান সম্পর্কে জ্ঞান ছাড়াই
				<strong class="text-ink font-medium">কম্পাসে সূর্য খুঁজে বের করার</strong> দ্রুততম উপায় এটি।
			</p>
			<p class="mt-4 leading-7">
				অজিমুথ প্রকৃত উত্তরের ঘড়ির কাঁটার দিকে পরিমাপ করা হয়: 0° উত্তর, 90° পূর্ব, 180° দক্ষিণ এবং 270°
				পশ্চিম। টুলটি আপনার স্থানাঙ্কের জন্য দুই বস্তুর লাইভ অজিমুথ গণনা করে এবং আপনার প্রকৃত হেডিংয়ের
				পাশে ডায়ালে এঁকে দেয়, যাতে ডায়াগ্রাম সবসময় সঠিক দিক দেখায়।
			</p>

			<h3 class="mt-10 text-display-sm text-ink">ডায়ালে সূর্য ও চাঁদ পড়া</h3>
			<p class="mt-3 leading-7">
				<strong class="text-ink font-medium">অ্যাম্বার মার্কার</strong> হলো সূর্য এবং
				<strong class="text-ink font-medium">নীল মার্কার</strong> হলো চাঁদ। প্রত্যেকটি বস্তুটির হেডিং
				ডিগ্রি ও মূলদিক হিসেবে দেখায়, সাথে দিগন্তের ওপর এর উচ্চতাও দেখায়। কোনো মার্কার যখন ডায়ালের বাইরে
				নির্দেশ করে বা কম উচ্চতা দেখায়, তখন সেই বস্তুটি দিগন্তের নিচে — মানে আপনার পায়ের নিচে, দৃশ্যমান নয়।
			</p>
			<p class="mt-4 leading-7">
				সূর্য পূর্ব দিকে ওঠে এবং পশ্চিম দিকে অস্ত যায়, তাই (উত্তর গোলার্ধে) সকাল থেকে বিকেল এর মার্কার
				ডায়ালের উত্তর অর্ধ বৃত্ত অতিক্রম করে। চাঁদ একই রকম পথ ধরে তবে প্রতি দিন প্রায় ১২ ডিগ্রি পিছিয়ে
				যায়, তাই কম্পাসে এর অবস্থান দিনে দিনে বদলে যায়।
			</p>

			<h3 class="mt-10 text-display-sm text-ink">সূর্য ও চাঁদ খুঁজতে কম্পাস কেন ব্যবহার করবেন</h3>
			<p class="mt-3 leading-7">
				কম্পাসের দিক আকাশের স্থানাঙ্কের সেটের চেয়ে অনেক বেশি কার্যকর। আপনি ছবি তুলছেন, ছায়ার পরিকল্পনা
				করছেন, স্যাটেলাইট ডিশ সারিবদ্ধ করছেন, আলো কোথায় পড়বে তা দেখছেন, বা আজ রাতে চাঁদ কোথায় সেটাই
				শুধু জানতে চান না কেন — দিকটিকে কম্পাসের একটি বিন্দু হিসেবে দেখা এটিকে সঙ্গে সঙ্গেই কার্যকর করে
				তোলে: ঘুরুন, আর দেখে নিন।
			</p>
			<p class="mt-4 leading-7">
				সবকিছু আপনার ব্রাউজারে স্থানীয়ভাবে চলে এবং কোনো ডেটা আপলোড হয় না।
				<a href="/bn/sun/" class="text-link underline decoration-link/30 hover:decoration-link">সূর্যের অবস্থান ক্যালকুলেটর</a>
				এবং
				<a href="/bn/compass/" class="text-link underline decoration-link/30 hover:decoration-link">অনলাইন কম্পাস</a>
				এর সাথে মিলিয়ে যে যেখানেই থাকুন, মাথার উপরে কী রয়েছে তার পূর্ণ চিত্র পেয়ে যাবেন।
			</p>
		</div>
	</section>

	<RelatedTools current="/sun-moon/" />
</Layout>