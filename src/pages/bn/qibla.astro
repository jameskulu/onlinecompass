---
import Layout from '../../layouts/Layout.astro';
import QiblaFinder from '../../components/QiblaFinder.astro';
import PageHero from '../../components/PageHero.astro';
import RelatedTools from '../../components/RelatedTools.astro';
---

<Layout
	title="কিবলা ফাইন্ডার অনলাইন — আমার অবস্থান থেকে কাব্বার দিক"
	description="কিবলার জন্য অনলাইন কম্পাস — আমার অবস্থান থেকে কাব্বার দিক খুঁজুন। মক্কার সাথে মহাসাগরীয় বেয়ারিং এবং দূরত্ব সহ কিবলা ফাইন্ডার, আপনার ব্রাউজারে গোপনীয়ভাবে গণনা করা হয়।"
	path="/bn/qibla/"
	keywords="কিবলার জন্য অনলাইন কম্পাস, কিবলা ফাইন্ডার অনলাইন কম্পাস, অনলাইন কম্পাস কাব্বা আমার অবস্থান থেকে উত্তর খুঁজে বের করতে, কিবলা দিক, কাব্বার দিক, আমার অবস্থান থেকে কিবলা খুঁজুন"
>
	<PageHero
		eyebrow="কিবলা ফাইন্ডার"
		title="পৃথিবীর যেকোনো স্থান থেকে কাব্বার দিকে মুখ করুন।"
		description="মক্কার সাথে মহাসাগরীয় বেয়ারিং আপনার কো-অর্ডিনেট থেকে আপনার ডিভাইসে গণনা করা হয় — ডিগ্রি পর্যন্ত নির্ভুল, নকশায় গোপনীয়।"
	>
		<QiblaFinder />
	</PageHero>

	<section class="border-y border-hairline bg-canvas">
		<div class="mx-auto max-w-[1200px] grid gap-6 px-4 py-16 sm:px-6 md:grid-cols-2">
			<div>
				<p class="eyebrow mb-2">কীভাবে গণনা করা হয়</p>
				<p class="text-sm text-body leading-6">
					বেয়ারিংটি আপনার অবস্থান এবং কাব্বার (২১.৪২২৫° উত্তর, ৩৯.৮২৬২° পূর্ব) মধ্যে সবুট মহাসাগরীয় পথ ব্যবহার করে। এটি পৃথিবীর বক্রতা বিবেচনা করে, তাই এটি একটি সমতল কম্পাস-গোলাকার রিডিংয়ের চেয়ে আলাদা।
				</p>
			</div>
			<div>
				<p class="eyebrow mb-2">বাস্তবে প্রয়োগ করুন</p>
				<p class="text-sm text-body leading-6">
					বেয়ারিংটি নোট করুন, তারপর কম্পাস টুল খুলুন এবং আপনার হেডিং এর সাথে মিলে যাওয়া পর্যন্ত ঘোরান। অথবা সেরা নির্ভুলতার জন্য ধাতব থেকে দূরে বাইরে ক্যালিব্রেট করুন।
				</p>
			</div>
		</div>
	</section>

	<section class="border-t border-hairline bg-canvas">
		<div class="mx-auto max-w-3xl px-4 py-20 sm:px-6 md:py-24">
			<p class="eyebrow">কিবলা ফাইন্ডার</p>
			<h2 class="mt-3 text-display-lg text-ink">আমার অবস্থান থেকে কিবলা দিক খুঁজুন</h2>

			<p class="mt-6 text-body-lg text-body">
				একটি <strong class="text-ink font-medium">কিবলা ফাইন্ডার অনলাইন</strong> আপনাকে প্রার্থনার জন্য মুখ করার সুনির্দিষ্ট দিক বলে — আপনি যেখানেই আছেন সেখান থেকে সৌদি আরবের মক্কায় কাব্বায় (২১.৪২২৫° উত্তর, ৩৯.৮২৬২° পূর্ব) বেয়ারিং। এই পৃষ্ঠটি আপনার লাইভ
				অবস্থান অথবা আপনি যেকোনো কো-অর্ডিনেট প্রবেশ করেন সেটি থেকে সেই দিক গণনা করে, ডিগ্রিতে বেয়ারিং এবং কম্পাস দিক উভয়ই দেখায়, পাশাপাশি মক্কার সাথে মহাসাগরীয় দূরত্ব। কোনো অ্যাপ নেই, ইনস্টল নেই, কোনো
				অ্যাকাউন্ট নেই — পৃষ্ঠটি খুলুন এবং কোন দিকে নামাজ পড়তে হবে তা জানুন।
			</p>
			<p class="mt-4 leading-7">
				বিশ্বের মুসলমানরা দিনে পাঁচ বার কাব্বার দিকে মুখ করে নামাজ পড়ে এবং
				দিক সঠিকভাবে পাওয়া গুরুত্বপূর্ণ। আপনি ভ্রমণ করছেন, একটি এলাকায় নতুন, বা সহজেই
				আপনার বাড়িতে দিকটি নিশ্চিত করতে চান, এই বিনামূল্যের <strong class="text-ink font-medium">কিবলা
				ফাইন্ডার অনলাইন কম্পাস</strong> সেকেন্ডের মধ্যে আপনাকে একটি নির্ভুল উত্তর দেয়।
			</p>

			<h3 class="mt-10 text-display-sm text-ink">কাব্বার দিক কীভাবে গণনা করা হয়</h3>
			<p class="mt-3 leading-7">
				<strong class="text-ink font-medium">আমার অবস্থান থেকে কাব্বার দিক</strong> একটি
				সমতল মানচিত্র শর্টকাট নয়। যেহেতু পৃথিবী বক্র, সঠিক বেয়ারিং দুটি বিন্দুর মধ্যে সবুট মহাসাগরীয়
				পথ অনুসরণ করে। লন্ডন থেকে মক্কার বেয়ারিং প্রায় ১১৮°,
				নিউইয়র্ক থেকে প্রায় ৫৮°, জাকার্তা থেকে প্রায় ২৯৫° এবং সিডনি থেকে প্রায় ২৯৫° উত্তরের
				পশ্চিমে — সংখ্যা যা অনেক মানুষকে অবাক করে ঠিক যেহেতু এগুলো মহাসাগরীয়
				বেয়ারিং, সোজা-রেখা মানচিত্র দিক নয়। এই টুলটি বিমান নেভিগেশনে ব্যবহৃত একই গোলকীয়
				ত্রিকোণমিতি সম্পাদন করে, তাই ফলাফল পৃথিবীর যেকোনো স্থানে ডিগ্রি পর্যন্ত নির্ভুল।
			</p>
			<p class="mt-4 leading-7">
				যেহেতু গণনাটি সম্পূর্ণরূপে আপনার ব্রাউজারে চলে, আপনার কো-অর্ডিনেট কখনই একটি
				সার্ভারে পাঠানো হয় না। অনেক অনলাইন কিবলা টুল লুকোচুরি করে আপনার অবস্থান লগ করে; এটি করতে পারে না। এটি
				একটি যতটা নির্ভুল ততটা গোপনীয় কিবলার জন্য অনলাইন কম্পাস।
			</p>

			<h3 class="mt-10 text-display-sm text-ink">কিবলা বেয়ারিং বাস্তবে প্রয়োগ করা</h3>
			<p class="mt-3 leading-7">
				একবার আপনি বেয়ারিং পেলে, পরবর্তী ধাপ হলো এটিকে একটি শারীরিকভাবে
				মুখ করার দিকে রূপান্তরিত করা। সবচেয়ে সহজ পদ্ধতি: বেয়ারিং ডিগ্রিতে নোট করুন, খুলুন
				<a href="/" class="text-link underline decoration-link/30 hover:decoration-link">লাইভ অনলাইন কম্পাস</a>,
				এবং আপনার হেডিং কিবলা বেয়ারিংয়ের সাথে মিলে যাওয়া পর্যন্ত ঘোরান। কম্পাস ডায়াল
				বাস্তব সময়ে আপনার হেডিং দেখায়, তাই এটির সাথে মিলাতে সেকেন্ড লাগে।
			</p>
			<p class="mt-4 leading-7">
				সেরা ফলাফলের জন্য, উভয় টুলে "অবস্থান ব্যবহার করুন" ট্যাপ করুন যাতে বিচ্যুতি সংশোধিত হয় এবং
				রিডিং প্রকৃত-উত্থিত হয়। আপনার হাতে কম্পাস না থাকলে, আপনি সূর্য দিয়েও নিজেকে সাজাতে পারেন:
				উত্তর গোলার্ধে স্থানীয় দুপুরে সূর্য ঠিক দক্ষিণে থাকেন, দক্ষিণ গোলার্ধে ঠিক উত্তরে — বেয়ারিং
				দিয়ে বারীক সাজানোর আগে আপনার সাধারণ অরিয়েন্টেশন বের করার একটি নির্ভরযোগ্য দিনের আলোর রেফারেন্স পয়েন্ট।
			</p>

			<div class="mt-10 grid gap-4 sm:grid-cols-2">
				<div class="card-soft p-5">
					<h4 class="text-sm font-medium text-ink mb-1">সাধারণ অনুসন্ধান: "অনলাইন কম্পাস কাব্বা আমার অবস্থান থেকে উত্তর খুঁজে বের করতে"</h4>
					<p class="text-sm leading-6">
						সেই বাক্যাংশটি ঠিক এই টুলটি যা উত্তর দেয়। নিজেকে অবস্থান করুন, কিবলা বেয়ারিং পড়ুন, তারপর কম্পাসে এটি অনুসরণ করুন — পৃথিবীর যেকোনো অবস্থান থেকে কিবলার জন্য একটি বিনামূল্যের অনলাইন কম্পাস।
					</p>
				</div>
				<div class="card-soft p-5">
					<h4 class="text-sm font-medium text-ink mb-1">মক্কার সাথে দূরত্ব</h4>
					<p class="text-sm leading-6">
						বেয়ারিংয়ের পাশাপাশি আপনি কাব্বার সাথে মহাসাগরীয় দূরত্ব পান — ভ্রমণ
						পরিকল্পনা এবং দূরত্বের সাথে বেয়ারিং কীভাবে পরিবর্তিত হয় তা বোঝার জন্য সহায়ক।
					</p>
				</div>
			</div>

			<h3 class="mt-10 text-display-sm text-ink">আপনার অবস্থানের সাথে পরিবর্তিত কিবলা দিক</h3>
			<p class="mt-3 leading-7">
				আপনার <strong class="text-ink font-medium">কিবলা দিক</strong> সম্পূর্ণভাবে নির্ভর করে
				আপনি কোথায় আছেন তার উপর। এটি শহর থেকে শহর এমনকি রাস্তা থেকে রাস্তা পরিবর্তিত হয়, তাই বছর আগে একটি
				দেশে দেখা একটি মান আরেকটিতে সাধারণত সঠিক নয়। তাই একটি লাইভ
				ক্যালকুলেটর নির্ভরযোগ্য পছন্দ: এটি আপনার বর্তমান
				কো-অর্ডিনেটের জন্য প্রতিবার তাজা বেয়ারিং গণনা করে। কয়েকশো কিলোমিটার ভ্রমণ করলে বেয়ারিং কয়েক
				ডিগ্রি সরতে পারে — এবং এই পৃষ্ঠটি স্বয়ংক্রিয়ভাবে তাড়া করে।
			</p>
			<p class="mt-4 leading-7">
				টুলটি ম্যানুয়াল কো-অর্ডিনেটেও কাজ করে, যা সুবিধাজনক যখন আপনি ভ্রমণ করতে যাওয়া একটি জায়গার জন্য দিক পরীক্ষা করতে চান, অথবা আপনার ব্রাউজার অনুমতি বন্ধ থাকলে। একটি শহর অথবা কো-অর্ডিনেট প্রবেশ করুন এবং কিবলা ফাইন্ডার একই নির্ভুল বেয়ারিং এবং
				দূরত্ব ফেরত দেয়। "আমার অবস্থান থেকে কিবলা খুঁজুন" প্রশ্ন যেখানেই, এই পৃষ্ঠটি উত্তর দেয় —
				গোপনীয়ভাবে, সুনির্দিষ্টভাবে এবং বিনামূল্যে।
			</p>
		</div>
	</section>

	<RelatedTools current="/qibla/" />
</Layout>
