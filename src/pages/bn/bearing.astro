---
import Layout from '../../layouts/Layout.astro';
import BearingCalculator from '../../components/BearingCalculator.astro';
import PageHero from '../../components/PageHero.astro';
import RelatedTools from '../../components/RelatedTools.astro';
---

<Layout
	title="বেয়ারিং ক্যালকুলেটর অনলাইন — দুটি বিন্দুর মধ্যে দিক ও দূরত্ব"
	description="দুটি কো-অর্ডিনেটের মধ্যে বেয়ারিং এবং মহাসাগরীয় দূরত্ব গণনা করার বিনামূল্যের অনলাইন কম্পাস টুল। আপনার অবস্থান থেকে কিবলা দিক, চৌম্বক বিচ্যুতি এবং সূর্যের অবস্থানও দেখায়।"
	path="/bn/bearing/"
	keywords="অনলাইন কম্পাস গণিত, অনলাইন কম্পাস জ্যামিতি, বেয়ারিং ক্যালকুলেটর, দুটি বিন্দুর মধ্যে দিক, মহাসাগরীয় দূরত্ব, অনলাইনে বেয়ারিং ক্যালকুলেটর"
>
	<PageHero
		eyebrow="বেয়ারিং ক্যালকুলেটর"
		title="একটি কোর্স প্লট করুন, ডিগ্রি ডিগ্রি করে।"
		description="পৃথিবীর যেকোনো দুটি বিন্দুর মধ্যে প্রাথমিক বেয়ারিং এবং মহাসাগরীয় দূরত্ব গণনা করুন — আপনার লাইভ অবস্থান, ম্যানুয়াল কো-অর্ডিনেট, বা একটি প্রি-সেট রুট থেকে।"
	>
		<BearingCalculator />
	</PageHero>

	<section class="border-y border-hairline bg-canvas">
		<div class="mx-auto max-w-[1200px] grid gap-6 px-4 py-16 sm:px-6 md:grid-cols-2">
			<div>
				<p class="eyebrow mb-2">প্রাথমিক বনাম চূড়ান্ত বেয়ারিং</p>
				<p class="text-sm text-body leading-6">
					এটি প্রাথমিক বেয়ারিং ফিরতি দেয় — আপনি যে দিকে রওনা দেন। দীর্ঘ রুটে
					বেয়ারিং মহাসাগরীয় পথে পরিবর্তিত হয়, তাই মাঝ-কোর্স সংশোধন স্বাভাবিক।
				</p>
			</div>
			<div>
				<p class="eyebrow mb-2">কম্পাসের সাথে ব্যবহার করুন</p>
				<p class="text-sm text-body leading-6">
					আপনার গণনা করা বেয়ারিং কম্পাস টুলে নিন এবং হেডিং মিলে যাওয়া পর্যন্ত চালনা করুন। মানচিত্র-নির্ভুল চালনার জন্য প্রকৃত উত্তরে স্যুইচ করুন।
				</p>
			</div>
		</div>
	</section>

	<section class="border-t border-hairline bg-canvas">
		<div class="mx-auto max-w-3xl px-4 py-20 sm:px-6 md:py-24">
			<p class="eyebrow">বেয়ারিং ক্যালকুলেটর</p>
			<h2 class="mt-3 text-display-lg text-ink">দুটি বিন্দুর মধ্যে বেয়ারিং এবং দূরত্ব গণনা করুন</h2>

			<p class="mt-6 text-body-lg text-body">
				একটি <strong class="text-ink font-medium">অনলাইনে বেয়ারিং ক্যালকুলেটর</strong> পৃথিবীর
				যেকোনো দুটি বিন্দুর মধ্যে দিক এবং দূরত্ব খুঁজে বের করে। দুটি সেট কো-অর্ডিনেট প্রবেশ করুন —
				অথবা একটি প্রান্তে আপনার লাইভ অবস্থান ব্যবহার করুন — এবং এই টুলটি ডিগ্রিতে প্রাথমিক বেয়ারিং,
				কম্পাস দিক এবং কিলোমিটারে মহাসাগরীয় দূরত্ব ফিরতি দেয়। এটি নেভিগেশন, রুট পরিকল্পনা, সার্ভে এবং অধ্যয়নের জন্য অপরিহার্য
				<strong class="text-ink font-medium">অনলাইন কম্পাস গণিত</strong> টুল।
			</p>
			<p class="mt-4 leading-7">
				বেয়ারিং হলো উত্তর থেকে আপনার যে দিকে ভ্রমণ করতে হবে তা ঘড়ির কাঁটার দিকে পরিমাপ কোণ: ০° উত্তর, ৯০° পূর্ব, ১৮০° দক্ষিণ, ২৭০° পশ্চিম। লন্ডন থেকে নিউইয়র্কের রুট, উদাহরণস্বরূপ, প্রায় ২৮৮° প্রাথমিক বেয়ারিং দিয়ে শুরু হয় — এটি কম্পাস দিক যা আপনি রওনা দেওয়ার মুহূর্তে বিমানের নাক বা জাহাজের নৌকা ঘোরান।
			</p>

			<h3 class="mt-10 text-display-sm text-ink">প্রাথমিক বেয়ারিং বনাম চূড়ান্ত বেয়ারিং</h3>
			<p class="mt-3 leading-7">
				যেহেতু পৃথিবী একটি গোলক, <strong class="text-ink font-medium">দুটি বিন্দুর মধ্যে দিক</strong> মানচিত্রে একটি সোজা রেখা নয়। সবুট রুট একটি মহাসাগরীয় অনুসরণ করে এবং সেই রুটে বেয়ারিং ধারাবাহিকভাবে পরিবর্তিত হয়। "প্রাথমিক বেয়ারিং" হলো আপনার শুরুর বিন্দুতে দিক — প্রথমে আপনি যেটি চালনা করেন। দীর্ঘ রুটে বেয়ারিং যাওয়ার সাথে সাথে ডোলে, তাই পাইলট এবং নেভিগেটররা ওয়েপয়েন্ট এবং মাঝ-কোর্স সংশোধন ব্যবহার করে। এই ক্যালকুলেটরটি প্রাথমিক বেয়ারিং রিপোর্ট করে এবং মহাসাগরীয় পথের চূড়ান্ত বেয়ারিংও গণনা করে।
			</p>
			<p class="mt-4 leading-7">
				ছোট ভ্রমণের জন্য — একটি হাইক, একটি শহর জুড়ে ড্রাইভ, দুটি মানচিত্র বিন্দুর মধ্যে হাঁটা — প্রাথমিক বেয়ারিং কার্যত পুরো কোর্স। এটি এই অনলাইনে বেয়ারিং ক্যালকুলেটরকে দৈনিক পরিকল্পনার পাশাপাশি ক্লাসরুম জ্যামিতির জন্য নিখুঁত করে।
			</p>

			<h3 class="mt-10 text-display-sm text-ink">নেভিগেটর যেভাবে মাপে তেমনি দূরত্ব</h3>
			<p class="mt-3 leading-7">
				বেয়ারিংয়ের পাশাপাশি আপনি মহাসাগরীয় দূরত্ব পান — দুটি বিন্দুর মধ্যে পৃথিবীর পৃষ্ঠের ওপর সবুট দূরত্ব, হ্যাভারসিন সূত্র দিয়ে গণনা করা। একটি সমতল মানচিত্রে রুলারের বিপরীতে, এটি গ্রহের বক্রতা বিবেচনা করে, তাই ফলাফল বাস্তব ভ্রমণ দূরত্বের সাথে মিলে। এটি ফ্লাইট পরিকল্পনা এবং সামুদ্রিক নেভিগেশনে ব্যবহৃত একই গণনা।
			</p>
			<p class="mt-4 leading-7">
				টুলটি একটি সাধারণ ক্যালকুলেটরের চেয়ে এগিয়ে যায়। প্রি-সেট তালিকা থেকে একটি গন্তব্য বাছাই করুন — বিশ্বের প্রধান শহর এবং মক্কায় কাব্বা সহ — এবং এটি সারসংক্ষেপ গণনা করে ("নিউইয়র্ক লন্ডন থেকে ২৪৫° পশ্চিম-দক্ষিণ-পশ্চিম, ৫,৫৭০ কিমি দূরে") এবং পয়েন্ট A থেকে চারটি অতিরিক্ত রিডআউট:
				<a href="/bn/qibla/" class="text-link underline decoration-link/30 hover:decoration-link">কিবলা দিক</a>,
				চৌম্বক বিচ্যুতি এবং
				<a href="/bn/sun/" class="text-link underline decoration-link/30 hover:decoration-link">সূর্যের অবস্থান</a>।
				একটি এন্ট্রি, এবং আপনি দেখতে পান আপনার কম্পাস, কিবলা এবং সৌর ডেটা আপনার রুটের সাথে কীভাবে সারিবদ্ধ হয়।
			</p>

			<h3 class="mt-10 text-display-sm text-ink">কম্পাসের সাথে বেয়ারিং ব্যবহার করুন</h3>
			<p class="mt-3 leading-7">
				এই টুলের প্রাকৃতিক সঙ্গী হলো
				<a href="/" class="text-link underline decoration-link/30 hover:decoration-link">অনলাইন কম্পাস</a>।
				আপনার বেয়ারিং গণনা করুন, কম্পাস খুলুন এবং হেডিং মিলে যাওয়া পর্যন্ত ঘোরান। মানচিত্র উত্তরের সাথে আপনার চালনা মিলিয়ে যাওয়ার জন্য কম্পাস প্রকৃত উত্তরে স্যুইচ করুন — এবং কম্পাসকে আপনার অবস্থানের বিচ্যুতি স্বয়ংক্রিয়ভাবে প্রয়োগ করতে দিন। এই সমন্বয় একটি পৃষ্ঠায় সংখ্যাকে একটি কোর্সে রূপান্তরিত করে যা আপনি সত্যিই হাঁটতে, নৌকায় যেতে বা গাড়ি চালাতে পারেন।
			</p>
			<p class="mt-4 leading-7">
				এই অনলাইনে বেয়ারিং ক্যালকুলেটরটি হাইকের আগে রুট পরিকল্পনা, অ্যান্টেনা এবং সৌর প্যানেল সারিবদ্ধ করা, দুটি ঠিকানার মধ্যে ভ্রমণ অনুমান, একটি কম্পাস কোর্স ডাবল-চেক করা, বা হোমওয়ার্ক যাচাই করার জন্য উপযোগী। যেহেতু সবকিছু আপনার ব্রাউজারে স্থানীয়ভাবে চলে, এটি সর্বত্র আত্মবিশ্বাসের সাথে ব্যবহার করার একটি গোপনীয়, বিনামূল্যের অনলাইন কম্পাস জ্যামিতি টুল — কোনো ইনস্টল, কোনো অ্যাকাউন্ট, কোনো ডেটা সংগ্রহ নেই।
			</p>

			<h3 class="mt-10 text-display-sm text-ink">ডিগ্রি, দিক এবং পরিকল্পনা</h3>
			<p class="mt-3 leading-7">
				ডিগ্রিতে পড়া বেয়ারিং সুনির্দিষ্ট কিন্তু অমূর্ত; তাই টুলটি সেগুলোকে সরল কম্পাস দিকেও রূপান্তরিত করে। ৪৫° হয়ে যায় উত্তর-পূর্ব, ২০০° হয়ে যায় দক্ষিণ-দক্ষিণ-পশ্চিম, এবং তাই পরে — তাই আপনি "আমাকে কোন দিকে যেতে হবে?" প্রশ্নের উত্তর দিতে পারেন একই ভাষায় যে ভাষায় কম্পাস বা মানচিত্র কথা বলে। আপনার লাইভ অবস্থান পয়েন্ট A এবং একটি গন্তব্য পয়েন্ট B হিসাবে প্রবেশ করুন এবং পুরো ছবি — বেয়ারিং, দিক, দূরত্ব, কিবলা, বিচ্যুতি এবং সূর্য — তাৎক্ষণিকভাবে আপডেট হয়। এটি আপনার প্রকৃত কো-অর্ডিনেটের চারপাশে তৈরি একটি অনলাইন কম্পাস গণিত টুলের ক্ষমতা।
			</p>
		</div>
	</section>

	<RelatedTools current="/bearing/" />
</Layout>
