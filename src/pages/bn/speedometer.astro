---
import Layout from '../../layouts/Layout.astro';
import Speedometer from '../../components/Speedometer.astro';
import PageHero from '../../components/PageHero.astro';
import RelatedTools from '../../components/RelatedTools.astro';
---

<Layout
	title="অনলাইন জিপিএস স্পিডোমিটার — রিয়েল-টাইম গতি ও অল্টিমিটার"
	description="বিনামূল্যে অনলাইন জিপিএস স্পিডোমিটার এবং উচ্চ নির্ভুলতার অল্টিমিটার। ব্রাউজারেই km/h, mph, knots বা m/s এককে তাৎক্ষণিক গতি, উচ্চতা ও ট্রিপ দূরত্ব মাপুন।"
	path="/bn/speedometer/"
	keywords="জিপিএস স্পিডোমিটার অনলাইন, গতি পরিমাপক, অল্টিমিটার অনলাইন, গাড়ির গতি মাপক"
>
	<PageHero
		eyebrow="জিপিএস স্পিডোমিটার · অল্টিমিটার"
		title="যেকোনো ডিভাইসে সঠিক গতি ও উচ্চতা নির্ণয়।"
		description="স্যাটেলাইট নেভিগেশনের মাধ্যমে আপনার ভূমির সাপেক্ষে প্রকৃত গতি এবং সমুদ্রপৃষ্ঠ থেকে উচ্চতা পরিমাপ করুন।"
	>
		<Speedometer />
	</PageHero>

	<section class="border-t border-hairline bg-canvas">
		<div class="mx-auto max-w-3xl px-4 py-20 sm:px-6 md:py-24">
			<p class="eyebrow">জিপিএস স্পিডোমিটার · অল্টিমিটার</p>
			<h2 class="mt-3 text-display-lg text-ink">অনলাইন জিপিএস স্পিডোমিটার কীভাবে কাজ করে</h2>

			<p class="mt-6 text-body-lg text-body">
				জিপিএস স্পিডোমিটার উপগ্রহ থেকে আসা রেডিও সিগন্যালের ডপলার শিফট বিশ্লেষণ করে প্রকৃত গতি নির্ণয় করে, যা গাড়ির চাকার ক্ষয়জনিত ত্রুটিমুক্ত।
			</p>

			<h3 class="mt-14 text-display-sm text-ink">FAQ</h3>
			<div class="mt-6 space-y-6 text-sm divide-y divide-hairline">
				<div class="pt-6 first:pt-0">
					<h4 class="font-semibold text-ink text-base">গাড়ির স্পিডোমিটারের চেয়ে জিপিএস স্পিড আলাদা কেন?</h4>
					<p class="mt-2 text-body leading-6">আন্তর্জাতিক নিরাপত্তা নিয়মের কারণে গাড়ির প্রস্তুতকারকরা স্পিডোমিটার ইচ্ছাকৃতভাবে ২–৫% বেশি গতি দেখানোর জন্য ক্যালিব্রেট করে।</p>
				</div>
				<div class="pt-6">
					<h4 class="font-semibold text-ink text-base">টানেলের মধ্যে কি কাজ করে?</h4>
					<p class="mt-2 text-body leading-6">না, জিপিএস সিগন্যালের জন্য সরাসরি খোলা আকাশের প্রয়োজন হয়, তাই মাটির নিচে বা টানেলে কাজ করে না।</p>
				</div>
				<div class="pt-6">
					<h4 class="font-semibold text-ink text-base">আমার লোকেশন ডেটা কি সুরক্ষিত?</h4>
					<p class="mt-2 text-body leading-6">হ্যাঁ, সম্পূর্ণ সুরক্ষিত। সমস্ত গণনা আপনার নিজস্ব ব্রাউজারে ঘটে এবং কোনো তথ্য সার্ভারে পাঠানো হয় না।</p>
				</div>
			</div>
		</div>
	</section>

	<RelatedTools current="/speedometer/" />
</Layout>
