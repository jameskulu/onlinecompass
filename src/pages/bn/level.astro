---
import Layout from '../../layouts/Layout.astro';
import BubbleLevel from '../../components/BubbleLevel.astro';
import PageHero from '../../components/PageHero.astro';
import RelatedTools from '../../components/RelatedTools.astro';
---

<Layout
	title="অনলাইন ডিজিটাল বাবল লেভেল — ফ্রি স্পিরিট লেভেল ও ইনক্লিনোমিটার"
	description="স্মার্টফোনের জাইরোস্কোপ সেন্সর ব্যবহার করে বিনামূল্যে অনলাইন ডিজিটাল বাবল লেভেল ও ইনক্লিনোমিটার। রিয়েল-টাইমে পিচ, রোল এবং পৃষ্ঠের ঢাল পরিমাপ করুন। জিরো ক্যালিব্রেশন সুবিধা।"
	path="/bn/level/"
	keywords="ডিজিটাল বাবল লেভেল, অনলাইন স্পিরিট লেভেল, কোণ পরিমাপ, সারফেস লেভেল"
>
	<PageHero
		eyebrow="বাবল লেভেল · ইনক্লিনোমিটার"
		title="আপনার ব্রাউজারেই নিখুঁত সারফেস লেভেলিং।"
		description="আপনার স্মার্টফোনটিকে একটি উচ্চ নির্ভুলতার ডিজিটাল স্পিরিট লেভেলে পরিণত করুন। হ্যাপটিক ভাইব্রেশন ও জিরো ক্যালিব্রেশন সহ যেকোনো সমতল ও উল্লম্ব পৃষ্ঠের ঢাল মাপুন।"
	>
		<BubbleLevel />
	</PageHero>

	<section class="border-t border-hairline bg-canvas">
		<div class="mx-auto max-w-3xl px-4 py-20 sm:px-6 md:py-24">
			<p class="eyebrow">বাবল লেভেল · ইনক্লিনোমিটার</p>
			<h2 class="mt-3 text-display-lg text-ink">ডিজিটাল বাবল লেভেল ও ইনক্লিনোমিটারের কাজের নিয়ম</h2>

			<p class="mt-6 text-body-lg text-body">
				ডিজিটাল বাবল লেভেল স্মার্টফোনের এমইএমএস (MEMS) অ্যাক্সিলোমিটার ব্যবহার করে পৃথিবীর অভিকর্ষজ ত্বরণের সাপেক্ষে পৃষ্ঠের কোণ হিসাব করে।
			</p>

			<h3 class="mt-14 text-display-sm text-ink">FAQ</h3>
			<div class="mt-6 space-y-6 text-sm divide-y divide-hairline">
				<div class="pt-6 first:pt-0">
					<h4 class="font-semibold text-ink text-base">ফোনের বাবল লেভেল কতটা সঠিক?</h4>
					<p class="mt-2 text-body leading-6">আধুনিক স্মার্টফোন ০.১ ডিগ্রি পর্যন্ত কোণ পরিবর্তন শনাক্ত করতে পারে, যা সাধারণ কার্পেন্ট্রি ও গৃহস্থালি কাজের জন্য চমৎকার।</p>
				</div>
				<div class="pt-6">
					<h4 class="font-semibold text-ink text-base">আইওএস কেন সেন্সর পারমিশন চায়?</h4>
					<p class="mt-2 text-body leading-6">অ্যাপল সাফারির গোপনীয়তা বিধির কারণে মোশন সেন্সর ব্যবহারের জন্য ব্যবহারকারীর সম্মতির প্রয়োজন হয়।</p>
				</div>
				<div class="pt-6">
					<h4 class="font-semibold text-ink text-base">ইন্টারনেট ছাড়া অফলাইনে কাজ করে?</h4>
					<p class="mt-2 text-body leading-6">হ্যাঁ, পিডব্লিউএ (PWA) সুবিধার মাধ্যমে ব্রাউজারে সংরক্ষিত হয়ে ইন্টারনেট ছাড়াই অফলাইনে কাজ করে।</p>
				</div>
			</div>
		</div>
	</section>

	<RelatedTools current="/level/" />
</Layout>
