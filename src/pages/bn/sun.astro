---
import Layout from '../../layouts/Layout.astro';
import SunPanel from '../../components/SunPanel.astro';
import PageHero from '../../components/PageHero.astro';
import RelatedTools from '../../components/RelatedTools.astro';
---

<Layout
	title="সূর্যের অবস্থান ক্যালকুলেটর অনলাইন — স্থিতিকোণ, সূর্যোদয় ও সূর্যাস্ত"
	description="অনলাইনে সূর্যের অবস্থান গণনা করুন: যেকোনো অবস্থানের জন্য স্থিতিকোণ, উন্নতি, সূর্যোদয়, সৌর মধ্যাহ্ন এবং সূর্যাস্ত। বিনামূল্যে এবং তাৎক্ষণিক — সম্পূর্ণরূপে আপনার ব্রাউজারে চলে।"
	path="/bn/sun/"
	keywords="সূর্যের অবস্থান ক্যালকুলেটর, সূর্যের স্থিতিকোণ, সূর্যোদয় সূর্যাস্তের সময়, সূর্যের দিক, অনলাইনে সৌর অবস্থান"
>
	<PageHero
		eyebrow="সূর্যের অবস্থান"
		title="সূর্যকে সুনির্দিষ্টভাবে ট্র্যাক করুন।"
		description="লাইভ সৌর স্থিতিকোণ এবং উন্নতি, সূর্যোদয়, সৌর মধ্যাহ্ন এবং সূর্যাস্ত সহ — আপনার অবস্থান অথবা আপনি যেকোনো কো-অর্ডিনেট প্রবেশ করেন সেটির জন্য গণনা করা।"
	>
		<SunPanel />
	</PageHero>

	<section class="border-y border-hairline bg-canvas">
		<div class="mx-auto max-w-[1200px] grid gap-6 px-4 py-16 sm:px-6 md:grid-cols-2">
			<div>
				<p class="eyebrow mb-2">সংখ্যা কী বোঝায়</p>
				<p class="text-sm text-body leading-6">
					স্থিতিকোণ হলো সূর্যের কম্পাস দিক (০° = উত্তর, ৯০° = পূর্ব)। উন্নতি হলো সে
					ক্ষিতিশীর্ষের উপরে কত উঁচুয়ে আছেন — ছায়া, সৌর প্যানেল এবং ফটোগ্রাফির জন্য উপযোগী।
				</p>
			</div>
			<div>
				<p class="eyebrow mb-2">আপনার কম্পাস ক্রস-চেক করুন</p>
				<p class="text-sm text-body leading-6">
					দুপুরে সূর্য উত্তর গোলার্ধে প্রকৃত দক্ষিণে এবং দক্ষিণ গোলার্ধে প্রকৃত উত্তরে থাকেন — দিনের আলোতে আপনার হেডিং যাচাই করার একটি নির্ভরযোগ্য উপায়।
				</p>
			</div>
		</div>
	</section>

	<section class="border-t border-hairline bg-canvas">
		<div class="mx-auto max-w-3xl px-4 py-20 sm:px-6 md:py-24">
			<p class="eyebrow">সূর্যের অবস্থান টুল</p>
			<h2 class="mt-3 text-display-lg text-ink">অনলাইনে সূর্যের অবস্থান গণনা করুন — যেকোনো অবস্থানের জন্য</h2>

			<p class="mt-6 text-body-lg text-body">
				একটি <strong class="text-ink font-medium">অনলাইনে সূর্যের অবস্থান ক্যালকুলেটর</strong> একটি
				নির্দিষ্ট মুহূর্তে একটি নির্দিষ্ট জায়গায় আকাশে সূর্য কোথায় আছেন তা দেখায়। এই পৃষ্ঠটি সূর্যের বর্তমান
				<strong class="text-ink font-medium">স্থিতিকোণ</strong> (তার কম্পাস দিক ডিগ্রিতে) এবং
				<strong class="text-ink font-medium">উন্নতি</strong> (ক্ষিতিশীর্ষের উপরে তার উচ্চতা) গণনা করে, সূর্যোদয়,
				সৌর মধ্যাহ্ন এবং সূর্যাস্তের সময়ের সাথে — আপনার লাইভ অবস্থান অথবা আপনি যেকোনো কো-অর্ডিনেট
				প্রবেশ করেন সেটির জন্য। সবকিছু আপনার ব্রাউজারে চলে, তাই এটি তাৎক্ষণিক, বিনামূল্যে এবং
				গোপনীয়।
			</p>
			<p class="mt-4 leading-7">
				দিন এগিয়ে গেলে সংখ্যাগুলো বাস্তব সময়ে আপডেট হয়, যা এই টুলটিকে আশ্চর্যজনকভাবে বৈচিত্র্যময়
				কাজের জন্য উপযোগী করে: সৌর প্যানেল স্থাপন, ফটোগ্রাফি আলো পরিকল্পনা, বাগানের
				বেড সাজানো, একটি প্যাটিওর জন্য ছায়া স্থাপন, বা সহজেই জানা সূর্য সড়কের ওপারের ভবন পেরিয়ে কখন ওঠবেন।
			</p>

			<h3 class="mt-10 text-display-sm text-ink">স্থিতিকোণ এবং উন্নতি — আকাশ পড়া</h3>
			<p class="mt-3 leading-7">
				<strong class="text-ink font-medium">স্থিতিকোণ</strong> হলো উত্তর থেকে ঘড়ির কাঁটার দিকে পরিমাপ সূর্যের দিক: ০° ঠিক উত্তর, ৯০° ঠিক পূর্ব, ১৮০° ঠিক দক্ষিণ এবং ২৭০° ঠিক পশ্চিম। দুপুরে সূর্য উত্তর গোলার্ধে প্রায় ১৮০° (ঠিক দক্ষিণ) এবং দক্ষিণ গোলার্ধে প্রায় ০° (ঠিক উত্তর) থাকেন।
				<strong class="text-ink font-medium">উন্নতি</strong> হলো ক্ষিতিশীর্ষের ওপরে সূর্যের কোণ, সূর্যোদয় এবং সূর্যাস্তে ০° থেকে সৌর মধ্যাহ্নে সর্বোচ্চ বিন্দু পর্যন্ত। একসাথে তারা বর্ণনা করে সূর্য আকাশে কোথায় আছেন — খগোলবিদ এবং সৌর প্রকৌশলীদের ব্যবহৃত একই কো-অর্ডিনেট।
			</p>
			<p class="mt-4 leading-7">
				সূর্যের পথ আপনার অক্ষাংশ এবং ঋতুর সাথে পরিবর্তিত হয়: গ্রীষ্মে উঁচু, শীতে নিচু,
				সর্বত্র পূর্বে ওঠে এবং পশ্চিমে অস্ত যায়। ক্যালকুলেটরটি প্রমিত সৌর-অবস্থান অ্যালগরিদমের মাধ্যমে এটি সব
				বিবেচনা করে, তাই আপনি যে স্থিতিকোণ এবং
				উন্নতি দেখেন তা আপনার তারিখ, সময় এবং কো-অর্ডিনেটের জন্য নির্ভুল।
			</p>

			<h3 class="mt-10 text-display-sm text-ink">দিক খুঁজে বের করতে সূর্য কেন উপযোগী</h3>
			<p class="mt-3 leading-7">
				কম্পাস এবং GPS-এর আগে, মানুষরা অরিয়েন্টেশনের জন্য সূর্যকে ব্যবহার করত — এবং এটি আজও কাজ করে।
				স্থানীয় দুপুরের আশপাশে উত্তর গোলার্ধে সূর্য ঠিক দক্ষিণে এবং দক্ষিণ গোলার্ধে ঠিক উত্তরে থাকেন। সূর্যোদয়ে সে প্রায় পূর্বে; সূর্যাস্তে, প্রায় পশ্চিমে। এগুলো নির্ভরযোগ্য হাতের নিয়ম এবং এই পৃষ্ঠটি সেগুলোকে সুনির্দিষ্ট সংখ্যায় রূপান্তরিত করে। আপনি দিনের আলোতে কম্পাস ছাড়া বাইরে থাকলে, এখানে স্থিতিকোণ দেখুন এবং সেই অনুযায়ী নিজেকে সাজান — তারপর
				<a href="/" class="text-link underline decoration-link/30 hover:decoration-link">অনলাইন কম্পাস</a>
				দিয়ে ক্রস-চেক করুন যখন আপনার ফোনে ফিরে আসেন।
			</p>

			<div class="mt-10 grid gap-4 sm:grid-cols-2">
				<div class="card-soft p-5">
					<h4 class="text-sm font-medium text-ink mb-1">সৌর শক্তি</h4>
					<p class="text-sm leading-6">
						প্যানেল সারিবদ্ধ করুন অথবা স্থাপনা পরিকল্পনা করুন: দুপুরে উন্নতি সেরা টিল্ট দেখায় এবং
						স্থিতিকোণ পরিসীমা দেখায় দিনজুড়ে একটি পৃষ্ঠ কতটা সূর্য পায়।
					</p>
				</div>
				<div class="card-soft p-5">
					<h4 class="text-sm font-medium text-ink mb-1">ফটোগ্রাফি এবং বাগানকাজ</h4>
					<p class="text-sm leading-6">
						গোল্ডেন-আওয়ার শুট পরিকল্পনা করুন, জানুন একটি বাগানের বেড কখন আলো পায়, অথবা বিকালের সূর্যের জন্য একটি প্যাটিও বা
						ছায়া পাল স্থাপন করুন — সব আপনার সুনির্দিষ্ট অবস্থান থেকে।
					</p>
				</div>
			</div>

			<h3 class="mt-10 text-display-sm text-ink">সূর্যোদয়, সৌর মধ্যাহ্ন এবং সূর্যাস্ত</h3>
			<p class="mt-3 leading-7">
				টুলটি দিনের মূল মুহূর্তগুলোও রিপোর্ট করে: <strong class="text-ink font-medium">সূর্যোদয়</strong>,
				যখন সূর্য প্রথম ক্ষিতিশীর্ষের ওপরে আবির্ভূত হন; <strong class="text-ink font-medium">সৌর মধ্যাহ্ন</strong>,
				যখন তিনি সর্বোচ্চ বিন্দুতে পৌঁছান; এবং <strong class="text-ink font-medium">সূর্যাস্ত</strong>,
				যখন তিনি অদৃশ্য হন। সৌর মধ্যাহ্ন হলো সূর্য মধ্যরেখা অতিক্রম করে এবং সবুট ছোট ছায়া ফেলে সেই মুহূর্ত — উপরের কম্পাস-সূর্য কৌশলের রেফারেন্স পয়েন্ট।
			</p>
			<p class="mt-4 leading-7">
				যেহেতু গণনাগুলো স্থানীয়, ফলাফল আপনার কো-অর্ডিনেট এবং তারিখের সাথে স্বাভাবিকভাবে সরে যায়: উত্তরের শীতে ছোট দিন এবং কম দুপুরের উন্নতি, যখন গ্রীষ্মমণ্ডলীয় অবস্থানে সূর্য
				সারা বছর উঁচুতে ওঠেন। আপনি যেখানেই থাকুন, এই বিনামূল্যের সূর্যের অবস্থান ক্যালকুলেটর এক চোখে
				সৌর পথ দেয় — এবং আকাশের পুরো ছবির জন্য পারফেক্টভাবে জুড়ে যায়
				<a href="/bn/bearing/" class="text-link underline decoration-link/30 hover:decoration-link">বেয়ারিং ক্যালকুলেটর</a>
				এবং
				<a href="/bn/qibla/" class="text-link underline decoration-link/30 hover:decoration-link">কিবলা ফাইন্ডার</a>
				এর সাথে।
			</p>
		</div>
	</section>

	<RelatedTools current="/sun/" />
</Layout>
