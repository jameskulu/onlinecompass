---
import Layout from '../../layouts/Layout.astro';
import Compass from '../../components/Compass.astro';

const faq = [
	{
		q: 'অনলাইন কম্পাস কী?',
		a: 'অনলাইন কম্পাস হলো একটি ডিজিটাল কম্পাস যা আলাদা অ্যাপ হিসেবে নয়, বরং আপনার ওয়েব ব্রাউজারের ভেতরেই চলে। এটি আপনার ফোনের চৌম্বকমিটার, অ্যাক্সেলেরোমিটার ও জাইরোস্কোপ পড়ে সেগুলোকে ডিগ্রিতে একটি লাইভ হেডিংয়ে রূপান্তর করে — কোনো ডাউনলোড লাগে না। আপনি এই পৃষ্ঠার মতো একটি পৃষ্ঠা খুলে সেন্সর অ্যাক্সেসের অনুমতি দিলে আপনি ঘোরার সাথে সাথে ডায়ালটি বাস্তব সময়ে আপডেট হয়।',
	},
	{
		q: 'ফোনে অনলাইন কম্পাস কীভাবে ব্যবহার করব?',
		a: 'আপনার ফোনে এই পৃষ্ঠাটি খুলুন, "লাইভ কম্পাস সক্রিয় করুন" ট্যাপ করুন এবং ডিভাইসটি হাতের তালুতে সমতল করে ধরে রাখুন। হেডিংটি ডায়ালের নিচে ডিগ্রি এবং কম্পাস পয়েন্ট উভয় আকারেই দেখা যায়। সর্বোচ্চ নির্ভুলতার জন্য চৌম্বকমিটার ক্যালিব্রেট করতে আটের আকারে হাত ঘোরান এবং ফোনটি ধাতু ও চুম্বক থেকে দূরে রাখুন।',
	},
	{
		q: 'অনলাইন কম্পাস কি নির্ভুল?',
		a: 'ক্যালিব্রেট করা ফোন কম্পাস সাধারণত খোলা জায়গায় প্রায় ১–৫ ডিগ্রির মধ্যে নির্ভুল থাকে। চৌম্বকমিটার নিজেই সংবেদনশীল, তাই কাছাকাছি ধাতু, ইলেকট্রনিক্স বা চৌম্বক ফোন কেস এটি বিকৃত করতে পারে। একবার ক্যালিব্রেট করে হস্তক্ষেপ থেকে সরে গেলে, রিডিং সাধারণত কয়েক ডিগ্রির মধ্যে একটি ভৌত কম্পাসের সাথে মিলে যায়।',
	},
	{
		q: 'প্রকৃত উত্তর ও চৌম্বক উত্তরের মধ্যে পার্থক্য কী?',
		a: 'চৌম্বক উত্তর হলো আপনার ফোনের চৌম্বকমিটার যে দিকে নির্দেশ করে — এটি পৃথিবীর চৌম্বক ক্ষেত্র অনুসরণ করে, যা প্রতি বছর সরে যায়। প্রকৃত উত্তর হলো ভৌগোলিক উত্তর মেরু, যা মানচিত্রে ব্যবহৃত হয়। এই দুটির মধ্যবর্তী কোণকে চৌম্বক বিচ্যুতি বলা হয়, এবং এই টুলটি স্বয়ংক্রিয়ভাবে তা সংশোধন করে যাতে আপনার হেডিং মানচিত্রের সাথে মিলে যায়।',
	},
	{
		q: 'চৌম্বক বিচ্যুতি কী?',
		a: 'চৌম্বক বিচ্যুতি হলো কোনো নির্দিষ্ট স্থানে চৌম্বক উত্তর ও প্রকৃত উত্তরের মধ্যবর্তী কোণ। এটি বিশ্বজুড়ে প্রায় −৩০° থেকে +৩০° পর্যন্ত হয় এবং সময়ের সাথে ধীরে ধীরে পরিবর্তিত হয়। লন্ডনে এটি প্রায় শূন্যের কাছাকাছি, অথচ কানাডার কিছু অংশে এটি ১৫° ছাড়িয়ে যেতে পারে। যেহেতু এটি স্থান অনুযায়ী বদলায়, তাই আপনি যখনই কোনো বেয়ারিং অনুসরণ করেন তখন GPS-নিখুঁত বিচ্যুতি সংশোধন গুরুত্বপূর্ণ।',
	},
	{
		q: 'আমার কম্পাসের সুচ কেন লাফালাফি করে বা ঘোরে?',
		a: 'চৌম্বকমিটার একটি সংবেদনশীল যন্ত্র। চুম্বকযুক্ত ফোন কেস, স্পিকার, ল্যাপটপ, ধাতব টেবিল, গাড়ির ড্যাশবোর্ড এবং ইস্পাত-কাঠামোর ভবন — সবই আপনার চারপাশের চৌম্বক ক্ষেত্র বাঁকিয়ে দেয়। এগুলো থেকে সরে যান, ফোনটি সমতল ধরে রাখুন এবং পুনরায় ক্যালিব্রেট করতে আটের আকার ট্রেস করুন। ঘরের ভেতরে কয়েক ডিগ্রি ওঠানামা স্বাভাবিক।',
	},
	{
		q: 'আমার ফোনের কম্পাস কীভাবে ক্যালিব্রেট করব?',
