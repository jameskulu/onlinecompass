---
import Layout from '../../layouts/Layout.astro';
import Compass from '../../components/Compass.astro';

const faq = [
	{
		q: 'আমি কোন দিকে তাকিয়ে আছি — অনলাইন কম্পাস?',
		a: 'আপনার ফোনে এই পৃষ্ঠাটি খুলুন এবং ডায়ালের নিচের লাইভ হেডিং রিডআউট আপনি কোন নির্দিষ্ট ডিগ্রি এবং কম্পাস দিকে (উত্তর, উত্তর-পূর্ব, পূর্ব, দক্ষিণ-পূর্ব, দক্ষিণ, দক্ষিণ-পশ্চিম, পশ্চিম, উত্তর-পশ্চিম) তাকিয়ে আছেন তা দেখায়, আপনি ঘোরালে বাস্তব সময়ে আপডেট হয়।',
	},
	{
		q: 'অনলাইন কম্পাস — উত্তর কোথায়?',
		a: 'সুচের প্রান্ত সবসময় উত্তর দিকে নির্দেশ করে, যা ডায়ালের শীর্ষে ০°/৩৬০° পড়ে। "প্রকৃত উত্তর" এ টগল করুন এবং সাইটটি আপনার অবস্থানে চৌম্বক বিচ্যুতি সংশোধন করে যাতে উত্তর মানচিত্রের সাথে মেলে।',
	},
	{
		q: 'আমি কোন দিকে তাকিয়ে আছি — অনলাইন কম্পাস?',
		a: 'আপনার ফোনটিকে সমতল রাখুন, সেন্সর অ্যাক্সেস দিন এবং ডায়ালের নিচের হেডিং আপনি কোন দিকে তাকিয়ে আছেন তা ডিগ্রি এবং কম্পাস পয়েন্ট উভয়ভাবেই বলে — উদাহরণস্বরূপ ২৭৪° বা পশ্চিম।',
	},
	{
		q: 'অনলাইনে কম্পাস ছাড়া দিক কীভাবে জানবেন?',
		a: 'সূর্য ব্যবহার করুন: স্থানীয় দুপুরের আশেপাশে উত্তর গোলার্ধে তিনি ঠিক দক্ষিণে এবং দক্ষিণ গোলার্ধে ঠিক উত্তরে থাকেন। এই সাইটের সূর্য টুল যেকোনো অবস্থানের জন্য সূর্যের নির্দিষ্ট স্থিতিকোণ দেখায়, এবং কিবলা ফাইন্ডার একটি স্থির রেফারেন্স দিক হিসাবেও কাজ করে।',
	},
	{
		q: 'আমি কোন দিকে মুখ করে আছি — অনলাইন কম্পাস?',
		a: 'সেন্সর অ্যাক্সেস দিন, ফোনটিকে ধাতব থেকে দূরে সমতল রাখুন এবং হেডিং রিডআউট পড়ুন। আপনি ঘুরলে এটি ধারাবাহিকভাবে আপডেট হয়, তাই আপনি সবসময় জানেন কোন দিকে মুখ করে আছেন।',
	},
	{
		q: 'অনলাইনে কম্পাস কীভাবে ব্যবহার করবেন?',
		a: 'ফোনে এই পৃষ্ঠাটি খুলুন, "লাইভ কম্পাস সক্রিয় করুন" ট্যাপ করুন, ডিভাইসটি সমতল রাখুন এবং হেডিং পড়ুন। সুচ ডোলে থাকলে, চৌম্বকমিটার পুনরায় ক্যালিব্রেট করতে কয়েকবার আটের আকার ট্রেস করুন।',
	},
	{
		q: 'আমি কি আমার ফোন কম্পাস হিসাবে ব্যবহার করতে পারি?',
		a: 'হ্যাঁ। আধুনিক ফোনে একটি চৌম্বকমিটার থাকে এবং এই ওয়েবসাইটটি সেই সেন্সরকে আপনার ব্রাউজারেই একটি কম্পাসে রূপান্তরিত করে — ডাউনলোড করার কোনো অ্যাপ নেই এবং ইনস্টল করার কিছু নেই।',
	},
	{
		q: 'গুগলে আমার কম্পাস কোথায়?',
		a: 'গুগল ম্যাপস মানচিত্র ভিউয়ের উপরে-ডানদিকে একটি ছোট কম্পাস দেখায়। ডিগ্রিতে লাইভ হেডিং জানতে, গুগলে "অনলাইন কম্পাস" সার্চ করুন এবং এই পৃষ্ঠাটি খুলুন — সেন্সর অ্যাক্সেস দেওয়ার সাথে সাথে এটি একটি কম্পাস হয়ে যায়।',
	},
	{
		q: 'আমার ফোন কি আমাকে বলতে পারে আমি কোন দিকে তাকিয়ে আছি?',
		a: 'হ্যাঁ। আপনার ফোনের চৌম্বকমিটার এই পৃষ্ঠার সাথে মিলিত হয়ে একটি লাইভ হেডিং দেয় এবং সাইটটি স্বয়ংক্রিয়ভাবে চৌম্বক বিচ্যুতি সংশোধন করে যাতে উত্তর আপনার মানচিত্রের সাথে মেলে।',
	},
	{
		q: 'মোবাইলে কম্পাস কীভাবে দেখবেন?',
		a: 'আপনার ফোনে এই পৃষ্ঠাটি খুলুন এবং কম্পাস তাৎক্ষণিকভাবে আবির্ভূত হয় — কোনো অ্যাপের প্রয়োজন নেই। অ্যান্ড্রয়েডে, গুগল ম্যাপসেও একটি কম্পাস আছে এবং কিছু ফোনে একটি বিল্ট-ইন কম্পাস অ্যাপ থাকে।',
	},
	{
		q: 'আমার উত্তর দিক কোনটি?',
		a: 'প্রকৃত উত্তর হলো ভৌগোলিক উত্তর মেরু; চৌম্বক উত্তর হলো যেখানে কম্পাসের সুচ নির্দেশ করে। দুটির মধ্যে কোণ (বিচ্যুতি) অবস্থান অনুযায়ী পরিবর্তিত হয় এবং এই সাইটটি এটি স্বয়ংক্রিয়ভাবে সংশোধন করে।',
	},
	{
		q: 'আমার ফোনে কম্পাস কোথায়?',
		a: 'অনেক ফোনে একটি নির্দিষ্ট কম্পাস অ্যাপ থাকে না — কিন্তু সেন্সরটি বিল্ট-ইন। আপনার ফোনে এই ওয়েবসাইটটি খুলুন এবং এটি ইনস্টল ছাড়াই একটি কম্পাস হয়ে যায়।',
	},
	{
		q: 'কোন মোবাইল ফোনগুলোতে কম্পাস সেন্সর আছে?',
		a: 'প্রায় প্রতিটি আধুনিক স্মার্টফোন — আইফোন ৩জিএস থেকে প্রতিটি আইফোন এবং প্রায় সব অ্যান্ড্রয়েড ফোন — একটি চৌম্বকমিটার অন্তর্ভুক্ত, তাই এই অনলাইন কম্পাসটি প্রায় প্রতিটি ডিভাইসে কাজ করে।',
	},
	{
		q: 'আমার হেডিং কেন লাফালাফি করে?',
		a: 'কাছাকাছি ধাতব এবং ইলেকট্রনিক্স চৌম্বকমিটারকে বিকৃত করে। উপরের ক্যালিব্রেশন পদ্ধতি অনুসরণ করুন এবং নিশ্চিত করুন ফোনটি সমতল। ঘরের ভেতরে কয়েক ডিগ্রির ড্রিফ্ট স্বাভাবিক।',
	},
	{
		q: 'চৌম্বক এবং প্রকৃত উত্তরের মধ্যে পার্থক্য কী?',
		a: 'চৌম্বক উত্তর হলো যেখানে আপনার কম্পাসের সুচ নির্দেশ করে। প্রকৃত উত্তর হলো ভৌগোলিক উত্তর মেরু, যা মানচিত্র এবং নেভিগেশন ব্যবহার করে। দুটির মধ্যে কোণ — বিচ্যুতি — অবস্থান অনুযায়ী পরিবর্তিত হয় এবং এই টুলটি এটি স্বয়ংক্রিয়ভাবে সংশোধন করে।',
	},
	{
		q: 'এটি কেন আমার অবস্থান চায়?',
		a: 'অবস্থান আমাদের চৌম্বক বিচ্যুতি, কিবলা বেয়ারিং এবং সূর্যের অবস্থান সুনির্দিষ্টভাবে গণনা করতে দেয়। এটি ঐচ্ছিক — প্রতিটি টুল ম্যানুয়াল কো-অর্ডিনেটেও কাজ করে — এবং এটি আপনার ডিভাইস ছাড়ে না।',
	},
	{
		q: 'আপনি কি আমার অবস্থান সংরক্ষণ বা বিক্রি করেন?',
		a: 'না। কোনো ট্র্যাকার নেই, কোনো অ্যানালিটিক্স নেই এবং কোনো ব্যাকএন্ড নেই। সমস্ত সেন্সর এবং অবস্থানের তথ্য আপনার ব্রাউজারে স্থানীয়ভাবে প্রক্রিয়া করা হয় এবং আপনি চলে গেলে মুছে ফেলা হয়।',
	},
];
---

<Layout
	path="/bn/"
	title="অনলাইন কম্পাস — উত্তর খুঁজে বের করার বিনামূল্যের লাইভ টুল"
	description="আপনার অবস্থান থেকে উত্তর খুঁজে বের করার বিনামূল্যের অনলাইন কম্পাস। প্রকৃত এবং চৌম্বক উত্তর, বিচ্যুতি, কিবলা ফাইন্ডার, বেয়ারিং ক্যালকুলেটর এবং সূর্যের অবস্থান সহ লাইভ হেডিং — ইনস্টল ছাড়াই, যেকোনো ফোনে কাজ করে।"
	keywords="অনলাইন কম্পাস, অনলাইন কম্পাস টুল, বিনামূল্যের অনলাইন কম্পাস, অনলাইন কম্পাস গুগল, অনলাইন কম্পাস বিনামূল্যে, অনলাইন কম্পাস উত্তর খুঁজে বের করতে, অনলাইন কম্পাস দিক, অনলাইন কম্পাস জ্যামিতি, অনলাইন কম্পাস টুল জ্যামিতি, অনলাইন কম্পাস জ্যামিতির জন্য, অনলাইন কম্পাস গণিত, বিনামূল্যে অনলাইন কম্পাস টুল, কিবলার জন্য অনলাইন কম্পাস, অনলাইন কম্পাস লাইভ, অনলাইন কম্পাস কাব্বা আমার অবস্থান থেকে উত্তর খুঁজে বের করতে, কিবলা ফাইন্ডার অনলাইন কম্পাস"
>
	<!-- ─── Hero ─────────────────────────────────────── -->
	<section id="compass" class="relative overflow-hidden">
		<div class="mesh-gradient" aria-hidden="true"></div>
		<div class="relative mx-auto max-w-[1200px] px-4 pt-12 pb-20 text-center sm:px-6 md:pt-20 md:pb-28">
			<Compass />
			<div class="mx-auto mt-10 max-w-3xl md:mt-14">
				<div class="badge mx-auto">বিনামূল্যে · গোপনীয় · ইনস্টল ছাড়াই</div>

				<h1 class="mx-auto mt-6 max-w-3xl text-[36px] leading-[40px] text-ink sm:text-display-xl md:text-[56px] md:leading-[56px]">একটি কম্পাস যা শুধু চৌম্বক নয়, প্রকৃত উত্তর দেখায়।</h1>

				<p class="mx-auto mt-4 max-w-xl text-body-lg text-body">স্বয়ংক্রিয় বিচ্যুতি সংশোধন, GPS কো-অর্ডিনেট, কিবলা দিক
				এবং সূর্যের অবস্থান সহ বাস্তব সময়ের ডিভাইস হেডিং — সব আপনার ব্রাউজারে। ইনস্টল করার কিছু নেই, আপলোড কিছু হয়নি।</p>

				<div class="mt-8 flex flex-wrap items-center justify-center gap-3">
					<a href="/bn/location/" class="btn-primary">আমাকে অবস্থান দেখাও</a>
					<a href="/bn/compass/" class="btn-secondary">কম্পাস খুলুন</a>
				</div>
			</div>
		</div>
	</section>

	<!-- ─── Feature strip ──────────────────────────────── -->
	<section class="border-y border-hairline bg-canvas">
		<div
			class="mx-auto grid max-w-[1200px] grid-cols-1 gap-px overflow-hidden px-4 py-12 sm:grid-cols-3 sm:px-6"
		>
			<div class="p-4">
				<p class="eyebrow mb-2">প্রকৃত বনাম চৌম্বক</p>
				<p class="text-sm text-body leading-6">
					বিচ্যুতি বিশ্ব চৌম্বক মডেল থেকে স্বয়ংক্রিয়ভাবে গণনা করা হয় — উভয়
					হেডিং একসাথে দেখুন।
				</p>
			</div>
			<div class="p-4">
				<p class="eyebrow mb-2">গোপনীয়তা প্রথমে</p>
				<p class="text-sm text-body leading-6">
					সমস্ত সেন্সর প্রক্রিয়াকরণ ডিভাইসে হয়। কোনো অ্যাকাউন্ট নেই, কোনো ট্র্যাকিং নেই এবং কিছুই
					আপনার ব্রাউজার ছাড়ে না।
