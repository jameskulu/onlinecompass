const compassTechComparison = [
	{
		"tech": "Boussole Navigateur MEMS (Fusion de Capteurs)",
		"operatingPrinciple": "Magnétomètre triaxial à effet Hall fusionné avec accéléromètre et gyroscope de vitesse",
		"accuracy": "±1.0° à ±2.5° (compensation d'inclinaison et correction de déclinaison automatiques)",
		"advantages": "Sans téléchargement, alignement automatique sur carte, affichage tête haute nuit, Qibla et coordonnées",
		"limitations": "Nécessite un composant magnétomètre matériel ; sensible aux masses métalliques proches"
	},
	{
		"tech": "Boussole Magnétique Traditionnelle à Bain d'Huile",
		"operatingPrinciple": "Aiguille en acier aimanté suspendue dans un liquide alignée sur les lignes de flux magnétique",
		"accuracy": "±2.0° à ±5.0° (selon l'amortissement du fluide et la mise à niveau manuelle)",
		"advantages": "Zéro pile nécessaire, insensibilité absolue aux anomalies logicielles",
		"limitations": "Pointe uniquement le nord magnétique ; nécessite un calcul manuel ; formation de bulles en altitude"
