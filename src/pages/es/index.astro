				))}
			</div>
		</div>
	</section>

	<!-- ——— CTA band ——— -->
	<section class="bg-ink text-on-primary">
		<div class="mx-auto max-w-[1200px] px-4 py-20 text-center sm:px-6 md:py-24">
			<p class="font-mono text-xs uppercase tracking-[0.08em] text-on-primary/60">listo cuando tú lo estés</p>
			<h2 class="mt-4 text-display-lg text-on-primary">Encuentra tu rumbo.</h2>
			<p class="mx-auto mt-3 max-w-lg text-body-lg text-on-primary/70">
