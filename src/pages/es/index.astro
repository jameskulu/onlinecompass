							<th scope="col" class="py-3.5 pr-4 font-semibold text-ink">Declinación Geomagnética</th>
							<th scope="col" class="py-3.5 font-semibold text-ink">Consecuencia en Navegación (por cada 1 km)</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-hairline">
						{declinationExamples.map((d) => (
							<tr class="hover:bg-canvas-soft/40 transition-colors">
								<td class="py-3.5 pr-4 font-medium text-ink">{d.place}</td>
								<td class="py-3.5 pr-4 font-mono text-link font-semibold">{d.value}</td>
								<td class="py-3.5 text-body text-xs leading-5">{d.impact}</td>
