const compassTechComparison = [
	{
		"tech": "Brújula de Navegador MEMS (Fusión Sensorial)",
		"operatingPrinciple": "Magnetómetro triaxial de efecto Hall fusionado con acelerómetro y giróscopo",
		"accuracy": "±1.0° a ±2.5° (compensada en inclinación y con corrección de declinación)",
		"advantages": "Sin descargas, coincidencia automática con mapas, modo noche HUD, Qibla y coordenadas",
		"limitations": "Requiere magnetómetro de hardware; susceptible a metales cercanos y fundas magnéticas"
	},
	{
		"tech": "Brújula Magnética Tradicional de Aguja",
		"operatingPrinciple": "Aguja de acero magnetizada suspendida en fluido alineada con líneas de flujo terrestre",
		"accuracy": "±2.0° a ±5.0° (depende de la amortiguación del líquido y nivelación manual)",
