							<th scope="col" class="py-3 pr-4 font-medium text-ink">Lokasi</th>
							<th scope="col" class="py-3 font-medium text-ink">Perkiraan deklinasi</th>
						</tr>
					</thead>
					<tbody>
						{declinationExamples.map((d) => (
							<tr class="border-b border-hairline">
								<td class="py-3 pr-4 text-body">{d.place}</td>
