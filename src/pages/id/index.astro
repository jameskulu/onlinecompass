---
import Layout from '../../layouts/Layout.astro';
import Compass from '../../components/Compass.astro';

const faq = [
	{
		"q": "Apa itu kompas digital online dan bagaimana cara kerjanya di peramban web?",
		"a": "Kompas digital online adalah aplikasi web yang mengakses langsung sensor fisik MEMS (magnetometer, akselerometer, dan giroskop) perangkat ponsel Anda melalui W3C DeviceOrientation API. Algoritma melakukan kompensasi kemiringan trigonometri secara langsung di JavaScript untuk menghasilkan arah derajat 0°–360° tanpa perlu instalasi aplikasi."
	},
	{
		"q": "Apa perbedaan antara utara sejati dan utara magnetik?",
		"a": "Utara sejati mengarah sepanjang sumbu rotasi Bumi menuju Kutub Utara geografis tempat semua garis bujur bertemu. Utara magnetik adalah titik di wilayah Arktik tempat garis medan geomagnetik Bumi masuk secara vertikal ke inti bumi. Selisih sudut antara keduanya disebut deklinasi magnetik."
	},
	{
		"q": "Apa itu deklinasi magnetik dan mengapa penting untuk navigasi yang akurat?",
		"a": "Deklinasi magnetik adalah sudut horizontal antara utara magnetik dan utara sejati di koordinat Anda. Di New York bernilai sekitar −13° Barat, di Los Angeles +12° Timur. Kompas kami mengintegrasikan World Magnetic Model (WMM) dari NOAA untuk mengoreksi selisih ini secara otomatis agar sesuai dengan peta topografi."
	},
	{
		"q": "Bagaimana cara mengalibrasi kompas ponsel untuk akurasi maksimal?",
		"a": "Pegang ponsel mendatar lalu gerakkan perlahan membentuk pola angka delapan (∞) di udara selama 5 hingga 10 detik. Gerakan ini menghadapkan magnetometer triaksial ke medan magnet Bumi dari berbagai sudut sehingga algoritma dapat mendeteksi dan meniadakan interferensi magnetik internal ponsel."
	},
	{
		"q": "Mengapa jarum kompas saya bergetar atau berputar tidak menentu?",
		"a": "Pembacaan yang tidak stabil disebabkan oleh interferensi medan elektromagnetik di sekitar Anda. Menjauhlah minimal dua meter dari benda logam, casing bermagnet atau MagSafe, laptop, rangka baja beton, dan dasbor mobil, kemudian ulangi kalibrasi angka delapan."
	},
	{
		"q": "Seberapa akurat kompas smartphone dibanding kompas bidik konvensional?",
		"a": "Bila terkalibrasi dan jauh dari logam, magnetometer MEMS ponsel memiliki akurasi ±1° hingga ±3° di luar ruangan, setara dengan kompas bidik cair. Smartphone juga memiliki keunggulan kompensasi kemiringan dan koreksi deklinasi otomatis, meski kompas fisik tetap menjadi cadangan wajib saat mendaki gunung."
	},
	{
		"q": "Apakah kompas online ini dapat bekerja secara offline dan dalam mode pesawat?",
		"a": "Ya. Situs ini dirancang sebagai Progressive Web App (PWA) offline-first. Semua kode dan tabel model geomagnetik tersimpan di memori Service Worker peramban Anda. Begitu halaman dimuat, kompas dan kalkulator koordinat tetap berfungsi di hutan belantara tanpa jaringan seluler atau Wi-Fi."
	},
	{
		"q": "Mengapa kompas menampilkan dial demo pada komputer dan laptop?",
		"a": "Penentuan arah secara langsung membutuhkan perangkat keras sensor medan magnet (magnetometer). Smartphone dan tablet memiliki chip ini, sementara laptop dan PC hampir selalu tidak memilikinya. Pada komputer, aplikasi menyediakan simulasi interaktif beserta perangkat kalkulator matahari dan geodesi."
	},
	{
		"q": "Bagaimana pencari kiblat menentukan arah Ka'bah secara presisi?",
		"a": "Alat ini menghitung azimut busur lingkaran besar (geodesik) dari koordinat lokasi Anda menuju Ka'bah di Makkah (21° 25' 21\" LU, 39° 49' 34\" BT) menggunakan rumus trigonometri bola. Indikator hijau zamrud pada cincin kompas memandu Anda menghadap arah kiblat dengan akurasi sub-derajat."
	},
	{
		"q": "Ke arah mana rumah, balkon, atau taman saya menghadap?",
		"a": "Berdirilah menghadap jendela atau pintu keluar rumah dengan ponsel dipegang mendatar. Nilai antara 315° dan 45° menandakan arah Utara. Arah Selatan (135°–225°) menerima sinar matahari terpanjang sepanjang tahun, Timur menerima matahari pagi, dan Barat mendapatkan terik sore."
	}
];

