const compassRose = [
	{ point: 'N', deg: '0°' },
	{ point: 'NNE', deg: '22.5°' },
	{ point: 'NE', deg: '45°' },
	{ point: 'ENE', deg: '67.5°' },
	{ point: 'E', deg: '90°' },
	{ point: 'ESE', deg: '112.5°' },
	{ point: 'SE', deg: '135°' },
	{ point: 'SSE', deg: '157.5°' },
	{ point: 'S', deg: '180°' },
	{ point: 'SSW', deg: '202.5°' },
	{ point: 'SW', deg: '225°' },
	{ point: 'WSW', deg: '247.5°' },
	{ point: 'W', deg: '270°' },
	{ point: 'WNW', deg: '292.5°' },
	{ point: 'NW', deg: '315°' },
	{ point: 'NNW', deg: '337.5°' },
];

const compassTypes = [
	{
		type: 'Traditional magnetic compass',
		measures: 'Earth\'s magnetic field with a floating needle',
		best: 'Offline reliability, zero batteries, teaching',
		limitation: 'Needs a level surface, no declination correction, single sensor',
	},
	{
		type: 'Phone sensor compass (this site)',
		measures: 'Magnetometer plus accelerometer and gyroscope, fused',
		best: 'Live heading in degrees, tilt compensation, map alignment',
		limitation: 'Sensitive to nearby metal and magnets',
	},
	{
		type: 'GPS course compass',
		measures: 'Direction of travel from GPS position changes',
		best: 'Navigation while moving, works without a magnetometer',
		limitation: 'Only works when moving; useless standing still',
	},
	{
		type: 'Gyrocompass',
		measures: 'Earth\'s rotation with fast-spinning gyroscopes',
		best: 'Ships and aircraft, unaffected by magnetic fields',
		limitation: 'Large, expensive, slow to settle',
	},
];
---

<Layout
	path="/"
	title="Online Compass — Free Live Tool to Find North"
	description="Free online compass to find north from your location. Live heading with true and magnetic north, declination, Qibla finder, bearing calculator, and sun position — no install, works on any phone."
	keywords="online compass, online compass tool, free online compass, online compass google, online compass free, online compass to find north, online compass direction, online compass geometry, online compass tool geometry, online compass for geometry, online compass math, free online compass tool, online compass for qibla, online compass live, online compass kabba to find north from my location, quibla finder online compass"
>
	<!-- ─── Hero ───────────────────────────────────────────── -->
	<section id="compass" class="relative overflow-hidden">
		<div class="mesh-gradient" aria-hidden="true"></div>
		<div class="relative mx-auto max-w-[1200px] px-4 pt-12 pb-20 text-center sm:px-6 md:pt-20 md:pb-28">
			<Compass />
			<div class="mx-auto mt-10 max-w-3xl md:mt-14">
				<div class="badge mx-auto">free · private · no install</div>

				<h1 class="mx-auto mt-6 max-w-3xl text-[36px] leading-[40px] text-ink sm:text-display-xl md:text-[56px] md:leading-[56px]">A compass that points to true north, not just magnetic.</h1>

