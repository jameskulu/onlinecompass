---
import Layout from '../layouts/Layout.astro';
import Compass from '../components/Compass.astro';

const faq = [
	{
		q: 'What is an online digital compass and how does it work in a browser?',
		a: 'An online compass is a client-side web application that accesses your device\'s physical MEMS magnetometer, accelerometer, and gyroscope via the W3C DeviceOrientation API. It executes real-time trigonometric tilt compensation in JavaScript to calculate an accurate 0°–360° heading directly in your browser without requiring app installation.',
	},
	{
		q: 'What is the difference between true north and magnetic north?',
		a: 'True north points along Earth\'s rotational axis to the geographic North Pole, where longitudinal meridians meet. Magnetic north is the wandering point in the Arctic where geomagnetic field lines enter Earth vertically. The angular difference between them at any coordinate is called magnetic declination.',
	},
	{
		q: 'What is magnetic declination, and why is it essential for accurate navigation?',
		a: 'Magnetic declination is the angle between magnetic north and true north at your location. In New York, declination is −13° West; in Los Angeles, +12° East. Our compass integrates the NOAA World Magnetic Model (WMM) to correct this offset automatically, aligning your heading with topographic maps.',
	},
	{
		q: 'How do I calibrate my phone\'s compass for maximum accuracy?',
		a: 'Hold your phone flat and wave it in a smooth, continuous figure-eight (∞) pattern for 5 to 10 seconds. This exposes the triaxial magnetometer to Earth\'s field across multiple angles, allowing the device\'s sensor fusion algorithm to detect and cancel out internal hard-iron and soft-iron magnetic interference.',
	},
	{
		q: 'Why does my compass needle fluctuate, jitter, or spin uncontrollably?',
		a: 'Erratic readings occur when local electromagnetic fields distort Earth\'s subtle magnetic flux. Step at least two meters away from metallic objects, MagSafe or magnetic phone cases, laptop chassis, steel rebar, and vehicle dashboards, then perform the figure-eight calibration motion.',
	},
	{
		q: 'How accurate is a smartphone compass compared to a physical baseplate compass?',
		a: 'When calibrated away from metal, a smartphone MEMS magnetometer achieves ±1° to ±3° accuracy outdoors, matching recreational liquid-filled compasses. Smartphones add automatic tilt compensation and true north correction, though physical compasses remain the ideal battery-free backup for wilderness mountaineering.',
	},
	{
		q: 'Does this online compass work offline and in airplane mode?',
		a: 'Yes. The application is built as an offline-first Progressive Web App (PWA). All code and geomagnetic model tables cache in your browser\'s Service Worker. Once loaded, you can navigate in airplane mode or remote wilderness without cellular signal or Wi-Fi.',
	},
	{
		q: 'Why does the compass show a demo dial on desktop computers and laptops?',
		a: 'Live compass headings require physical magnetometer hardware (an electronic magnetic field sensor). While smartphones and tablets include magnetometers for navigation, laptops and desktops lack this chip. On non-mobile devices, the application provides an interactive preview with solar and geodetic reference tools.',
	},
	{
		q: 'How does the Qibla finder determine the exact direction to Mecca?',
		a: 'The tool calculates the forward geodetic azimuth (Great-Circle path) from your coordinates to the Kaaba in Mecca (21° 25\' 21" N, 39° 49\' 34" E) using the spherical law of cosines. An emerald indicator on the compass rim guides you to face the exact prayer direction.',
	},
	{
		q: 'How do I determine which direction my house, balcony, or garden faces?',
		a: 'Stand facing outward from your exterior window or doorway and hold your phone flat. A reading between 315° and 45° indicates North facing. South facing (135°–225°) offers optimal year-round sunlight, East receives morning light, and West captures intense afternoon sun.',
	},
];

const declinationExamples = [
	{ place: 'London, United Kingdom', value: '≈ +0.2° East', impact: 'Negligible map divergence' },
	{ place: 'New York, United States', value: '≈ −12.8° West', impact: 'High: 225 m offset per kilometer' },
	{ place: 'Los Angeles, United States', value: '≈ +11.6° East', impact: 'High: 205 m offset per kilometer' },
	{ place: 'Sydney, Australia', value: '≈ +12.5° East', impact: 'Steep eastern deviation' },
	{ place: 'Cape Town, South Africa', value: '≈ −25.4° West', impact: 'Extreme: 450 m offset per kilometer' },
	{ place: 'Tokyo, Japan', value: '≈ −8.2° West', impact: 'Consistent westerly correction' },
];

const compassRose = [
	{ point: 'N', deg: '0.0°', name: 'North', quadrant: 'Cardinal' },
	{ point: 'NNE', deg: '22.5°', name: 'North-Northeast', quadrant: 'Principal Intercardinal' },
	{ point: 'NE', deg: '45.0°', name: 'Northeast', quadrant: 'Intercardinal' },
	{ point: 'ENE', deg: '67.5°', name: 'East-Northeast', quadrant: 'Principal Intercardinal' },
	{ point: 'E', deg: '90.0°', name: 'East', quadrant: 'Cardinal' },
	{ point: 'ESE', deg: '112.5°', name: 'East-Southeast', quadrant: 'Principal Intercardinal' },
	{ point: 'SE', deg: '135.0°', name: 'Southeast', quadrant: 'Intercardinal' },
	{ point: 'SSE', deg: '157.5°', name: 'South-Southeast', quadrant: 'Principal Intercardinal' },
	{ point: 'S', deg: '180.0°', name: 'South', quadrant: 'Cardinal' },
	{ point: 'SSW', deg: '202.5°', name: 'South-Southwest', quadrant: 'Principal Intercardinal' },
	{ point: 'SW', deg: '225.0°', name: 'Southwest', quadrant: 'Intercardinal' },
	{ point: 'WSW', deg: '247.5°', name: 'West-Southwest', quadrant: 'Principal Intercardinal' },
	{ point: 'W', deg: '270.0°', name: 'West', quadrant: 'Cardinal' },
	{ point: 'WNW', deg: '292.5°', name: 'West-Northwest', quadrant: 'Principal Intercardinal' },
	{ point: 'NW', deg: '315.0°', name: 'Northwest', quadrant: 'Intercardinal' },
	{ point: 'NNW', deg: '337.5°', name: 'North-Northwest', quadrant: 'Principal Intercardinal' },
];

const compassTechComparison = [
	{
		tech: 'Electronic Browser Compass (MEMS Sensor Fusion)',
		operatingPrinciple: 'Triaxial Hall-effect magnetometer fused with capacitive accelerometer and rate gyro',
		accuracy: '±1.0° to ±2.5° (tilt-compensated & auto-declination corrected)',
		advantages: 'No app download, automatic true north matching, night backlit HUD, coordinates & Qibla integration',
		limitations: 'Requires hardware magnetometer; sensitive to localized steel and magnetic cases',
	},
	{
		tech: 'Traditional Liquid-Damped Magnetic Compass',
		operatingPrinciple: 'Magnetized steel needle or pivot card aligning with Earth\'s horizontal flux lines',
		accuracy: '±2.0° to ±5.0° (depends on capsule damping and user leveling)',
		advantages: 'Zero battery requirement, completely immune to electromagnetic software glitches',
		limitations: 'Points exclusively to magnetic north; requires manual declination math; capsule bubbles at altitude',
	},
	{
		tech: 'Satellite GPS Kinematic Compass (COG)',
		operatingPrinciple: 'Microwave carrier-phase Doppler frequency shift and sequential GNSS position vectors',
		accuracy: '±0.5° to ±1.0° (when in continuous forward motion above 3 km/h)',
		advantages: 'Completely immune to metallic interference, car chassis steel, and magnetic mineral deposits',
