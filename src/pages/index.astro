								<td class="py-3 pr-4 text-body">{c.measures}</td>
								<td class="py-3 pr-4 text-body">{c.best}</td>
								<td class="py-3 text-body">{c.limitation}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>
	</section>

