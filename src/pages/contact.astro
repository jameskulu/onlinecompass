---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Contact"
	description="Get in touch with the Accurate Online Compass team — feedback, bug reports, and suggestions."
	path="/contact/"
>
	<div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 md:py-24">
		<p class="eyebrow">contact</p>
		<h1 class="mt-4 text-display-lg text-ink">Get in touch.</h1>
		<p class="mt-4 text-body-lg text-body">
			Found a bug, want a feature, or just have feedback? We read everything.
		</p>

		<form data-contact-form class="card-lg mt-10 p-6 md:p-8 space-y-5">
			<div class="grid gap-5 sm:grid-cols-2">
				<label class="block">
					<span class="eyebrow block mb-1">name</span>
					<input data-c-name class="field-input" type="text" autocomplete="name" placeholder="Your name" />
				</label>
				<label class="block">
					<span class="eyebrow block mb-1">email</span>
					<input data-c-email class="field-input" type="email" autocomplete="email" placeholder="you@example.com" />
				</label>
			</div>
			<label class="block">
				<span class="eyebrow block mb-1">message</span>
				<textarea
					data-c-message
					class="field-input h-36 resize-y py-2"
					placeholder="Tell us what's on your mind…"
					required
				></textarea>
			</label>
			<div class="flex items-center gap-3">
				<button data-c-submit type="submit" class="btn-primary">Send message</button>
				<p data-c-note class="text-xs text-mute"></p>
			</div>
		</form>

		<p class="mt-6 text-xs text-mute leading-5">
			Prefer email? Write to hello@accurateonlinecompass.com. Since the tools run entirely in your
			browser, please include your device and browser when reporting sensor issues.
		</p>
	</div>
</Layout>

<script>
	const form = document.querySelector('[data-contact-form]');
	const note = document.querySelector('[data-c-note]');
	const submit = document.querySelector('[data-c-submit]');

	form?.addEventListener('submit', (e) => {
		e.preventDefault();
		submit.disabled = true;
		note.textContent = 'Sending…';
		// No backend — this form is a placeholder until an endpoint is configured.
		setTimeout(() => {
			submit.disabled = false;
			note.textContent = 'This form is not wired up yet. Email us instead at hello@accurateonlinecompass.com';
		}, 800);
	});
</script>