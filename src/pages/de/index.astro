---
import Layout from '../../layouts/Layout.astro';
import Compass from '../../components/Compass.astro';

const faq = [
	{
		q: 'Was ist ein Online-Kompass?',
		a: 'Ein Online-Kompass ist ein digitaler Kompass, der direkt in Ihrem Webbrowser läuft statt als separate App. Er liest das Magnetometer, den Beschleunigungssensor und das Gyroskop Ihres Smartphones aus und verwandelt sie in einen live-Kurs in Grad — ganz ohne Download. Sie öffnen eine Seite wie diese, gewähren den Sensorzugriff, und das Zifferblatt aktualisiert sich in Echtzeit, während Sie sich drehen.',
	},
	{
		q: 'Wie benutze ich einen Online-Kompass auf meinem Smartphone?',
		a: 'Öffnen Sie diese Seite auf Ihrem Smartphone, tippen Sie auf „Live-Kompass aktivieren" und halten Sie das Gerät flach in Ihrer Hand. Der Kurs erscheint unter dem Zifferblatt in Grad und als Himmelsrichtung. Für die genauesten Ergebnisse zeichnen Sie eine Acht, um das Magnetometer zu kalibrieren, und halten Sie das Smartphone von Metall und Magneten fern.',
	},
	{
		q: 'Ist ein Online-Kompass genau?',
		a: 'Ein kalibrierter Handy-Kompass ist im Freien meist auf etwa 1–5 Grad genau. Das Magnetometer selbst ist empfindlich, und Metall, Elektronik oder eine magnetische Handyhülle in der Nähe können es verfälschen. Nach der Kalibrierung und mit etwas Abstand zu Störquellen stimmen die Werte in der Regel bis auf wenige Grad mit einem physischen Kompass überein.',
	},
	{
		q: 'Was ist der Unterschied zwischen wahrem und magnetischem Norden?',
		a: 'Der magnetische Norden ist die Richtung, in die Ihr Handy-Magnetometer zeigt — er folgt dem Erdmagnetfeld, das sich jedes Jahr verschiebt. Der wahre Norden ist der geografische Nordpol, den Karten verwenden. Der Winkel zwischen beiden heißt magnetische Deklination, und dieses Werkzeug korrigiert sie automatisch, damit Ihr Kurs mit der Karte übereinstimmt.',
	},
	{
		q: 'Was ist die magnetische Deklination?',
		a: 'Die magnetische Deklination ist der Winkel zwischen magnetischem und wahrem Norden an einem bestimmten Ort. Weltweit reicht sie von etwa −30° bis +30° und ändert sich langsam mit der Zeit. In London liegt sie nahe null, in Teilen Kanadas kann sie über 15° betragen. Da sie vom Ort abhängt, ist eine GPS-genaue Deklinationskorrektur wichtig, sobald Sie einem Kurs folgen.',
	},
	{
		q: 'Warum springt oder dreht sich meine Kompassnadel?',
		a: 'Ein Magnetometer ist ein empfindliches Instrument. Handyhüllen mit Magneten, Lautsprecher, Laptops, Metalltische, Autoramaturen und Stahlgebäude verbiegen das Magnetfeld um Sie herum. Entfernen Sie sich davon, halten Sie das Smartphone flach und zeichnen Sie eine Acht, um neu zu kalibrieren. Ein paar Grad Bewegung in Innenräumen sind normal.',
	},
	{
		q: 'Wie kalibriere ich den Kompass meines Smartphones?',
		a: 'Halten Sie das Smartphone flach und drehen Sie es langsam mehrere Male in einer Acht, während der Bildschirm nach oben zeigt. So erhält das Magnetometer einen vollen Wertebereich zur Kalibrierung. Halten Sie am Ende einen Moment still. Wiederholen Sie das jedes Mal, wenn der Kurs instabil wirkt.',
	},
	{
		q: 'Funktioniert ein Online-Kompass offline — und auf einem Laptop?',
		a: 'Das Zifferblatt funktioniert auch offline weiter, sobald die Seite geladen ist, denn der Kurs wird auf Ihrem Gerät erzeugt. Ein Laptop oder Desktop-PC eignet sich jedoch nicht für Live-Kurse — die meisten haben kein Magnetometer, es gibt also nichts auszulesen. Verwenden Sie ein Smartphone oder Tablet; ein Computer zeigt weiterhin das Demo-Zifferblatt sowie die Sonnen- und Monddaten.',
	},
	{
		q: 'Fragt ein Online-Kompass nach meinem Standort, und ist er privat?',
		a: 'Der Standort ist optional und wird nur zur Berechnung der magnetischen Deklination, des Qibla-Kurses und der Sonnenposition verwendet. Die gesamte Mathematik läuft lokal in Ihrem Browser — kein Konto, kein Backend, kein Analytics. Ihre Koordinaten verlassen niemals Ihr Gerät, und Sie können die Koordinaten jederzeit auch manuell eingeben.',
	},
	{
		q: 'Kann ich mit einem Online-Kompass die Qibla finden?',
		a: 'Ja. Der Qibla-Finder nutzt Ihre Koordinaten, um den Großkreis-Kurs zur Kaaba in Mekka auf den Grad genau zu berechnen, samt Entfernung. Diesen Kurs können Sie dann auf dem live-Kompass-Zifferblatt verfolgen, um sich dorthin auszurichten.',
	},
	{
		q: 'Wie finde ich Norden ohne Kompass?',
		a: 'Auf der Nordhalbkugel steht die Sonne zur lokalen Mittagszeit genau im Süden und wirft Schatten, die nach Norden zeigen. Nachts steht Polaris (der Polarstern) fast exakt über dem wahren Norden. Das Sonnenpositions-Werkzeug dieser Seite liefert den exakten solaren Azimut für Ihren Standort und Ihre Zeit — eine verlässliche Gegenprobe für jeden Kompass.',
	},
	{
		q: 'Muss ich eine App installieren, um diesen Kompass zu benutzen?',
		a: 'Nein. Alles läuft im Browser, es gibt also nichts herunterzuladen, keinen App-Store, keine Anmeldung und keine Updates. Auf iPhone, Android und den meisten Tablets funktioniert es gleichermaßen.',
	},
	{
		q: 'Ist dieser Online-Kompass kostenlos?',
		a: 'Ja, er ist völlig kostenlos, ohne Premium-Stufen oder Bezahlschranken. Jedes Werkzeug der Website — Kompass, GPS-Koordinaten, Qibla-Finder, Kursrechner, Sonnenposition sowie Sonnen- und Mondrichtung — ist kostenlos nutzbar.',
	},
	{
		q: 'In welche Richtung schaut mein Haus oder Fenster?',
		a: 'Stellen Sie sich mit Blick nach draußen ans Fenster, halten Sie das Smartphone flach und lesen Sie den Kurs ab. Norden ist 0°, Osten 90°, Süden 180° und Westen 270°. Gärtner planen damit das Sonnenlicht, Fotografen sagen damit voraus, wo die Sonne auf- und untergeht.',
	},
];

const declinationExamples = [
	{ place: 'London, Vereinigtes Königreich', value: '≈ 0°' },
	{ place: 'Paris, Frankreich', value: '≈ +1° östlich' },
	{ place: 'New York, Vereinigte Staaten', value: '≈ −13° westlich' },
	{ place: 'Toronto, Kanada', value: '≈ −11° westlich' },
	{ place: 'Los Angeles, Vereinigte Staaten', value: '≈ +12° östlich' },
	{ place: 'Anchorage, Vereinigte Staaten', value: '≈ +15° östlich' },
	{ place: 'Sydney, Australien', value: '≈ +12° östlich' },
	{ place: 'São Paulo, Brasilien', value: '≈ −23° westlich' },
	{ place: 'Kapstadt, Südafrika', value: '≈ −25° westlich' },
	{ place: 'Tokio, Japan', value: '≈ −8° westlich' },
];

const compassRose = [
	{ point: 'N', deg: '0°' },
	{ point: 'NNE', deg: '22.5°' },
	{ point: 'NE', deg: '45°' },
	{ point: 'ENE', deg: '67.5°' },
	{ point: 'E', deg: '90°' },
	{ point: 'ESE', deg: '112.5°' },
	{ point: 'SE', deg: '135°' },
	{ point: 'SSE', deg: '157.5°' },
	{ point: 'S', deg: '180°' },
	{ point: 'SSW', deg: '202.5°' },
	{ point: 'SW', deg: '225°' },
	{ point: 'WSW', deg: '247.5°' },
	{ point: 'W', deg: '270°' },
	{ point: 'WNW', deg: '292.5°' },
	{ point: 'NW', deg: '315°' },
	{ point: 'NNW', deg: '337.5°' },
];

const compassTypes = [
	{
		type: 'Traditioneller Magnetkompass',
		measures: 'Misst das Erdmagnetfeld mit einer schwimmenden Nadel',
		best: 'Zuverlässigkeit offline, keine Batterien, zum Lehren',
		limitation: 'Braucht eine waagerechte Fläche, keine Deklinationskorrektur, nur ein Sensor',
	},
	{
		type: 'Smartphone-Sensorkompass (diese Seite)',
		measures: 'Magnetometer plus Beschleunigungssensor und Gyroskop, fusioniert',
		best: 'Live-Kurs in Grad, Neigungskompensation, Kartenausrichtung',
		limitation: 'Empfindlich gegenüber nahem Metall und Magneten',
	},
	{
		type: 'GPS-Kurskompass',
		measures: 'Bewegungsrichtung aus Änderungen der GPS-Position',
		best: 'Navigation in Bewegung, funktioniert ohne Magnetometer',
		limitation: 'Funktioniert nur in Bewegung; im Stand nutzlos',
	},
	{
		type: 'Kreiselkompass',
		measures: 'Erdrotation mit schnell rotierenden Kreiseln',
		best: 'Schiffe und Flugzeuge, unbeeinflusst von Magnetfeldern',
		limitation: 'Groß, teuer, braucht lange zum Einschwingen',
	},
];
---

<Layout
	path="/de/"
	title="Online-Kompass — Kostenloses Live-Werkzeug, um Norden zu finden"
	description="Kostenloser Online-Kompass, um Norden von Ihrem Standort zu finden. Live-Kurs mit wahrem und magnetischem Norden, Deklination, Qibla-Finder, Kursrechner und Sonnenposition — keine Installation, funktioniert auf jedem Smartphone."
	keywords="online kompass, online kompass tool, kostenloser online kompass, online kompass google, online kompass kostenlos, online kompass norden finden, online kompass richtung, online kompass geometrie, online kompass tool geometrie, online kompass geometrie, online kompass mathe, kostenloser online kompass tool, online kompass qibla, online kompass live, online kompass kabba norden vom standort finden, qibla finder online kompass"
>
	<!-- ─── Hero ───────────────────────────────────────────── -->
	<section id="compass" class="relative overflow-hidden">
		<div class="mesh-gradient" aria-hidden="true"></div>
		<div class="relative mx-auto max-w-[1200px] px-4 pt-12 pb-20 text-center sm:px-6 md:pt-20 md:pb-28">
			<Compass />
			<div class="mx-auto mt-10 max-w-3xl md:mt-14">
				<div class="badge mx-auto">kostenlos · privat · keine installation</div>

				<h1 class="mx-auto mt-6 max-w-3xl text-[36px] leading-[40px] text-ink sm:text-display-xl md:text-[56px] md:leading-[56px]">Ein Kompass, der zum wahren Norden zeigt, nicht nur zum magnetischen.</h1>

				<p class="mx-auto mt-4 max-w-xl text-body-lg text-body">Echtzeit-Gerätekurs mit automatischer Deklination, GPS-Koordinaten, Qibla-Richtung
				und Sonnenposition — alles in Ihrem Browser. Nichts zu installieren, nichts wird hochgeladen.</p>

				<div class="mt-8 flex flex-wrap items-center justify-center gap-3">
					<a href="/de/location/" class="btn-primary">Mich lokalisieren</a>
					<a href="/de/compass/" class="btn-secondary">Kompass öffnen</a>
				</div>
			</div>
		</div>
	</section>

	<!-- ─── Feature strip ──────────────────────────────────── -->
	<section class="border-y border-hairline bg-canvas">
		<div
			class="mx-auto grid max-w-[1200px] grid-cols-1 gap-px overflow-hidden px-4 py-12 sm:grid-cols-3 sm:px-6"
		>
			<div class="p-4">
				<p class="eyebrow mb-2">wahr vs. magnetisch</p>
				<p class="text-sm text-body leading-6">
					Die Deklination wird automatisch aus dem Weltmagnetischen Modell berechnet — sehen
					Sie beide Kurse auf einen Blick.
				</p>
			</div>
			<div class="p-4">
				<p class="eyebrow mb-2">datenschutz zuerst</p>
				<p class="text-sm text-body leading-6">
					Die gesamte Sensorverarbeitung erfolgt auf dem Gerät. Keine Konten, kein Tracking, und
					nichts verlässt jemals Ihren Browser.
				</p>
			</div>
			<div class="p-4">
				<p class="eyebrow mb-2">funktioniert überall</p>
				<p class="text-sm text-body leading-6">
					Chrome, Safari und Firefox auf iOS und Android, mit einem GPS-Kurs als Ersatz, wenn
					Sie in Bewegung sind.
				</p>
			</div>
		</div>
	</section>

	<!-- ─── Tools grid ─────────────────────────────────────── -->
	<section id="tools" class="scroll-mt-16">
		<div class="mx-auto max-w-[1200px] px-4 py-20 sm:px-6 md:py-28">
			<p class="eyebrow">das werkzeug-set</p>
			<h2 class="mt-3 max-w-2xl text-display-lg text-ink">
				Ein Kompass, jede Richtung, die Sie brauchen.
			</h2>
			<p class="mt-3 max-w-xl text-body-lg text-body">
				Sechs fokussierte Werkzeuge, jedes auf einer eigenen Seite, alle lokal auf Ihrem Gerät.
			</p>

			<div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
				<a href="/de/compass/" class="card-lg group p-6 transition-shadow hover:shadow-modal">
					<p class="eyebrow mb-2">kompass</p>
					<h3 class="text-display-sm text-ink group-hover:text-link transition-colors">Live-Kurs</h3>
					<p class="mt-2 text-sm text-body leading-6">
						Echtzeit-360°-Zifferblatt mit sanfter Nadel, magnetischem und wahrem Norden sowie
						live-Genauigkeitsanzeige.
					</p>
				</a>
				<a href="/de/location/" class="card-lg group p-6 transition-shadow hover:shadow-modal">
					<p class="eyebrow mb-2">standort</p>
					<h3 class="text-display-sm text-ink group-hover:text-link transition-colors">GPS-Koordinaten</h3>
					<p class="mt-2 text-sm text-body leading-6">
						Breitengrad, Längengrad, Höhe und Genauigkeit in Dezimal- und DMS-Format — mit
						Kopieren, Teilen und in Maps öffnen.
					</p>
				</a>
				<a href="/de/qibla/" class="card-lg group p-6 transition-shadow hover:shadow-modal">
					<p class="eyebrow mb-2">qibla</p>
					<h3 class="text-display-sm text-ink group-hover:text-link transition-colors">Richtung nach Mekka</h3>
					<p class="mt-2 text-sm text-body leading-6">
						Großkreis-Kurs und Entfernung zur Kaaba von Ihren Koordinaten, genau bis auf den Grad.
					</p>
				</a>
				<a href="/de/bearing/" class="card-lg group p-6 transition-shadow hover:shadow-modal">
					<p class="eyebrow mb-2">kurs</p>
					<h3 class="text-display-sm text-ink group-hover:text-link transition-colors">Kursrechner</h3>
					<p class="mt-2 text-sm text-body leading-6">
						Kurs und Großkreis-Entfernung zwischen zwei Punkten — ideal für Navigation
						und Routenplanung.
					</p>
				</a>
				<a href="/de/sun/" class="card-lg group p-6 transition-shadow hover:shadow-modal">
					<p class="eyebrow mb-2">sonne</p>
					<h3 class="text-display-sm text-ink group-hover:text-link transition-colors">Sonnenposition</h3>
					<p class="mt-2 text-sm text-body leading-6">
						Solarer Azimut und Höhenwinkel, sowie Sonnenaufgang, Sonnenhöchststand und Sonnenuntergang
						für jeden Standort.
					</p>
				</a>
				<a href="/de/sun-moon/" class="card-lg group p-6 transition-shadow hover:shadow-modal">
					<p class="eyebrow mb-2">sonne & mond</p>
					<h3 class="text-display-sm text-ink group-hover:text-link transition-colors">Richtung von Sonne und Mond</h3>
					<p class="mt-2 text-sm text-body leading-6">
						Sonne und Mond als Azimut direkt auf dem live-Kompass-Zifferblatt eingezeichnet,
						sodass Sie beide am Himmel finden, indem Sie sich zum Marker drehen.
					</p>
				</a>
				<div class="card-soft flex flex-col justify-center p-6">
					<p class="text-sm text-body leading-6">
						Keine Konten. Keine Tracker. Jede Berechnung läuft in Ihrem Browser und wird
						sofort verworfen, wenn Sie die Seite verlassen.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- ─── How it works ───────────────────────────────────── -->
	<section id="how-it-works" class="border-y border-hairline bg-canvas scroll-mt-16">
		<div class="mx-auto max-w-[1200px] px-4 py-20 sm:px-6 md:py-28">
			<p class="eyebrow">so funktioniert es</p>
			<h2 class="mt-3 max-w-2xl text-display-lg text-ink">Entwickelt für Genauigkeit.</h2>
			<p class="mt-3 max-w-xl text-body-lg text-body">
				Das Magnetometer, Gyroskop und Beschleunigungssensor Ihres Smartphones speisen eine
				neigungskompensierte Kursberechnung, korrigiert durch das Weltmagnetische Modell.
			</p>

			<div class="mt-12 grid gap-6 md:grid-cols-3">
				<div class="card p-6">
					<div class="mb-4 flex h-10 w-10 items-center justify-center rounded-md border border-hairline text-ink">
						<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" aria-hidden="true">
							<circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5" />
							<path d="M15.5 8.5 13 13l-4.5 2.5L11 11z" fill="var(--color-error)" />
						</svg>
					</div>
					<h3 class="text-display-sm text-ink">Sensorfusion</h3>
					<p class="mt-2 text-sm text-body leading-6">
						Der Kurs wird aus Orientierungs- und Magnetometer-Daten abgeleitet, in Echtzeit
						geglättet, sodass die Nadel in Ihrer Hand stabil bleibt.
					</p>
				</div>
				<div class="card p-6">
					<div class="mb-4 flex h-10 w-10 items-center justify-center rounded-md border border-hairline text-ink">
						<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" aria-hidden="true">
							<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5" />
							<path
								d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4"
								stroke="currentColor"
								stroke-width="1.5"
							/>
							<circle cx="12" cy="12" r="3" fill="currentColor" />
						</svg>
					</div>
					<h3 class="text-display-sm text-ink">Korrektur auf wahren Norden</h3>
					<p class="mt-2 text-sm text-body leading-6">
						Die Deklination schwankt weltweit zwischen −30° und +30°. Wir wenden das
						Weltmagnetische Modell an, damit wahrer Norden überall exakt ist.
					</p>
				</div>
				<div class="card p-6">
					<div class="mb-4 flex h-10 w-10 items-center justify-center rounded-md border border-hairline text-ink">
						<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" aria-hidden="true">
							<path
								d="M12 21s7-5.1 7-11a7 7 0 1 0-14 0c0 5.9 7 11 7 11Z"
								stroke="currentColor"
								stroke-width="1.5"
							/>
							<circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="1.5" />
						</svg>
					</div>
					<h3 class="text-display-sm text-ink">Lokal konzipiert</h3>
					<p class="mt-2 text-sm text-body leading-6">
						Koordinaten, Qibla-Kurs und Sonnenberechnungen laufen vollständig auf Ihrem Gerät.
						Ihr Standort verlässt niemals Ihr Gerät.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- ─── What is an online compass (SEO / value) ───────── -->
	<section id="about" class="scroll-mt-16">
		<div class="mx-auto max-w-[1200px] px-4 py-20 sm:px-6 md:py-24">
			<div class="mx-auto max-w-3xl">
				<p class="eyebrow text-center">der kostenlose online-kompass</p>
				<h2 class="mt-3 text-center text-display-lg text-ink">Was ist ein Online-Kompass?</h2>
				<p class="mt-6 text-body-lg text-body">
					Ein <strong class="text-ink font-medium">Online-Kompass</strong> ist ein digitaler
					Kompass, der direkt in Ihrem Webbrowser läuft — keine App zum Herunterladen, keine
					Installation und nichts zu bezahlen. Öffnen Sie diese Seite auf Ihrem Smartphone und,
					in wenigen Sekunden, haben Sie einen kostenlosen Online-Kompass, der Ihren live-Kurs in
					Grad anzeigt, von wo auch immer Sie sich befinden nach Norden weist und den Unterschied
					zwischen magnetischem und wahrem Norden selbstständig korrigieren kann.
				</p>
				<p class="mt-4 text-body leading-7">
					Weil er im Browser lebt, verhält er sich überall gleich — ob zu Hause, im Gelände oder
					im Klassenzimmer. Suchen Sie bei Google nach „Online-Kompass", öffnen Sie diese
					Website, und die Sensoren Ihres Geräts übernehmen. Anders als ein traditioneller
					Kompass, dessen Nadel gegen Schwerkraft und Drift ankämpft, kombiniert ein
					Online-Kompass das Magnetometer, das Gyroskop und den Beschleunigungssensor Ihres
					Smartphones zu einer stabileren und zuverlässigeren
					<strong class="text-ink font-medium">Online-Kompass-Richtung</strong>.
				</p>
				<p class="mt-4 text-body leading-7">
					Jedes Werkzeug hier dreht sich um eine Aufgabe — Ihnen zu helfen, sich zu orientieren
					und <strong class="text-ink font-medium">Norden online zu finden</strong> — und darum
					herum liegt ein vollständiges Navigations-Set: eine live-Kursanzeige in Grad, Himmels-
					und Zwischenhimmelsrichtungen, ein Vollbildmodus per Tipp und ein Genauigkeitsindikator,
					damit Sie immer wissen, wie sehr Sie der Anzeige vertrauen können. Weil alles lokal
					verarbeitet wird, verlässt Ihr Standort niemals Ihr Gerät.
				</p>
			</div>

			<div class="mx-auto mt-12 grid max-w-5xl gap-6 md:grid-cols-3">
				<div class="card p-6">
					<h3 class="text-display-sm text-ink">Wie ein Online-Kompass funktioniert</h3>
					<p class="mt-2 text-sm text-body leading-6">
						<strong class="text-ink font-medium">Drei Sensoren</strong> erledigen die Arbeit: Ein
						Magnetometer misst das Erdmagnetfeld, ein Beschleunigungssensor erkennt, wo unten
						ist, und ein Gyroskop verfolgt die Drehung. Der Browser fusioniert sie zu einem
						einzigen Kurs, und die Neigungskompensation hält ihn auch dann korrekt, wenn das
						Smartphone nicht flach liegt.
					</p>
				</div>
				<div class="card p-6">
					<h3 class="text-display-sm text-ink">Online-Kompass vs. ein traditioneller Kompass</h3>
					<p class="mt-2 text-sm text-body leading-6">
						Ein Nadelkompass ist einfach, muss aber waagerecht liegen und zeigt immer nach
						magnetischem Norden — nicht nach dem Norden auf Ihrer Karte. Ein Online-Kompass
						ergänzt den exakten Grad Ihres Kurses, eine automatische Deklinationskorrektur und
						eine Anzeige, die Sie auch im Dunkeln lesen können.
					</p>
				</div>
				<div class="card p-6">
					<h3 class="text-display-sm text-ink">Warum überhaupt einen Browser-Kompass verwenden?</h3>
					<p class="mt-2 text-sm text-body leading-6">
						Er öffnet sich mit einem Tipp aus einem Lesezeichen oder einer Suche, ohne
						Installation und ohne Konto. Wenn Ihr Smartphone eine Kompass-App hat, die Sie
						selten öffnen, ist ein Browser-Kompass derjenige, den Sie tatsächlich nutzen werden.
					</p>
				</div>
			</div>
