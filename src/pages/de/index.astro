	<section id="rose" class="border-t border-hairline bg-canvas scroll-mt-16">
		<div class="mx-auto max-w-[1200px] px-4 py-20 sm:px-6 md:py-28">
			<div class="mx-auto max-w-3xl text-center">
				<p class="eyebrow">kartografische referenz</p>
				<h2 class="mt-3 text-display-lg text-ink">Die Vollständige 16-Teilige Nautische Kompassrose</h2>
				<p class="mt-4 text-body-lg text-body">
					Internationale meteorologische und maritime Standard-Peilungen, Winkelsektoren und Quadranten-Einteilung von 0.0° bis 360.0°.
				</p>
			</div>

			<div class="mx-auto mt-12 max-w-4xl grid grid-cols-2 sm:grid-cols-4 gap-4">
				{compassRose.map((c) => (
					<div class="card p-4 flex flex-col justify-between">
						<div class="flex items-center justify-between">
							<span class="font-mono text-base font-bold text-ink">{c.point}</span>
							<span class="font-mono text-xs font-semibold text-link">{c.deg}</span>
						</div>
						<div class="mt-3">
							<p class="text-xs font-medium text-ink">{c.name}</p>
							<p class="text-[11px] text-mute">{c.quadrant}</p>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- ─── Comprehensive FAQ Section (10 In-Depth Items) ──── -->
	<section id="faq" class="border-t border-hairline bg-canvas scroll-mt-16">
		<div class="mx-auto max-w-3xl px-4 py-20 sm:px-6 md:py-28">
			<p class="eyebrow text-center">häufig gestellte fragen</p>
			<h2 class="mt-3 text-center text-display-lg text-ink">Wissenswertes Rund um die Kompassnavigation</h2>
			<p class="mt-4 text-center text-body leading-relaxed">
				Detaillierte Antworten zu Sensorik, magnetischer Deklination und browsergestützter Geonavigation.
			</p>

			<div class="mt-12 space-y-4">
				{faq.map((f) => (
					<details class="card overflow-hidden group">
						<summary class="flex cursor-pointer items-center justify-between gap-4 px-6 py-4.5 text-sm font-semibold text-ink group-open:border-b group-open:border-hairline transition-colors">
							<span>{f.q}</span>
							<svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0 text-mute group-hover:text-ink transition-transform duration-200" fill="none" aria-hidden="true">
								<path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</summary>
						<p class="px-6 py-5 text-sm text-body leading-7 bg-canvas-soft/20">{f.a}</p>
					</details>
				))}
			</div>
		</div>
	</section>

	<!-- ─── Call to Action Banner ──────────────────────────── -->
	<section class="border-t border-hairline bg-ink text-on-primary">
		<div class="mx-auto max-w-[1200px] px-4 py-20 text-center sm:px-6 md:py-24">
			<p class="font-mono text-xs uppercase tracking-[0.08em] text-on-primary/60">browsergestützte navigation</p>
			<h2 class="mt-4 text-display-lg text-on-primary">Bereit für die Exakte Orientierung?</h2>
			<p class="mx-auto mt-3 max-w-xl text-body-lg text-on-primary/75">
				Starten Sie Ihren Browser-Kompass jetzt für sofortige, verlässliche Peilung – kostenlos, privat und direkt auf Ihrem Gerät ausgeführt.
			</p>
			<div class="mt-8 flex flex-wrap items-center justify-center gap-3">
				<a href="/de/compass/" class="btn-primary bg-on-primary text-primary hover:opacity-90">Live-Kompass Starten</a>
				<a href="/de/level/" class="btn-secondary text-on-primary border-on-primary/30 hover:bg-on-primary/10">Wasserwaage Ausprobieren</a>
			</div>
		</div>
	</section>

	<!-- Structured Data for FAQ Schema -->
	<script type="application/ld+json" set:html={JSON.stringify({
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: faq.map((f) => ({
			'@type': 'Question',
			name: f.q,
			acceptedAnswer: {
				'@type': 'Answer',
				text: f.a,
			},
		})),
	})} />
</Layout>

<style>
	details summary::-webkit-details-marker {
		display: none;
	}
	details[open] summary svg {
		transform: rotate(180deg);
	}
	details summary svg {
		transition: transform 0.2s ease;
	}
</style>
