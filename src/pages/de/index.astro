import Layout from '../../layouts/Layout.astro';
import Compass from '../../components/Compass.astro';

const faq = [
	{
		"q": "Was ist ein digitaler Online-Kompass und wie funktioniert er im Browser?",
		"a": "Ein digitaler Online-Kompass ist eine Webanwendung, die über die W3C DeviceOrientation-API direkt auf die physischen MEMS-Sensoren (Magnetometer, Beschleunigungssensor und Gyroskop) Ihres Smartphones zugreift. Mittels trigonometrischer Echtzeit-Neigungskompensation in JavaScript berechnet er einen stabilen Kurs von 0° bis 360° ohne App-Installation."
	},
	{
		"q": "Was ist der Unterschied zwischen wahrem und magnetischem Norden?",
		"a": "Der wahre Norden weist entlang der Rotationsachse der Erde zum geografischen Nordpol, an dem alle Längengrade zusammenlaufen. Der magnetische Norden ist der Punkt in der Arktis, an dem die geomagnetischen Feldlinien senkrecht in den Erdkern eintreten. Die Winkeldifferenz zwischen beiden bezeichnet man als magnetische Deklination."
	},
	{
		"q": "Was ist die magnetische Deklination und warum ist sie beim Navigieren unverzichtbar?",
		"a": "Die magnetische Deklination ist der Horizontalwinkel zwischen magnetischem und wahrem Norden an Ihrem Standort. In New York beträgt sie etwa −13° West, in Los Angeles +12° Ost. Unser Kompass nutzt das World Magnetic Model (WMM) der NOAA, um diesen Versatz automatisch zu korrigieren und Ihren Kurs exakt auf topografische Karten abzustimmen."
	},
	{
		"q": "Wie kalibriere ich den Kompass meines Smartphones für maximale Präzision?",
		"a": "Halten Sie das Smartphone flach und führen Sie es 5 bis 10 Sekunden lang in einer flüssigen dreidimensionalen Achterbewegung (∞) durch die Luft. Dadurch wird das dreiachsige Magnetometer aus allen Winkeln dem Erdmagnetfeld ausgesetzt, sodass der Fusionsfilter interne Störfelder von Gehäuse und Lautsprechern herausrechnen kann."
	},
	{
		"q": "Warum zittert die Kompassnadel oder dreht sich unkontrolliert im Kreis?",
		"a": "Instabile Werte entstehen durch lokale elektromagnetische Störquellen. Halten Sie mindestens zwei Meter Abstand zu Metallgegenständen, MagSafe- oder Magnet-Hüllen, Laptops, Stahlbeton und Fahrzeug-Armaturenbrettern und führen Sie anschließend die Achter-Kalibrierung durch."
	},
	{
		"q": "Wie genau ist ein Smartphone-Kompass im Vergleich zu einem Wanderkompass?",
		"a": "Nach korrekter Kalibrierung und fernab von Metall erreicht ein Smartphone-MEMS-Magnetometer im Freien eine Genauigkeit von ±1° bis ±3°, vergleichbar mit flüssigkeitsgedämpften Handkompassen. Smartphones bieten zudem automatische Neigungskompensation und Deklinationskorrektur, während physische Kompasse das stromlose Backup bleiben."
	},
	{
		"q": "Funktioniert dieser Online-Kompass auch offline und im Flugmodus?",
		"a": "Ja. Die Plattform ist als Offline-first Progressive Web App (PWA) konzipiert. Der gesamte Quellcode und die geomagnetischen WMM-Tabellen werden im Service-Worker-Speicher Ihres Browsers abgelegt. Einmal geladen, funktioniert die Navigation auch in unberührter Wildnis ohne Mobilfunknetz oder WLAN."
	},
	{
		"q": "Warum zeigt der Kompass auf Desktop-PCs und Laptops ein Demo-Zifferblatt?",
		"a": "Ein Echtzeit-Kompasskurs setzt einen physischen Magnetfeldsensor (Magnetometer) voraus. Während Smartphones und Tablets standardmäßig damit ausgestattet sind, fehlt dieser Chip in Laptops und Desktop-Rechnern fast ausnahmslos. Auf PCs steht daher eine interaktive Simulation mit Sonnen- und Geodaten-Tools bereit."
	},
	{
		"q": "Wie berechnet der Qibla-Finder die exakte Richtung nach Mekka?",
		"a": "Das Werkzeug berechnet das geodätische Großkreis-Azimut (Orthodrome) von Ihren Koordinaten zur Kaaba in Mekka (21° 25' 21\" N, 39° 49' 34\" E) mithilfe des sphärischen Kosinussatzes. Eine smaragdgrüne Markierung auf dem Zifferblatt führt Sie visuell zur punktgenauen Ausrichtung."
	},
	{
		"q": "In welche Himmelsrichtung blickt mein Haus, mein Balkon oder mein Garten?",
		"a": "Stellen Sie sich mit flach gehaltenem Smartphone an Ihr Fenster oder Ihre Außentür. Ein Wert zwischen 315° und 45° bedeutet Nordausrichtung. Eine Südausrichtung (135°–225°) liefert ganzjährig maximalen Sonnenschein, Osten bringt Morgensonne und Westen warme Nachmittagsstrahlen."
	}
];

