const compassTechComparison = [
	{
		"tech": "Browser-MEMS-Kompass (Sensorfusion)",
		"operatingPrinciple": "Dreiachsiges Hall-Magnetometer fusioniert mit kapazitivem Beschleunigungssensor und Gyroskop",
		"accuracy": "±1.0° bis ±2.5° (mit Neigungskompensation & automatischer Deklinationskorrektur)",
		"advantages": "Ohne Download, automatische Kartenausrichtung, Nacht-HUD, Qibla & Koordinaten",
		"limitations": "Erfordert Hardware-Magnetometer; empfindlich gegenüber ferromagnetischen Hüllen"
	},
	{
