---
import Layout from '../../layouts/Layout.astro';
import Compass from '../../components/Compass.astro';

const faq = [
	{
		q: 'In welche Richtung schaue ich — Online-Kompass?',
		a: 'Öffnen Sie diese Seite auf Ihrem Smartphone und die live-Anzeige unter der Zifferblatt zeigt den genauen Grad und die Kompassrichtung (N, NO, O, SO, S, SW, W, NW), in die Sie schauen, in Echtzeit aktualisiert, während Sie sich drehen.',
	},
	{
