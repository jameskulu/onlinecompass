---
import Layout from '../../layouts/Layout.astro';
import Compass from '../../components/Compass.astro';

const faq = [
	{
		"q": "Çevrimiçi dijital pusula nedir ve tarayıcıda nasıl çalışır?",
		"a": "Çevrimiçi dijital pusula, akıllı telefonunuzdaki donanımsal MEMS sensörlerini (manyetometre, ivmeölçer ve jiroskop) W3C DeviceOrientation API aracılığıyla doğrudan okuyan bir web uygulamasıdır. Herhangi bir uygulama yüklemenize gerek kalmadan, JavaScript üzerinde gerçek zamanlı trigonometrik eğim telafisi yaparak 0°–360° arasında kararlı bir yön açısı üretir."
	},
	{
		"q": "Gerçek kuzey ile manyetik kuzey arasındaki fark nedir?",
		"a": "Gerçek kuzey, Dünya'nın dönme ekseni boyunca tüm meridyenlerin birleştiği coğrafi Kuzey Kutbu'nu gösterir. Manyetik kuzey ise Dünya'nın jeomanyetik alan çizgilerinin dikey olarak gezegenin çekirdeğine girdiği kutup bölgesidir. Bu iki yön arasındaki açısal farka manyetik sapma (deklinasyon) denir."
	},
	{
		"q": "Manyetik sapma nedir ve hassas navigasyon için neden hayati önem taşır?",
		"a": "Manyetik sapma, bulunduğunuz koordinattaki manyetik kuzey ile gerçek kuzey arasındaki yatay açıdır. New York'ta yaklaşık −13° Batı, Los Angeles'ta ise +12° Doğu civarındadır. Pusulamız, bu sapmayı otomatik olarak düzeltmek ve rotanızı topografik haritalarla birebir eşleştirmek için NOAA'nın Dünya Manyetik Modeli'ni (WMM) kullanır."
	},
	{
		"q": "Telefonumun pusulasını en yüksek hassasiyet için nasıl kalibre ederim?",
		"a": "Telefonunuzu avucunuzda düz tutun ve havada 5 ila 10 saniye boyunca akıcı bir sonsuzluk işareti (∞) veya sekiz çizin. Bu hareket, üç eksenli manyetometreyi Dünya'nın alanına her açıdan maruz bırakarak dahili bileşenlerden kaynaklanan manyetik bozulmaların filtrelenmesini sağlar."
	},
	{
		"q": "Pusula ibrem neden titriyor veya kontrolsüzce dönüyor?",
		"a": "Kararsız okumalar çevredeki elektromanyetik alan parazitlerinden kaynaklanır. Metal nesnelerden, mıknatıslı kılıflardan, MagSafe aksesuarlarından, dizüstü bilgisayarlardan, betonarme demirlerinden ve araç konsollarından en az iki metre uzaklaşın ve ardından sekiz çizerek kalibre edin."
	},
	{
		"q": "Akıllı telefon pusulası fiziksel bir harita pusulasına göre ne kadar hassastır?",
		"a": "Kalibre edildiğinde ve metallerden uzak tutulduğunda, bir akıllı telefonun MEMS manyetometresi açık alanda ±1° ila ±3° doğruluk sağlar. Bu değer sıvı sönümlemeli klasik pusulalarla eşdeğerdir. Ayrıca dijital eğim telafisi ve otomatik gerçek kuzey düzeltmesi gibi büyük avantajlar sunar."
	},
	{
		"q": "Bu çevrimiçi pusula çevrimdışı ve uçak modunda çalışır mı?",
		"a": "Evet. Bu web sitesi çevrimdışı öncelikli bir Progressive Web App (PWA) olarak tasarlanmıştır. Tüm kodlar ve jeomanyetik WMM tabloları tarayıcınızın Service Worker önbelleğinde saklanır. Sayfa bir kez açıldıktan sonra, hücresel kapsama alanı veya Wi-Fi olmayan dağlarda bile tam olarak çalışır."
	},
	{
		"q": "Pusula masaüstü bilgisayarlarda ve laptoplarda neden demo kadranı gösterir?",
		"a": "Canlı yön tespiti fiziksel bir manyetometre (manyetik alan sensörü) gerektirir. Akıllı telefonlar ve tabletlerde bu donanım bulunurken, dizüstü ve masaüstü bilgisayarlarda neredeyse hiç yer almaz. Bilgisayarlarda uygulama, etkileşimli bir simülasyon ve güneş/koordinat araçları sunar."
	},
	{
		"q": "Kıble bulucu Mekke'nin yönünü nasıl tam doğrulukla tespit eder?",
		"a": "Araç, bulunduğunuz koordinatlardan Mekke'deki Kabe'ye (21° 25' 21\" K, 39° 49' 34\" D) doğru olan büyük daire yayını (ortodromik azimut) küresel trigonometri formülleriyle hesaplar. Pusula halkasındaki zümrüt yeşili Kabe simgesi, yönünüzü tam olarak hizalamanız için görsel kılavuzluk eder."
	},
	{
		"q": "Evim, balkonum veya bahçem hangi yöne bakıyor?",
		"a": "Pencerenizin veya dış kapınızın önünde telefonunuzu düz tutarak durun. 315° ile 45° arasındaki değerler Kuzey cepheyi gösterir. Güney cephe (135°–225°) yıl boyunca en istikrarlı güneş ışığını alırken, Doğu sabah güneşini, Batı ise sıcak öğleden sonra ışığını yakalar."
	}
];

