const compassTechComparison = [
	{
		"tech": "Tarayıcı MEMS Pusulası (Sensör Füzyonu)",
		"operatingPrinciple": "Üç eksenli Hall manyetometresi, kapasitif ivmeölçer ve jiroskop bileşimi",
		"accuracy": "±1.0° ila ±2.5° (eğim telafili ve otomatik sapma açısı düzeltmeli)",
		"advantages": "Yükleme gerektirmez, harita çizgileriyle otomatik uyum, gece modu HUD, kıble ve koordinatlar",
		"limitations": "Donanımsal manyetometre gerektirir; yakın metal kütlelerine karşı duyarlıdır"
	},
	{
		"tech": "Geleneksel Sıvılı Manyetik Pusula",
		"operatingPrinciple": "Kapsül sıvısı içinde yüzen ve Dünya alan çizgilerini izleyen mıknatıslı çelik iğne",
		"accuracy": "±2.0° ila ±5.0° (kapsül sönümlemesine ve kullanıcının yatay tutuşuna bağlıdır)",
		"advantages": "Pil gereksinimi sıfırdır, yazılım veya elektronik arızalarından etkilenmez",
		"limitations": "Sadece manyetik kuzeyi gösterir; manuel hesaplama gerektirir; irtifada hava kabarcığı riski"
	},
	{
		"tech": "Uydu GPS Kinematik Pusula (COG)",
		"operatingPrinciple": "Mikrodalga taşıyıcı Doppler frekans kayması ve sıralı GNSS konum vektörleri",
