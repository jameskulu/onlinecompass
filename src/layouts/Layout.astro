---
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	path: string;
	keywords?: string;
}

const {
	title = 'True Online Compass — Free True & Magnetic North Compass',
	description = 'A free, privacy-first online compass. Real-time device heading, true vs magnetic north, GPS coordinates, Qibla direction, bearing calculator, and sun position.',
	path = '/',
	keywords = '',
} = Astro.props;

const canonical = new URL(path, Astro.site).href;
const current = Astro.url.pathname;
const ogImage = new URL('/og.png', Astro.site).href;
const navLinks = [
	{ href: '/', label: 'Compass' },
	{ href: '/location/', label: 'Location' },
	{ href: '/qibla/', label: 'Qibla' },
	{ href: '/bearing/', label: 'Bearing' },
	{ href: '/sun/', label: 'Sun' },
];
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonical} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		{keywords && <meta name="keywords" content={keywords} />}
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafafa" />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0a0a" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="default" />
		<meta name="apple-mobile-web-app-title" content="True Online Compass" />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:site_name" content="True Online Compass" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="2400" />
		<meta property="og:image:height" content="1260" />
		<meta property="og:image:alt" content="True Online Compass — free online compass tool with live heading, Qibla, bearing, and sun position" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<!-- Structured data -->
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'WebSite',
			name: 'True Online Compass',
			alternateName: 'Online Compass',
			url: new URL('/', Astro.site).href,
			description: 'Free online compass tool — live heading, true and magnetic north, Qibla finder, bearing calculator, and sun position. All in your browser, no install.',
		})} />

		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-4Y5H9H5KZD"></script>
		<script>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());

			gtag('config', 'G-4Y5H9H5KZD');
		</script>

		<!-- Theme init — avoids FOUC -->
		<script is:inline>
			(function () {
				try {
					var stored = localStorage.getItem('compass-theme');
					var dark =
						stored === 'dark' ||
						(!stored && window.matchMedia('(prefers-color-scheme: dark)').matches);
					document.documentElement.classList.toggle('dark', dark);
				} catch (e) {}
			})();
		</script>
	</head>
	<body class="min-h-screen antialiased">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-ink focus:text-on-primary focus:px-4 focus:py-2 focus:rounded-md"
			>Skip to content</a
		>

		<!-- Nav -->
		<header class="sticky top-0 z-40 border-b border-hairline bg-canvas/80 backdrop-blur-md">
			<nav
				class="mx-auto flex h-16 max-w-[1200px] items-center justify-between gap-4 px-4 sm:px-6"
				aria-label="Main"
			>
				<a href="/" class="flex shrink-0 items-center gap-2 text-ink">
					<svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" aria-hidden="true">
						<circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5" />
						<path d="M15.5 8.5 13 13l-4.5 2.5L11 11z" fill="var(--color-error)" />
						<path d="M8.5 15.5 11 11l4.5-2.5L13 13z" fill="currentColor" opacity="0.5" />
					</svg>
					<span class="font-semibold tracking-tight text-sm">True Online Compass</span>
				</a>

				<div class="hidden items-center gap-1 md:flex">
					{navLinks.map((l) => (
						<a
							href={l.href}
							class:list={[
								'whitespace-nowrap rounded-full px-3 py-1.5 text-sm transition-colors',
								current === l.href
									? 'bg-ink text-on-primary'
									: 'text-body hover:text-ink hover:bg-canvas-soft-2',
							]}
							aria-current={current === l.href ? 'page' : undefined}
							>{l.label}</a
						>
					))}
				</div>

				<div class="flex items-center gap-1.5">
					<button
						data-theme-toggle
						class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-hairline bg-canvas text-ink transition-colors hover:bg-canvas-soft-2"
						aria-label="Toggle dark mode"
						title="Toggle dark mode"
					>
						<svg data-theme-icon-sun class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6" />
							<path
								stroke="currentColor"
								stroke-width="1.6"
								stroke-linecap="round"
								d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
							/>
						</svg>
						<svg data-theme-icon-moon class="hidden h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<path
								d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"
								stroke="currentColor"
								stroke-width="1.6"
								stroke-linejoin="round"
							/>
						</svg>
					</button>

					<button
						data-menu-toggle
						class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-hairline bg-canvas text-ink transition-colors hover:bg-canvas-soft-2 md:hidden"
						aria-label="Toggle navigation menu"
						aria-controls="mobile-menu"
						aria-expanded="false"
					>
						<svg data-menu-icon-open class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
						</svg>
						<svg data-menu-icon-close class="hidden h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
							<path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
						</svg>
					</button>
				</div>
			</nav>

			<div data-mobile-menu id="mobile-menu" class="hidden border-t border-hairline bg-canvas md:hidden">
				<div class="mx-auto max-w-[1200px] px-4 py-3 sm:px-6">
					<div class="grid gap-1">
						{navLinks.map((l) => (
							<a
								href={l.href}
								class:list={[
									'rounded-lg px-4 py-3 text-sm transition-colors',
									current === l.href
										? 'bg-ink font-medium text-on-primary'
										: 'text-body hover:bg-canvas-soft-2 hover:text-ink',
								]}
								aria-current={current === l.href ? 'page' : undefined}
								>{l.label}</a
							>
						))}
					</div>
				</div>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<!-- Footer -->
		<footer class="border-t border-hairline bg-canvas">
			<div class="mx-auto grid max-w-[1200px] gap-10 px-4 py-14 sm:px-6 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
<div>
				<a href="/" class="flex items-center gap-2 text-ink mb-3">
					<svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" aria-hidden="true">
						<circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5" />
						<path d="M15.5 8.5 13 13l-4.5 2.5L11 11z" fill="var(--color-error)" />
						<path d="M8.5 15.5 11 11l4.5-2.5L13 13z" fill="currentColor" opacity="0.5" />
					</svg>
					<span class="font-semibold tracking-tight text-sm">True Online Compass</span>
				</a>
				<p class="text-sm text-body max-w-xs leading-6">
					A free, private, and accurate online compass. Real device sensors, no tracking, no
					install.
				</p>
			</div>

			<nav aria-label="Tools">
				<p class="eyebrow mb-3">tools</p>
				<ul class="space-y-2 text-sm">
					<li><a class="text-body hover:text-ink transition-colors" href="/">Compass</a></li>
					<li><a class="text-body hover:text-ink transition-colors" href="/location/">Location</a></li>
					<li><a class="text-body hover:text-ink transition-colors" href="/qibla/">Qibla finder</a></li>
					<li><a class="text-body hover:text-ink transition-colors" href="/bearing/">Bearing calculator</a></li>
					<li><a class="text-body hover:text-ink transition-colors" href="/sun/">Sun position</a></li>
				</ul>
			</nav>

			<nav aria-label="Resources">
				<p class="eyebrow mb-3">learn</p>
				<ul class="space-y-2 text-sm">
					<li><a class="text-body hover:text-ink transition-colors" href="/#how-it-works">How it works</a></li>
					<li><a class="text-body hover:text-ink transition-colors" href="/#calibration">Calibration guide</a></li>
					<li><a class="text-body hover:text-ink transition-colors" href="/#faq">FAQ</a></li>
				</ul>
			</nav>

				<nav aria-label="Company">
					<p class="eyebrow mb-3">company</p>
					<ul class="space-y-2 text-sm">
						<li><a class="text-body hover:text-ink transition-colors" href="/about/">About us</a></li>
						<li><a class="text-body hover:text-ink transition-colors" href="/contact/">Contact</a></li>
						<li><a class="text-body hover:text-ink transition-colors" href="/privacy/">Privacy</a></li>
						<li><a class="text-body hover:text-ink transition-colors" href="/terms/">Terms &amp; conditions</a></li>
					</ul>
				</nav>
			</div>
			<div class="border-t border-hairline">
				<p class="mx-auto max-w-[1200px] px-4 sm:px-6 py-6 text-xs text-mute font-mono">
					© {new Date().getFullYear()} True Online Compass · trueonlinecompass.com
				</p>
			</div>
		</footer>

		<script>
			const toggle = document.querySelector('[data-theme-toggle]');
			const sunIcon = document.querySelector('[data-theme-icon-sun]');
			const moonIcon = document.querySelector('[data-theme-icon-moon]');

			function apply(theme) {
				document.documentElement.classList.toggle('dark', theme === 'dark');
				try {
					localStorage.setItem('compass-theme', theme);
				} catch (e) {}
				sunIcon.classList.toggle('hidden', theme === 'dark');
				moonIcon.classList.toggle('hidden', theme !== 'dark');
			}

			toggle?.addEventListener('click', () => {
				const isDark = document.documentElement.classList.contains('dark');
				apply(isDark ? 'light' : 'dark');
			});

			apply(document.documentElement.classList.contains('dark') ? 'dark' : 'light');

			/* Mobile menu */
			const menuToggle = document.querySelector('[data-menu-toggle]');
			const mobileMenu = document.querySelector('[data-mobile-menu]');
			const menuOpenIcon = document.querySelector('[data-menu-icon-open]');
			const menuCloseIcon = document.querySelector('[data-menu-icon-close]');

			function setMenu(open) {
				mobileMenu.classList.toggle('hidden', !open);
				menuToggle.setAttribute('aria-expanded', String(open));
				menuOpenIcon.classList.toggle('hidden', open);
				menuCloseIcon.classList.toggle('hidden', !open);
			}

			menuToggle?.addEventListener('click', () => {
				setMenu(mobileMenu.classList.contains('hidden'));
			});

			mobileMenu?.querySelectorAll('a').forEach((a) => {
				a.addEventListener('click', () => setMenu(false));
			});
		</script>
	</body>
</html>
