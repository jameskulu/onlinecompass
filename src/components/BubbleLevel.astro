---
// Digital Bubble Level / Inclinometer component
import { getLangFromUrl } from '../i18n/utils';
import { defaultLang } from '../i18n/ui';
import { getToolStrings } from '../i18n/tools-i18n';

interface Props {
  lang?: string;
}

const { lang: propLang } = Astro.props;
const lang = propLang ?? getLangFromUrl(Astro.url) ?? defaultLang;
const strings = getToolStrings(lang).bubbleLevel;
---

<section class="bubble-level-tool card-lg p-6 md:p-8" id="bubble-level" data-lang={lang} data-strings={JSON.stringify(strings)}>
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <div>
      <div class="flex items-center gap-2">
        <span class="inline-flex h-2.5 w-2.5 rounded-full bg-emerald-500 animate-pulse" data-level-indicator></span>
        <p class="eyebrow">{strings.eyebrow}</p>
      </div>
      <h3 class="text-display-sm text-ink mt-1">{strings.title}</h3>
    </div>

    <!-- Mode Selector & Actions -->
    <div class="flex flex-wrap items-center gap-2">
      <div class="inline-flex rounded-lg border border-hairline bg-canvas-soft p-1 text-xs font-medium" role="tablist">
        <button
          type="button"
          data-mode-tab="bullseye"
          class="rounded-md px-3 py-1.5 transition-colors bg-ink text-on-primary font-semibold shadow-xs"
          role="tab"
          aria-selected="true"
        >
          {strings.tabBullseye}
        </button>
        <button
          type="button"
          data-mode-tab="tubular"
          class="rounded-md px-3 py-1.5 transition-colors text-body hover:text-ink"
          role="tab"
          aria-selected="false"
        >
          {strings.tabTubular}
        </button>
      </div>

      <button
        type="button"
        data-btn-zero
        class="btn-nav btn-nav-white border border-hairline px-3 py-1.5 text-xs font-medium"
        title="Zero relative to current angle"
      >
        <span data-zero-text>{strings.setZero}</span>
      </button>

      <button
        type="button"
        data-btn-reset-zero
        class="btn-nav btn-nav-white border border-hairline px-2.5 py-1.5 text-xs font-medium hidden text-body hover:text-ink"
        title="Reset zero calibration"
      >{strings.reset}</button>
    </div>
  </div>

  <!-- Main Visual Level Viewport -->
  <div class="relative flex flex-col items-center justify-center min-h-[380px] rounded-xl border border-hairline bg-canvas-soft/60 p-6 overflow-hidden">
    <!-- Permission / Activation Overlay for iOS -->
    <div
      data-permission-overlay
      class="hidden absolute inset-0 z-30 flex flex-col items-center justify-center bg-canvas/95 backdrop-blur-sm p-6 text-center"
    >
      <div class="max-w-md space-y-4">
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full border border-hairline bg-canvas shadow-card">
          <svg class="h-7 w-7 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
            <rect x="5" y="2" width="14" height="20" rx="3" ry="3"></rect>
            <line x1="12" y1="18" x2="12" y2="18.01"></line>
          </svg>
        </div>
        <div>
          <h4 class="text-display-sm text-ink font-semibold">{strings.permTitle}</h4>
          <p class="text-sm text-body mt-1.5 leading-6">
            {strings.permDesc}
          </p>
        </div>
        <button
          type="button"
          data-btn-enable-sensors
          class="btn-primary inline-flex items-center gap-2 text-sm h-11 px-6 shadow-float"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2v20M2 12h20"></path>
          </svg>
          {strings.permBtn}
        </button>
      </div>
    </div>

    <!-- Sensor Error Overlay (shown when device has no gyro / motion sensor for this tool) -->
    <div
      data-sensor-error-overlay
      class="hidden absolute inset-0 z-30 flex flex-col items-center justify-center bg-canvas/95 backdrop-blur-md p-6 text-center"
    >
      <div class="max-w-md flex flex-col items-center gap-3">
        <div class="flex h-14 w-14 items-center justify-center rounded-full bg-error/15 text-error shadow-card">
          <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
        </div>
        <div>
          <h4 data-sensor-error-title class="text-display-sm text-ink font-semibold">{strings.errTitle}</h4>
          <p data-sensor-error-desc class="text-sm text-body mt-2 leading-6">{strings.errDesc}</p>
          <p class="text-xs text-mute mt-1.5">
            {strings.errMobileHint}
          </p>
        </div>
        <div class="flex flex-wrap items-center justify-center gap-2 mt-3">
          <button
            type="button"
            data-btn-use-sim
            class="btn-primary text-xs h-9 px-4"
          >{strings.btnSim}</button>
          <button
            type="button"
            data-btn-copy-url
            class="btn-nav btn-nav-white border border-hairline text-xs font-medium h-9 px-4"
          >{strings.btnCopy}</button>
        </div>
      </div>
    </div>

    <!-- Bullseye Level Container -->
    <div data-view-bullseye class="relative flex flex-col items-center justify-center w-full max-w-[340px] aspect-square">
      <!-- Outer Dial Housing -->
      <div
        class="bullseye-dial relative w-full h-full rounded-full border-2 border-hairline bg-gradient-to-b from-canvas via-canvas-soft to-canvas-soft-2 shadow-modal flex items-center justify-center select-none"
      >
        <!-- Concentric Reference Rings: 15°, 10°, 5°, and center deadband (0.5°) -->
        <!-- 15° outer ring -->
        <div class="absolute w-[85%] h-[85%] rounded-full border border-hairline/80 pointer-events-none flex items-center justify-center">
          <span class="absolute top-1 text-[10px] font-mono text-mute">15°</span>
          <span class="absolute bottom-1 text-[10px] font-mono text-mute">15°</span>
          <span class="absolute left-1 text-[10px] font-mono text-mute">15°</span>
          <span class="absolute right-1 text-[10px] font-mono text-mute">15°</span>
        </div>

        <!-- 10° mid ring -->
        <div class="absolute w-[60%] h-[60%] rounded-full border border-dashed border-hairline pointer-events-none flex items-center justify-center">
          <span class="absolute top-1 text-[9px] font-mono text-mute/80">10°</span>
          <span class="absolute bottom-1 text-[9px] font-mono text-mute/80">10°</span>
        </div>

        <!-- 5° inner ring -->
        <div class="absolute w-[36%] h-[36%] rounded-full border border-hairline pointer-events-none"></div>

        <!-- Crosshair Axes -->
        <div class="absolute inset-x-0 h-px bg-hairline/70 pointer-events-none"></div>
        <div class="absolute inset-y-0 w-px bg-hairline/70 pointer-events-none"></div>

        <!-- Center Level Deadband Circle (Snapped Target) -->
        <div
          data-target-circle
          class="absolute w-[18%] h-[18%] rounded-full border-2 border-hairline transition-all duration-200 pointer-events-none flex items-center justify-center"
        >
          <div class="w-1.5 h-1.5 rounded-full bg-mute transition-colors duration-200" data-target-dot></div>
        </div>

        <!-- The Fluid Spirit Bubble -->
        <div
          data-bubble
          class="bubble-disc absolute w-14 h-14 rounded-full pointer-events-none transition-transform will-change-transform flex items-center justify-center shadow-lg"
          style="transform: translate3d(0px, 0px, 0px);"
        >
          <div class="bubble-reflection absolute inset-1 rounded-full border border-white/40"></div>
          <div class="bubble-core w-4 h-4 rounded-full bg-white/60"></div>
        </div>
      </div>
    </div>

    <!-- Tubular Dual-Axis Level Container (Hidden by default, toggled via tab) -->
    <div data-view-tubular class="hidden flex-col items-center justify-center w-full max-w-lg gap-8 py-4">
      <!-- Horizontal Tubular Vial (Roll / Gamma) -->
      <div class="w-full space-y-2">
        <div class="flex items-center justify-between text-xs text-body px-1">
          <span class="font-medium">{strings.rollTitle}</span>
          <span data-tubular-roll-deg class="font-mono text-ink font-semibold">0.0°</span>
        </div>
        <div class="relative h-14 w-full rounded-full border-2 border-hairline bg-gradient-to-b from-canvas-soft to-canvas-soft-2 p-1.5 shadow-card overflow-hidden flex items-center justify-center">
          <!-- Center Level Marker Lines -->
          <div class="absolute inset-y-0 left-1/2 -translate-x-1/2 w-8 border-x-2 border-hairline pointer-events-none z-10"></div>
          <div class="absolute inset-y-0 left-1/2 -translate-x-1/2 w-px bg-emerald-500/50 pointer-events-none z-10"></div>
          <!-- Grid tick marks -->
          <div class="absolute inset-x-8 inset-y-0 flex justify-between items-center pointer-events-none opacity-40">
            <span class="w-px h-3 bg-hairline-strong"></span>
            <span class="w-px h-4 bg-hairline-strong"></span>
            <span class="w-px h-3 bg-hairline-strong"></span>
            <span class="w-px h-4 bg-hairline-strong"></span>
            <span class="w-px h-3 bg-hairline-strong"></span>
          </div>
          <!-- Roll Bubble -->
          <div
            data-tubular-roll-bubble
            class="tubular-bubble absolute h-10 w-12 rounded-full shadow-md will-change-transform flex items-center justify-center"
            style="transform: translate3d(0px, 0px, 0px);"
          >
            <div class="w-2.5 h-2.5 rounded-full bg-white/70"></div>
          </div>
        </div>
      </div>

      <!-- Vertical Tubular Vial (Pitch / Beta) -->
      <div class="w-full space-y-2">
        <div class="flex items-center justify-between text-xs text-body px-1">
          <span class="font-medium">{strings.pitchTitle}</span>
          <span data-tubular-pitch-deg class="font-mono text-ink font-semibold">0.0°</span>
        </div>
        <div class="relative h-14 w-full rounded-full border-2 border-hairline bg-gradient-to-b from-canvas-soft to-canvas-soft-2 p-1.5 shadow-card overflow-hidden flex items-center justify-center">
          <div class="absolute inset-y-0 left-1/2 -translate-x-1/2 w-8 border-x-2 border-hairline pointer-events-none z-10"></div>
          <div class="absolute inset-y-0 left-1/2 -translate-x-1/2 w-px bg-emerald-500/50 pointer-events-none z-10"></div>
          <div class="absolute inset-x-8 inset-y-0 flex justify-between items-center pointer-events-none opacity-40">
            <span class="w-px h-3 bg-hairline-strong"></span>
            <span class="w-px h-4 bg-hairline-strong"></span>
            <span class="w-px h-3 bg-hairline-strong"></span>
            <span class="w-px h-4 bg-hairline-strong"></span>
            <span class="w-px h-3 bg-hairline-strong"></span>
          </div>
          <!-- Pitch Bubble -->
          <div
            data-tubular-pitch-bubble
            class="tubular-bubble absolute h-10 w-12 rounded-full shadow-md will-change-transform flex items-center justify-center"
            style="transform: translate3d(0px, 0px, 0px);"
          >
            <div class="w-2.5 h-2.5 rounded-full bg-white/70"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Status Alignment Banner Pill -->
    <div class="mt-6 flex items-center gap-2">
      <div
        data-alignment-badge
        class="inline-flex items-center gap-2 rounded-full border border-hairline bg-canvas px-4 py-1.5 text-xs font-mono font-medium shadow-xs transition-all duration-200"
      >
        <span data-badge-dot class="h-2 w-2 rounded-full bg-mute transition-colors"></span>
        <span data-badge-text class="text-ink">{strings.statusChecking}</span>
      </div>
      <div data-calibrated-badge class="hidden inline-flex items-center rounded-full bg-link/10 border border-link/20 px-2.5 py-1 text-[11px] font-mono text-link">
        {strings.calibratedZero}
      </div>
    </div>
  </div>

  <!-- Real-Time Inclinometer Metrics Grid -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mt-6">
    <div class="card-soft p-4">
      <div class="flex items-center justify-between mb-1">
        <p class="eyebrow">{strings.cardPitch}</p>
        <span class="text-[11px] font-mono text-mute">{strings.cardPitchSub}</span>
      </div>
      <p data-val-pitch class="text-display-md text-ink font-mono tabular-nums">0.0°</p>
      <p class="text-xs text-body mt-1">{strings.cardPitchDesc}</p>
    </div>

    <div class="card-soft p-4">
      <div class="flex items-center justify-between mb-1">
        <p class="eyebrow">{strings.cardRoll}</p>
        <span class="text-[11px] font-mono text-mute">{strings.cardRollSub}</span>
      </div>
      <p data-val-roll class="text-display-md text-ink font-mono tabular-nums">0.0°</p>
      <p class="text-xs text-body mt-1">{strings.cardRollDesc}</p>
    </div>

    <div class="card-soft p-4">
      <div class="flex items-center justify-between mb-1">
        <p class="eyebrow">{strings.cardTotal}</p>
        <span class="text-[11px] font-mono text-mute">{strings.cardTotalSub}</span>
      </div>
      <p data-val-total class="text-display-md text-ink font-mono tabular-nums">0.0°</p>
      <p class="text-xs text-body mt-1">{strings.cardTotalDesc}</p>
    </div>

    <div class="card-soft p-4">
      <div class="flex items-center justify-between mb-1">
        <p class="eyebrow">{strings.cardGrade}</p>
        <span class="text-[11px] font-mono text-mute">{strings.cardGradeSub}</span>
      </div>
      <p data-val-grade class="text-display-md text-ink font-mono tabular-nums">0.0%</p>
      <p class="text-xs text-body mt-1">{strings.cardGradeDesc}</p>
    </div>
  </div>

  <!-- Desktop Simulation Controls (shown when simulation mode is active) -->
  <div data-desktop-sim class="hidden mt-6 rounded-lg border border-hairline bg-canvas-soft/40 p-4">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
      <div class="flex items-center gap-2">
        <svg class="h-4 w-4 text-warning" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <p class="text-xs font-medium text-ink">{strings.simTitle}</p>
        <span class="text-xs text-mute">({strings.simDesc})</span>
      </div>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      <label class="grid gap-1.5 text-xs text-body">
        <span class="flex justify-between font-mono"><span>{strings.simPitch}:</span><span data-sim-pitch-val>0.0°</span></span>
        <input data-sim-pitch type="range" min="-45" max="45" step="0.5" value="0" class="slider" aria-label="Simulate Pitch" />
      </label>
      <label class="grid gap-1.5 text-xs text-body">
        <span class="flex justify-between font-mono"><span>{strings.simRoll}:</span><span data-sim-roll-val>0.0°</span></span>
        <input data-sim-roll type="range" min="-45" max="45" step="0.5" value="0" class="slider" aria-label="Simulate Roll" />
      </label>
    </div>
  </div>
</section>

<style>
  /* Fluid bubble visual styling with refractive highlights */
  .bubble-disc {
    background: radial-gradient(circle at 35% 35%, rgba(16, 185, 129, 0.85) 0%, rgba(5, 150, 105, 0.95) 70%, rgba(4, 120, 87, 1) 100%);
    box-shadow: 0 4px 14px rgba(5, 150, 105, 0.4), inset 0 2px 4px rgba(255, 255, 255, 0.6), inset 0 -2px 4px rgba(0, 0, 0, 0.3);
    transition: background 0.25s ease, box-shadow 0.25s ease;
  }

  /* When tilted, use modern luminous cyan / blue fluid */
  .bubble-disc.tilted {
    background: radial-gradient(circle at 35% 35%, rgba(56, 189, 248, 0.85) 0%, rgba(14, 165, 233, 0.95) 70%, rgba(2, 132, 199, 1) 100%);
    box-shadow: 0 4px 14px rgba(14, 165, 233, 0.35), inset 0 2px 4px rgba(255, 255, 255, 0.6), inset 0 -2px 4px rgba(0, 0, 0, 0.3);
  }

  /* When perfectly level within deadband */
  .bubble-disc.level {
    background: radial-gradient(circle at 35% 35%, rgba(52, 211, 153, 0.95) 0%, rgba(16, 185, 129, 1) 70%, rgba(5, 150, 105, 1) 100%);
    box-shadow: 0 0 24px rgba(16, 185, 129, 0.8), inset 0 2px 6px rgba(255, 255, 255, 0.8), inset 0 -2px 4px rgba(0, 0, 0, 0.2);
  }

  .tubular-bubble {
    background: radial-gradient(circle at 40% 35%, rgba(56, 189, 248, 0.85) 0%, rgba(14, 165, 233, 0.95) 70%, rgba(2, 132, 199, 1) 100%);
    box-shadow: 0 2px 8px rgba(14, 165, 233, 0.35), inset 0 1px 3px rgba(255, 255, 255, 0.5);
    transition: background 0.25s ease, box-shadow 0.25s ease;
  }

  .tubular-bubble.level {
    background: radial-gradient(circle at 40% 35%, rgba(52, 211, 153, 0.95) 0%, rgba(16, 185, 129, 1) 70%, rgba(5, 150, 105, 1) 100%);
    box-shadow: 0 0 16px rgba(16, 185, 129, 0.7), inset 0 1px 3px rgba(255, 255, 255, 0.7);
  }
</style>

<script>
  (function initBubbleLevel() {
    const root = document.getElementById('bubble-level');
    if (!root) return;

    const strings = JSON.parse(root.dataset.strings || "{}");
    const $ = (sel) => root.querySelector(sel);
    const $$ = (sel) => root.querySelectorAll(sel);

    // Elements
    const bubble = $('[data-bubble]');
    const targetCircle = $('[data-target-circle]');
    const targetDot = $('[data-target-dot]');
    const levelIndicator = $('[data-level-indicator]');
    const alignmentBadge = $('[data-alignment-badge]');
    const badgeDot = $('[data-badge-dot]');
    const badgeText = $('[data-badge-text]');
    const calibratedBadge = $('[data-calibrated-badge]');
    const btnZero = $('[data-btn-zero]');
    const zeroText = $('[data-zero-text]');
    const btnResetZero = $('[data-btn-reset-zero]');
    const permissionOverlay = $('[data-permission-overlay]');
    const btnEnableSensors = $('[data-btn-enable-sensors]');
    const sensorErrorOverlay = $('[data-sensor-error-overlay]');
    const btnUseSim = $('[data-btn-use-sim]');
    const btnCopyUrl = $('[data-btn-copy-url]');

    const viewBullseye = $('[data-view-bullseye]');
    const viewTubular = $('[data-view-tubular]');
    const tabBullseye = $('[data-mode-tab="bullseye"]');
    const tabTubular = $('[data-mode-tab="tubular"]');

    const tubularRollBubble = $('[data-tubular-roll-bubble]');
    const tubularPitchBubble = $('[data-tubular-pitch-bubble]');
    const tubularRollDeg = $('[data-tubular-roll-deg]');
    const tubularPitchDeg = $('[data-tubular-pitch-deg]');

    const valPitch = $('[data-val-pitch]');
    const valRoll = $('[data-val-roll]');
    const valTotal = $('[data-val-total]');
    const valGrade = $('[data-val-grade]');

    const desktopSim = $('[data-desktop-sim]');
    const simPitch = $('[data-sim-pitch]');
    const simRoll = $('[data-sim-roll]');
    const simPitchVal = $('[data-sim-pitch-val]');
    const simRollVal = $('[data-sim-roll-val]');

    // Calibration offsets
    let offsetBeta = 0;
    let offsetGamma = 0;
    let isCalibrated = false;

    // Smoothed state for buttery 60fps rendering
    let targetBeta = 0;
    let targetGamma = 0;
    let currentBeta = 0;
    let currentGamma = 0;
    let hasSensorData = false;
    let wasLevel = false;
    let isSimMode = false;

    // LERP smoothing coefficient
    const LERP_FACTOR = 0.22;
    // Deadband threshold in degrees for "perfect level"
    const LEVEL_THRESHOLD = 0.5;
    // Max degrees mapped to visual radius in bullseye
    const MAX_VISUAL_ANGLE = 16.0;

    // Display error when device has no sensor
    function showNoSensorError() {
      if (hasSensorData || isSimMode) return;
      if (sensorErrorOverlay) sensorErrorOverlay.classList.remove('hidden');
      if (levelIndicator) levelIndicator.className = 'inline-flex h-2.5 w-2.5 rounded-full bg-error';
      if (badgeDot) badgeDot.className = 'h-2 w-2 rounded-full bg-error';
      if (badgeText) {
        badgeText.textContent = strings.statusNoSensor || 'NO SENSOR DETECTED ON THIS DEVICE';
        badgeText.className = 'text-error font-semibold';
      }
      if (alignmentBadge) {
        alignmentBadge.className = 'inline-flex items-center gap-2 rounded-full border border-error/40 bg-error/10 px-4 py-1.5 text-xs font-mono font-medium shadow-xs';
      }
    }

    // Dismiss error to activate desktop simulation
    btnUseSim?.addEventListener('click', () => {
      isSimMode = true;
      if (sensorErrorOverlay) sensorErrorOverlay.classList.add('hidden');
      if (desktopSim) desktopSim.classList.remove('hidden');
      if (levelIndicator) levelIndicator.className = 'inline-flex h-2.5 w-2.5 rounded-full bg-warning';
      if (badgeDot) badgeDot.className = 'h-2 w-2 rounded-full bg-warning';
      if (badgeText) {
        badgeText.textContent = strings.statusSim || 'DESKTOP SIMULATION MODE';
        badgeText.className = 'text-warning font-semibold';
      }
      if (alignmentBadge) {
        alignmentBadge.className = 'inline-flex items-center gap-2 rounded-full border border-warning/40 bg-warning/10 px-4 py-1.5 text-xs font-mono font-medium shadow-xs';
      }
    });

    btnCopyUrl?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        const orig = btnCopyUrl.textContent;
        btnCopyUrl.textContent = strings.copied || 'Copied ✓';
        setTimeout(() => (btnCopyUrl.textContent = orig), 1800);
      } catch (_) {}
    });

    // Tab switching
    function setTab(mode) {
      if (mode === 'bullseye') {
        tabBullseye.classList.add('bg-ink', 'text-on-primary', 'font-semibold', 'shadow-xs');
        tabBullseye.classList.remove('text-body');
        tabTubular.classList.remove('bg-ink', 'text-on-primary', 'font-semibold', 'shadow-xs');
        tabTubular.classList.add('text-body');
        viewBullseye.classList.remove('hidden');
        viewTubular.classList.add('hidden');
      } else {
        tabTubular.classList.add('bg-ink', 'text-on-primary', 'font-semibold', 'shadow-xs');
        tabTubular.classList.remove('text-body');
        tabBullseye.classList.remove('bg-ink', 'text-on-primary', 'font-semibold', 'shadow-xs');
        tabBullseye.classList.add('text-body');
        viewTubular.classList.remove('hidden');
        viewBullseye.classList.add('hidden');
      }
    }

    tabBullseye?.addEventListener('click', () => setTab('bullseye'));
    tabTubular?.addEventListener('click', () => setTab('tubular'));

    // Zero / Calibrate
    btnZero?.addEventListener('click', () => {
      offsetBeta = targetBeta;
      offsetGamma = targetGamma;
      isCalibrated = true;
      calibratedBadge?.classList.remove('hidden');
      btnResetZero?.classList.remove('hidden');
      if (zeroText) zeroText.textContent = strings.reZero || 'Re-Zero';
    });

    btnResetZero?.addEventListener('click', () => {
      offsetBeta = 0;
      offsetGamma = 0;
      isCalibrated = false;
      calibratedBadge?.classList.add('hidden');
      btnResetZero?.classList.add('hidden');
      if (zeroText) zeroText.textContent = strings.setZero || 'Set Zero';
    });

    // Handle Orientation Event
    function handleOrientation(e) {
      if (e.beta === null && e.gamma === null) return;
      hasSensorData = true;
      if (sensorErrorOverlay) sensorErrorOverlay.classList.add('hidden');
      desktopSim?.classList.add('hidden');
      if (levelIndicator) levelIndicator.className = 'inline-flex h-2.5 w-2.5 rounded-full bg-emerald-500 animate-pulse';

      // Raw pitch (beta: -180 to 180) and roll (gamma: -90 to 90)
      targetBeta = e.beta || 0;
      targetGamma = e.gamma || 0;
    }

    // Animation loop using requestAnimationFrame
    function renderLoop() {
      // Smooth LERP filter
      currentBeta += (targetBeta - currentBeta) * LERP_FACTOR;
      currentGamma += (targetGamma - currentGamma) * LERP_FACTOR;

      // Apply calibration offsets
      const effectiveBeta = currentBeta - offsetBeta;
      const effectiveGamma = currentGamma - offsetGamma;

      // Compound 3D inclination angle: theta = acos(cos(beta) * cos(gamma))
      const radBeta = (effectiveBeta * Math.PI) / 180;
      const radGamma = (effectiveGamma * Math.PI) / 180;
      const cosTotal = Math.max(-1, Math.min(1, Math.cos(radBeta) * Math.cos(radGamma)));
      const totalAngle = (Math.acos(cosTotal) * 180) / Math.PI;

      // Slope grade % = tan(theta) * 100
      const slopeGrade = Math.abs(Math.tan((totalAngle * Math.PI) / 180) * 100);

      // Check level state
      const isLevel = totalAngle <= LEVEL_THRESHOLD;

      // Haptic feedback when entering level state
      if (isLevel && !wasLevel && hasSensorData) {
        if (typeof navigator.vibrate === 'function') {
          try {
            navigator.vibrate(25);
          } catch (_) {}
        }
      }
      wasLevel = isLevel;

      // Update Bullseye View
      if (bubble) {
        const maxRadiusPx = (viewBullseye?.clientWidth ? viewBullseye.clientWidth / 2 - 32 : 115);
        const normX = Math.max(-1, Math.min(1, effectiveGamma / MAX_VISUAL_ANGLE));
        const normY = Math.max(-1, Math.min(1, effectiveBeta / MAX_VISUAL_ANGLE));

        const transX = normX * maxRadiusPx;
        const transY = normY * maxRadiusPx;

        bubble.style.transform = `translate3d(${transX.toFixed(1)}px, ${transY.toFixed(1)}px, 0px)`;

        if (isLevel) {
          bubble.classList.add('level');
          bubble.classList.remove('tilted');
          targetCircle?.classList.add('border-emerald-500', 'shadow-[0_0_15px_rgba(16,185,129,0.5)]');
          targetDot?.classList.add('bg-emerald-500');
        } else {
          bubble.classList.remove('level');
          bubble.classList.add('tilted');
          targetCircle?.classList.remove('border-emerald-500', 'shadow-[0_0_15px_rgba(16,185,129,0.5)]');
          targetDot?.classList.remove('bg-emerald-500');
        }
      }

      // Update Tubular View
      if (viewTubular && !viewTubular.classList.contains('hidden')) {
        const tubularWidth = tubularRollBubble?.parentElement?.clientWidth || 300;
        const maxTubularPx = tubularWidth / 2 - 36;

        const normRoll = Math.max(-1, Math.min(1, effectiveGamma / MAX_VISUAL_ANGLE));
        const normPitch = Math.max(-1, Math.min(1, effectiveBeta / MAX_VISUAL_ANGLE));

        const rollX = normRoll * maxTubularPx;
        const pitchX = normPitch * maxTubularPx;

        if (tubularRollBubble) {
          tubularRollBubble.style.transform = `translate3d(${rollX.toFixed(1)}px, 0px, 0px)`;
          if (Math.abs(effectiveGamma) <= LEVEL_THRESHOLD) {
            tubularRollBubble.classList.add('level');
          } else {
            tubularRollBubble.classList.remove('level');
          }
        }
        if (tubularPitchBubble) {
          tubularPitchBubble.style.transform = `translate3d(${pitchX.toFixed(1)}px, 0px, 0px)`;
          if (Math.abs(effectiveBeta) <= LEVEL_THRESHOLD) {
            tubularPitchBubble.classList.add('level');
          } else {
            tubularPitchBubble.classList.remove('level');
          }
        }
        if (tubularRollDeg) tubularRollDeg.textContent = `${effectiveGamma >= 0 ? '+' : ''}${effectiveGamma.toFixed(1)}°`;
        if (tubularPitchDeg) tubularPitchDeg.textContent = `${effectiveBeta >= 0 ? '+' : ''}${effectiveBeta.toFixed(1)}°`;
      }

      // Update Metrics Readout
      if (valPitch) valPitch.textContent = `${effectiveBeta >= 0 ? '+' : ''}${effectiveBeta.toFixed(1)}°`;
      if (valRoll) valRoll.textContent = `${effectiveGamma >= 0 ? '+' : ''}${effectiveGamma.toFixed(1)}°`;
      if (valTotal) valTotal.textContent = `${totalAngle.toFixed(1)}°`;
      if (valGrade) valGrade.textContent = `${slopeGrade.toFixed(1)}%`;

      // Update Status Badge if sensor is active or simulated
      if (alignmentBadge && badgeDot && badgeText && (hasSensorData || isSimMode)) {
        if (isLevel) {
          badgeDot.className = 'h-2 w-2 rounded-full bg-emerald-500 animate-ping';
          badgeText.textContent = `${strings.statusLevel || 'PERFECTLY LEVEL'} · ${totalAngle.toFixed(1)}°`;
          badgeText.className = 'text-emerald-500 font-semibold';
          alignmentBadge.className = 'inline-flex items-center gap-2 rounded-full border border-emerald-500/40 bg-emerald-500/10 px-4 py-1.5 text-xs font-mono font-medium shadow-xs';
        } else {
          badgeDot.className = isSimMode ? 'h-2 w-2 rounded-full bg-warning' : 'h-2 w-2 rounded-full bg-mute';
          badgeText.textContent = `${strings.statusTilted || 'TILTED'} · ${totalAngle.toFixed(1)}°`;
          badgeText.className = 'text-ink';
          alignmentBadge.className = 'inline-flex items-center gap-2 rounded-full border border-hairline bg-canvas px-4 py-1.5 text-xs font-mono font-medium shadow-xs';
        }
      }

      requestAnimationFrame(renderLoop);
    }

    // Start orientation listener
    function startListening() {
      if (typeof window === 'undefined' || !window.DeviceOrientationEvent) {
        showNoSensorError();
        return;
      }

      window.addEventListener('deviceorientation', handleOrientation, true);
      requestAnimationFrame(renderLoop);

      // Check after 1.2s if real sensors fired; if not, show sensor error message
      setTimeout(() => {
        if (!hasSensorData) {
          showNoSensorError();
        }
      }, 1200);
    }

    // iOS 13+ Permission check
    if (
      typeof DeviceOrientationEvent !== 'undefined' &&
      typeof DeviceOrientationEvent.requestPermission === 'function'
    ) {
      permissionOverlay?.classList.remove('hidden');
      btnEnableSensors?.addEventListener('click', async () => {
        try {
          const res = await DeviceOrientationEvent.requestPermission();
          if (res === 'granted') {
            permissionOverlay?.classList.add('hidden');
            startListening();
          } else {
            permissionOverlay?.classList.add('hidden');
            showNoSensorError();
          }
        } catch (err) {
          console.error(err);
          permissionOverlay?.classList.add('hidden');
          showNoSensorError();
        }
      });
    } else {
      startListening();
    }

    // Desktop Simulation Sliders
    function targetPitchVal() {
      if (!simPitch) return;
      targetBeta = parseFloat(simPitch.value);
      if (simPitchVal) simPitchVal.textContent = `${targetBeta.toFixed(1)}°`;
    }

    function targetRollVal() {
      if (!simRoll) return;
      targetGamma = parseFloat(simRoll.value);
      if (simRollVal) simRollVal.textContent = `${targetGamma.toFixed(1)}°`;
    }

    simPitch?.addEventListener('input', targetPitchVal);
    simRoll?.addEventListener('input', targetRollVal);
  })();
</script>
