---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { defaultLang } from '../i18n/ui';

const lang = Astro.props.lang ?? getLangFromUrl(Astro.url) ?? defaultLang;
const t = useTranslations(lang);

const STRINGS = {
	statusStarting: t('sunmoon.status.starting'),
	heading: t('sunmoon.heading'),
	modeTrue: t('sunmoon.mode.true'),
	modeMag: t('sunmoon.mode.mag'),
	decl: t('sunmoon.decl'),
	src: t('sunmoon.src'),
	useLocation: t('sunmoon.useLocation'),
	sunDirection: t('sunmoon.sunDirection'),
	moonDirection: t('sunmoon.moonDirection'),
	elev: t('sunmoon.elev'),
	legendSun: t('sunmoon.legendSun'),
	legendMoon: t('sunmoon.legendMoon'),
	legendNorth: t('sunmoon.legendNorth'),
	demoTitle: t('sunmoon.demoTitle'),
	enableLive: t('sunmoon.enableLive'),
	demoIos: t('sunmoon.demoIos'),
	fsLabel: t('sunmoon.fsLabel'),
	fsEnter: t('sunmoon.fsEnter') || 'Full screen',
	fsExit: t('sunmoon.fsExit') || 'Exit full screen',
};
---
<div class="sunmoon-root relative w-full max-w-2xl mx-auto select-none" data-lang={lang}>
  <!-- Floating exit fullscreen button -->
  <button
    data-fs-exit
    type="button"
    class="hidden fixed top-3 right-3 z-[1000000] items-center gap-1.5 rounded-full border border-hairline bg-canvas/90 backdrop-blur px-3.5 py-1.5 text-xs font-medium text-ink shadow-float hover:bg-canvas-soft-2 transition-colors cursor-pointer"
    aria-label={STRINGS.fsExit}
    title={STRINGS.fsExit}
  >
    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
    <span>{STRINGS.fsExit}</span>
  </button>

  <!-- Live compass -->
  <div data-live-view class="flex flex-col items-center gap-6">
    <!-- Enable compass — primary CTA shown before the dial -->
    <div data-perm-card class="hidden w-full max-w-md flex-col items-center gap-4 rounded-2xl border border-hairline bg-canvas p-6 text-center shadow-float">
      <div>
        <p class="text-display-sm text-ink mb-1">{STRINGS.enableLive}</p>
        <p class="text-sm text-body leading-5">
          {STRINGS.demoIos}
        </p>
      </div>
      <button data-perm-btn class="btn-primary w-full">{STRINGS.enableLive}</button>
    </div>

    <!-- Status pill positioned clearly above dial so it never obstructs orbiting markers -->
    <div data-status-wrapper class="flex items-center justify-center z-10 -mb-2">
      <span class="badge">
        <span data-status-dot class="inline-block w-1.5 h-1.5 rounded-full bg-mute"></span>
        <span data-status-text>{STRINGS.statusStarting}</span>
      </span>
    </div>

    <!-- Dial container: dial has same size as homepage compass, with Sun & Moon orbiting OUTSIDE the dial -->
    <div data-dial-box class="relative w-full max-w-[540px] aspect-square">
      <!-- Dial SVG containing 456px compass dial and 540px outer orbit zone -->
      <div data-dial-svg class="absolute inset-0"></div>

      <!-- fullscreen corner toggle -->
      <button
        data-fs-btn
        type="button"
        class="absolute top-2 right-2 z-10 flex h-9 w-9 items-center justify-center rounded-full border border-hairline bg-canvas text-ink transition-colors hover:bg-canvas-soft-2 shadow-sm cursor-pointer"
        aria-label={STRINGS.fsLabel}
        title={STRINGS.fsLabel}
      >
        <svg data-fs-open class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" />
        </svg>
        <svg data-fs-close class="hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5" />
        </svg>
      </button>
    </div>

    <!-- Heading readout and compass data -->
    <div data-readout class="text-center -mt-2">
      <div class="flex items-end justify-center gap-2">
        <span data-heading-deg class="text-[80px] leading-none font-semibold text-ink tracking-tight tabular-nums">
          0°
        </span>
        <span data-heading-dir class="text-display-md text-body mb-1.5">N</span>
      </div>
      <p class="eyebrow mt-3" data-heading-desc>{STRINGS.heading}</p>

      <div class="mt-6 inline-flex items-center gap-1 rounded-full border border-hairline bg-canvas p-1 shadow-sm">
        <button data-mode="true" class="rounded-full px-3 py-1 text-xs font-medium text-body hover:text-ink transition-colors">{STRINGS.modeTrue}</button>
        <button data-mode="mag" class="rounded-full px-3 py-1 text-xs font-medium text-body hover:text-ink transition-colors">{STRINGS.modeMag}</button>
        <button
          data-fs-toggle
          type="button"
          class="rounded-full px-3 py-1 text-xs font-medium text-body hover:text-ink transition-colors inline-flex items-center gap-1.5"
          aria-label={STRINGS.fsLabel}
          title={STRINGS.fsLabel}
        >
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" />
          </svg>
          <span data-fs-toggle-text>{STRINGS.fsEnter}</span>
        </button>
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-xs text-mute font-mono">
        <span>{STRINGS.decl} <span data-decl>0.0°</span></span>
        <span>·</span>
        <span>{STRINGS.src} <span data-src>—</span></span>
      </div>

      <div data-loc-wrap class="mt-3 flex flex-col items-center gap-2">
        <button data-loc-btn class="btn-ghost text-xs">{STRINGS.useLocation}</button>
        <p data-loc-coords class="hidden text-xs text-mute font-mono"></p>
      </div>
    </div>

    <!-- Sun & Moon markers readout -->
    <div data-bodies-grid class="grid w-full max-w-md grid-cols-1 gap-3 sm:grid-cols-2">
      <div class="card-soft p-4">
        <p class="eyebrow mb-1 flex items-center gap-1.5">
          <span class="inline-block h-2 w-2 rounded-full bg-amber shadow-[0_0_0_3px] shadow-amber/30"></span>
          {STRINGS.sunDirection}
        </p>
        <p class="text-display-md text-ink tabular-nums"><span data-sun-az>—</span></p>
        <p class="text-xs text-body mt-0.5"><span data-sun-dir>—</span> · {STRINGS.elev} <span data-sun-elev>—</span>°</p>
      </div>
      <div class="card-soft p-4">
        <p class="eyebrow mb-1 flex items-center gap-1.5">
          <span class="inline-block h-2 w-2 rounded-full bg-link shadow-[0_0_0_3px] shadow-link/30"></span>
          {STRINGS.moonDirection}
        </p>
        <p class="text-display-md text-ink tabular-nums"><span data-moon-az>—</span></p>
        <p class="text-xs text-body mt-0.5"><span data-moon-dir>—</span> · {STRINGS.elev} <span data-moon-elev>—</span>°</p>
      </div>
    </div>

    <!-- Legend -->
    <div data-legend class="flex flex-wrap items-center justify-center gap-x-5 gap-y-1 text-xs text-body">
      <span class="flex items-center gap-1.5"><span class="inline-block h-2 w-2 rounded-full bg-amber"></span> {STRINGS.legendSun}</span>
      <span class="flex items-center gap-1.5"><span class="inline-block h-2 w-2 rounded-full bg-link"></span> {STRINGS.legendMoon}</span>
      <span class="flex items-center gap-1.5"><span class="inline-block h-2 w-2 rounded-sm bg-error"></span> {STRINGS.legendNorth}</span>
    </div>

    <!-- Demo notice -->
    <div data-demo-notice class="hidden w-full max-w-sm card-soft p-4 items-start gap-3">
      <span class="text-lg leading-none mt-0.5" aria-hidden="true">◎</span>
      <div class="text-left">
        <p class="text-sm font-medium text-ink mb-1">{STRINGS.demoTitle}</p>
        <p data-demo-text class="text-xs text-body leading-5"></p>
      </div>
    </div>
  </div>
</div>

<script>
  import { sunPosition, moonPosition, directionName, normalize, headingDiff } from '../lib/geo.js';
  import { Compass } from '../lib/compass.js';
  import { ui, defaultLang } from '../i18n/ui.js';

  const root = document.querySelector('.sunmoon-root');
  if (!root) throw new Error('sunmoon root missing');

  const langParam = (root.dataset.lang || defaultLang) in ui ? root.dataset.lang : defaultLang;
  const t = (key) => (ui[langParam] && key in ui[langParam]) ? ui[langParam][key] : ui[defaultLang][key];

  const $ = (sel) => root.querySelector(sel);
  const svgHost = $('[data-dial-svg]');
  const permBtn = $('[data-perm-btn]');
  const permCard = $('[data-perm-card]');
  const degEl = $('[data-heading-deg]');
  const dirEl = $('[data-heading-dir]');
  const descEl = $('[data-heading-desc]');
  const declEl = $('[data-decl]');
  const srcEl = $('[data-src]');
  const statusText = $('[data-status-text]');
  const statusDot = $('[data-status-dot]');
  const fsBtn = $('[data-fs-btn]');
  const fsOpenIcon = $('[data-fs-open]');
  const fsCloseIcon = $('[data-fs-close]');
  const fsToggleBtn = $('[data-fs-toggle]');
  const fsToggleText = $('[data-fs-toggle-text]');
  const fsExitBtn = $('[data-fs-exit]');
  const locBtn = $('[data-loc-btn]');
  const locCoords = $('[data-loc-coords]');
  const demoNotice = $('[data-demo-notice]');
  const demoTextEl = $('[data-demo-text]');
  const sunAzEl = $('[data-sun-az]');
  const sunDirEl = $('[data-sun-dir]');
  const sunElevEl = $('[data-sun-elev]');
  const moonAzEl = $('[data-moon-az]');
  const moonDirEl = $('[data-moon-dir]');
  const moonElevEl = $('[data-moon-elev]');

  const compass = new Compass();

  let mode = 'true';
  let magnetic = null;
  let trueHeading = null;
  let latest = null;
  let currentAngle = 0;
  let lastFrameTime = 0;
  let lastTextDeg = 0;
  let rafId = 0;
  let noticeLive = false;
  let isFullscreen = false;

  let lat = null;
  let lng = null;
  let sunElevation = null;
  let moonElevation = null;

  /* ---------------- dial ---------------- */

  const NS = 'http://www.w3.org/2000/svg';
  // SIZE 540 provides 42px on all sides around the 456px dial face for the Sun & Moon to orbit OUTSIDE
  const SIZE = 540;
  const C = SIZE / 2; // 270

  const svg = document.createElementNS(NS, 'svg');
  svg.setAttribute('viewBox', `0 0 ${SIZE} ${SIZE}`);
  svg.classList.add('w-full', 'h-full');

  const rose = document.createElementNS(NS, 'g');
  svg.appendChild(rose);

  function line(x1, y1, x2, y2, stroke, width) {
    const l = document.createElementNS(NS, 'line');
    l.setAttribute('x1', x1);
    l.setAttribute('y1', y1);
    l.setAttribute('x2', x2);
    l.setAttribute('y2', y2);
    l.setAttribute('stroke', stroke);
    l.setAttribute('stroke-width', width);
    return l;
  }

  function text(x, y, str, cls, size) {
    const tNode = document.createElementNS(NS, 'text');
    tNode.setAttribute('x', x);
    tNode.setAttribute('y', y);
    tNode.setAttribute('text-anchor', 'middle');
    tNode.setAttribute('dominant-baseline', 'central');
    tNode.setAttribute('font-size', size);
    tNode.setAttribute('fill', 'currentColor');
    tNode.textContent = str;
    return tNode;
  }

  function circleNode(cx, cy, r, fill) {
    const c = document.createElementNS(NS, 'circle');
    c.setAttribute('cx', cx);
    c.setAttribute('cy', cy);
    c.setAttribute('r', r);
    c.setAttribute('fill', fill);
    return c;
  }

  function polygonNode(points, fill) {
    const p = document.createElementNS(NS, 'polygon');
    p.setAttribute('points', points);
    p.setAttribute('fill', fill);
    return p;
  }

  // Build celestial body (Sun or Moon) positioned completely OUTSIDE the dial face (radius 250px vs face 228px)
  function buildCelestialMarker(kind) {
    const g = document.createElementNS(NS, 'g');
    g.style.display = 'none';

    // Center of body is placed at y = 20 (radius 250 from center C=270). Face edge is at y = 42 (radius 228).
    // The entire body disc and rays sit outside y = 42, with only the arrow pointer touching the dial rim.
    const cy = 20;
    const amber = 'var(--color-amber, #f59e0b)';
    const link = 'var(--color-link, #0284c7)';
    const color = kind === 'sun' ? amber : link;

    const drop = document.createElementNS(NS, 'g');
    drop.style.filter = 'drop-shadow(0px 2px 4px rgba(0,0,0,0.45))';
    g.appendChild(drop);

    if (kind === 'sun') {
      // Sun disc outside the dial
      const disc = circleNode(C, cy, 10.5, color);
      disc.setAttribute('stroke', '#ffffff');
      disc.setAttribute('stroke-width', '1.5');
      drop.appendChild(disc);

      // Sun radiant rays
      for (let i = 0; i < 8; i++) {
        const a = (i * 45 * Math.PI) / 180;
        const ray = line(
          C + 13.5 * Math.cos(a),
          cy + 13.5 * Math.sin(a),
          C + 17.5 * Math.cos(a),
          cy + 17.5 * Math.sin(a),
          color,
          2.2
        );
        ray.setAttribute('stroke-linecap', 'round');
        drop.appendChild(ray);
      }

      // Disc highlight
      drop.appendChild(circleNode(C - 2.5, cy - 2.5, 2.5, 'rgba(255,255,255,0.75)'));

      // Direction pointer arrow pointing inward from outside toward the dial face rim (y=42)
      drop.appendChild(line(C, cy + 12, C, cy + 20, color, 2.5));
      drop.appendChild(polygonNode(`${C - 5},${cy + 19} ${C + 5},${cy + 19} ${C},${cy + 25}`, color));
    } else {
      // Moon disc outside the dial
      const disc = circleNode(C, cy, 10.5, color);
      disc.setAttribute('stroke', '#ffffff');
      disc.setAttribute('stroke-width', '1.5');
      drop.appendChild(disc);

      // Craters and surface detail
      drop.appendChild(circleNode(C - 3, cy - 2.5, 2, 'rgba(255,255,255,0.65)'));
      drop.appendChild(circleNode(C + 3, cy + 2.5, 1.5, 'rgba(255,255,255,0.55)'));
      drop.appendChild(circleNode(C + 0.5, cy - 4, 1.2, 'rgba(255,255,255,0.45)'));

      // Terminator shadow
      drop.appendChild(circleNode(C + 2.5, cy + 1, 6, 'rgba(0,0,0,0.18)'));

      // Direction pointer arrow pointing inward from outside toward the dial face rim (y=42)
      drop.appendChild(line(C, cy + 12, C, cy + 20, color, 2.5));
      drop.appendChild(polygonNode(`${C - 5},${cy + 19} ${C + 5},${cy + 19} ${C},${cy + 25}`, color));
    }

    return g;
  }

  function buildDial() {
    // R = 222 gives exactly a 456px diameter dial face (R + 6 = 228), identical to the homepage compass
    const R = 222;
    const ink = 'var(--color-ink)';
    const body = 'var(--color-body)';
    const mute = 'var(--color-mute)';
    const hairline = 'var(--color-hairline)';

    // Outer orbital guide track outside the dial (radius 250)
    const orbitTrack = circleNode(C, C, 250, 'none');
    orbitTrack.setAttribute('stroke', hairline);
    orbitTrack.setAttribute('stroke-width', '1');
    orbitTrack.setAttribute('stroke-dasharray', '2 4');
    orbitTrack.setAttribute('opacity', '0.6');
    rose.appendChild(orbitTrack);

    // Compass face (identical diameter to homepage compass)
    const face = document.createElementNS(NS, 'circle');
    face.setAttribute('cx', C);
    face.setAttribute('cy', C);
    face.setAttribute('r', R + 6);
    face.setAttribute('fill', 'var(--color-canvas)');
    face.setAttribute('stroke', hairline);
    face.setAttribute('stroke-width', '1');
    rose.appendChild(face);

    // Ticks
    for (let i = 0; i < 360; i += 2) {
      const a = ((i - 90) * Math.PI) / 180;
      const major = i % 30 === 0;
      const minor = i % 10 === 0 && !major;
      const inner = major ? R - 27 : minor ? R - 15 : R - 9;
      const outer = R - 3;
      const w = major ? 2.5 : minor ? 2 : 1.2;
      const col = major ? ink : body;
      rose.appendChild(
        line(
          C + inner * Math.cos(a),
          C + inner * Math.sin(a),
          C + outer * Math.cos(a),
          C + outer * Math.sin(a),
          col,
          w,
        ),
      );
      if (major) {
        const deg = i % 360 === 0 ? '0' : String(i);
        const label = text(C + (R - 48) * Math.cos(a), C + (R - 48) * Math.sin(a), deg, '', 16);
        label.setAttribute('fill', mute);
        rose.appendChild(label);
      }
    }

    // Cardinal and intercardinal labels
    const cards = [
      [0, 'N', 39, 'var(--color-error)'],
      [90, 'E', 30, body],
      [180, 'S', 30, body],
      [270, 'W', 30, body],
      [45, 'NE', 20, mute],
      [135, 'SE', 20, mute],
      [225, 'SW', 20, mute],
      [315, 'NW', 20, mute],
    ];
    for (const [deg, label, size, fill] of cards) {
      const a = ((deg - 90) * Math.PI) / 180;
      const tNode = text(C + (R - 84) * Math.cos(a), C + (R - 84) * Math.sin(a), label, '', size);
      tNode.setAttribute('fill', fill);
      tNode.setAttribute('font-weight', deg === 0 ? '600' : '400');
      rose.appendChild(tNode);
    }

    // Needle
    const north = document.createElementNS(NS, 'polygon');
    north.setAttribute('points', `${C},${C - R + 51} ${C - 14},${C} ${C + 14},${C}`);
    north.setAttribute('fill', 'var(--color-error)');
    rose.appendChild(north);

    const south = document.createElementNS(NS, 'polygon');
    south.setAttribute('points', `${C},${C + R - 39} ${C - 11},${C} ${C + 11},${C}`);
    south.setAttribute('fill', body);
    rose.appendChild(south);

    // Center cap
    const cap = document.createElementNS(NS, 'circle');
    cap.setAttribute('cx', C);
    cap.setAttribute('cy', C);
    cap.setAttribute('r', 15);
    cap.setAttribute('fill', 'var(--color-canvas)');
    cap.setAttribute('stroke', hairline);
    rose.appendChild(cap);

    // Sun & Moon markers attached to rose OUTSIDE the dial face, rotating with heading
    const sunMarker = buildCelestialMarker('sun');
    sunMarker.setAttribute('data-marker', 'sun');
    rose.appendChild(sunMarker);

    const moonMarker = buildCelestialMarker('moon');
    moonMarker.setAttribute('data-marker', 'moon');
    rose.appendChild(moonMarker);
  }

  function setMarker(el, bearing) {
    if (!el) return;
    if (bearing == null || isNaN(bearing)) {
      el.style.display = 'none';
      return;
    }
    el.setAttribute('transform', `rotate(${bearing} ${C} ${C})`);
    el.style.display = '';
  }

  buildDial();
  svgHost.appendChild(svg);
  svgHost.style.transformOrigin = '50% 50%';
  svgHost.style.willChange = 'transform';
  svgHost.style.transition = 'none';

  /* ---------------- status ---------------- */

  const STATUS = {
    starting: [t('sunmoon.status.starting'), 'bg-mute'],
    live: [t('sunmoon.status.live'), 'bg-success'],
    unsupported: [t('sunmoon.status.unsupported'), 'bg-error'],
    'no-gyro': [t('sunmoon.status.noGyro') || t('sunmoon.status.unsupported'), 'bg-error'],
    denied: [t('sunmoon.status.denied'), 'bg-error'],
    insecure: [t('sunmoon.status.insecure'), 'bg-warning'],
  };

  function setStatus(key) {
    const [label, cls] = STATUS[key] ?? STATUS.starting;
    statusText.textContent = label;
    statusDot.className = `inline-block w-1.5 h-1.5 rounded-full ${cls}`;
  }

  compass.onStatus = setStatus;
  compass.onError = (code) => {
    if (code === 'no-gyro' || code === 'unsupported') {
      setStatus('no-gyro');
      permCard.classList.add('hidden');
      permCard.classList.remove('flex');
      permBtn.disabled = false;
      permBtn.textContent = t('sunmoon.status.noGyro') || t('sunmoon.status.unsupported');
      enterDemo(t('sunmoon.noGyroDesc') || t('sunmoon.demoSensors'));
    }
  };

  /* ---------------- coordinate / celestial update ---------------- */

  function updateBodies() {
    if (lat == null || lng == null) return;
    const now = new Date();
    const sp = sunPosition(now, lat, lng);
    const mp = moonPosition(now, lat, lng);
    sunElevation = sp.altitude;
    moonElevation = mp.altitude;
    sunAzEl.textContent = `${Math.round(sp.azimuth)}°`;
    sunDirEl.textContent = directionName(sp.azimuth, false);
    sunElevEl.textContent = `${sp.altitude.toFixed(1)}`;
    moonAzEl.textContent = `${Math.round(mp.azimuth)}°`;
    moonDirEl.textContent = directionName(mp.azimuth, false);
    moonElevEl.textContent = `${mp.altitude.toFixed(1)}`;

    const sunMarker = rose.querySelector('[data-marker="sun"]');
    const moonMarker = rose.querySelector('[data-marker="moon"]');
    setMarker(sunMarker, sp.azimuth);
    setMarker(moonMarker, mp.azimuth);
  }

  /* ---------------- readings ---------------- */

  compass.subscribe((r) => {
    latest = mode === 'true' ? (r.trueHeading ?? r.magnetic) : (r.magnetic ?? r.trueHeading);
    if (latest != null && r.source != null) {
      if (noticeLive) {
        noticeLive = false;
        demoNotice.classList.add('hidden');
        demoNotice.classList.remove('flex');
      }
      permCard.classList.add('hidden');
      permCard.classList.remove('flex');
    }
    if (r.source != null) srcEl.textContent = r.source;
    if (r.declination != null) declEl.textContent = `${r.declination >= 0 ? '+' : ''}${r.declination.toFixed(1)}°`;
    const degNow = Math.round(normalize(latest));
    if (degNow !== lastTextDeg) {
      lastTextDeg = degNow;
      degEl.textContent = `${degNow}°`;
      dirEl.textContent = directionName(latest);
    }
  });

  /* ---------------- dial rendering ---------------- */

  function tick() {
    const now = performance.now();
    const dt = lastFrameTime ? Math.min((now - lastFrameTime) / 1000, 0.1) : 1 / 60;
    lastFrameTime = now;

    if (latest != null) {
      const desired = -latest;
      let target = desired;
      const rawDiff = desired - currentAngle;
      if (Math.abs(rawDiff) > 180) {
        if (rawDiff > 0) target -= 360;
        else target += 360;
      }
      const diff = target - currentAngle;
      const tau = 0.08;
      const k = 1 - Math.exp(-dt / tau);
      currentAngle += diff * k;
      svgHost.style.transform = `rotate(${currentAngle}deg) translateZ(0)`;
    }

    rafId = requestAnimationFrame(tick);
  }

  /* ---------------- mode toggle ---------------- */

  function setMode(next) {
    mode = next;
    const buttons = root.querySelectorAll('[data-mode]');
    buttons.forEach((b) => {
      const active = b.dataset.mode === next;
      b.className = `rounded-full px-3 py-1 text-xs font-medium transition-colors ${
        active ? 'bg-ink text-on-primary' : 'text-body hover:text-ink'
      }`;
    });
    const h = mode === 'true' ? (trueHeading ?? magnetic) : (magnetic ?? trueHeading);
    if (h != null) {
      latest = h;
      currentAngle += headingDiff(-h, currentAngle);
      svgHost.style.transform = `rotate(${currentAngle}deg) translateZ(0)`;
      degEl.textContent = `${Math.round(normalize(h))}°`;
      dirEl.textContent = directionName(h);
      lastTextDeg = Math.round(normalize(h));
    }
  }

  root.querySelectorAll('[data-mode]').forEach((b) => b.addEventListener('click', () => setMode(b.dataset.mode)));
  setMode('true');

  /* ---------------- notices ---------------- */

  function enterDemo(text) {
    demoTextEl.textContent = text;
    demoNotice.classList.remove('hidden');
    demoNotice.classList.add('flex');
  }

  /* ---------------- permission flow ---------------- */

  permBtn.addEventListener('click', async () => {
    permBtn.disabled = true;
    permBtn.textContent = t('sunmoon.starting');
    const ok = await compass.requestPermission();
    if (!ok) {
      permBtn.disabled = false;
      permBtn.textContent = t('sunmoon.enableLive');
      return;
    }
    compass.start();
  });

  const needsPermission =
    typeof DeviceOrientationEvent !== 'undefined' &&
    typeof DeviceOrientationEvent.requestPermission === 'function';

  /* ---------------- location ---------------- */

  function useLocationText(latitude, longitude) {
    lat = latitude;
    lng = longitude;
    locCoords.textContent = `lat ${latitude.toFixed(4)} · lng ${longitude.toFixed(4)}`;
    locCoords.classList.remove('hidden');
    locBtn.classList.add('hidden');
    updateBodies();
  }

  function useLocation() {
    if (!navigator.geolocation) {
      locBtn.textContent = t('sunmoon.notSupported');
      return;
    }
    locBtn.disabled = true;
    locBtn.textContent = t('sunmoon.locating');
    navigator.geolocation.getCurrentPosition(
      (pos) => {
        const { latitude, longitude } = pos.coords;
        compass.setLocation(latitude, longitude);
        declEl.textContent = `${compass.declination >= 0 ? '+' : ''}${compass.declination.toFixed(1)}°`;
        useLocationText(latitude, longitude);
      },
      (err) => {
        locBtn.disabled = false;
        locBtn.textContent = err.code === 1 ? t('sunmoon.locationDenied') : t('sunmoon.retryLocation');
      },
      { enableHighAccuracy: true, timeout: 15000 },
    );
  }

  locBtn.addEventListener('click', useLocation);

  // Auto-use location so sun/moon directions appear immediately.
  if (navigator.geolocation) {
    navigator.geolocation.getCurrentPosition(
      (pos) => {
        const { latitude, longitude } = pos.coords;
        compass.setLocation(latitude, longitude);
        declEl.textContent = `${compass.declination >= 0 ? '+' : ''}${compass.declination.toFixed(1)}°`;
        useLocationText(latitude, longitude);
      },
      () => {},
      { enableHighAccuracy: true, timeout: 10000 },
    );
  }

  // Keep sun/moon fresh over time.
  setInterval(() => {
    if (lat != null && lng != null) updateBodies();
  }, 60000);

  /* ---------------- fullscreen ---------------- */

  function updateFullscreenUI(active) {
    isFullscreen = active;
    root.classList.toggle('is-fullscreen', active);
    fsOpenIcon.classList.toggle('hidden', active);
    fsCloseIcon.classList.toggle('hidden', !active);

    if (active) {
      document.documentElement.classList.add('compass-fs-active');
      document.body.classList.add('compass-fs-active');
    } else {
      document.documentElement.classList.remove('compass-fs-active');
      document.body.classList.remove('compass-fs-active');
    }
  }

  async function toggleFullscreen(force) {
    const next = force !== undefined ? force : !isFullscreen;
    updateFullscreenUI(next);

    const hasNativeFs = !!(document.fullscreenElement || document.webkitFullscreenElement);
    if (next) {
      if (!hasNativeFs) {
        try {
          const req = root.requestFullscreen || root.webkitRequestFullscreen;
          if (req) {
            await req.call(root);
          }
        } catch (_) {}
      }
    } else {
      if (hasNativeFs) {
        try {
          const exit = document.exitFullscreen || document.webkitExitFullscreen;
          if (exit) await exit.call(document);
        } catch (_) {}
      }
    }
  }

  fsBtn?.addEventListener('click', () => toggleFullscreen());
  fsToggleBtn?.addEventListener('click', () => toggleFullscreen());
  fsExitBtn?.addEventListener('click', () => toggleFullscreen(false));

  function onNativeFsChange() {
    const nativeActive = !!(document.fullscreenElement || document.webkitFullscreenElement);
    if (!nativeActive && isFullscreen) {
      updateFullscreenUI(false);
    }
  }
  document.addEventListener('fullscreenchange', onNativeFsChange);
  document.addEventListener('webkitfullscreenchange', onNativeFsChange);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isFullscreen) {
      toggleFullscreen(false);
    }
  });

  const isMobile = /Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent);

  if (needsPermission) {
    permCard.classList.remove('hidden');
    permCard.classList.add('flex');
    noticeLive = true;
  } else if (isMobile) {
    noticeLive = true;
    compass.start();
  } else {
    setStatus('no-gyro');
    enterDemo(t('sunmoon.noGyroDesc') || t('sunmoon.demoDesktop'));
  }

  tick();
</script>

