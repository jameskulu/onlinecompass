---
import { getLangFromUrl, localizePath } from '../i18n/utils';
import { languages } from '../i18n/ui';

interface Props {
	current?: string;
}

const { current } = Astro.props;
const lang = getLangFromUrl(Astro.url);

const toolNames: Record<string, Record<string, string>> = {
	en: { compass: 'Compass', level: 'Bubble Level', speedometer: 'Speedometer', location: 'Location', qibla: 'Qibla', bearing: 'Bearing', sun: 'Sun', sunmoon: 'Sun & Moon' },
	es: { compass: 'Brújula', level: 'Nivel de Burbuja', speedometer: 'Velocímetro', location: 'Ubicación', qibla: 'Qibla', bearing: 'Rumbo', sun: 'Sol', sunmoon: 'Sol y Luna' },
	ja: { compass: 'コンパス', level: 'デジタル水準器、傾斜計、ピッチとロール。', speedometer: 'リアルタイムGPS速度、高度、トリップメーター。', level: '水準器', speedometer: 'スピードメーター', location: '位置情報', qibla: 'キブラ', bearing: '方位', sun: '太陽', sunmoon: '太陽と月' },
	fr: { compass: 'Boussole', level: 'Niveau à bulle numérique, inclinomètre, tangage et roulis.', speedometer: 'Vitesse GPS en direct, altitude et odomètre de trajet.', level: 'Niveau à bulle', speedometer: 'Tachymètre', location: 'Position', qibla: 'Qibla', bearing: 'Cap', sun: 'Soleil', sunmoon: 'Soleil et Lune' },
	de: { compass: 'Kompass', level: 'Digitale Wasserwaage, Neigungsmesser, Pitch & Roll.', speedometer: 'Echtzeit-GPS-Geschwindigkeit, Höhe und Tageskilometerzähler.', level: 'Wasserwaage', speedometer: 'Tachometer', location: 'Standort', qibla: 'Qibla', bearing: 'Kurs', sun: 'Sonne', sunmoon: 'Sonne & Mond' },
	pt: { compass: 'Bússola', level: 'Nível de bolha digital, inclinômetro, inclinação lateral e frontal.', speedometer: 'Velocidade GPS em tempo real, altitude e hodômetro.', level: 'Nível de bolha', speedometer: 'Velocímetro', location: 'Localização', qibla: 'Qibla', bearing: 'Rumbo', sun: 'Sol', sunmoon: 'Sol e Lua' },
	ko: { compass: '나침반', level: '디지털 수평계, 경사계, 피치 및 롤 각도.', speedometer: '실시간 GPS 속도, 고도 및 트립 거리.', level: '수평계', speedometer: '속도계', location: '위치', qibla: '키블라', bearing: '방위각', sun: '태양', sunmoon: '태양과 달' },
	it: { compass: 'Bussola', level: 'Livella a bolla digitale, inclinometro, beccheggio e rollio.', speedometer: 'Velocità GPS in tempo reale, altitudine e contachilometri.', level: 'Livella a bolla', speedometer: 'Tachimetro', location: 'Posizione', qibla: 'Qibla', bearing: 'Rotta', sun: 'Sole', sunmoon: 'Sole e Luna' },
	id: { compass: 'Kompas', level: 'Waterpass digital, inclinometer, pitch & roll.', speedometer: 'Kecepatan GPS real-time, elevasi, dan odometer trip.', level: 'Waterpass', speedometer: 'Speedometer', location: 'Lokasi', qibla: 'Qibla', bearing: 'Arah', sun: 'Matahari', sunmoon: 'Matahari & Bulan' },
	bn: { compass: 'কম্পাস', level: 'ডিজিটাল বাবল লেভেল, ইনক্লিনোমিটার, পিচ ও রোল।', speedometer: 'রিয়েল-টাইম জিপিএস গতি, উচ্চতা ও দূরত্ব পরিমাপ।', level: 'বাবল লেভেল', speedometer: 'স্পিডোমিটার', location: 'অবস্থান', qibla: 'কিবলা', bearing: 'বেয়ারিং', sun: 'সূর্য', sunmoon: 'সূর্য ও চাঁদ' },
	tr: { compass: 'Pusula', level: 'Dijital su terazisi, eğimölçer, yunuslama ve yuvarlanma.', speedometer: 'Canlı GPS hızı, rakım ve seyahat sayacı.', level: 'Su Terazisi', speedometer: 'Hız Göstergesi', location: 'Konum', qibla: 'Kıble', bearing: 'Yön', sun: 'Güneş', sunmoon: 'Güneş ve Ay' },
	ur: { compass: 'کمپاس', level: 'ڈیجیٹل ببل لیول، انکلینومیٹر، پچ اور رول۔', speedometer: 'لائیو جی پی ایس اسپیڈ، بلندی اور اوڈومیٹر۔', level: 'ببل لیول', speedometer: 'اسپیڈومیٹر', location: 'مقام', qibla: 'قبلہ', bearing: 'ہدایت', sun: 'سورج', sunmoon: 'سورج اور چاند' },
	ar: { compass: 'بوصلة', level: 'ميزان مائي رقمي ومقياس ميل وزوايا الانحدار.', speedometer: 'سرعة GPS في الوقت الفعلي والارتفاع وعداد المسافات.', level: 'ميزان مائي', speedometer: 'عداد السرعة', location: 'الموقع', qibla: 'القبلة', bearing: 'الاتجاه', sun: 'الشمس', sunmoon: 'الشمس والقمر' },
};

const toolDescs: Record<string, Record<string, string>> = {
	en: { compass: 'Real-time heading, true & magnetic north.', level: 'Digital spirit level, inclinometer, pitch & roll.', speedometer: 'Live GPS speed, elevation, and trip odometer.', location: 'GPS coordinates, altitude, and accuracy.', qibla: 'Direction and distance to Makkah.', bearing: 'Bearing between two coordinates.', sun: 'Azimuth, elevation, sunrise and sunset.', sunmoon: 'Sun and moon direction on the compass.' },
	es: { compass: 'Rumbo en tiempo real, norte magnético y verdadero.', location: 'Coordenadas GPS, altitud y precisión.', qibla: 'Dirección y distancia a la Meca.', bearing: 'Rumbo entre dos coordenadas.', sun: 'Acimut, elevación, amanecer y atardecer.', sunmoon: 'Dirección del sol y la luna en la brújula.' },
	ja: { compass: 'リアルタイム方位、真北と磁北。', location: 'GPS座標、標高、精度。', qibla: 'メッカへの方位と距離。', bearing: '2点間の方位。', sun: '方位角、高度、日の出と日没。', sunmoon: 'コンパス上の太陽と月の方向。' },
	fr: { compass: 'Cap en temps réel, nord vrai et magnétique.', location: 'Coordonnées GPS, altitude et précision.', qibla: 'Direction et distance vers La Mecque.', bearing: 'Cap entre deux coordonnées.', sun: 'Azimut, élévation, lever et coucher du soleil.', sunmoon: 'Direction du soleil et de la lune sur la boussole.' },
	de: { compass: 'Echtzeit-Kurs, wahrer & magnetischer Norden.', location: 'GPS-Koordinaten, Höhe und Genauigkeit.', qibla: 'Richtung und Entfernung nach Mekka.', bearing: 'Kurs zwischen zwei Koordinaten.', sun: 'Azimut, Höhenwinkel, Sonnenauf- und Untergang.', sunmoon: 'Sonne- und Mondrichtung auf dem Kompass.' },
	pt: { compass: 'Rumbo em tempo real, norte magnético e verdadeiro.', location: 'Coordenadas GPS, altitude e precisão.', qibla: 'Direção e distância para Meca.', bearing: 'Rumbo entre duas coordenadas.', sun: 'Azimute, elevação, nascer e pôr do sol.', sunmoon: 'Direção do sol e da lua na bússola.' },
	ko: { compass: '실시간 방위각, 진북 및 자북.', location: 'GPS 좌표, 고도 및 정확도.', qibla: '메카 방향과 거리.', bearing: '두 좌표 간 방위각.', sun: '방위각, 고도, 일출 및 일몰.', sunmoon: '나침반 위의 태양과 달 방향.' },
	it: { compass: 'Rotta in tempo reale, nord vero e magnetico.', location: 'Coordinate GPS, altitudine e precisione.', qibla: 'Direzione e distanza verso La Mecca.', bearing: 'Rotta tra due coordinate.', sun: 'Azimut, elevazione, alba e tramonto.', sunmoon: 'Direzione del sole e della luna sulla bussola.' },
	id: { compass: 'Arah waktu nyata, utara magnetik & sejati.', location: 'Koordinat GPS, ketinggian, dan akurasi.', qibla: 'Arah dan jarak ke Makkah.', bearing: 'Arah antara dua koordinat.', sun: 'Azimut, elevasi, terbit dan terbenam matahari.', sunmoon: 'Arah matahari & bulan pada kompas.' },
	bn: { compass: 'রিয়েল-টাইম বেয়ারিং, সত্য ও চৌম্বক উত্তর।', location: 'জিপিএস সমন্বয়, উচ্চতা ও নির্ভুলতা।', qibla: 'মক্কার দিক ও দূরত্ব।', bearing: 'দুই সমন্বয়ের মধ্যে বেয়ারিং।', sun: 'এজিমুথ, উচ্চতা, সূর্যোদয় ও সূর্যাস্ত।', sunmoon: 'কম্পাসে সূর্য ও চাঁদের দিক।' },
	tr: { compass: 'Gerçek zamanlı yön, manyetik ve gerçek kuzey.', location: 'GPS koordinatları, rakım ve doğruluk.', qibla: 'Kabe yönü ve mesafesi.', bearing: 'İki koordinat arası yön.', sun: 'Azimut, yükseklik, gün doğumu ve batımı.', sunmoon: 'Pusulada güneş ve ay yönü.' },
	ur: { compass: 'رئیل ٹائم ہدایت، اصلی اور مقناطیسی شمال۔', location: 'جی پی اس کوآرڈینیٹس، اونچائی اور درستگی۔', qibla: 'مکہ کی سمت اور فاصلہ۔', bearing: 'دو کوآرڈینیٹس کے درمیان ہدایت۔', sun: 'ایزیموت، اونچائی، طلوع آفتاب اور غروب۔', sunmoon: 'کمپاس پر سورج اور چاند کی سمت۔' },
	ar: { compass: 'اتجاه فوري، الشمال الحقيقي والمغناطيسي.', location: 'إحداثيات GPS والارتفاع والدقة.', qibla: 'اتجاه المسافة إلى مكة.', bearing: 'الاتجاه بين إحداثيتين.', sun: 'الazimuth والارتفاع وشروق وغروب الشمس.', sunmoon: 'اتجاه الشمس والقمر على البوصلة.' },
};

const names = toolNames[lang] || toolNames.en;
const descs = toolDescs[lang] || toolDescs.en;

const toolPaths: Record<string, string> = {
	compass: '/',
	level: '/level/',
	speedometer: '/speedometer/',
	location: '/location/',
	qibla: '/qibla/',
	bearing: '/bearing/',
	sun: '/sun/',
	sunmoon: '/sun-moon/',
};

const toolEntries = [
	{ slug: 'compass', name: names.compass, desc: descs.compass },
	{ slug: 'level', name: names.level || 'Bubble Level', desc: descs.level || 'Digital spirit level, inclinometer, pitch & roll.' },
	{ slug: 'speedometer', name: names.speedometer || 'Speedometer', desc: descs.speedometer || 'Live GPS speed, elevation, and trip odometer.' },
	{ slug: 'location', name: names.location, desc: descs.location },
	{ slug: 'qibla', name: names.qibla, desc: descs.qibla },
	{ slug: 'bearing', name: names.bearing, desc: descs.bearing },
	{ slug: 'sun', name: names.sun, desc: descs.sun },
	{ slug: 'sunmoon', name: names.sunmoon, desc: descs.sunmoon },
];

const tools = toolEntries
	.map((t) => ({ ...t, href: localizePath(lang, toolPaths[t.slug]) }))
	.filter((t) => {
		const currentSlug = current?.replace(/^\//, '').replace(/\/$/, '');
		return t.slug !== currentSlug;
	});

const moreLabel: Record<string, string> = {
	en: 'more tools', es: 'más herramientas', ja: 'その他のツール', fr: 'plus d\'outils',
	de: 'weitere Werkzeuge', pt: 'mais ferramentas', ko: '더 많은 도구', it: 'altri strumenti',
	id: 'lebih banyak alat', bn: 'আরো সরঞ্জাম', tr: 'daha fazla araç', ur: 'مزید ٹولز', ar: 'أدوات أخرى',
};
---

<section class="border-t border-hairline bg-canvas">
	<div class="mx-auto max-w-[1200px] px-4 py-16 sm:px-6">
		<p class="eyebrow mb-6">{moreLabel[lang] || moreLabel.en}</p>
		<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
			{tools.map((t) => (
				<a
					href={t.href}
					class="card group p-5 transition-shadow hover:shadow-float"
				>
					<h3 class="text-display-sm text-ink group-hover:text-link transition-colors">{t.name}</h3>
					<p class="mt-1.5 text-sm text-body leading-5">{t.desc}</p>
				</a>
			))}
		</div>
	</div>
</section>
