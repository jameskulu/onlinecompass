---
import QRCode from 'qrcode';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { defaultLang } from '../i18n/ui';

const lang = Astro.props.lang ?? getLangFromUrl(Astro.url) ?? defaultLang;
const t = useTranslations(lang);

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const qrDataUrl = import.meta.env.PROD ? await QRCode.toDataURL(pageUrl, { margin: 1, width: 240 }) : null;

const fsLabel = t('compass.fsLabel');
const fsEnter = t('compass.fsEnter');
const fsExit = t('compass.fsExit');
---
<div class="compass-root relative w-full max-w-2xl mx-auto select-none" data-lang={lang}>
  <!-- Floating exit fullscreen button -->
  <button
    data-fs-exit
    type="button"
    class="hidden fixed top-3 right-3 z-[1000000] items-center gap-1.5 rounded-full border border-hairline bg-canvas/90 backdrop-blur px-3.5 py-1.5 text-xs font-medium text-ink shadow-float hover:bg-canvas-soft-2 transition-colors cursor-pointer"
    aria-label={fsExit}
    title={fsExit}
  >
    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
    <span>{fsExit}</span>
  </button>

  <!-- Live compass -->
  <div data-live-view class="flex flex-col items-center gap-6">
    <!-- Enable compass — primary CTA shown before the dial -->
    <div data-perm-card class="hidden w-full max-w-md flex-col items-center gap-4 rounded-2xl border border-hairline bg-canvas p-6 text-center shadow-float">
      <div>
        <p class="text-display-sm text-ink mb-1">Enable the live compass</p>
        <p class="text-sm text-body leading-5">
          Tap the button below to let this page read your device's sensors — then hold your
          phone flat and the dial comes alive.
        </p>
      </div>
      <button data-perm-btn class="btn-primary w-full">Enable live compass</button>
      <p class="text-xs text-mute">Your location stays on your device.</p>
    </div>

    <!-- Sensor error notice (shown when no gyro / orientation sensor exists) -->
    <div data-sensor-error class="hidden w-full max-w-md flex-col items-center gap-3 rounded-2xl border border-error/40 bg-error/5 p-6 text-center shadow-float">
      <div class="flex h-12 w-12 items-center justify-center rounded-full bg-error/15 text-error">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
      </div>
      <div>
        <p data-sensor-error-title class="text-display-sm text-ink mb-1 font-semibold">No gyroscope sensor detected</p>
        <p data-sensor-error-desc class="text-sm text-body leading-5">
          This device does not have a gyroscope or orientation sensor (common on computers, laptops, and some budget tablets). The compass needs hardware motion sensors to detect rotation in real time.
        </p>
      </div>
      <div data-sensor-error-share class="mt-2 flex w-full flex-col items-stretch gap-4 border-t border-hairline pt-4 sm:flex-row sm:items-center" data-page-url={pageUrl} data-qr={qrDataUrl ? 'yes' : 'no'}>
        <img
          data-sensor-error-qr
          alt="QR code to open this page on your phone"
          class="hidden w-28 h-28 shrink-0 mx-auto rounded-xl border border-hairline bg-white p-2 shadow-card sm:mx-0"
          src={qrDataUrl ?? ''}
        />
        <div class="text-left">
          <p class="text-xs font-semibold text-ink mb-1">Open on your phone for live heading:</p>
          <p class="inline-block text-xs text-body font-mono break-all leading-5 mb-2 bg-canvas-soft rounded-lg px-2.5 py-1.5 border border-hairline">{pageUrl}</p>
          <div>
            <button data-sensor-error-copy type="button" class="btn-ghost text-xs">Copy link</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Compass dial container -->
    <div data-dial-box class="relative w-full max-w-[480px] aspect-square">
      <div data-dial-svg class="absolute inset-0"></div>

      <!-- status pill -->
      <div class="absolute top-2 left-1/2 -translate-x-1/2 flex items-center gap-2 z-10">
        <span class="badge">
          <span data-status-dot class="inline-block w-1.5 h-1.5 rounded-full bg-mute"></span>
          <span data-status-text>starting…</span>
        </span>
      </div>

      <!-- fullscreen corner toggle -->
      <button
        data-fs-btn
        type="button"
        class="absolute top-2 right-2 z-10 flex h-9 w-9 items-center justify-center rounded-full border border-hairline bg-canvas text-ink transition-colors hover:bg-canvas-soft-2 shadow-sm"
        aria-label={fsLabel}
        title={fsLabel}
      >
        <svg data-fs-open class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" />
        </svg>
        <svg data-fs-close class="hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5" />
        </svg>
      </button>
    </div>

    <!-- Heading readout and compass data -->
    <div data-readout class="text-center -mt-2">
      <div class="flex items-end justify-center gap-2">
        <span data-heading-deg class="text-[80px] leading-none font-semibold text-ink tracking-tight tabular-nums">
          0°
        </span>
        <span data-heading-dir class="text-display-md text-body mb-1.5">N</span>
      </div>
      <p class="eyebrow mt-3" data-heading-desc>heading</p>

      <div class="mt-6 inline-flex items-center gap-1 rounded-full border border-hairline bg-canvas p-1 shadow-sm">
        <button data-mode="true" class="rounded-full px-3 py-1 text-xs font-medium text-body hover:text-ink transition-colors">True north</button>
        <button data-mode="mag" class="rounded-full px-3 py-1 text-xs font-medium text-body hover:text-ink transition-colors">Magnetic</button>
        <button
          data-fs-toggle
          type="button"
          class="rounded-full px-3 py-1 text-xs font-medium text-body hover:text-ink transition-colors inline-flex items-center gap-1.5"
          aria-label={fsLabel}
          title={fsLabel}
        >
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" />
          </svg>
          <span data-fs-toggle-text>{fsEnter}</span>
        </button>
      </div>

      <div data-telemetry-row class="mt-4 flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-xs text-mute font-mono">
        <span>decl <span data-decl>0.0°</span></span>
        <span>·</span>
        <span>src <span data-src>—</span></span>
        <span>·</span>
        <span>±<span data-accuracy>—</span>°</span>
        <span data-hz-item>·</span>
        <span data-hz-item data-telemetry>— Hz</span>
      </div>

      <div data-loc-wrap class="mt-3 flex flex-col items-center gap-2">
        <button data-loc-btn class="btn-ghost text-xs">Use location for declination</button>
        <p data-loc-coords class="hidden text-xs text-mute font-mono"></p>
      </div>
    </div>

    <!-- Demo notice -->
    <div data-demo-notice class="hidden w-full max-w-sm card-soft p-4 items-start gap-3">
      <span class="text-lg leading-none mt-0.5" aria-hidden="true">◎</span>
      <div class="text-left">
        <p class="text-sm font-medium text-ink mb-1">Demo mode</p>
        <p data-demo-text class="text-xs text-body leading-5"></p>
        <div data-demo-share class="hidden mt-4 flex-col items-stretch gap-4 border-t border-hairline pt-4 sm:items-center sm:flex-row" data-page-url={pageUrl} data-qr={qrDataUrl ? 'yes' : 'no'}>
          <img
            data-demo-qr
            alt="QR code to open this page on your phone"
            class="hidden w-36 h-36 shrink-0 rounded-xl border border-hairline bg-white p-2 shadow-card"
            src={qrDataUrl ?? ''}
          />
          <div class="text-left">
            <p class="text-sm font-semibold text-ink mb-1.5">Scan with your phone to open this page</p>
            <p data-demo-url class="inline-block text-xs text-body font-mono break-all leading-5 mb-3 bg-canvas-soft rounded-lg px-2.5 py-1.5 border border-hairline">{pageUrl}</p>
            <div>
              <button data-demo-copy type="button" class="btn-ghost text-xs">Copy link</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Calibration / tips -->
    <div data-calibration class="hidden w-full max-w-sm card-soft p-4 flex items-start gap-3">
      <span class="text-lg leading-none mt-0.5" aria-hidden="true">◇</span>
      <div class="text-left">
        <p class="text-sm font-medium text-ink mb-1">Calibration needed</p>
        <p data-calibration-text class="text-xs text-body leading-5"></p>
      </div>
    </div>
  </div>
</div>

<script>
  import { Compass } from '../lib/compass.js';
  import { normalize, headingDiff, directionName } from '../lib/geo.js';
  import { ui, defaultLang } from '../i18n/ui.js';

  const root = document.querySelector('.compass-root');
  if (!root) throw new Error('compass root missing');

  const langParam = (root.dataset.lang || defaultLang) in ui ? root.dataset.lang : defaultLang;
  const t = (key) => (ui[langParam] && key in ui[langParam]) ? ui[langParam][key] : ui[defaultLang][key];

  const $ = (sel) => root.querySelector(sel);
  const svgHost = $('[data-dial-svg]');
  const permCard = $('[data-perm-card]');
  const permBtn = $('[data-perm-btn]');
  const sensorErrorCard = $('[data-sensor-error]');
  const sensorErrorTitle = $('[data-sensor-error-title]');
  const sensorErrorDesc = $('[data-sensor-error-desc]');
  const sensorErrorShare = $('[data-sensor-error-share]');
  const sensorErrorQr = $('[data-sensor-error-qr]');
  const sensorErrorCopy = $('[data-sensor-error-copy]');
  const degEl = $('[data-heading-deg]');
  const dirEl = $('[data-heading-dir]');
  const descEl = $('[data-heading-desc]');
  const declEl = $('[data-decl]');
  const srcEl = $('[data-src]');
  const accEl = $('[data-accuracy]');
  const statusText = $('[data-status-text]');
  const statusDot = $('[data-status-dot]');
  const fsBtn = $('[data-fs-btn]');
  const fsOpenIcon = $('[data-fs-open]');
  const fsCloseIcon = $('[data-fs-close]');
  const fsToggleBtn = $('[data-fs-toggle]');
  const fsToggleText = $('[data-fs-toggle-text]');
  const fsExitBtn = $('[data-fs-exit]');
  const locBtn = $('[data-loc-btn]');
  const locCoords = $('[data-loc-coords]');
  const demoNotice = $('[data-demo-notice]');
  const demoTextEl = $('[data-demo-text]');
  const demoShare = $('[data-demo-share]');
  const demoQr = $('[data-demo-qr]');
  const demoUrlEl = $('[data-demo-url]');
  const demoCopy = $('[data-demo-copy]');
  const calibrationBox = $('[data-calibration]');
  const calibrationText = $('[data-calibration-text]');
  const telemetryEl = $('[data-telemetry]');

  const compass = new Compass();

  let mode = 'true';
  let magnetic = null;
  let trueHeading = null;
  let lastDecl = 0;
  let latest = null;
  let currentAngle = 0;
  let velocity = 0;
  let hasInitializedAngle = false;
  let lastDisplayedDeg = null;
  let lastFrameTime = 0;
  let noticeLive = false;
  let telemAt = 0;
  let qiblaBearing = null;
  let sunAzimuth = null;
  let evtN = 0;
  let rafId = 0;
  let isFullscreen = false;

  /* ---------------- dial ---------------- */

  const NS = 'http://www.w3.org/2000/svg';
  const SIZE = 480;
  const C = SIZE / 2;

  const svg = document.createElementNS(NS, 'svg');
  svg.setAttribute('viewBox', `0 0 ${SIZE} ${SIZE}`);
  svg.classList.add('w-full', 'h-full');

  const rose = document.createElementNS(NS, 'g');
  svg.appendChild(rose);

  function line(x1, y1, x2, y2, stroke, width) {
    const l = document.createElementNS(NS, 'line');
    l.setAttribute('x1', x1);
    l.setAttribute('y1', y1);
    l.setAttribute('x2', x2);
    l.setAttribute('y2', y2);
    l.setAttribute('stroke', stroke);
    l.setAttribute('stroke-width', width);
    return l;
  }

  function text(x, y, str, cls, size) {
    const tNode = document.createElementNS(NS, 'text');
    tNode.setAttribute('x', x);
    tNode.setAttribute('y', y);
    tNode.setAttribute('text-anchor', 'middle');
    tNode.setAttribute('dominant-baseline', 'central');
    tNode.setAttribute('font-size', size);
    tNode.setAttribute('fill', 'currentColor');
    tNode.textContent = str;
    return tNode;
  }

  function buildDial() {
    const R = 222;
    const ink = 'var(--color-ink)';
    const body = 'var(--color-body)';
    const mute = 'var(--color-mute)';
    const hairline = 'var(--color-hairline)';

    // face
    const face = document.createElementNS(NS, 'circle');
    face.setAttribute('cx', C);
    face.setAttribute('cy', C);
    face.setAttribute('r', R + 6);
    face.setAttribute('fill', 'var(--color-canvas)');
    face.setAttribute('stroke', hairline);
    face.setAttribute('stroke-width', '1');
    rose.appendChild(face);

    // ticks
    for (let i = 0; i < 360; i += 2) {
      const a = ((i - 90) * Math.PI) / 180;
      const major = i % 30 === 0;
      const minor = i % 10 === 0 && !major;
      const inner = major ? R - 27 : minor ? R - 15 : R - 9;
      const outer = R - 3;
      const w = major ? 2.5 : minor ? 2 : 1.2;
      const col = major ? ink : body;
      rose.appendChild(
        line(
          C + inner * Math.cos(a),
          C + inner * Math.sin(a),
          C + outer * Math.cos(a),
          C + outer * Math.sin(a),
          col,
          w,
        ),
      );
      if (major) {
        const deg = i % 360 === 0 ? '0' : String(i);
        const label = text(C + (R - 48) * Math.cos(a), C + (R - 48) * Math.sin(a), deg, '', 16);
        label.setAttribute('fill', mute);
        rose.appendChild(label);
      }
    }

    // cardinal + intercardinal labels
    const cards = [
      [0, 'N', 39, 'var(--color-error)'],
      [90, 'E', 30, body],
      [180, 'S', 30, body],
      [270, 'W', 30, body],
      [45, 'NE', 20, mute],
      [135, 'SE', 20, mute],
      [225, 'SW', 20, mute],
      [315, 'NW', 20, mute],
    ];
    for (const [deg, label, size, fill] of cards) {
      const a = ((deg - 90) * Math.PI) / 180;
      const tNode = text(C + (R - 84) * Math.cos(a), C + (R - 84) * Math.sin(a), label, '', size);
      tNode.setAttribute('fill', fill);
      tNode.setAttribute('font-weight', deg === 0 ? '600' : '400');
      rose.appendChild(tNode);
    }

    // needle — north (red) + south (gray)
    const north = document.createElementNS(NS, 'polygon');
    north.setAttribute('points', `${C},${C - R + 51} ${C - 14},${C} ${C + 14},${C}`);
    north.setAttribute('fill', 'var(--color-error)');
    rose.appendChild(north);

    const south = document.createElementNS(NS, 'polygon');
    south.setAttribute('points', `${C},${C + R - 39} ${C - 11},${C} ${C + 11},${C}`);
    south.setAttribute('fill', body);
    rose.appendChild(south);

    // center cap
    const cap = document.createElementNS(NS, 'circle');
    cap.setAttribute('cx', C);
    cap.setAttribute('cy', C);
    cap.setAttribute('r', 15);
    cap.setAttribute('fill', 'var(--color-canvas)');
    cap.setAttribute('stroke', hairline);
    rose.appendChild(cap);

    // qibla marker (hidden)
    const qibla = document.createElementNS(NS, 'g');
    qibla.setAttribute('data-marker', 'qibla');
    qibla.style.display = 'none';
    const qArrow = line(C, C - R + 60, C, C - R + 90, 'var(--color-link)', 3);
    qibla.appendChild(qArrow);
    rose.appendChild(qibla);

    // sun marker (hidden)
    const sun = document.createElementNS(NS, 'g');
    sun.setAttribute('data-marker', 'sun');
    sun.style.display = 'none';
    const sArrow = line(C, C - R + 60, C, C - R + 90, 'var(--color-amber)', 3);
    sun.appendChild(sArrow);
    rose.appendChild(sun);
  }

  function setMarker(el, bearing) {
    if (!el) return;
    el.setAttribute('transform', `rotate(${bearing} ${C} ${C})`);
    el.style.display = bearing == null ? 'none' : '';
  }

  buildDial();
  svgHost.appendChild(svg);
  svgHost.style.transformOrigin = '50% 50%';
  svgHost.style.willChange = 'transform';
  svgHost.style.transition = 'none';
  svgHost.style.backfaceVisibility = 'hidden';
  svgHost.style.webkitBackfaceVisibility = 'hidden';

  /* ---------------- status ---------------- */

  const STATUS = {
    starting: ['starting…', 'bg-mute'],
    live: ['live', 'bg-success'],
    unsupported: ['no sensor', 'bg-error'],
    'no-gyro': ['no gyro sensor', 'bg-error'],
    denied: ['permission denied', 'bg-error'],
    insecure: ['requires https', 'bg-warning'],
  };

  function setStatus(key) {
    const [label, cls] = STATUS[key] ?? STATUS.starting;
    statusText.textContent = label;
    statusDot.className = `inline-block w-1.5 h-1.5 rounded-full ${cls}`;
  }

  function showSensorError(title, desc) {
    if (title && sensorErrorTitle) sensorErrorTitle.textContent = title;
    if (desc && sensorErrorDesc) sensorErrorDesc.textContent = desc;
    if (sensorErrorCard) {
      sensorErrorCard.classList.remove('hidden');
      sensorErrorCard.classList.add('flex');
    }
    if (sensorErrorQr && sensorErrorShare?.dataset.qr === 'yes') {
      sensorErrorQr.classList.remove('hidden');
    }
    permCard.classList.add('hidden');
    permCard.classList.remove('flex');
    demoNotice.classList.add('hidden');
    demoNotice.classList.remove('flex');
    permBtn.disabled = false;
    permBtn.textContent = 'No gyro sensor detected';
    setStatus('no-gyro');
  }

  function hideSensorError() {
    if (sensorErrorCard) {
      sensorErrorCard.classList.add('hidden');
      sensorErrorCard.classList.remove('flex');
    }
  }

  compass.onStatus = setStatus;
  compass.onError = (code) => {
    if (code === 'no-gyro' || code === 'unsupported') {
      showSensorError(
        'No gyroscope sensor detected',
        'This device does not have a gyroscope or orientation sensor (common on computers, laptops, and some budget tablets). The compass cannot detect rotation without hardware motion sensors.'
      );
    } else if (code === 'insecure') {
      showSensorError(
        'HTTPS required',
        'Motion and orientation sensors require a secure HTTPS connection. Please reload this page over HTTPS.'
      );
    }
  };
  compass.onPermission = (state) => {
    if (state === 'denied') {
      showSensorError(
        'Permission denied',
        'Permission was denied. Enable motion & orientation sensors for this site in your browser settings, then reload.'
      );
    }
  };

  /* ---------------- readings ---------------- */

  compass.subscribe((r) => {
    magnetic = r.magnetic;
    trueHeading = r.trueHeading;
    latest = mode === 'true' ? (r.trueHeading ?? r.magnetic) : (r.magnetic ?? r.trueHeading);
    if (latest != null && r.source != null) {
      if (noticeLive) {
        noticeLive = false;
        demoNotice.classList.add('hidden');
        demoNotice.classList.remove('flex');
      }
      permCard.classList.add('hidden');
      permCard.classList.remove('flex');
      hideSensorError();
    }
    if (r.source != null) {
      srcEl.textContent = r.source;
    }
    if (r.accuracy != null && r.accuracy !== accEl.textContent) {
      accEl.textContent = r.accuracy.toFixed(1);
    }
    if (r.declination != null && r.declination !== lastDecl) {
      lastDecl = r.declination;
      declEl.textContent = `${lastDecl >= 0 ? '+' : ''}${lastDecl.toFixed(1)}°`;
    }
    if (r.accuracy != null && r.accuracy > 8) {
      calibrationText.textContent =
        'Readings are drifting. Hold the device flat and trace a figure-eight motion until the needle steadies.';
      calibrationBox.classList.remove('hidden');
      calibrationBox.classList.add('flex');
    } else if (r.accuracy == null || r.accuracy <= 8) {
      calibrationBox.classList.add('hidden');
    }
    const now = performance.now();
    if (now - telemAt >= 1000) {
      telemAt = now;
      telemetryEl.textContent = `${evtN} Hz`;
      evtN = 0;
    }
    evtN++;
  });

  /* ---------------- dial rendering & physics ---------------- */

  const OMEGA = 16.0; // Natural frequency (rad/s) — crisp, authentic iPhone responsiveness
  const DAMPING = 32.0; // Critical damping (2 * OMEGA) for zero overshoot and butter-smooth settle

  function tick() {
    const now = performance.now();
    const dt = lastFrameTime ? Math.min((now - lastFrameTime) / 1000, 0.05) : 1 / 60;
    lastFrameTime = now;

    if (latest != null) {
      const desired = -latest;

      if (!hasInitializedAngle) {
        currentAngle = desired;
        velocity = 0;
        hasInitializedAngle = true;
      } else {
        // Multi-substep semi-implicit Euler integration for rock-solid stability at 60Hz/120Hz/throttled frames
        const steps = dt > 0.02 ? 2 : 1;
        const stepDt = dt / steps;
        for (let s = 0; s < steps; s++) {
          let diff = (desired - currentAngle) % 360;
          if (diff < -180) diff += 360;
          if (diff > 180) diff -= 360;

          // Deadband: eliminate sensor noise micro-tremors when resting stationary
          if (Math.abs(diff) < 0.1 && Math.abs(velocity) < 0.3) {
            velocity = 0;
          } else {
            const accel = OMEGA * OMEGA * diff - DAMPING * velocity;
            velocity += accel * stepDt;
            currentAngle += velocity * stepDt;
          }
        }
      }

      svgHost.style.transform = `rotate(${currentAngle.toFixed(3)}deg) translateZ(0)`;

      // Smooth visual heading readout with 0.5° hysteresis to eliminate 1-degree flickering
      const visualHeading = normalize(-currentAngle);
      let targetDeg = Math.round(visualHeading);
      if (lastDisplayedDeg !== null) {
        const delta = headingDiff(visualHeading, lastDisplayedDeg);
        if (Math.abs(delta) < 0.5) {
          targetDeg = lastDisplayedDeg;
        }
      }
      if (targetDeg !== lastDisplayedDeg) {
        lastDisplayedDeg = targetDeg;
        degEl.textContent = `${lastDisplayedDeg}°`;
        dirEl.textContent = directionName(lastDisplayedDeg);
      }
    }

    rafId = requestAnimationFrame(tick);
  }

  /* ---------------- mode toggle ---------------- */

  function setMode(next) {
    mode = next;
    const buttons = root.querySelectorAll('[data-mode]');
    buttons.forEach((b) => {
      const active = b.dataset.mode === next;
      b.className = `rounded-full px-3 py-1 text-xs font-medium transition-colors ${
        active
          ? 'bg-ink text-on-primary'
          : 'text-body hover:text-ink'
      }`;
    });
    const h = mode === 'true' ? (trueHeading ?? magnetic) : (magnetic ?? trueHeading);
    if (h != null) {
      latest = h;
    }
  }

  root.querySelectorAll('[data-mode]').forEach((b) => b.addEventListener('click', () => setMode(b.dataset.mode)));
  setMode('true');

  /* ---------------- notices ---------------- */

  function enterDemo(text) {
    demoTextEl.textContent = text;
    demoNotice.classList.remove('hidden');
    demoNotice.classList.add('flex');
  }

  /* ---------------- permission flow ---------------- */

  permBtn.addEventListener('click', async () => {
    permBtn.disabled = true;
    permBtn.textContent = 'Starting…';
    hideSensorError();
    const ok = await compass.requestPermission();
    if (!ok) {
      permBtn.disabled = false;
      permBtn.textContent = 'Enable live compass';
      return;
    }
    compass.start();
  });

  const needsPermission =
    typeof DeviceOrientationEvent !== 'undefined' &&
    typeof DeviceOrientationEvent.requestPermission === 'function';

  /* ---------------- location → declination ---------------- */

  locBtn.addEventListener('click', () => {
    if (!navigator.geolocation) {
      locBtn.textContent = 'Not supported';
      return;
    }
    locBtn.disabled = true;
    locBtn.textContent = 'Locating…';
    navigator.geolocation.getCurrentPosition(
      (pos) => {
        const { latitude, longitude } = pos.coords;
        compass.setLocation(latitude, longitude);
        locCoords.textContent = `lat ${latitude.toFixed(4)} · lng ${longitude.toFixed(4)}`;
        locCoords.classList.remove('hidden');
        locBtn.classList.add('hidden');
        declEl.textContent = `${compass.declination >= 0 ? '+' : ''}${compass.declination.toFixed(1)}°`;
      },
      (err) => {
        locBtn.disabled = false;
        locBtn.textContent = err.code === 1 ? 'Location denied — magnetic only' : 'Retry location';
      },
      { enableHighAccuracy: true, timeout: 15000 },
    );
  });

  /* ---------------- fullscreen ---------------- */

  function updateFullscreenUI(active) {
    isFullscreen = active;
    root.classList.toggle('is-fullscreen', active);
    fsOpenIcon.classList.toggle('hidden', active);
    fsCloseIcon.classList.toggle('hidden', !active);

    if (active) {
      document.documentElement.classList.add('compass-fs-active');
      document.body.classList.add('compass-fs-active');
    } else {
      document.documentElement.classList.remove('compass-fs-active');
      document.body.classList.remove('compass-fs-active');
    }
  }

  async function toggleFullscreen(force) {
    const next = force !== undefined ? force : !isFullscreen;
    updateFullscreenUI(next);

    const hasNativeFs = !!(document.fullscreenElement || document.webkitFullscreenElement);
    if (next) {
      if (!hasNativeFs) {
        try {
          const req = root.requestFullscreen || root.webkitRequestFullscreen;
          if (req) {
            await req.call(root);
          }
        } catch (_) {}
      }
    } else {
      if (hasNativeFs) {
        try {
          const exit = document.exitFullscreen || document.webkitExitFullscreen;
          if (exit) await exit.call(document);
        } catch (_) {}
      }
    }
  }

  fsBtn?.addEventListener('click', () => toggleFullscreen());
  fsToggleBtn?.addEventListener('click', () => toggleFullscreen());
  fsExitBtn?.addEventListener('click', () => toggleFullscreen(false));

  function onNativeFsChange() {
    const nativeActive = !!(document.fullscreenElement || document.webkitFullscreenElement);
    if (!nativeActive && isFullscreen) {
      updateFullscreenUI(false);
    }
  }
  document.addEventListener('fullscreenchange', onNativeFsChange);
  document.addEventListener('webkitfullscreenchange', onNativeFsChange);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isFullscreen) {
      toggleFullscreen(false);
    }
  });

  const isMobile = /Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent);

  if (needsPermission) {
    permCard.classList.remove('hidden');
    permCard.classList.add('flex');
    noticeLive = true;
  } else if (isMobile) {
    noticeLive = true;
    compass.start();
  } else {
    setStatus('no-gyro');
    showSensorError(
      'No gyroscope sensor detected',
      'The live compass needs a gyroscope and magnetometer, which most desktop computers and laptops do not have. Open this page on your phone to get real headings — the location, Qibla, bearing, and sun tools all work here.'
    );
  }

  demoCopy?.addEventListener('click', () => {
    const url = demoShare?.dataset.pageUrl;
    if (!url) return;
    navigator.clipboard
      .writeText(url)
      .then(() => {
        demoCopy.textContent = 'Copied ✓';
        setTimeout(() => (demoCopy.textContent = 'Copy link'), 1500);
      })
      .catch(() => {});
  });

  sensorErrorCopy?.addEventListener('click', () => {
    const url = sensorErrorShare?.dataset.pageUrl;
    if (!url) return;
    navigator.clipboard
      .writeText(url)
      .then(() => {
        sensorErrorCopy.textContent = 'Copied ✓';
        setTimeout(() => (sensorErrorCopy.textContent = 'Copy link'), 1500);
      })
      .catch(() => {});
  });

  tick();

  /* ---------------- cross-component markers ---------------- */

  window.addEventListener('compass:target', (e) => {
    qiblaBearing = e.detail?.bearing ?? null;
    const marker = rose.querySelector('[data-marker="qibla"]');
    setMarker(marker, qiblaBearing);
  });

  window.addEventListener('compass:sun', (e) => {
    sunAzimuth = e.detail?.azimuth ?? null;
    const marker = rose.querySelector('[data-marker="sun"]');
    setMarker(marker, sunAzimuth);
  });
</script>

<style>
  [data-live-view] {
    transition: opacity 0.3s ease;
  }
  .compass-root svg text {
    user-select: none;
  }

  /* Full screen mode — ONLY the compass dial and related data are visible */
  .compass-root.is-fullscreen,
  .compass-root:fullscreen,
  .compass-root:-webkit-full-screen {
    position: fixed !important;
    inset: 0 !important;
    z-index: 999999 !important;
    width: 100vw !important;
    max-width: 100vw !important;
    height: 100dvh !important;
    max-height: 100dvh !important;
    margin: 0 !important;
    padding: max(env(safe-area-inset-top), 16px) max(env(safe-area-inset-right), 16px) max(env(safe-area-inset-bottom), 16px) max(env(safe-area-inset-left), 16px) !important;
    background: var(--color-canvas) !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: space-evenly !important;
    overflow: hidden !important;
    box-sizing: border-box !important;
  }

  .compass-root.is-fullscreen [data-live-view],
  .compass-root:fullscreen [data-live-view],
  .compass-root:-webkit-full-screen [data-live-view] {
    width: 100% !important;
    height: 100% !important;
    max-height: 100% !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: space-evenly !important;
    gap: 0.5rem !important;
  }

  .compass-root.is-fullscreen [data-dial-box],
  .compass-root:fullscreen [data-dial-box],
  .compass-root:-webkit-full-screen [data-dial-box] {
    width: min(84vw, 54vh, 500px) !important;
    max-width: min(84vw, 54vh, 500px) !important;
    height: min(84vw, 54vh, 500px) !important;
    aspect-ratio: 1 / 1 !important;
    margin: 0 auto !important;
    flex-shrink: 0 !important;
  }

  .compass-root.is-fullscreen [data-readout],
  .compass-root:fullscreen [data-readout],
  .compass-root:-webkit-full-screen [data-readout] {
    margin-top: 0 !important;
    flex-shrink: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    gap: 0.25rem !important;
  }

  .compass-root.is-fullscreen [data-heading-deg],
  .compass-root:fullscreen [data-heading-deg],
  .compass-root:-webkit-full-screen [data-heading-deg] {
    font-size: clamp(3.5rem, 8.5vh, 5.5rem) !important;
    line-height: 1 !important;
  }

  /* Hide everything except the compass and its related data */
  .compass-root.is-fullscreen [data-perm-card],
  .compass-root:fullscreen [data-perm-card],
  .compass-root:-webkit-full-screen [data-perm-card],
  .compass-root.is-fullscreen [data-sensor-error],
  .compass-root:fullscreen [data-sensor-error],
  .compass-root:-webkit-full-screen [data-sensor-error],
  .compass-root.is-fullscreen [data-demo-notice],
  .compass-root:fullscreen [data-demo-notice],
  .compass-root:-webkit-full-screen [data-demo-notice],
  .compass-root.is-fullscreen [data-calibration],
  .compass-root:fullscreen [data-calibration],
  .compass-root:-webkit-full-screen [data-calibration],
  .compass-root.is-fullscreen [data-loc-wrap],
  .compass-root:fullscreen [data-loc-wrap],
  .compass-root:-webkit-full-screen [data-loc-wrap],
  .compass-root.is-fullscreen [data-fs-toggle],
  .compass-root:fullscreen [data-fs-toggle],
  .compass-root:-webkit-full-screen [data-fs-toggle],
  .compass-root.is-fullscreen [data-hz-item],
  .compass-root:fullscreen [data-hz-item],
  .compass-root:-webkit-full-screen [data-hz-item] {
    display: none !important;
  }

  .compass-root.is-fullscreen [data-fs-exit],
  .compass-root:fullscreen [data-fs-exit],
  .compass-root:-webkit-full-screen [data-fs-exit] {
    display: inline-flex !important;
  }

  :global(html.compass-fs-active),
  :global(body.compass-fs-active) {
    overflow: hidden !important;
  }
</style>
