---
interface Props {
	eyebrow: string;
	title: string;
	description: string;
}

const { eyebrow, title, description } = Astro.props;
---
<section class="relative">
	<div class="mx-auto max-w-[1200px] px-4 py-16 sm:px-6 md:py-24">
		<div class="max-w-2xl">
			<p class="eyebrow">{eyebrow}</p>
			<h1 class="mt-4 text-display-lg text-ink md:text-[40px] md:leading-[48px]">{title}</h1>
			<p class="mt-4 text-body-lg text-body">{description}</p>
		</div>
		<div class="mt-12">
			<slot />
		</div>
	</div>
</section>