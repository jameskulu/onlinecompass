---
// Coordinate Format Converter & Great-Circle Bearing Calculator
import { getLangFromUrl } from '../i18n/utils';
import { defaultLang } from '../i18n/ui';
import { getToolStrings } from '../i18n/tools-i18n';

interface Props {
  lang?: string;
}

const { lang: propLang } = Astro.props;
const lang = propLang ?? getLangFromUrl(Astro.url) ?? defaultLang;
const strings = getToolStrings(lang).bearing;

const CITIES = [
  { name: 'New York', lat: 40.7128, lng: -74.006 },
  { name: 'London', lat: 51.5074, lng: -0.1278 },
  { name: 'Tokyo', lat: 35.6762, lng: 139.6503 },
  { name: 'Sydney', lat: -33.8688, lng: 151.2093 },
  { name: 'Paris', lat: 48.8566, lng: 2.3522 },
  { name: 'Dubai', lat: 25.2048, lng: 55.2708 },
  { name: 'Singapore', lat: 1.3521, lng: 103.8198 },
  { name: 'Moscow', lat: 55.7558, lng: 37.6173 },
  { name: 'Los Angeles', lat: 34.0522, lng: -118.2437 },
  { name: 'Istanbul', lat: 41.0082, lng: 28.9784 },
  { name: 'Cairo', lat: 30.0444, lng: 31.2357 },
  { name: 'Delhi', lat: 28.6139, lng: 77.209 },
  { name: 'Mumbai', lat: 19.076, lng: 72.8777 },
  { name: 'Beijing', lat: 39.9042, lng: 116.4074 },
  { name: 'Bangkok', lat: 13.7563, lng: 100.5018 },
  { name: 'Jakarta', lat: -6.2088, lng: 106.8456 },
  { name: 'Berlin', lat: 52.52, lng: 13.405 },
  { name: 'São Paulo', lat: -23.5505, lng: -46.6333 },
  { name: 'Mexico City', lat: 19.4326, lng: -99.1332 },
  { name: 'Cape Town', lat: -33.9249, lng: 18.4241 },
  { name: 'Mecca (Kaaba)', lat: 21.4225, lng: 39.8262 },
];
---

<section class="bearing-converter-tool card-lg p-6 md:p-8" id="bearing-converter" data-lang={lang} data-strings={JSON.stringify(strings)}>
  <!-- Header with Tab Navigation -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <div>
      <p class="eyebrow">coordinate converter & bearing calculator</p>
      <h3 class="text-display-sm text-ink mt-1">{strings.title}</h3>
    </div>

    <!-- Mode Selector Tabs -->
    <div class="inline-flex rounded-lg border border-hairline bg-canvas-soft p-1 text-xs font-medium" role="tablist">
      <button
        type="button"
        data-tool-tab="bearing"
        class="rounded-md px-3.5 py-1.5 transition-colors bg-ink text-on-primary font-semibold shadow-xs"
        role="tab"
        aria-selected="true"
      >{strings.tabBearing}</button>
      <button
        type="button"
        data-tool-tab="converter"
        class="rounded-md px-3.5 py-1.5 transition-colors text-body hover:text-ink"
        role="tab"
        aria-selected="false"
      >{strings.tabConverter}</button>
    </div>
  </div>

  <!-- PANEL 1: Bearing & Great-Circle Distance Calculator -->
  <div data-panel-bearing class="space-y-6">
    <div class="grid gap-6 md:grid-cols-2">
      <!-- Point A -->
      <fieldset class="grid gap-3.5 content-start rounded-xl border border-hairline bg-canvas-soft/40 p-5">
        <legend class="eyebrow px-2">{strings.legendPointA}</legend>
        <label class="grid gap-1.5">
          <span class="text-xs font-medium text-body">{strings.labelLatA}</span>
          <input data-a-lat class="field-input text-sm font-mono" type="number" step="any" placeholder="e.g. 51.5074" value="51.5074" />
          <input data-a-lat-r class="slider" type="range" min="-90" max="90" step="0.5" value="51.5" aria-label="Point A latitude" />
        </label>
        <label class="grid gap-1.5">
          <span class="text-xs font-medium text-body">{strings.labelLngA}</span>
          <input data-a-lng class="field-input text-sm font-mono" type="number" step="any" placeholder="e.g. -0.1278" value="-0.1278" />
          <input data-a-lng-r class="slider" type="range" min="-180" max="180" step="0.5" value="-0.1" aria-label="Point A longitude" />
        </label>
        <div class="flex items-center gap-2 pt-1">
          <button type="button" data-a-gps class="btn-nav btn-nav-white border border-hairline text-xs font-medium">
            <svg class="h-3.5 w-3.5 text-link" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="8"></circle>
              <line x1="12" y1="2" x2="12" y2="4"></line>
              <line x1="12" y1="20" x2="12" y2="22"></line>
              <line x1="2" y1="12" x2="4" y2="12"></line>
              <line x1="20" y1="12" x2="22" y2="12"></line>
            </svg>
            {strings.btnGpsLocation}
          </button>
        </div>
      </fieldset>

      <!-- Point B -->
      <fieldset class="grid gap-3.5 content-start rounded-xl border border-hairline bg-canvas-soft/40 p-5">
        <legend class="eyebrow px-2">{strings.legendPointB}</legend>
        <label class="grid gap-1.5">
          <span class="text-xs font-medium text-body">Latitude</span>
          <input data-b-lat class="field-input text-sm font-mono" type="number" step="any" placeholder="e.g. 40.7128" value="40.7128" />
          <input data-b-lat-r class="slider" type="range" min="-90" max="90" step="0.5" value="40.7" aria-label="Point B latitude" />
        </label>
        <label class="grid gap-1.5">
          <span class="text-xs font-medium text-body">Longitude</span>
          <input data-b-lng class="field-input text-sm font-mono" type="number" step="any" placeholder="e.g. -74.006" value="-74.006" />
          <input data-b-lng-r class="slider" type="range" min="-180" max="180" step="0.5" value="-74.0" aria-label="Point B longitude" />
        </label>
        <label class="grid gap-1.5">
          <span class="text-xs font-medium text-body">{strings.labelDestCities}</span>
          <select data-b-city class="field-input text-sm">
            <option value="">{strings.selectDest}</option>
            {CITIES.map((c) => (
              <option value={`${c.lat},${c.lng}`} data-name={c.name} selected={c.name === 'New York'}>
                {c.name} ({c.lat > 0 ? `${c.lat}°N` : `${Math.abs(c.lat)}°S`})
              </option>
            ))}
          </select>
        </label>
      </fieldset>
    </div>

    <!-- Quick Preset Buttons -->
    <div class="flex flex-wrap items-center gap-2">
      <span class="eyebrow mr-1">{strings.popularRoutes}</span>
      <button type="button" data-route-london-nyc class="btn-nav btn-nav-white border border-hairline text-xs font-medium">
        London → New York
      </button>
      <button type="button" data-route-tokyo-sydney class="btn-nav btn-nav-white border border-hairline text-xs font-medium">
        Tokyo → Sydney
      </button>
      <button type="button" data-route-paris-cairo class="btn-nav btn-nav-white border border-hairline text-xs font-medium">
        Paris → Cairo
      </button>
      <button type="button" data-route-sf-tokyo class="btn-nav btn-nav-white border border-hairline text-xs font-medium">
        Los Angeles → Tokyo
      </button>
    </div>

    <button type="button" data-btn-compute class="btn-primary text-sm h-11 px-7">
      {strings.btnCompute}
    </button>

    <!-- Results Display -->
    <div data-b-result class="space-y-6 pt-2">
      <div class="rounded-xl border border-hairline bg-canvas p-5 shadow-xs">
        <p data-b-summary class="text-ink text-sm font-medium leading-6 mb-4">
          Route summary loading…
        </p>

        <!-- Metric Readouts -->
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <div class="card-soft p-4">
            <p class="eyebrow mb-1">{strings.cardInitBearing}</p>
            <p data-b-bearing class="text-display-md text-ink font-mono tabular-nums">—</p>
            <p class="text-xs text-body mt-1">{strings.cardInitBearingDesc}</p>
          </div>
          <div class="card-soft p-4">
            <p class="eyebrow mb-1">{strings.cardCardinal}</p>
            <p data-b-dir class="text-display-md text-ink font-mono">—</p>
            <p class="text-xs text-body mt-1">{strings.cardCardinalDesc}</p>
          </div>
          <div class="card-soft p-4">
            <p class="eyebrow mb-1">{strings.cardDistance}</p>
            <p data-b-distance class="text-display-md text-ink font-mono tabular-nums">—</p>
            <p data-b-distance-alt class="text-xs text-body mt-1 font-mono tabular-nums">—</p>
          </div>
          <div class="card-soft p-4">
            <p class="eyebrow mb-1">{strings.cardFinalBearing}</p>
            <p data-b-final-bearing class="text-display-md text-ink font-mono tabular-nums">—</p>
            <p class="text-xs text-body mt-1">{strings.cardFinalBearingDesc}</p>
          </div>
        </div>

        <!-- Compass Visualizer Indicator -->
        <div class="mt-6 flex flex-col sm:flex-row items-center gap-6 rounded-lg border border-hairline bg-canvas-soft/50 p-5">
          <div class="relative w-28 h-28 flex items-center justify-center shrink-0">
            <svg class="w-full h-full" viewBox="0 0 100 100">
              <circle cx="50" cy="50" r="45" fill="none" stroke="var(--color-hairline-strong)" stroke-width="1.5" />
              <circle cx="50" cy="50" r="42" fill="none" stroke="var(--color-hairline)" stroke-width="0.5" stroke-dasharray="2 2" />
              <!-- Cardinals -->
              <text x="50" y="14" font-size="8" font-family="monospace" font-weight="bold" fill="var(--color-ink)" text-anchor="middle">N</text>
              <text x="88" y="53" font-size="8" font-family="monospace" font-weight="bold" fill="var(--color-mute)" text-anchor="middle">E</text>
              <text x="50" y="92" font-size="8" font-family="monospace" font-weight="bold" fill="var(--color-mute)" text-anchor="middle">S</text>
              <text x="12" y="53" font-size="8" font-family="monospace" font-weight="bold" fill="var(--color-mute)" text-anchor="middle">W</text>
              <!-- Rotatable Bearing Needle Vector -->
              <g data-bearing-needle style="transform-origin: 50px 50px; transition: transform 0.4s ease-out;">
                <line x1="50" y1="50" x2="50" y2="18" stroke="#ef4444" stroke-width="2.5" stroke-linecap="round" />
                <polygon points="50,12 46,20 54,20" fill="#ef4444" />
                <line x1="50" y1="50" x2="50" y2="72" stroke="var(--color-mute)" stroke-width="1.5" stroke-linecap="round" opacity="0.6" />
                <circle cx="50" cy="50" r="3.5" fill="var(--color-ink)" />
              </g>
            </svg>
          </div>
          <div class="space-y-1.5 text-center sm:text-left">
            <h4 class="text-sm font-semibold text-ink">{strings.headingVectorTitle}</h4>
            <p class="text-xs text-body leading-5">
              {strings.headingVectorDesc} <span data-b-vector-deg class="font-mono font-semibold text-ink">0°</span> {strings.headingVectorSub}
            </p>
          </div>
        </div>
      </div>

      <!-- Point A Environmental & Astronomical Context -->
      <div>
        <p class="eyebrow mb-3">{strings.telemetryTitle}</p>
        <div class="grid gap-4 sm:grid-cols-3">
          <div class="card-soft p-4">
            <p class="eyebrow mb-1">{strings.cardQibla}</p>
            <p data-b-qibla class="text-display-md text-ink font-mono">—</p>
            <p class="text-xs text-body mt-1">{strings.cardQiblaDesc}</p>
          </div>
          <div class="card-soft p-4">
            <p class="eyebrow mb-1">{strings.cardDecl}</p>
            <p data-b-decl class="text-display-md text-ink font-mono tabular-nums">—</p>
            <p class="text-xs text-body mt-1">{strings.cardDeclDesc}</p>
          </div>
          <div class="card-soft p-4">
            <p class="eyebrow mb-1">{strings.cardSun}</p>
            <p data-b-sun class="text-display-md text-ink font-mono">—</p>
            <p class="text-xs text-body mt-1">{strings.cardSunDesc}</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- PANEL 2: Coordinate Format Converter -->
  <div data-panel-converter class="hidden space-y-6">
    <div class="rounded-xl border border-hairline bg-canvas-soft/40 p-5">
      <h4 class="text-display-sm text-ink mb-1 font-semibold">{strings.convTitle}</h4>
      <p class="text-sm text-body leading-6 mb-5">
        {strings.convDesc}
      </p>

      <!-- Input Bar -->
      <div class="space-y-3">
        <label class="block">
          <span class="eyebrow mb-1.5 block">{strings.convInputLabel}</span>
          <div class="flex flex-col sm:flex-row gap-2">
            <input
              data-converter-input
              type="text"
              class="field-input flex-1 font-mono text-sm h-11"
              placeholder="e.g. 40° 42' 46.1&quot; N, 74° 0' 21.6&quot; W  OR  40.7128, -74.0060  OR  18T 583959 4507351"
              value="40.7128, -74.0060"
            />
            <button
              type="button"
              data-btn-conv-convert
              class="btn-primary text-sm h-11 px-6 shrink-0"
            >{strings.convBtn}</button>
            <button
              type="button"
              data-btn-conv-gps
              class="btn-nav btn-nav-white border border-hairline text-xs font-medium h-11 px-4 shrink-0"
            >
              {strings.btnGpsLocation}
            </button>
          </div>
        </label>
        <p data-converter-error class="hidden text-xs text-error font-medium">
          {strings.convError}
        </p>
      </div>
    </div>

    <!-- Conversion Results Grid -->
    <div class="grid gap-4 sm:grid-cols-2">
      <!-- 1. Decimal Degrees (DD) -->
      <div class="card-soft p-5 relative group">
        <div class="flex items-center justify-between mb-2">
          <span class="eyebrow">{strings.cardDD}</span>
          <button
            type="button"
            data-copy-btn="dd"
            class="text-xs text-link font-medium hover:underline flex items-center gap-1 cursor-pointer"
          >{strings.btnCopy}</button>
        </div>
        <p data-out-dd class="text-display-sm text-ink font-mono tabular-nums break-all">40.712800°, -74.006000°</p>
        <p class="text-xs text-body mt-2">{strings.cardDDDesc}</p>
      </div>

      <!-- 2. Degrees Minutes Seconds (DMS) -->
      <div class="card-soft p-5 relative group">
        <div class="flex items-center justify-between mb-2">
          <span class="eyebrow">{strings.cardDMS}</span>
          <button
            type="button"
            data-copy-btn="dms"
            class="text-xs text-link font-medium hover:underline flex items-center gap-1 cursor-pointer"
          >{strings.btnCopy}</button>
        </div>
        <p data-out-dms class="text-display-sm text-ink font-mono tabular-nums break-all">40° 42' 46.1" N, 74° 0' 21.6" W</p>
        <p class="text-xs text-body mt-2">{strings.cardDMSDesc}</p>
      </div>

      <!-- 3. UTM (Universal Transverse Mercator) -->
      <div class="card-soft p-5 relative group">
        <div class="flex items-center justify-between mb-2">
          <span class="eyebrow">{strings.cardUTM}</span>
          <button
            type="button"
            data-copy-btn="utm"
            class="text-xs text-link font-medium hover:underline flex items-center gap-1 cursor-pointer"
          >{strings.btnCopy}</button>
        </div>
        <p data-out-utm class="text-display-sm text-ink font-mono tabular-nums break-all">18T 583959m E 4507351m N</p>
        <p class="text-xs text-body mt-2">{strings.cardUTMDesc}</p>
      </div>

      <!-- 4. Plus Code (Open Location Code) -->
      <div class="card-soft p-5 relative group">
        <div class="flex items-center justify-between mb-2">
          <span class="eyebrow">{strings.cardOLC}</span>
          <button
            type="button"
            data-copy-btn="olc"
            class="text-xs text-link font-medium hover:underline flex items-center gap-1 cursor-pointer"
          >{strings.btnCopy}</button>
        </div>
        <p data-out-olc class="text-display-sm text-ink font-mono tabular-nums break-all">87G8P2X7+9P</p>
        <p class="text-xs text-body mt-2">{strings.cardOLCDesc}</p>
      </div>
    </div>

    <!-- External Map Links -->
    <div class="flex flex-wrap items-center gap-3 pt-2">
      <span class="eyebrow">{strings.viewOnMap}</span>
      <a
        data-link-gmaps
        href="https://www.google.com/maps/search/?api=1&query=40.7128,-74.006"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-nav btn-nav-white border border-hairline text-xs font-medium"
      >
        Google Maps ↗
      </a>
      <a
        data-link-osm
        href="https://www.openstreetmap.org/?mlat=40.7128&mlon=-74.006#map=14/40.7128/-74.006"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-nav btn-nav-white border border-hairline text-xs font-medium"
      >
        OpenStreetMap ↗
      </a>
    </div>
  </div>
</section>

<script>
  import {
    initialBearing,
    finalBearing,
    haversine,
    directionName,
    qiblaBearing,
    magneticDeclination,
    sunPosition,
    formatDMS,
    toUTM,
    encodePlusCode,
    parseCoordinateInput,
  } from '../lib/geo.js';
  import { wireSlider } from '../lib/slider.js';

  (function initBearingAndConverter() {
    const root = document.getElementById('bearing-converter');
    if (!root) return;

    const strings = JSON.parse(root.dataset.strings || "{}");
    const $ = (sel) => root.querySelector(sel);
    const $$ = (sel) => root.querySelectorAll(sel);

    // Mode tabs
    const tabBearing = $('[data-tool-tab="bearing"]');
    const tabConverter = $('[data-tool-tab="converter"]');
    const panelBearing = $('[data-panel-bearing]');
    const panelConverter = $('[data-panel-converter]');

    function switchTab(tab) {
      if (tab === 'bearing') {
        tabBearing.className = 'rounded-md px-3.5 py-1.5 transition-colors bg-ink text-on-primary font-semibold shadow-xs';
        tabConverter.className = 'rounded-md px-3.5 py-1.5 transition-colors text-body hover:text-ink';
        panelBearing.classList.remove('hidden');
        panelConverter.classList.add('hidden');
      } else {
        tabConverter.className = 'rounded-md px-3.5 py-1.5 transition-colors bg-ink text-on-primary font-semibold shadow-xs';
        tabBearing.className = 'rounded-md px-3.5 py-1.5 transition-colors text-body hover:text-ink';
        panelConverter.classList.remove('hidden');
        panelBearing.classList.add('hidden');
      }
    }

    tabBearing?.addEventListener('click', () => switchTab('bearing'));
    tabConverter?.addEventListener('click', () => switchTab('converter'));

    /* ============================================================
       BEARING & ROUTE CALCULATOR
       ============================================================ */
    const aLat = $('[data-a-lat]');
    const aLng = $('[data-a-lng]');
    const bLat = $('[data-b-lat]');
    const bLng = $('[data-b-lng]');
    const aLatR = $('[data-a-lat-r]');
    const aLngR = $('[data-a-lng-r]');
    const bLatR = $('[data-b-lat-r]');
    const bLngR = $('[data-b-lng-r]');

    const syncALat = wireSlider(aLat, aLatR, -90, 90);
    const syncALng = wireSlider(aLng, aLngR, -180, 180);
    const syncBLat = wireSlider(bLat, bLatR, -90, 90);
    const syncBLng = wireSlider(bLng, bLngR, -180, 180);

    const calcBtn = $('[data-btn-compute]');
    const citySel = $('[data-b-city]');
    const aGpsBtn = $('[data-a-gps]');

    const bearingEl = $('[data-b-bearing]');
    const dirEl = $('[data-b-dir]');
    const distanceEl = $('[data-b-distance]');
    const distanceAltEl = $('[data-b-distance-alt]');
    const finalBearingEl = $('[data-b-final-bearing]');
    const summaryEl = $('[data-b-summary]');
    const vectorDegEl = $('[data-b-vector-deg]');
    const bearingNeedle = $('[data-bearing-needle]');

    const qiblaEl = $('[data-b-qibla]');
    const declEl = $('[data-b-decl]');
    const sunEl = $('[data-b-sun]');

    let aName = 'London';
    let bName = 'New York';

    function computeBearing() {
      const lat1 = parseFloat(aLat.value);
      const lng1 = parseFloat(aLng.value);
      const lat2 = parseFloat(bLat.value);
      const lng2 = parseFloat(bLng.value);

      if ([lat1, lng1, lat2, lng2].some(Number.isNaN)) return;

      const initB = initialBearing(lat1, lng1, lat2, lng2);
      const finB = finalBearing(lat1, lng1, lat2, lng2);
      const distKm = haversine(lat1, lng1, lat2, lng2);
      const distMiles = distKm * 0.621371;
      const distNM = distKm * 0.539957;

      const roundedInit = Math.round(initB);
      const roundedFin = Math.round(finB);
      const cardinal = directionName(initB, true);

      if (bearingEl) bearingEl.textContent = `${roundedInit}°`;
      if (dirEl) dirEl.textContent = cardinal;
      if (distanceEl) distanceEl.textContent = `${distKm > 100 ? Math.round(distKm).toLocaleString() : distKm.toFixed(1)} km`;
      if (distanceAltEl) distanceAltEl.textContent = `(${Math.round(distMiles).toLocaleString()} mi · ${Math.round(distNM).toLocaleString()} NM)`;
      if (finalBearingEl) finalBearingEl.textContent = `${roundedFin}° (${directionName(finB, true)})`;
      if (vectorDegEl) vectorDegEl.textContent = `${roundedInit}° ${cardinal}`;

      if (bearingNeedle) {
        bearingNeedle.style.transform = `rotate(${initB.toFixed(1)}deg)`;
      }

      if (summaryEl) {
        summaryEl.textContent = `${bName} is ${roundedInit}° ${cardinal} from ${aName}, along a great-circle route of ${Math.round(distKm).toLocaleString()} km (${Math.round(distMiles).toLocaleString()} miles).`;
      }

      // Telemetry from Point A
      if (qiblaEl) {
        const qibla = qiblaBearing(lat1, lng1);
        qiblaEl.textContent = `${Math.round(qibla)}° ${directionName(qibla, false)}`;
      }
      if (declEl) {
        const decl = magneticDeclination(lat1, lng1);
        declEl.textContent = `${decl >= 0 ? '+' : ''}${decl.toFixed(1)}°`;
      }
      if (sunEl) {
        const sun = sunPosition(new Date(), lat1, lng1).azimuth;
        sunEl.textContent = `${Math.round(sun)}° ${directionName(sun, false)}`;
      }
    }

    calcBtn?.addEventListener('click', computeBearing);

    citySel?.addEventListener('change', () => {
      const opt = citySel.selectedOptions[0];
      if (!opt?.value) return;
      const [lat, lng] = opt.value.split(',').map(Number);
      bLat.value = lat;
      bLng.value = lng;
      bName = opt.dataset.name || 'Destination';
      syncBLat();
      syncBLng();
      computeBearing();
    });

    aGpsBtn?.addEventListener('click', () => {
      if (!navigator.geolocation) {
        alert(strings.errNoSensor || 'This device has no sensor for this tool.');
        return;
      }
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          aLat.value = pos.coords.latitude.toFixed(6);
          aLng.value = pos.coords.longitude.toFixed(6);
          aName = 'Your Location';
          syncALat();
          syncALng();
          computeBearing();
        },
        (err) => {
          if (err.code === 2) {
            alert(strings.errNoGps || 'This device has no GPS sensor for this tool.');
          } else {
            alert(strings.errDenied || 'Location permission was denied.');
          }
        },
        { enableHighAccuracy: true },
      );
    });

    // Preset Routes
    function setRoute(latA, lngA, nameA, latB, lngB, nameB) {
      aLat.value = latA;
      aLng.value = lngA;
      bLat.value = latB;
      bLng.value = lngB;
      aName = nameA;
      bName = nameB;
      syncALat();
      syncALng();
      syncBLat();
      syncBLng();
      computeBearing();
    }

    $('[data-route-london-nyc]')?.addEventListener('click', () => setRoute(51.5074, -0.1278, 'London', 40.7128, -74.006, 'New York'));
    $('[data-route-tokyo-sydney]')?.addEventListener('click', () => setRoute(35.6762, 139.6503, 'Tokyo', -33.8688, 151.2093, 'Sydney'));
    $('[data-route-paris-cairo]')?.addEventListener('click', () => setRoute(48.8566, 2.3522, 'Paris', 30.0444, 31.2357, 'Cairo'));
    $('[data-route-sf-tokyo]')?.addEventListener('click', () => setRoute(34.0522, -118.2437, 'Los Angeles', 35.6762, 139.6503, 'Tokyo'));

    // Initial calculation
    computeBearing();

    /* ============================================================
       COORDINATE FORMAT CONVERTER
       ============================================================ */
    const convInput = $('[data-converter-input]');
    const convBtn = $('[data-btn-conv-convert]');
    const convGpsBtn = $('[data-btn-conv-gps]');
    const convError = $('[data-converter-error]');

    const outDD = $('[data-out-dd]');
    const outDMS = $('[data-out-dms]');
    const outUTM = $('[data-out-utm]');
    const outOLC = $('[data-out-olc]');

    const linkGmaps = $('[data-link-gmaps]');
    const linkOSM = $('[data-link-osm]');

    function performConversion(parsed) {
      if (!parsed || Number.isNaN(parsed.lat) || Number.isNaN(parsed.lng)) {
        convError?.classList.remove('hidden');
        return;
      }
      convError?.classList.add('hidden');

      const lat = parsed.lat;
      const lng = parsed.lng;

      // 1. DD
      const ddFormatted = `${lat.toFixed(6)}°, ${lng.toFixed(6)}°`;
      if (outDD) outDD.textContent = ddFormatted;

      // 2. DMS
      const dmsFormatted = formatDMS(lat, lng);
      if (outDMS) outDMS.textContent = dmsFormatted;

      // 3. UTM
      const utmObj = toUTM(lat, lng);
      const utmFormatted = utmObj.formatted || 'Polar (Out of UTM zone)';
      if (outUTM) outUTM.textContent = utmFormatted;

      // 4. Plus Code
      const olcFormatted = encodePlusCode(lat, lng);
      if (outOLC) outOLC.textContent = olcFormatted;

      // Update external map links
      if (linkGmaps) linkGmaps.href = `https://www.google.com/maps/search/?api=1&query=${lat.toFixed(6)},${lng.toFixed(6)}`;
      if (linkOSM) linkOSM.href = `https://www.openstreetmap.org/?mlat=${lat.toFixed(6)}&mlon=${lng.toFixed(6)}#map=14/${lat.toFixed(6)}/${lng.toFixed(6)}`;
    }

    convBtn?.addEventListener('click', () => {
      const val = convInput?.value || '';
      const parsed = parseCoordinateInput(val);
      performConversion(parsed);
    });

    convInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const parsed = parseCoordinateInput(convInput.value);
        performConversion(parsed);
      }
    });

    convGpsBtn?.addEventListener('click', () => {
      if (!navigator.geolocation) {
        alert('This device has no sensor for this tool. Geolocation is not supported by your browser or hardware.');
        return;
      }
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          const lat = pos.coords.latitude;
          const lng = pos.coords.longitude;
          if (convInput) convInput.value = `${lat.toFixed(6)}, ${lng.toFixed(6)}`;
          performConversion({ lat, lng });
        },
        (err) => {
          if (err.code === 2) {
            alert('This device has no GPS sensor for this tool (or position is unavailable). Please enter coordinates manually.');
          } else {
            alert(strings.errDenied || 'Location permission was denied.');
          }
        },
        { enableHighAccuracy: true },
      );
    });

    // Copy Buttons with tooltip feedback
    $$('[data-copy-btn]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const type = btn.dataset.copyBtn;
        let textToCopy = '';
        if (type === 'dd') textToCopy = outDD?.textContent || '';
        if (type === 'dms') textToCopy = outDMS?.textContent || '';
        if (type === 'utm') textToCopy = outUTM?.textContent || '';
        if (type === 'olc') textToCopy = outOLC?.textContent || '';

        if (textToCopy) {
          try {
            await navigator.clipboard.writeText(textToCopy);
            const orig = btn.textContent;
            btn.textContent = strings.copied || 'Copied!';
            btn.classList.add('text-emerald-500');
            setTimeout(() => {
              btn.textContent = orig;
              btn.classList.remove('text-emerald-500');
            }, 1800);
          } catch (_) {}
        }
      });
    });

    // Trigger initial conversion for the default NYC coordinate
    performConversion({ lat: 40.7128, lng: -74.006 });
  })();
</script>
